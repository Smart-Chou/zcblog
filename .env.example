# 所有数据源变量均为可选：不配置则跳过对应数据的拉取（保留现有 JSON）

# ── 数据源 ──

# Blinko 服务地址 + API Token（用于 fetch-talks.mjs 拉取随笔数据）
# BLINKO_API_URL=https://memos.example.com
# BLINKO_API_TOKEN=

# 豆瓣用户 ID（用于 fetch-douban.mjs 拉取书影音数据）
# DOUBAN_USER_ID=

# Bangumi 用户 ID（用于 fetch-bangumi.mjs 拉取追番数据）
# BANGUMI_USER_ID=

# ── 其他 ──

# Foreverblog RSS 源地址（用于 fetch-friends.mjs，默认用 rsshub.rssforever.com）
# FOREVERBLOG_RSS_URL=https://rsshub.rssforever.com/foreverblog/feeds

# 文章加密密码（用于 remark-encrypted；存在加密内容但未设置时会构建报错）
# ENCRYPTION_PASSWORD=your-secret-password

# 构建并发数（用于 astro.config.mjs；不设时 = CPU 核心数 os.cpus().length）
# BUILD_CONCURRENCY=2

# ── 热门文章（Umami 统计，可选）──

# Umami 只读（view-only）账号；未配置时跳过热门文章数据抓取（首页自动隐藏该区块）
# UMAMI_API_URL=https://umami.example.com
# UMAMI_WEBSITE_ID=
# UMAMI_USERNAME=
# UMAMI_PASSWORD=
