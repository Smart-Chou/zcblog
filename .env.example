# 豆瓣用户 ID（用于抓取书影音数据）
# 在豆瓣个人主页 URL 中查找，如 https://www.douban.com/people/123456789/
DOUBAN_USER_ID=

# Blinko API Token（用于抓取公开笔记/Talks）
# 在 Blinko 设置 → API Token 中获取
BLINKO_API_TOKEN=

# Foreverblog RSS 地址（可选，默认为 rsshub.rssforever.com）
# 用于抓取友圈文章
# FOREVERBLOG_RSS_URL=https://rsshub.rssforever.com/foreverblog/feeds
