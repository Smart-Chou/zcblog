{
    "name": "dogeared",
    "version": "1.0.0",
    "description": "Dogeared — a warm editorial blog theme for Astro: Pagefind search, optional Waline comments, PWA, zh-CN/en i18n.",
    "type": "module",
    "private": true,
    "author": "MarxChou",
    "license": "MIT",
    "homepage": "https://github.com/Smart-Chou/dogeared",
    "keywords": [
        "astro",
        "astro-theme",
        "blog",
        "blog-theme",
        "editorial",
        "tailwindcss",
        "pwa"
    ],
    "scripts": {
        "dev": "astro dev",
        "dev:clean": "rm -rf node_modules/.vite && astro dev",
        "start": "astro dev",
        "build": "pnpm run fetch:all || true && pnpm run fetch:verify || true && astro build",
        "pagefind": "node scripts/pagefind.mjs",
        "preview": "astro preview",
        "astro": "astro",
        "type-check": "tsc --noEmit",
        "new-post": "node scripts/new-post.js",
        "preinstall": "npx only-allow pnpm",
        "fetch:all": "pnpm run talks & pnpm run douban & pnpm run friends & pnpm run bangumi & pnpm run icons",
        "icons": "node scripts/generate-icons.js",
        "talks": "node scripts/fetch-talks.mjs",
        "douban": "node scripts/fetch-douban.mjs",
        "friends": "node scripts/fetch-friends.mjs",
        "bangumi": "node scripts/fetch-bangumi.mjs",
        "fetch:verify": "node scripts/verify-data.mjs",
        "links": "node scripts/link-check.mjs",
        "release": "standard-version",
        "release:dry": "standard-version --dry-run",
        "format": "prettier -w .",
        "format:check": "prettier --check .",
        "lint": "pnpm run format:check",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/markdown-remark": "^7.3.1",
        "@astrojs/mdx": "^7.0.8",
        "@astrojs/partytown": "^2.1.8",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@expressive-code/plugin-collapsible-sections": "^0.41.7",
        "@expressive-code/plugin-line-numbers": "^0.41.7",
        "@fancyapps/ui": "^6.1.15",
        "@pagefind/component-ui": "^1.5.2",
        "@tailwindcss/vite": "^4.3.3",
        "@waline/client": "^3.16.0",
        "astro": "^7.3.5",
        "astro-expressive-code": "^0.44.2",
        "astro-icon": "^1.2.0",
        "astro-vtbot": "^2.1.12",
        "fast-glob": "^3.3.3",
        "hast-util-to-html": "^9.0.5",
        "hastscript": "^9.0.1",
        "html-minifier-terser": "^7.2.0",
        "katex": "^0.16.47",
        "marked": "^18.0.14",
        "pagefind": "^1.5.2",
        "pangu": "^7.2.1",
        "reading-time": "^1.5.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-callouts": "^2.2.0",
        "rehype-components": "^0.3.0",
        "rehype-katex": "^7.0.1",
        "rehype-slug": "^6.0.0",
        "remark-directive": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "sanitize-html": "^2.17.7",
        "satori": "^0.26.0",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.3.3",
        "tocbot": "^4.36.8",
        "unist-util-remove": "^4.0.0",
        "unist-util-visit": "^5.1.0"
    },
    "devDependencies": {
        "@iconify-json/logos": "^1.2.15",
        "@iconify-json/mingcute": "^1.2.8",
        "@iconify-json/tabler": "^1.2.41",
        "@iconify/utils": "^3.1.7",
        "@playwright/test": "^1.63.0",
        "@types/hast": "^3.0.5",
        "@types/mdast": "^4.0.4",
        "@types/sanitize-html": "^2.16.2",
        "jsdom": "^28.1.0",
        "prettier": "^3.9.9",
        "prettier-plugin-astro": "^0.14.1",
        "standard-version": "^9.5.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.11"
    },
    "packageManager": "pnpm@11.5.0"
}
