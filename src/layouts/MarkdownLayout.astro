---
import "~/styles/remark-aside.css";

import BaseLayout from "~/layouts/BaseLayout.astro";
import PostMeta from "~/components/Article/PostMeta.astro";
import PostCardImage from "~/components/Article/PostCardImage.astro";
import PostFooter from "~/components/Article/PostFooter.astro";
import PostNavigation from "~/components/Article/PostNavigation.astro";
import Toc from "~/components/Article/Toc.astro";
import BackToTop from "~/components/Layout/BackToTop.astro";
import Donate from "~/components/Feature/Donate.astro";
import Author from "~/components/Feature/Author.astro";
import WalineComment from "~/components/Widget/WalineComment.astro";
import { site, postView, waline, donate } from "~/self.config";
import { getRandomImageUrl } from "~/utils";

const {
    frontmatter = {
        waline: false,
        donate: false,
        toc: false,
        mathjax: false,
        mermaid: false,
    },
    slug,
    modifiedTime,
    readTime,
    wordCount,
} = Astro.props;

const today = new Date();
const publishedTime = frontmatter.pubDate;
const publishedDays = Math.floor(
    (today.getTime() - publishedTime.getTime()) / (1000 * 60 * 60 * 24),
);

const imageUrl = frontmatter.image?.url || getRandomImageUrl();
const imageAlt = frontmatter.image?.alt || "Blog Cover";
const ogImage =
    import.meta.env.DEV || import.meta.env.PREVIEW
        ? imageUrl
        : `${Astro.site}og/${slug}.png`;
---

<BaseLayout
    title={`${frontmatter.title} - ${site.title}`}
    description={`${frontmatter.title} - ${frontmatter.description}`}
    image={ogImage}
    imageAlt={imageAlt}
    keywords={frontmatter.tags}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    mathjax={frontmatter.mathjax}
    mermaid={frontmatter.mermaid}
>
    <div class="reading-progress"></div>
    <div class="post-title">
        <h1 class="post-title-text">
            {frontmatter.title}
        </h1>
        <PostMeta
            publishedTime={publishedTime}
            wordCount={wordCount}
            readTime={readTime}
            currentSlug={slug}
        />
    </div>
    <div class="post-card content-box">
        <div class="post-header">
            <PostCardImage imagePath={imageUrl} altText={imageAlt} />
        </div>
        {
            publishedDays >= 180 && (
                <div class="remark-aside remark-aside--danger">
                    <p>
                        🌶 <strong>过期警告：</strong> 本页面距今已有
                        {publishedDays}
                        天未更新，年久失修，内容可能有所偏颇，还请仔细甄别！
                    </p>
                </div>
            )
        }
        <div id="post-content" class="post-content" data-pagefind-body>
            <h2 id="post-content-title" class="toc-ignore" style="display: none;">
                {frontmatter.title}
            </h2>
            <slot />
        </div>
        <PostFooter tags={frontmatter.tags} />
        <PostNavigation slug={slug} />
    </div>
    {frontmatter.toc && <Toc />}
    {postView.backtotop && <BackToTop />}
    {frontmatter.donate && donate.enable && <Donate />}
    {frontmatter.author && postView.author && <Author />}
    {frontmatter.waline && waline.enable && <WalineComment />}
</BaseLayout>

<style>
    .reading-progress {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 1000;
        width: 100%;
        height: 2px;
        background: linear-gradient(to right, #2ea997, #f59e0b);
        transform-origin: left;
        animation: reading-progress linear;
        animation-timeline: scroll(root);
    }

    @keyframes reading-progress {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }

    .post-header {
        width: calc(100% + var(--space) * 2);
        margin-left: calc(var(--space) * -1);
        margin-top: calc(var(--space) * -1);
        margin-bottom: calc(var(--space) / 2);
        overflow: hidden;
        border-radius: var(--radius) var(--radius) 0 0;
    }

    .post-header img {
        width: 100%;
    }

    .post-header:empty {
        display: none;
    }
</style>

<script>
    import "~/scripts/fancybox-handler.ts";
</script>
