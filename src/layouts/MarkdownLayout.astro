---
import { getAllArticles } from "~/utils/article-stats";
import { sortByPubDate } from "~/utils/date-utils";
import { getAdjacentPosts } from "~/utils/adjacent-posts";
import "~/styles/remark-aside.css";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

import BaseLayout from "~/layouts/BaseLayout.astro";
import PostMeta from "~/components/Article/PostMeta.astro";
import PostCardImage from "~/components/Article/PostCardImage.astro";
import PostFooter from "~/components/Article/PostFooter.astro";
import PostNavigation from "~/components/Article/PostNavigation.astro";
import Toc from "~/components/Article/Toc.astro";
import BackToTop from "~/components/Layout/BackToTop.astro";
import Donate from "~/components/UI/Donate.astro";
import Author from "~/components/UI/Author.astro";
import WalineComment from "~/components/UI/WalineComment.astro";
import MermaidRenderer from "~/components/Layout/MermaidRenderer.astro";
import RelatedPosts from "~/components/Article/RelatedPosts.astro";
import Breadcrumb from "~/components/Article/Breadcrumb.astro";
import { site, postView, waline, donate } from "~/config";
import { getRandomImageUrl } from "~/utils";

interface Props {
    frontmatter: Record<string, any>;
    slug: string;
    modifiedTime: Date | string;
    readTime: string;
    wordCount: number;
    noindex?: boolean;
    noEnAlternate?: boolean;
}

const {
    frontmatter = {
        waline: false,
        donate: false,
        toc: false,
        mathjax: false,
        katex: false,
        mermaid: false,
    },
    slug,
    modifiedTime,
    readTime,
    wordCount,
    noindex = false,
    noEnAlternate = false,
} = Astro.props;

const { prev: prevSlug, next: nextSlug } = await getAdjacentPosts(slug);
const prevUrl = prevSlug ? `/article/${prevSlug}/` : null;
const nextUrl = nextSlug ? `/article/${nextSlug}/` : null;

// 相关文章计算需要排序后的完整文章列表
const allPosts = await getAllArticles();
const sorted = sortByPubDate(allPosts);

const today = new Date();
const publishedTime = frontmatter.pubDate;
const updateTime = modifiedTime instanceof Date ? modifiedTime : new Date(modifiedTime);
const daysSinceUpdate = Math.floor(
    (today.getTime() - updateTime.getTime()) / (1000 * 60 * 60 * 24),
);

const imageUrl = frontmatter.image?.url || getRandomImageUrl();
const imageAlt = frontmatter.image?.alt || "Blog Cover";
const ogImage =
    import.meta.env.DEV || import.meta.env.PREVIEW ? imageUrl : `${Astro.site}og/${slug}.png`;

// 相关文章：按标签匹配数量降序排列，排除当前文章，取前 3 篇
const currentTags: string[] = frontmatter.tags || [];
const relatedPosts = sorted
    .filter((post) => post.id !== slug)
    .map((post) => ({
        post,
        matchCount: (post.data.tags || []).filter((tag: string) => currentTags.includes(tag))
            .length,
    }))
    .filter(({ matchCount }) => matchCount > 0)
    .sort((a, b) => b.matchCount - a.matchCount)
    .slice(0, 3)
    .map(({ post }) => post);

const isEn = Astro.url.pathname.startsWith("/en/");
const firstTag = currentTags[0] || "";
---

<BaseLayout
    title={`${frontmatter.title} - ${site.title}`}
    description={`${frontmatter.title} - ${frontmatter.description}`}
    image={ogImage}
    imageAlt={imageAlt}
    keywords={frontmatter.tags}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    mathjax={frontmatter.mathjax}
    katex={frontmatter.katex}
    mermaid={frontmatter.mermaid}
    prevUrl={prevUrl}
    nextUrl={nextUrl}
    noindex={noindex}
    noEnAlternate={noEnAlternate}
    locale={isEn ? "en" : "zh"}
>
    <div class="reading-progress"></div>
    <div class="post-title">
        <h1 class="post-title-text">
            {frontmatter.title}
        </h1>
        <PostMeta
            publishedTime={publishedTime}
            modifiedTime={modifiedTime}
            wordCount={wordCount}
            readTime={readTime}
            currentSlug={slug}
        />
    </div>
    <div class="post-card content-box">
        <div class="post-header">
            <PostCardImage imagePath={imageUrl} altText={imageAlt} />
        </div>
        <Breadcrumb title={frontmatter.title} firstTag={firstTag} isEn={isEn} />
        {
            daysSinceUpdate >= 180 && (
                <div class="remark-aside remark-aside--danger">
                    <p>
                        🌶 <strong>过期警告：</strong> 本页面距今已有
                        {daysSinceUpdate}
                        天未更新，年久失修，内容可能有所偏颇，还请仔细甄别！
                    </p>
                </div>
            )
        }
        <div
            id="post-content"
            class="post-content"
            data-pagefind-body
            data-pagefind-meta={`title:${frontmatter.title}`}
        >
            <h2 id="post-content-title" class="toc-ignore sr-only">
                {frontmatter.title}
            </h2>
            <div class="article-content">
                <slot />
            </div>
        </div>
        <PostFooter tags={frontmatter.tags} />
        <PostNavigation slug={slug} />
        <RelatedPosts relatedPosts={relatedPosts} />
    </div>
    {frontmatter.toc && <Toc />}
    {postView.backtotop && <BackToTop />}
    {frontmatter.donate && donate.enable && <Donate />}
    {frontmatter.author && postView.author && <Author />}
    {frontmatter.waline && waline.enable && <WalineComment />}
    {frontmatter.mermaid && <MermaidRenderer />}
</BaseLayout>

<style>
    /* 文章页内容区统一宽度，不再全局污染 .content */
    .article-content {
        max-width: 860px;
        margin: 0 auto;
        box-sizing: border-box;
    }

    .post-title {
        max-width: 860px;
        margin-inline: auto;
        text-align: center;
        width: 100%;
        box-sizing: border-box;
        display: block;
        padding: 3.5rem 0 3.5rem;
        position: relative;
        contain: layout style;
        flex-shrink: 0;
        align-self: center;
        transform: translateZ(0);
        backface-visibility: hidden;
    }

    .reading-progress {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 1000;
        width: 100%;
        height: 2px;
        background: linear-gradient(to right, #2ea997, #f59e0b);
        transform-origin: left;
        animation: reading-progress linear;
        animation-timeline: scroll(root);
        will-change: transform;
        contain: strict;
    }

    @keyframes reading-progress {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }

    .post-header {
        width: calc(100% + var(--space) * 2);
        margin-left: calc(var(--space) * -1);
        margin-top: calc(var(--space) * -1);
        margin-bottom: calc(var(--space) / 2);
        overflow: hidden;
        border-radius: var(--radius) var(--radius) 0 0;
    }

    .post-header img {
        width: 100%;
    }

    .post-header:empty {
        display: none;
    }
</style>

{frontmatter.fancybox !== false && <script>import "~/scripts/fancybox-handler.ts";</script>}
{frontmatter.markmap && <script>import "~/scripts/markmap-renderer.ts";</script>}
{frontmatter.chart && <script>import "~/scripts/chart-renderer.ts";</script>}
{frontmatter.reveal && <script>import "~/scripts/reveal-renderer.ts";</script>}
{frontmatter.tabs !== false && <script>import "~/scripts/tabs";</script>}

<script>
    // reading-progress JS fallback：Firefox 等不支持 scroll-driven animation 的浏览器
    (function () {
        const bar = document.querySelector<HTMLElement>(".reading-progress");
        if (!bar || bar.dataset.progressBound) return;
        bar.dataset.progressBound = "1";

        // 检测浏览器是否支持 animation-timeline
        const supportsScrollTimeline = CSS.supports("animation-timeline: scroll()");

        if (supportsScrollTimeline) return; // 用 CSS 原生实现，无需 JS

        // JS fallback：scroll 事件 + requestAnimationFrame
        let ticking = false;
        function update() {
            const el = bar as HTMLElement;
            const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
            const scrollHeight =
                document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const progress = scrollHeight > 0 ? scrollTop / scrollHeight : 0;
            el.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
            el.style.animation = "none";
            ticking = false;
        }

        document.addEventListener(
            "scroll",
            () => {
                if (!ticking) {
                    requestAnimationFrame(update);
                    ticking = true;
                }
            },
            { passive: true },
        );

        update();
    })();
</script>
