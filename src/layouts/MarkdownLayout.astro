---
import "~/styles/remark-aside.css";

import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import PostMeta from "~/components/Article/PostMeta.astro";
import PostCardImage from "~/components/Article/PostCardImage.astro";
import PostTag from "~/components/Article/PostTag.astro";
import Toc from "~/components/Article/Toc.astro";
import BackToTop from "~/components/Layout/BackToTop.astro";
import Donate from "~/components/Feature/Donate.astro";
import Author from "~/components/Feature/Author.astro";
import WalineComment from "~/components/Widget/WalineComment.astro";
import PostCopyright from "~/components/Article/PostCopyright.astro";
import { site, postView, waline, donate } from "~/self.config";
import { getRandomImageUrl } from "~/utils";

const {
    frontmatter = {
        waline: false,
        donate: false,
        toc: false,
        mathjax: false,
        mermaid: false,
    },
    slug,
    modifiedTime,
    readTime,
    wordCount,
} = Astro.props;

const today = new Date();
const publishedTime = frontmatter.pubDate;
const publishedDays = Math.floor(
    (today.getTime() - publishedTime.getTime()) / (1000 * 60 * 60 * 24),
);

const allPosts = await getCollection("article");
const currentSlug = Astro.params.slug;

const imageUrl = frontmatter.image?.url || getRandomImageUrl();
const imageAlt = frontmatter.image?.alt || "Blog Cover";
// OG 图片：开发模式用随机图fallback，生产环境用动态生成的png
const ogImage =
    import.meta.env.DEV || import.meta.env.PREVIEW
        ? imageUrl
        : `${Astro.site}og/${slug}.png`;
---

<BaseLayout
    title={`${frontmatter.title} - ${site.title}`}
    description={`${frontmatter.title} - ${frontmatter.description}`}
    image={ogImage}
    imageAlt={imageAlt}
    keywords={frontmatter.tags}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    mathjax={frontmatter.mathjax}
    mermaid={frontmatter.mermaid}
>
    <div class="reading-progress"></div>
    <div class="post-title">
        <h1 class="post-title__text">
            {frontmatter.title}
        </h1>
        <PostMeta
            publishedTime={publishedTime}
            wordCount={wordCount}
            readTime={readTime}
            currentSlug={currentSlug}
        />
    </div>
    <div class="post-card content-box">
        <div class="post__header">
            {(<PostCardImage imagePath={imageUrl} altText={imageAlt} />)}
        </div>
        {
            publishedDays >= 180 && (
                <div class="remark-aside remark-aside--danger">
                    <p>
                        🌶 <strong>过期警告：</strong> 本页面距今已有
                        {publishedDays}
                        天未更新，年久失修，内容可能有所偏颇，还请仔细甄别！
                    </p>
                </div>
            )
        }
        <div id="post-content" class="post__content" data-pagefind-body>
            <h2 id="post-content-title" style="display: none;">
                {frontmatter.title}
            </h2>
            <slot />
        </div>
        <div class="post__footer">
            <div class="post-tags post-card__tags">
                {
                    frontmatter.tags.map((tag: string) => (
                        <PostTag tag={tag} url={`/tags/${tag}/`} />
                    ))
                }
            </div>
            <div class="post-tags post-card__tags">
                <PostCopyright />
            </div>
        </div>
        <div class="post__navigation">
            {
                allPosts
                    .sort(
                        (a, b) =>
                            new Date(b.data.pubDate).getTime() -
                            new Date(a.data.pubDate).getTime(),
                    )
                    .map((post, index) => {
                        if (post.id === Astro.params.slug) {
                            const prevPost =
                                index > 0 ? allPosts[index - 1] : null;
                            const nextPost =
                                index < allPosts.length - 1
                                    ? allPosts[index + 1]
                                    : null;
                            return (
                                <>
                                    {prevPost && (
                                        <a
                                            href={`/article/${prevPost.id}/`}
                                            class="navlink"
                                            style="float: left;"
                                        >
                                            ◀ {prevPost.data.title}
                                        </a>
                                    )}
                                    {nextPost && (
                                        <a
                                            href={`/article/${nextPost.id}/`}
                                            class="navlink"
                                            style="float: right;"
                                        >
                                            {nextPost.data.title} ▶
                                        </a>
                                    )}
                                </>
                            );
                        }
                    })
            }
        </div>
    </div>
    {frontmatter.toc && <Toc />}
    {postView.backtotop && <BackToTop />}
    {frontmatter.donate && donate.enable && <Donate />}
    {frontmatter.author && postView.author && <Author />}
    {frontmatter.waline && waline.enable && <WalineComment />}
</BaseLayout>

<style>
    .reading-progress {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 1000;
        width: 100%;
        height: 2px;
        background: linear-gradient(to right, #2ea997, #f59e0b);
        transform-origin: left;
        animation: reading-progress linear;
        animation-timeline: scroll(root);
    }

    @keyframes reading-progress {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }

    .post__header {
        width: calc(100% + var(--space) * 2);
        margin-left: calc(var(--space) * -1);
        margin-top: calc(var(--space) * -1);
        margin-bottom: calc(var(--space) / 2);
        overflow: hidden;
        border-radius: var(--radius) var(--radius) 0 0;
    }

    .post__header img {
        width: 100%;
    }

    .post__header:empty {
        display: none;
    }

    .post__navigation {
        border-top: 1px solid var(--border-color);
        margin-top: calc(var(--space) / 2);
        padding: calc(var(--space) / 2) 0 0 0;
        overflow: auto;
    }

    .post__navigation .navlink {
        border: none;
        text-decoration: none;
    }

    .post__navigation .navlink:first-of-type {
        margin-bottom: calc(var(--space) / 4);
    }

    .post__footer {
        margin-top: calc(var(--space) / 2);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
</style>

<script>
    // 导入 Fancybox 图片点击放大支持
    import "~/scripts/fancybox-handler.ts";
</script>
