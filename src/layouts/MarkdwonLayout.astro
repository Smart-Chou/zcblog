---
import "~/styles/remark-aside.css";

import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import PostMeta from "~/components/PostMeta.astro";
import PostCardImage from "~/components/PostCardImage.astro";
import PostTag from "~/components/PostTag.astro";
import Toc from "~/components/Toc.astro";
import BackToTop from "~/components/BackToTop.astro";
import Donate from "~/components/Donate.astro";
import Author from "~/components/Author.astro";
import WalineComment from "~/components/WalineComment.astro";
import PostCopyright from "~/components/PostCopyright.astro";
import { site, postView, waline, donate } from "~/self.config";
import { getRandomImageUrl } from "~/utils";
import { Image } from "astro:assets";

const {
    frontmatter = {
        waline: false,
        donate: false,
        toc: false,
        mathjax: false,
        mermaid: false,
    },
    modifiedTime,
    readTime,
    wordCount,
} = Astro.props;

const today = new Date();
const publishedTime = frontmatter.pubDate;
const publishedDays = Math.floor(
    (today.getTime() - publishedTime.getTime()) / (1000 * 60 * 60 * 24),
);

const allPosts = await getCollection("article");
const currentSlug = Astro.params.slug;

const imageUrl = frontmatter.image?.url || "https://pic.mcc.im/images";
const imageAlt = frontmatter.image?.alt || "Blog Cover";
const isDefaultImage = /^https:\/\/pic\.mcc\.im\/images(\?.*)?$/.test(imageUrl);
const isRemoteImage = /^https?:\/\//.test(imageUrl);
---

<BaseLayout
    title={`${frontmatter.title} - ${site.title}`}
    description={`${frontmatter.title} - ${frontmatter.description}`}
    image={`${Astro.site}${imageUrl}`}
    imageAlt={imageAlt}
    keywords={frontmatter.tags}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    mathjax={frontmatter.mathjax}
    mermaid={frontmatter.mermaid}
>
    <progress id="content_progress" value="0"></progress>
    <div class="post-title">
        <h1 class="post-title__text">
            {frontmatter.title}
        </h1>
        <PostMeta
            publishedTime={publishedTime}
            wordCount={wordCount}
            readTime={readTime}
            currentSlug={currentSlug}
        />
    </div>
    <div class="post-card content-box">
        <div class="post__header">
            {
                isDefaultImage ? (
                    <Image
                        src={getRandomImageUrl()}
                        alt={imageAlt}
                        class="post-card__image"
                        loading="lazy"
                        width={800}
                        height={450}
                        format="webp"
                        quality={80}
                        decoding="async"
                    />
                ) : isRemoteImage ? (
                    <Image
                        src={imageUrl}
                        alt={imageAlt}
                        class="post-card__image"
                        loading="eager"
                        width={800}
                        height={450}
                        format="webp"
                        quality={80}
                        decoding="async"
                    />
                ) : (
                    <PostCardImage
                        imagePath={imageUrl}
                        altText={imageAlt}
                        loading="eager"
                    />
                )
            }
        </div>
        {
            publishedDays >= 180 && (
                <div class="remark-aside remark-aside--danger">
                    <p>
                        🌶 <strong>过期警告：</strong> 本页面距今已有
                        {publishedDays}
                        天未更新，年久失修，内容可能有所偏颇，还请仔细甄别！
                    </p>
                </div>
            )
        }
        <div id="post-content" class="post__content" data-pagefind-body>
            <h2 id="post-content-title" style="display: none;">
                {frontmatter.title}
            </h2>
            <slot />
        </div>
        <div class="post__footer">
            <div class="post-tags post-card__tags">
                {
                    frontmatter.tags.map((tag: string) => (
                        <PostTag tag={tag} url={`/tag/${tag}/`} />
                    ))
                }
            </div>
            <div class="post-tags post-card__tags">
                <PostCopyright />
            </div>
        </div>
        <div class="post__navigation">
            {
                allPosts
                    .sort(
                        (a, b) =>
                            new Date(b.data.pubDate).getTime() -
                            new Date(a.data.pubDate).getTime(),
                    )
                    .map((post, index) => {
                        if (post.id === Astro.params.slug) {
                            const prevPost =
                                index > 0 ? allPosts[index - 1] : null;
                            const nextPost =
                                index < allPosts.length - 1
                                    ? allPosts[index + 1]
                                    : null;
                            return (
                                <>
                                    {prevPost && (
                                        <a
                                            href={`/article/${prevPost.id}/`}
                                            class="navlink"
                                            style="float: left;"
                                        >
                                            ◀ {prevPost.data.title}
                                        </a>
                                    )}
                                    {nextPost && (
                                        <a
                                            href={`/article/${nextPost.id}/`}
                                            class="navlink"
                                            style="float: right;"
                                        >
                                            {nextPost.data.title} ▶
                                        </a>
                                    )}
                                </>
                            );
                        }
                    })
            }
        </div>
    </div>
    {frontmatter.toc && <Toc />}
    {postView.backtotop && <BackToTop />}
    {frontmatter.donate && donate.enable && <Donate />}
    {frontmatter.author && postView.author && <Author />}
    {frontmatter.waline && waline.enable && <WalineComment />}
</BaseLayout>

<script>
    document.addEventListener("astro:page-load", () => {
        const progressBar = document.querySelector("#content_progress");
        if (progressBar instanceof HTMLProgressElement) {
            const winHeight = window.innerHeight;
            const docHeight = document.documentElement.scrollHeight;

            progressBar.max = docHeight - winHeight;
            progressBar.value = window.scrollY;

            const setProgressBarColor = () => {
                const scrollPercent =
                    (window.scrollY / (docHeight - winHeight)) * 100;
                const hue = 150 + scrollPercent * 0.6;
                progressBar.style.setProperty(
                    "--progress-color",
                    `hsl(${hue}, 100%, 50%)`,
                );
            };

            document.addEventListener("scroll", () => {
                progressBar.max =
                    document.documentElement.scrollHeight - winHeight;
                progressBar.value = window.scrollY;
                setProgressBarColor();
            });

            setProgressBarColor();
        }
    });
</script>

<style>
    #content_progress {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 1000;
        width: 100%;
        height: 2px;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        border: none;
        background-color: transparent;
        color: #2ea997;
    }

    #content_progress::-webkit-progress-bar {
        background-color: transparent;
    }

    #content_progress::-webkit-progress-value {
        background-color: var(--progress-color, #2ea997);
    }

    #content_progress::-moz-progress-bar {
        background-color: var(--progress-color, #2ea997);
    }

    .post__header {
        width: calc(100% + var(--space) * 2);
        margin-left: calc(var(--space) * -1);
        margin-top: calc(var(--space) * -1);
        margin-bottom: calc(var(--space) / 2);
        overflow: hidden;
        border-radius: var(--radius) var(--radius) 0 0;
    }

    .post__header img {
        width: 100%;
    }

    .post__header:empty {
        display: none;
    }

    .post__navigation {
        border-top: 1px solid var(--border-color);
        margin-top: calc(var(--space) / 2);
        padding: calc(var(--space) / 2) 0 0 0;
        overflow: auto;
    }

    .post__navigation .navlink {
        border: none;
        text-decoration: none;
    }

    .post__navigation .navlink:first-of-type {
        margin-bottom: calc(var(--space) / 4);
    }

    .post__footer {
        margin-top: calc(var(--space) / 2);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
</style>
