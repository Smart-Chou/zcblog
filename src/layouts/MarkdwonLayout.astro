---
import { getCollection } from 'astro:content'
import BaseLayout from '~/layouts/BaseLayout.astro'
import PostMeta from '~/components/PostMeta.astro'
import PostCardImage from '~/components/PostCardImage.astro'
import PostTag from '~/components/PostTag.astro'
import Toc from '~/components/Toc.astro'
import BackToTop from '~/components/BackToTop.astro'
import Donate from '~/components/Donate.astro'
import Author from '~/components/Author.astro'
import WalineComment from '~/components/WalineComment.astro'
import PostCopyright from '~/components/PostCopyright.astro'
import { site } from '~/self.config'

const { frontmatter, lastModified, readingTime } = Astro.props

const today = new Date()
const publishTime = new Date(frontmatter.pubDate)
const lastModifiedTime = new Date(lastModified)
const publishedDays = Math.floor((today.getTime() - lastModifiedTime.getTime()) / (1000 * 60 * 60 * 24))

const allPosts = await getCollection('archives')
const currentSlug = Astro.params.slug
---

<BaseLayout 
    title={frontmatter.title + ` - ` + site.title} 
    description={frontmatter.title + ` - ` + frontmatter.description}
    image={Astro.site + frontmatter.image.url}
    imageAlt={frontmatter.image.alt}
> 
  <progress id="content_progress" value="0"></progress>
  <div class="post-title">
    <h1 class="post-title__text">
      {frontmatter.title}
    </h1>
    <PostMeta 
        pubDate={publishTime} 
        upDate={lastModifiedTime} 
        wordCount={readingTime.words}
        readTime={readingTime.text}
        currentSlug={currentSlug} 
    />
  </div>
  <div class="post content-box">
    <div class="post-card__header">
      <PostCardImage imagePath={frontmatter.image.url} altText={frontmatter.image.alt} loading="eager" />
    </div>
    {
      publishedDays >= 180 ? (
        <div class="admonition admonition-warning">
          <p style="margin-bottom: 0;">
            🌶 <strong>过期警告：</strong> 本页面距今已有
            {publishedDays}
            天未更新，年久失修，内容可能有所偏颇，还请仔细甄别！
          </p>
        </div>
      ) : null
    }
    <div class="post__content">
      <slot />
    </div>
    <div class="post__footer">
      <div class="post-tags post-card__tags">
        {frontmatter.tags.map(tag => <PostTag tag={tag} url={`/tags/${tag}/`} />)}
      </div>
      <div class="post-tags post-card__tags">
        <PostCopyright />
      </div>
    </div>
    <div class="post__navigation">
      {
        allPosts
          .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
          .map((post, index) => {
            if (post.slug === Astro.params.slug) {
              const prevPost = index > 0 ? allPosts[index - 1] : null
              const nextPost = index < allPosts.length - 1 ? allPosts[index + 1] : null
              return (
                <>
                  {prevPost && (
                    <a href={`/archives/${prevPost.slug}/`} class="navlink" style="float: left;">
                      ◀ {prevPost.data.title}
                    </a>
                  )}
                  {nextPost && (
                    <a href={`/archives/${nextPost.slug}/`} class="navlink" style="float: right;">
                      {nextPost.data.title} ▶
                    </a>
                  )}
                </>
              )
            }
          })
      }
    </div>
  </div>
  <Toc />
  <BackToTop />
  <Donate />
  <Author />
  {frontmatter.comment && <WalineComment />}
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', function () {
    var winHeight = window.innerHeight,
      docHeight = document.documentElement.scrollHeight

    const progressBar = document.querySelector('#content_progress')
    if (progressBar instanceof HTMLProgressElement) {
      progressBar.max = docHeight - winHeight
      progressBar.value = window.scrollY

      const setProgressBarColor = () => {
        const scrollPercent = (window.scrollY / (docHeight - winHeight)) * 100
        const hue = 150 + scrollPercent * 0.6
        progressBar.style.setProperty('--progress-color', `hsl(${hue}, 100%, 50%)`)
      }

      document.addEventListener('scroll', function () {
        if (progressBar instanceof HTMLProgressElement) {
          progressBar.max = document.documentElement.scrollHeight - window.innerHeight
          progressBar.value = window.scrollY
          setProgressBarColor()
        }
      })
      setProgressBarColor()
    }
  })
</script>

<style>
  #content_progress {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 1000;
    width: 100%;
    height: 2px;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    border: none;
    background-color: transparent;
    color: #2ea997;
  }

  #content_progress::-webkit-progress-bar {
    background-color: transparent;
  }

  #content_progress::-webkit-progress-value {
    background-color: var(--progress-color, #2ea997);
  }

  #content_progress::-moz-progress-bar {
    background-color: var(--progress-color, #2ea997);
  }
</style>
