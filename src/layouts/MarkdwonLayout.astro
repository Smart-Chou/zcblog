---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import PostMeta from "~/components/PostMeta.astro";
import PostCardImage from "~/components/PostCardImage.astro";
import PostTag from "~/components/PostTag.astro";
import Toc from "~/components/Toc.astro";
import BackToTop from "~/components/BackToTop.astro";
import Donate from "~/components/Donate.astro";
import Author from "~/components/Author.astro";
import WalineComment from "~/components/WalineComment.astro";
import PostCopyright from "~/components/PostCopyright.astro";
import { site, postView, comment, donate } from "~/self.config";

const {
    frontmatter = {
        comment: false,
        donate: false,
        toc: false,
        mathjax: false,
        mermaid: false,
    },
    modifiedTime,
    readTime,
    wordCount,
} = Astro.props;

const today = new Date();
const publishedTime = frontmatter.pubDate;
const publishedDays = Math.floor(
    (today.getTime() - publishedTime.getTime()) / (1000 * 60 * 60 * 24),
);

const allPosts = await getCollection("article");
const currentSlug = Astro.params.slug;
const isDefaultImage = /^https:\/\/pic\.mcc\.im\/images(\?.*)?$/.test(
    frontmatter.image.url,
);

let imageUrl = frontmatter.image.url;
if (isDefaultImage) {
    imageUrl = site.coverImage;
}
---

<BaseLayout
    title={`${frontmatter.title} - ${site.title}`}
    description={`${frontmatter.title} - ${frontmatter.description}`}
    image={`${Astro.site}${imageUrl}`}
    imageAlt={frontmatter.image.alt}
    keywords={frontmatter.tags}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    mathjax={frontmatter.mathjax}
    mermaid={frontmatter.mermaid}
>
    <progress id="content_progress" value="0"></progress>
    <div class="post-title">
        <h1 class="post-title__text">
            {frontmatter.title}
        </h1>
        <PostMeta
            publishedTime={publishedTime}
            modifiedTime={modifiedTime}
            wordCount={wordCount}
            readTime={readTime}
            currentSlug={currentSlug}
        />
    </div>
    <div class="post content-box">
        <div class="post__header">
            {
                isDefaultImage ? (
                    <img
                        src={frontmatter.image.url}
                        alt="random image"
                        class="post-card__image"
                        loading="eager"
                    />
                ) : (
                    <PostCardImage
                        imagePath={frontmatter.image.url}
                        altText={frontmatter.image.alt}
                        loading="eager"
                    />
                )
            }
        </div>
        {
            publishedDays >= 180 && (
                <div class="remark-aside remark-aside--danger">
                    <p>
                        🌶 <strong>过期警告：</strong> 本页面距今已有
                        {publishedDays}
                        天未更新，年久失修，内容可能有所偏颇，还请仔细甄别！
                    </p>
                </div>
            )
        }
        <div id="post-content" class="post__content">
            <slot />
        </div>
        <div class="post__footer">
            <div class="post-tags post-card__tags">
                {
                    frontmatter.tags.map((tag: string) => (
                        <PostTag tag={tag} url={`/tag/${tag}/`} />
                    ))
                }
            </div>
            <div class="post-tags post-card__tags">
                <PostCopyright />
            </div>
        </div>
        <div class="post__navigation">
            {
                allPosts
                    .sort(
                        (a, b) =>
                            new Date(b.data.pubDate).getTime() -
                            new Date(a.data.pubDate).getTime(),
                    )
                    .map((post, index) => {
                        if (post.slug === Astro.params.slug) {
                            const prevPost =
                                index > 0 ? allPosts[index - 1] : null;
                            const nextPost =
                                index < allPosts.length - 1
                                    ? allPosts[index + 1]
                                    : null;
                            return (
                                <>
                                    {prevPost && (
                                        <a
                                            href={`/article/${prevPost.slug}/`}
                                            class="navlink"
                                            style="float: left;"
                                        >
                                            ◀ {prevPost.data.title}
                                        </a>
                                    )}
                                    {nextPost && (
                                        <a
                                            href={`/article/${nextPost.slug}/`}
                                            class="navlink"
                                            style="float: right;"
                                        >
                                            {nextPost.data.title} ▶
                                        </a>
                                    )}
                                </>
                            );
                        }
                    })
            }
        </div>
    </div>
    {frontmatter.toc && <Toc />}
    {postView.backtotop && <BackToTop />}
    {frontmatter.donate && donate.enable && <Donate />}
    {frontmatter.author && postView.author && <Author />}
    {frontmatter.comment && comment.enable && <WalineComment />}
</BaseLayout>

<script>
    document.addEventListener("astro:page-load", () => {
        const progressBar = document.querySelector("#content_progress");
        if (progressBar instanceof HTMLProgressElement) {
            const winHeight = window.innerHeight;
            const docHeight = document.documentElement.scrollHeight;

            progressBar.max = docHeight - winHeight;
            progressBar.value = window.scrollY;

            const setProgressBarColor = () => {
                const scrollPercent =
                    (window.scrollY / (docHeight - winHeight)) * 100;
                const hue = 150 + scrollPercent * 0.6;
                progressBar.style.setProperty(
                    "--progress-color",
                    `hsl(${hue}, 100%, 50%)`,
                );
            };

            document.addEventListener("scroll", () => {
                progressBar.max =
                    document.documentElement.scrollHeight - winHeight;
                progressBar.value = window.scrollY;
                setProgressBarColor();
            });

            setProgressBarColor();
        }
    });
</script>
