---
import "~/styles/global.css";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import BaseHead from "~/components/BaseHead/BaseHead.astro";
import Header from "~/components/Layout/Header.astro";
import Footer from "~/components/Layout/Footer.astro";

const {
    title,
    description,
    image,
    imageAlt,
    keywords = [],
    publishedTime,
    modifiedTime,
    mathjax = false,
    mermaid = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
    <BaseHead
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        keywords={keywords}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
        mathjax={mathjax}
        mermaid={mermaid}
    />
    <body>
        <div id="app" class="full-width">
            <Header />
            <div class="main">
                <div class="content">
                    <slot />
                </div>
            </div>
            <Footer />
        </div>
        <script>
            import "~/scripts/redirect-handler";
        </script>
    </body>
</html>
