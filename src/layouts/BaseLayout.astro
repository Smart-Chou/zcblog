---
import "~/styles/global.css";
import BaseHead from "~/components/BaseHead/BaseHead.astro";
import Header from "~/components/Layout/Header.astro";
import Footer from "~/components/Layout/Footer.astro";
import Notice from "~/components/ui/Notice.astro";
import Watermark from "~/components/ui/Watermark.astro";

const {
    title,
    description,
    image,
    imageAlt,
    keywords = [],
    publishedTime,
    modifiedTime,
    mathjax = false,
    mermaid = false,
    fullWidth = false,
    locale = "zh",
    prevUrl,
    nextUrl,
    noindex = false,
} = Astro.props;

const lang = locale === "en" ? "en" : "zh-CN";
---

<!doctype html>
<html lang={lang}>
    <BaseHead
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        keywords={keywords}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
        mathjax={mathjax}
        mermaid={mermaid}
        prevUrl={prevUrl}
        nextUrl={nextUrl}
        noindex={noindex}
    />
    <body>
        <a href="#main-content" class="skip-link"
            >{locale === "en" ? "Skip to content" : "跳至内容"}</a
        >
        <Notice />
        <div id="app" class="full-width">
            <Header />
            <main id="main-content" class="main">
                <div class:list={["content", { "content--full": fullWidth }]}>
                    <slot />
                </div>
            </main>
            <Footer />
        </div>
        <Watermark />
        <script>
            import "~/scripts/redirect-handler";
        </script>
        <script>
            import "~/scripts/tabs";
        </script>
    </body>
</html>
