---
import "~/styles/global.css";
import BaseHead from "~/components/BaseHead/BaseHead.astro";
import Header from "~/components/Layout/Header.astro";
import Footer from "~/components/Layout/Footer.astro";
import Notice from "~/components/UI/Notice.astro";
import Watermark from "~/components/UI/Watermark.astro";
import Sidebar from "~/components/Layout/Sidebar.astro";
import { config } from "~/config";
import { sidebarConfig } from "~/config/ui";

interface Props {
    title: string;
    description: string;
    image?: string;
    imageAlt?: string;
    keywords?: string | string[];
    publishedTime?: Date | string;
    modifiedTime?: Date | string;
    mathjax?: boolean;
    katex?: boolean;
    mermaid?: boolean;
    fullWidth?: boolean;
    locale?: string;
    prevUrl?: string | null;
    nextUrl?: string | null;
    noindex?: boolean;
    noEnAlternate?: boolean;
    showSidebar?: boolean;
    template?: "default" | "splash" | "doc";
}

const {
    title,
    description,
    image,
    imageAlt,
    keywords = [],
    publishedTime,
    modifiedTime,
    mathjax = false,
    katex = false,
    mermaid = false,
    fullWidth = false,
    locale = "zh",
    prevUrl,
    nextUrl,
    noindex = false,
    noEnAlternate = false,
    showSidebar = false,
    template = "default",
} = Astro.props;

const isSplash = template === "splash";
const isDoc = template === "doc";

const lang = locale === "en" ? "en" : "zh-CN";
// 预览构建（PUBLIC_PREVIEW=1）才打包这段清理脚本，正式站不引入
---

<!doctype html>
<html lang={lang}>
    <BaseHead
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        keywords={keywords}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
        mathjax={mathjax}
        katex={katex}
        mermaid={mermaid}
        prevUrl={prevUrl}
        nextUrl={nextUrl}
        noindex={noindex}
        noEnAlternate={noEnAlternate}
    />
    <body>
        <a href="#main-content" class="skip-link"
            >{locale === "en" ? "Skip to content" : "跳至内容"}</a
        >
        <Notice />
        <div
            id="app"
            class:list={[
                "full-width",
                `template-${template}`,
                { "with-sidebar": showSidebar || isDoc },
            ]}
        >
            {!isSplash && <Header locale={locale} />}
            {
                showSidebar || isDoc ? (
                    <div class="page-wrapper">
                        <Sidebar items={sidebarConfig} currentPath={Astro.url.pathname} />
                        <main id="main-content" class="main">
                            <div class:list={["content", { "content--full": fullWidth }]}>
                                <slot />
                            </div>
                        </main>
                    </div>
                ) : (
                    <main id="main-content" class="main">
                        <div class:list={["content", { "content--full": fullWidth }]}>
                            <slot />
                        </div>
                    </main>
                )
            }
            {!isSplash && <Footer />}
        </div>
        <Watermark />
        {config.redirect && <script>import "~/scripts/redirect-handler";</script>}
        <script>
            import "~/scripts/a11y-scroll";
            import "~/scripts/anchor-scroll";
            // 页面级样式提到全局（D-0083）：换页时不再新拉一份 CSS —— 慢链路上那一次请求
            // 就是「内容出来了、样式还没到」的根因。home.css 的规则已全部收进 .home-page 作用域。
            import "~/styles/home.css";
            import "~/scripts/tab-nav";
            import "~/scripts/pwa-register";
        </script>
    </body>
</html>

<style is:global>
    .page-wrapper {
        display: flex;
        max-width: var(--content-width-max);
        margin: 0 auto;
        padding: var(--space-md);
    }

    .with-sidebar .page-wrapper {
        display: grid;
        grid-template-columns: var(--sidebar-width) 1fr;
        gap: var(--space-xl);
        align-items: start;
    }

    .with-sidebar .main {
        min-width: 0;
    }

    @media (max-width: 768px) {
        .with-sidebar .page-wrapper {
            grid-template-columns: 1fr;
        }
    }

    /* Template: splash — full-width, no chrome */
    .template-splash .content {
        max-width: var(--content-width-max);
        padding: 0;
    }
    .template-splash .main {
        padding-top: var(--space-3xl);
        padding-bottom: var(--space-3xl);
    }
</style>
