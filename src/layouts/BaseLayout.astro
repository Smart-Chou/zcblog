---
import BaseHead from '~/components/BaseHead.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

const { title, description, image, imageAlt, mathjax = false, mermaid = false } = Astro.props
---

<html lang="zh-CN">
    <BaseHead 
        title={title} 
        description={description} 
        image={image} 
        imageAlt={imageAlt}
        mathjax={mathjax}
        mermaid={mermaid}
/>
    <body>
        <div id="app">
            <Header />
            <main class="main">
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>
