---
import BaseHead from "~/components/BaseHead/BaseHead.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";

const {
    title,
    description,
    image,
    imageAlt,
    keywords = [],
    publishedTime,
    modifiedTime,
    mathjax = false,
    mermaid = false,
} = Astro.props;
---

<html lang="zh-CN">
    <BaseHead
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        keywords={keywords}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
        mathjax={mathjax}
        mermaid={mermaid}
    />
    <body>
        <div id="app">
            <Header />
            <main class="main">
                <div class="content">
                    <slot />
                </div>
            </main>
            <Footer />
        </div>
        <script>
            import { config } from "~/self.config";
            document.addEventListener("astro:page-load", () => {
                try {
                    // 是否启用跳转功能
                    const enable = config.redirect; // 设为 true 以启用跳转功能
                    if (!enable) return;
                    // 中转页地址
                    const redirectPage = "/redirect/?url=";
                    // 包含的 className
                    const includeClass = config.redirectIncludeClass;
                    // 排除的 className
                    const excludeClass = config.redirectExcludeClass;
                    // 判断元素或其父元素是否包含指定类名
                    const hasIncludeClass = (element: HTMLElement) => {
                        while (element) {
                            if (
                                includeClass.some((className) =>
                                    element.classList.contains(className),
                                )
                            ) {
                                return true;
                            }
                            element = element.parentElement as HTMLElement;
                        }
                        return false;
                    };
                    // 判断元素或其父元素是否排除指定类名
                    const hasExcludeClass = (element: HTMLElement) => {
                        while (element) {
                            if (
                                excludeClass.some((className) =>
                                    element.classList.contains(className),
                                )
                            ) {
                                return true;
                            }
                            element = element.parentElement as HTMLElement;
                        }
                        return false;
                    };
                    // 获取所有链接
                    const allLinks = [...document.getElementsByTagName("a")];
                    if (allLinks.length === 0) return;
                    allLinks.forEach((link) => {
                        // 检查链接是否排除指定类名
                        if (hasExcludeClass(link)) return;
                        // 检查链接是否为相对路径
                        const linkHref = link.getAttribute("href");
                        // 检查链接是否包含 target="_blank" 属性或指定的类名
                        if (
                            link.getAttribute("target") === "_blank" ||
                            hasIncludeClass(link)
                        ) {
                            // 检查链接是否为相对路径或根路径
                            const isRelativeOrRootPath =
                                linkHref && /^(\.|\/(?!\/))/.test(linkHref);
                            if (isRelativeOrRootPath) return;
                            // 存在链接且非中转页
                            if (linkHref && !linkHref.includes(redirectPage)) {
                                // Base64 编码 href
                                const encodedHref = btoa(linkHref);
                                // 处理 Base64 编码中的特殊字符，确保 URL 安全
                                const urlSafeEncodedHref = encodedHref
                                    .replace(/\+/g, "-")
                                    .replace(/\//g, "_")
                                    .replace(/=/g, "");
                                const redirectLink = `${redirectPage}${urlSafeEncodedHref}`;
                                // 保存原始链接
                                link.setAttribute("original-href", linkHref);
                                // 覆盖 href
                                link.setAttribute("href", redirectLink);
                                // 增加 target="_blank" 属性
                                link.setAttribute("target", "_blank");
                                // 增加 rel="noopener noreferrer" 属性
                                link.setAttribute("rel", "noopener noreferrer");
                                // 创建并插入 SVG 图标
                                if (hasIncludeClass(link)) {
                                    const svgIcon = document.createElementNS(
                                        "http://www.w3.org/2000/svg",
                                        "svg",
                                    );
                                    svgIcon.setAttribute("width", "16");
                                    svgIcon.setAttribute("height", "16");
                                    svgIcon.setAttribute(
                                        "viewBox",
                                        "0 0 100 100",
                                    );
                                    svgIcon.setAttribute(
                                        "fill",
                                        "currentColor",
                                    );
                                    svgIcon.innerHTML = `
                                        <path fill="currentColor" d="M18.8,85.1h56l0,0c2.2,0,4-1.8,4-4v-32h-8v28h-48v-48h28v-8h-32l0,0c-2.2,0-4,1.8-4,4v56C14.8,83.3,16.6,85.1,18.8,85.1z"></path>
                                    `;
                                    svgIcon.innerHTML += `
                                        <polygon fill="currentColor" points="45.7,48.7 51.3,54.3 77.2,28.5 77.2,37.2 85.2,37.2 85.2,14.9 62.8,14.9 62.8,22.9 71.5,22.9"></polygon>
                                    `;
                                    link.appendChild(svgIcon);
                                }
                            }
                        }
                    });
                } catch (error) {
                    console.error("处理链接时出错：", error);
                }
            });
        </script>
    </body>
</html>
