---
import "~/styles/global.css";
import BaseHead from "~/components/BaseHead/BaseHead.astro";
import Header from "~/components/Layout/Header.astro";
import Footer from "~/components/Layout/Footer.astro";
import Notice from "~/components/UI/Notice.astro";
import Watermark from "~/components/UI/Watermark.astro";
import { config } from "~/config";

interface Props {
    title: string;
    description: string;
    image?: string;
    imageAlt?: string;
    keywords?: string | string[];
    publishedTime?: Date | string;
    modifiedTime?: Date | string;
    mathjax?: boolean;
    katex?: boolean;
    mermaid?: boolean;
    fullWidth?: boolean;
    locale?: string;
    prevUrl?: string | null;
    nextUrl?: string | null;
    noindex?: boolean;
    noEnAlternate?: boolean;
}

const {
    title,
    description,
    image,
    imageAlt,
    keywords = [],
    publishedTime,
    modifiedTime,
    mathjax = false,
    katex = false,
    mermaid = false,
    fullWidth = false,
    locale = "zh",
    prevUrl,
    nextUrl,
    noindex = false,
    noEnAlternate = false,
} = Astro.props;

const lang = locale === "en" ? "en" : "zh-CN";
---

<!doctype html>
<html lang={lang}>
    <BaseHead
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        keywords={keywords}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
        mathjax={mathjax}
        katex={katex}
        mermaid={mermaid}
        prevUrl={prevUrl}
        nextUrl={nextUrl}
        noindex={noindex}
        noEnAlternate={noEnAlternate}
    />
    <body>
        <a href="#main-content" class="skip-link"
            >{locale === "en" ? "Skip to content" : "跳至内容"}</a
        >
        <Notice />
        <div id="app" class="full-width">
            <Header />
            <main id="main-content" class="main">
                <div class:list={["content", { "content--full": fullWidth }]}>
                    <slot />
                </div>
            </main>
            <Footer />
        </div>
        <Watermark />
        {config.redirect && <script>import "~/scripts/redirect-handler";</script>}
    </body>
</html>
