---
import "~/styles/global.css";
import BaseHead from "~/components/BaseHead/BaseHead.astro";
import Header from "~/components/Layout/Header.astro";
import Footer from "~/components/Layout/Footer.astro";
import Notice from "~/components/UI/Notice.astro";
import Watermark from "~/components/UI/Watermark.astro";
import Sidebar from "~/components/Layout/Sidebar.astro";
import { config } from "~/config";
import { sidebarConfig } from "~/config/ui";

interface Props {
    title: string;
    description: string;
    image?: string;
    imageAlt?: string;
    keywords?: string | string[];
    publishedTime?: Date | string;
    modifiedTime?: Date | string;
    mathjax?: boolean;
    katex?: boolean;
    mermaid?: boolean;
    fullWidth?: boolean;
    locale?: string;
    prevUrl?: string | null;
    nextUrl?: string | null;
    noindex?: boolean;
    noEnAlternate?: boolean;
    showSidebar?: boolean;
}

const {
    title,
    description,
    image,
    imageAlt,
    keywords = [],
    publishedTime,
    modifiedTime,
    mathjax = false,
    katex = false,
    mermaid = false,
    fullWidth = false,
    locale = "zh",
    prevUrl,
    nextUrl,
    noindex = false,
    noEnAlternate = false,
    showSidebar = false,
} = Astro.props;

const lang = locale === "en" ? "en" : "zh-CN";
---

<!doctype html>
<html lang={lang}>
    <BaseHead
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        keywords={keywords}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
        mathjax={mathjax}
        katex={katex}
        mermaid={mermaid}
        prevUrl={prevUrl}
        nextUrl={nextUrl}
        noindex={noindex}
        noEnAlternate={noEnAlternate}
    />
    <body>
        <a href="#main-content" class="skip-link"
            >{locale === "en" ? "Skip to content" : "跳至内容"}</a
        >
        <Notice />
        <div
            id="app"
            class:list={["full-width", { "with-sidebar": showSidebar }]}
        >
            <Header locale={locale} />
            <div class="page-wrapper">
                {showSidebar && <Sidebar items={sidebarConfig} currentPath={Astro.url.pathname} />}
                <main id="main-content" class="main">
                <div class:list={["content", { "content--full": fullWidth }]}>
                    <slot />
                </div>
            </main>
            </div>
            <Footer />
        </div>
        <Watermark />
        {config.redirect && <script>import "~/scripts/redirect-handler";</script>}
    </body>
</html>

<style is:global>
    .page-wrapper {
        display: flex;
        max-width: var(--content-width-max);
        margin: 0 auto;
        padding: var(--space-md);
    }

    .with-sidebar .page-wrapper {
        display: grid;
        grid-template-columns: var(--sidebar-width) 1fr;
        gap: var(--space-xl);
        align-items: start;
    }

    .with-sidebar .main {
        min-width: 0;
    }

    @media (max-width: 768px) {
        .with-sidebar .page-wrapper {
            grid-template-columns: 1fr;
        }
    }
</style>
