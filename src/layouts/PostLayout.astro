---
import Layout from './BaseLayout.astro';
import Author from '../components/Author.astro';
import PostTag from '../components/PostTag.astro';
import PostTagLayout from './PostTagLayout.astro';
const { frontmatter } = Astro.props;
---

<Layout pageTitle={frontmatter.title}>
    <div>
        <div class="post-title">
            <h1 class="post-title__text">
                {frontmatter.title}
            </h1>
            <div class="post-meta">
                Posted on {frontmatter.pubDate.toString().slice(0, 10)} 1239 words.
                <strong>6 min read.</strong>
            </div>
        </div>
        <div class="post content-box">
            <div class="post__header">
                <img src="/assets/static/new-year-2021.a209973.09c7021b1947b5f3a76206991df6e4ed.png" class="g-image--loaded" width="1280" alt="Cover image" />
            </div>
            <div class="post__content">
                <slot />
            </div>
            <PostTagLayout>
            {frontmatter.tags.map(tag => <PostTag tag={tag} url={`/tags/${tag}`}/> )}
            </PostTagLayout>
            <div class="post__navigation">
                <a href="/2020/08/wait-this-is-not-my-commit/" class="navlink" style="float: right">震惊！竟然有人在 GitHub 上冒充我的身份！ ▶</a>
            </div>
        </div>
        <Author />
    </div>
</Layout>
