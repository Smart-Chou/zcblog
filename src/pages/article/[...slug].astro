---
import { getCollection } from "astro:content";
import MarkdwonLayout from "~/layouts/MarkdwonLayout.astro";
import { getPostsWithMeta } from "~/utils/getPostsWithMeta";

export async function getStaticPaths() {
    const article = await getCollection("article");
    return article.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const modifiedTime = getPostsWithMeta(entry).modifiedTime;
const readTime = getPostsWithMeta(entry).readTime;
const wordCount = getPostsWithMeta(entry).wordCount;
---

<MarkdwonLayout
    frontmatter={entry.data}
    modifiedTime={modifiedTime}
    readTime={readTime}
    wordCount={wordCount}
>
    <Content />
</MarkdwonLayout>
