---
import { getCollection, render } from "astro:content";
import MarkdownLayout from "~/layouts/MarkdownLayout.astro";
import { getPostsWithMeta } from "~/utils/getPostsWithMeta";

export async function getStaticPaths() {
    try {
        const article = await getCollection("article", ({ data }) => {
            return !(data.draft ?? false);
        });
        return article.map((entry) => ({
            params: { slug: entry.id },
            props: { entry },
        }));
    } catch (e) {
        console.error("获取文章集合失败：", e);
        return [];
    }
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const postMeta = getPostsWithMeta({ ...entry, slug: entry.id });
const modifiedTime = postMeta.modifiedTime;
const readTime = postMeta.readTime;
const wordCount = postMeta.wordCount;
---

<MarkdownLayout
    frontmatter={entry.data}
    slug={entry.id}
    modifiedTime={modifiedTime}
    readTime={readTime}
    wordCount={wordCount}
>
    <Content />
</MarkdownLayout>
