---
import { getCollection } from "astro:content";
import MarkdwonLayout from "~/layouts/MarkdwonLayout.astro";

export async function getStaticPaths() {
    const article = await getCollection("article");
    return article.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await entry.render();

const modifiedTime = remarkPluginFrontmatter.modifiedTime;
const readTime = remarkPluginFrontmatter.readTime;
---

<MarkdwonLayout
    frontmatter={entry.data}
    modifiedTime={modifiedTime}
    readTime={readTime}
>
    <Content />
</MarkdwonLayout>
