---
import { getCollection, render } from "astro:content";
import MarkdownLayout from "~/layouts/MarkdownLayout.astro";
import { enrichPost } from "~/utils/get-posts-with-meta";

export async function getStaticPaths() {
    try {
        const article = await getCollection("article", ({ data }) => {
            return !(data.draft ?? false);
        });
        return article.map((entry) => ({
            params: { article: entry.id },
            props: { entry },
        }));
    } catch (e) {
        console.error("获取文章集合失败：", e);
        return [];
    }
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { modifiedTime, readTime, wordCount } = enrichPost(entry);

// 检测当前页面语言与文章实际语言是否匹配
// 当前没有英文文章，所有 /en/article/ 页面都是中文内容，应设为 noindex
const articleLang = entry.data.lang ?? "zh";
const isEnUrl = Astro.url.pathname.startsWith("/en/");
const localeMismatch = isEnUrl && articleLang !== "en";
---

<MarkdownLayout
    frontmatter={entry.data}
    slug={entry.id}
    modifiedTime={modifiedTime}
    readTime={readTime}
    wordCount={wordCount}
    noindex={localeMismatch}
    noEnAlternate={localeMismatch || articleLang === "zh"}
>
    <Content />
</MarkdownLayout>
