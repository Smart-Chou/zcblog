---
import { getCollection, render } from "astro:content";
import MarkdownLayout from "~/layouts/MarkdownLayout.astro";
import { enrichPost } from "~/utils/get-posts-with-meta";

export async function getStaticPaths() {
    try {
        // 中文文章路由：仅生成非英文文章（英文文章走 /en/article/）
        const article = await getCollection(
            "article",
            ({ data }) => !(data.draft ?? false) && data.lang !== "en",
        );
        return article.map((entry) => ({
            params: { article: entry.id },
            props: { entry },
        }));
    } catch (e) {
        console.error("获取文章集合失败：", e);
        return [];
    }
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { modifiedTime, readTime, wordCount } = enrichPost(entry);
---

<MarkdownLayout
    headings={headings}
    frontmatter={entry.data}
    slug={entry.id}
    modifiedTime={modifiedTime}
    readTime={readTime}
    wordCount={wordCount}
>
    <Content />
</MarkdownLayout>
