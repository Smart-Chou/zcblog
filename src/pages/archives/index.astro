---
import { getCollection } from "astro:content";
import SectionPage from "~/components/Layout/SectionPage.astro";
import Archive from "~/components/Widget/Archive.astro";
import Author from "~/components/Feature/Author.astro";
import Heatmap from "~/components/Widget/Heatmap.astro";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import { site, archivesPage } from "~/self.config";
import { getPostsWithMeta } from "~/utils/getPostsWithMeta";
import { sortByPubDate, formatDateToYYYYMMDD } from "~/utils/date-utils";
import type { CollectionEntry } from "astro:content";

// Define interface for post with meta information
interface PostWithMeta extends CollectionEntry<"article"> {
    wordCount: number;
    slug: string;
}

// Define interface for posts grouped by year
interface PostsByYear {
    [year: number]: PostWithMeta[];
}

const allPosts = await getCollection("article");

const postsWithMeta = await Promise.all(
    allPosts.map(async (post) => {
        const { wordCount } = getPostsWithMeta({ ...post, slug: post.id });
        return {
            ...post,
            wordCount,
            slug: post.id,
        } as PostWithMeta;
    }),
);

// Group posts by year with proper typing
const postsByYear = postsWithMeta.reduce<PostsByYear>((acc, post) => {
    const year = new Date(post.data.pubDate).getFullYear();
    if (!acc[year]) {
        acc[year] = [];
    }
    acc[year].push(post);
    return acc;
}, {});

// Calculate statistics
const totalPosts = postsWithMeta.length;
const totalWords = postsWithMeta.reduce((sum, post) => sum + post.wordCount, 0);
const totalWordsInThousands = (totalWords / 1000).toFixed(1) + "k";

// Find the earliest year more efficiently with proper typing
const startYear = Math.min(
    ...postsWithMeta.map((post) => new Date(post.data.pubDate).getFullYear()),
);

// 热力图数据
const postsData = postsWithMeta.map((post) => ({
    date: post.data.pubDate
        ? formatDateToYYYYMMDD(new Date(post.data.pubDate))
        : "",
    title: post.data.title || "",
    wordCount: post.wordCount,
}));
---

<SectionPage
    title={archivesPage.title}
    subtitle={`(｡･∀･)ﾉﾞ 自 ${startYear} 以来, 我共发布了 ${totalPosts} 篇文章，共计 ${totalWordsInThousands} 字。`}
    description={`${archivesPage.description} - ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={archivesPage.description}
    keywords={["Archives"]}
    publishedTime={new Date()}
    modifiedTime={new Date()}
>
    <DynamicIcon name="archive" slot="icon" />
    <!-- 发文热力图 -->
    <section class="stats-section">
        <Heatmap postsData={postsData} />
    </section>

    {
        Object.keys(postsByYear)
            .map((year) => Number(year))
            .sort((a, b) => new Date(b).getTime() - new Date(a).getTime())
            .map((year) => (
                <section data-key={year}>
                    <h2>{year}</h2>
                    {sortByPubDate(postsByYear[year]).map((post) => (
                        <Archive
                            key={post.slug}
                            url={`/article/${post.slug}/`}
                            title={post.data.title}
                            publishedTime={post.data.pubDate}
                        />
                    ))}
                </section>
            ))
    }

    <Author />
</SectionPage>
