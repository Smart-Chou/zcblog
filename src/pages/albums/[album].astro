---
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { site, imageService } from "~/config";

interface AlbumPhoto {
    id: string;
    url: string;
    alt?: string;
    description?: string;
}

interface Album {
    id: string;
    name: string;
    description?: string;
    location?: string;
    date?: string;
    tags?: string[];
    cover?: string;
    photos: AlbumPhoto[];
    photoCount?: number;
}

import albumsData from "~/data/albums.json";

const allAlbums: Album[] = (albumsData as Album[]).map((album) => ({
    ...album,
    cover: album.cover
        ? `${imageService.baseUrl}${imageService.picPath}${album.cover}`
        : "",
    photoCount: album.photos?.length || 0,
}));

export async function getStaticPaths() {
    const data = await import("~/data/albums.json");
    const allAlbums = (data.default as Album[]).map((album) => ({
        ...album,
        cover: album.cover
            ? `${imageService.baseUrl}${imageService.picPath}${album.cover}`
            : "",
        photoCount: album.photos?.length || 0,
    }));

    return allAlbums.map((album) => ({
        params: { album: album.id },
    }));
}

const { album } = Astro.params;
const foundAlbum = allAlbums.find((a) => a.id === album);

if (!foundAlbum) {
    return Astro.redirect("/albums");
}
---

<BaseLayout
    title={`${foundAlbum.name} - 相册`}
    description={site.title + ` - ` + foundAlbum.description}
    image={foundAlbum.cover}
    imageAlt={foundAlbum.name}
    keywords={`${foundAlbum.name},相册,照片`}
>
    <div class="album-detail-container">
        <div class="album-header">
            <a href="/albums/" class="back-link">← 返回相册列表</a>
            <h1 class="album-title">{foundAlbum.name}</h1>
            <p class="album-description">{foundAlbum.description}</p>
            <div class="album-meta">
                <span class="photo-count"
                    >{foundAlbum.photos.length} 张照片</span
                >
                {
                    foundAlbum.location && (
                        <span class="location">{foundAlbum.location}</span>
                    )
                }
            </div>
        </div>

        <div class="photos-grid" id="fancybox-gallery">
            {
                foundAlbum.photos.map((photo, index) => (
                    <a
                        href={`${imageService.baseUrl}${imageService.picPath}${photo.url}`}
                        class="photo-item"
                        data-fancybox="gallery"
                        data-caption=""
                        data-index={index}
                    >
                        <div class="photo-wrapper">
                            <img
                                src={`${imageService.baseUrl}${imageService.picPath}${photo.url}`}
                                alt={photo.alt || ""}
                                class="photo-image"
                                loading="lazy"
                            />
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</BaseLayout>

<style>
    .album-detail-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .album-header {
        margin-bottom: 3rem;
        text-align: center;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 1.5rem;
        font-size: 1rem;
        color: var(--color-body);
        text-decoration: none;
        transition: color var(--duration-slow) var(--ease-out);
    }

    .back-link:hover {
        color: var(--color-link);
    }

    .album-title {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--color-title);
    }

    .album-description {
        font-size: 1.1rem;
        color: var(--color-body);
        margin-bottom: 1rem;
    }

    .album-meta {
        display: flex;
        justify-content: center;
        gap: 2rem;
        font-size: 0.9rem;
        color: var(--color-body);
        opacity: 0.8;
    }

    .photos-grid {
        column-count: 2;
        column-gap: 1rem;
    }

    .photo-item {
        display: block;
        border-radius: var(--radius);
        overflow: hidden;
        break-inside: avoid;
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
        transition: box-shadow var(--duration-slow) var(--ease-out);
        text-decoration: none;
        color: inherit;
        cursor: zoom-in;
    }

    .photo-item:hover {
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15);
    }

    .photo-wrapper {
        overflow: hidden;
    }

    .photo-image {
        width: 100%;
        display: block;
        transition: transform var(--duration-slower) var(--ease-out);
    }

    .photo-item:hover .photo-image {
        transform: scale(1.05);
    }

    .photo-overlay {
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
        color: white;
        padding: 1rem;
        opacity: 0;
        transition: opacity var(--duration-slow) var(--ease-out);
    }

    .photo-item:hover .photo-overlay {
        opacity: 1;
    }

    .photo-description {
        font-size: 0.85rem;
        line-height: 1.4;
    }

    @media (max-width: 768px) {
        .album-meta {
            flex-direction: column;
            gap: 0.5rem;
        }

        .photos-grid {
            column-count: 1;
            column-gap: 0.5rem;
        }
    }
</style>

<script>
    import "~/scripts/fancybox-album.ts";
</script>
