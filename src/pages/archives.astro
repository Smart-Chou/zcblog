---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostLayout from '~/layouts/PostLayout.astro';
import Archive from '~/components/Archive.astro';
import { site, archivesPage } from '~/self.config';
import { getPostsWithMeta } from '~/utils/getPostsWithMeta';
import type { CollectionEntry } from 'astro:content';

// Define interface for post with meta information
interface PostWithMeta extends CollectionEntry<'article'> {
    wordCount: number;
}

// Define interface for posts grouped by year
interface PostsByYear {
    [year: number]: PostWithMeta[];
}

const allPosts = await getCollection('article');

const postsWithMeta = await Promise.all(
    allPosts.map(async post => {
        const { wordCount } = getPostsWithMeta(post);
        return {
            ...post,
            wordCount,
        } as PostWithMeta;
    })
);

// Group posts by year with proper typing
const postsByYear = postsWithMeta.reduce<PostsByYear>((acc, post) => {
    const year = new Date(post.data.pubDate).getFullYear();
    if (!acc[year]) {
        acc[year] = [];
    }
    acc[year].push(post);
    return acc;
}, {});

// Calculate statistics
const totalPosts = postsWithMeta.length;
const totalWords = postsWithMeta.reduce((sum, post) => sum + post.wordCount, 0);
const totalWordsInThousands = (totalWords / 1000).toFixed(1) + 'k';

// Find the earliest year more efficiently with proper typing
const startYear = Math.min(...postsWithMeta.map(post => new Date(post.data.pubDate).getFullYear()));
---

<BaseLayout title={`${archivesPage.title} - ${site.title}`} description={`${archivesPage.description} - ${site.description}`} image={`${Astro.site + site.coverImage}`} imageAlt={archivesPage.description} keywords="Archives" publishedTime={new Date()} modifiedTime={new Date()}>
    <h1 class="text-center space-bottom">Archives</h1>
    <PostLayout>
        <p style="opacity: 0.6">
            <strong>
                (｡･∀･)ﾉﾞ 自 {startYear} 以来, 我共发布了 {totalPosts} 篇文章，共计
                {totalWordsInThousands} 字。
            </strong>
        </p>
        {
            Object.keys(postsByYear)
                .map(year => Number(year))
                .sort((a, b) => new Date(b).getTime() - new Date(a).getTime())
                .map(year => (
                    <section data-key={year}>
                        <h2>{year}</h2>
                        {postsByYear[year]
                            .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
                            .map(post => (
                                <Archive key={post.slug} url={`/article/${post.slug}/`} title={post.data.title} publishedTime={post.data.pubDate} />
                            ))}
                    </section>
                ))
        }
    </PostLayout>
</BaseLayout>
