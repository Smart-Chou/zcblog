---
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import SectionPage from "~/components/Layout/SectionPage.astro";
import EssayItem from "~/components/UI/EssayItem.astro";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { site, author } from "~/config";
import talksData from "~/data/talks.json";
import logo from "~/assets/logo.svg";

function extractTags(content: string): string[] {
    const matches = content.match(/#[^\s#]+/g);
    return matches || [];
}

function stripTags(content: string): string {
    return content.replace(/#[^\s#]+\s*/g, "").trim();
}

const talkItems = talksData.map((t) => ({
    username: author.type,
    time: t.datetime,
    content: stripTags(t.content),
    images: (t as { images?: string[] }).images ?? null,
    comment: null as string | null,
    avatar_url: logo.src,
    tags: extractTags(t.content),
    url: t.url,
}));

const merged = [...talkItems].sort(
    (a, b) => new Date(b.time).getTime() - new Date(a.time).getTime(),
);
---

<SectionPage
    title="Talks"
    subtitle="我的碎碎念"
    description={`${site.title} 的日常说说`}
    empty={merged.length === 0}
    emptyEmoji="💬"
    emptyTitle="暂无说说"
>
    <DynamicIcon name="tabler:message-chatbot-filled" slot="icon" />
    <div class="talk-timeline">
        {
            merged.map((item) => (
                <div class="talk-item">
                    <div class="talk-marker" />
                    <EssayItem item={item} />
                </div>
            ))
        }
    </div>
</SectionPage>

<style is:global>
    .talk-timeline {
        position: relative;
        max-width: 800px;
        margin: 0 auto;
    }

    .talk-timeline::before {
        content: "";
        position: absolute;
        left: 1rem;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--color-border);
    }

    .talk-item {
        position: relative;
        padding-left: 3.5rem;
        margin-bottom: 1.5rem;
    }

    .talk-marker {
        position: absolute;
        left: calc(1rem - 5px);
        top: 2rem;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--color-link);
        border: 2px solid var(--color-bg);
        z-index: 1;
    }
</style>

<script>
    import "~/scripts/fancybox-essay.ts";
</script>
