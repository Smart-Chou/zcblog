---
import SectionPage from "~/components/Layout/SectionPage.astro";
import TabNav from "~/components/bangumi/TabNav.astro";
import BangumiSection from "~/components/bangumi/BangumiSection.astro";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import { formatDateI18nWithTime } from "~/utils/date-utils";
import type { UserSubjectCollection } from "~/types/bangumi";

interface Props {
    locale: "zh" | "en";
}

const { locale = "zh" } = Astro.props;

const BANGUMI_CONFIG = {
    username: "1143164",
    apiUrl: "https://api.bgm.tv",
    pagination: {
        limit: 50,
        delay: 50,
        maxTotal: 1000,
    },
};

const t = {
    zh: {
        subtitle: "我的动漫、书籍、音乐和游戏收藏",
        buildTimePrefix: "最后更新: ",
        emptyTitleNoUser: "未配置 Bangumi 用户ID",
        emptyMessageNoUser: "请在页面代码中配置你的 Bangumi 用户ID",
        emptyTitleNoData: "暂无数据",
        emptyMessageNoData: "你的收藏列表是空的",
        categories: {
            anime: "动画",
            book: "书籍",
            music: "音乐",
            game: "游戏",
        },
    },
    en: {
        subtitle: "My anime, book, music and game collection",
        buildTimePrefix: "Last updated: ",
        emptyTitleNoUser: "Bangumi user ID not configured",
        emptyMessageNoUser: "Please configure your Bangumi user ID in the code",
        emptyTitleNoData: "No data available",
        emptyMessageNoData: "Your collection is empty",
        categories: {
            anime: "Anime",
            book: "Book",
            music: "Music",
            game: "Game",
        },
    },
}[locale];

const buildTime = formatDateI18nWithTime(new Date());

const categoryMap: Record<
    string,
    { id: string; name: string; subjectType: number }
> = {
    anime: { id: "anime", name: t.categories.anime, subjectType: 2 },
    book: { id: "book", name: t.categories.book, subjectType: 1 },
    music: { id: "music", name: t.categories.music, subjectType: 3 },
    game: { id: "game", name: t.categories.game, subjectType: 4 },
};

async function fetchBangumiData(
    username: string,
    subjectType: number,
): Promise<UserSubjectCollection[]> {
    try {
        const { limit, delay, maxTotal } = BANGUMI_CONFIG.pagination;
        let offset = 0;
        let allData: UserSubjectCollection[] = [];
        let hasMore = true;
        const isDev = import.meta.env.DEV;

        while (hasMore) {
            if (isDev && allData.length >= limit) break;
            if (maxTotal > 0 && allData.length >= maxTotal) break;

            const url = `${BANGUMI_CONFIG.apiUrl}/v0/users/${username}/collections?subject_type=${subjectType}&limit=${limit}&offset=${offset}`;

            const response = await fetch(url, {
                headers: {
                    "User-Agent": "YuuOuRou Blog",
                    Accept: "application/json",
                },
            });

            if (!response.ok) break;

            const data = await response.json();
            const currentBatch = data.data || [];

            if (currentBatch.length > 0) {
                allData = allData.concat(currentBatch);
                offset += limit;
                if (currentBatch.length < limit) hasMore = false;
            } else {
                hasMore = false;
            }

            if (hasMore)
                await new Promise((resolve) => setTimeout(resolve, delay));
        }
        return allData;
    } catch (error) {
        console.error("[Bangumi] Error fetching data:", error);
        return [];
    }
}

const bangumiData: Record<string, UserSubjectCollection[]> = {};
const tabs: Array<{ id: string; name: string; count: number }> = [];

const isUserIdConfigured =
    BANGUMI_CONFIG.username && BANGUMI_CONFIG.username.trim() !== "";

if (isUserIdConfigured) {
    for (const [categoryKey, categoryInfo] of Object.entries(categoryMap)) {
        const data = await fetchBangumiData(
            BANGUMI_CONFIG.username,
            categoryInfo.subjectType,
        );
        bangumiData[categoryKey] = data;
        tabs.push({
            id: categoryKey,
            name: categoryInfo.name,
            count: data.length,
        });
    }
}

const activeTab = tabs[0]?.id || "anime";
const hasData = tabs.length > 0;
---

<SectionPage
    title="Bangumi"
    subtitle={t.subtitle}
    buildTime={`${t.buildTimePrefix}${buildTime}`}
    empty={!hasData}
    emptyTitle={isUserIdConfigured ? t.emptyTitleNoData : t.emptyTitleNoUser}
    emptyMessage={isUserIdConfigured
        ? t.emptyMessageNoData
        : t.emptyMessageNoUser}
>
    <DynamicIcon name="tabler:movie" slot="icon" />
    {
        hasData && (
            <>
                <TabNav tabs={tabs} activeTab={activeTab} />
                {tabs.map((tab) => (
                    <BangumiSection
                        sectionId={tab.id}
                        items={bangumiData[tab.id] || []}
                        isActive={tab.id === activeTab}
                        itemsPerPage={12}
                    />
                ))}
            </>
        )
    }
</SectionPage>
