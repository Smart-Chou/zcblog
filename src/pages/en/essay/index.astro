---
import BaseLayout from "~/layouts/BaseLayout.astro";
import EssayItem from "~/components/essay/EssayItem.astro";
import Chat from "~/components/icons/Chat.astro";
import PageHeader from "~/components/Widget/PageHeader.astro";
import { site } from "~/self.config";
import essaysData from "~/data/essays.json";
---

<BaseLayout title="Essays" description={`${site.title}'s essays collection`}>
    <div class="essay-container">
        <PageHeader title="Essays" subtitle="A collection of moments from my social media - mostly from my wild youth days">
            <Chat slot="icon" />
        </PageHeader>

        <div class="essay-masonry">
            {essaysData.map((item) => <EssayItem item={item} />)}
        </div>
    </div>
</BaseLayout>

<style>
    .essay-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .essay-masonry {
        column-count: 3;
        column-gap: 1rem;
    }

    @media (max-width: 1024px) {
        .essay-masonry {
            column-count: 2;
        }
    }

    @media (max-width: 640px) {
        .essay-masonry {
            column-count: 1;
        }
    }
</style>
