---
import BaseLayout from "~/layouts/BaseLayout.astro";
import AlbumCard from "~/components/gallery/AlbumCard.astro";
import Gallery from "~/components/icons/Gallery.astro";
import PageHeader from "~/components/Widget/PageHeader.astro";
import EmptyState from "~/components/Widget/EmptyState.astro";
import { scanAlbumPhotos, getAlbumCover } from "~/utils/gallery-utils";
import { site } from "~/self.config";

interface Album {
    id: string;
    name: string;
    description?: string;
    location?: string;
    date?: string;
    tags?: string[];
}

const GALLERY_CONFIG: Album[] = [];

const albums = GALLERY_CONFIG.map((album) => {
    const photos = scanAlbumPhotos(album.id);
    const cover = getAlbumCover(album, photos);
    return { ...album, cover, photoCount: photos.length };
});

const allTags = [...new Set(albums.flatMap((a) => a.tags || []))].sort();
---

<BaseLayout
    title="Gallery"
    description={`${site.title} - Photo Gallery`}
    locale="en"
>
    <div class="gallery-container">
        <PageHeader title="Gallery" subtitle="Capturing beautiful moments in life">
            <Gallery slot="icon" />
        </PageHeader>

        {
            albums.length > 0 && allTags.length > 0 && (
                <div class="gallery-filter">
                    <button class="filter-tag active" data-tag="all">
                        All
                    </button>
                    {allTags.map((tag) => (
                        <button class="filter-tag" data-tag={tag}>
                            {tag}
                        </button>
                    ))}
                </div>
            )
        }

        {
            albums.length > 0 ? (
                <div class="albums-grid">
                    {albums.map((album) => (
                        <AlbumCard
                            id={album.id}
                            name={album.name}
                            cover={album.cover}
                            description={album.description}
                            date={album.date}
                            location={album.location}
                            tags={album.tags}
                            photoCount={album.photoCount}
                        />
                    ))}
                </div>
            ) : (
                <EmptyState emoji="📷" title="No albums yet" />
            )
        }
    </div>
</BaseLayout>

<script is:inline>
    document.querySelectorAll(".filter-tag").forEach((btn) => {
        btn.addEventListener("click", function () {
            const tag = this.getAttribute("data-tag");
            document
                .querySelectorAll(".filter-tag")
                .forEach((b) => b.classList.remove("active"));
            this.classList.add("active");
            document.querySelectorAll(".album-card").forEach((card) => {
                const tags = (card.getAttribute("data-tags") || "").split(",");
                if (tag === "all" || (tag && tags.includes(tag))) {
                    card.style.display = "";
                } else {
                    card.style.display = "none";
                }
            });
        });
    });
</script>

<style>
    .gallery-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .gallery-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .filter-tag {
        padding: 6px 16px;
        border: none;
        border-radius: 20px;
        background: var(--bg-content-color);
        color: var(--body-color);
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: var(--shadow-small);
    }

    .filter-tag:hover {
        background: var(--link-color);
        color: white;
    }

    .filter-tag.active {
        background: var(--link-color);
        color: white;
    }

    .albums-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

</style>
