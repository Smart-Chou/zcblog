---
import { getCollection, render } from "astro:content";
import MarkdownLayout from "~/layouts/MarkdownLayout.astro";
import { enrichPost } from "~/utils/get-posts-with-meta";
import { articleSlug } from "~/utils/article-url";

export async function getStaticPaths() {
    try {
        // 英文文章路由：仅生成 lang: en 的文章 → /en/article/<slug>/（-en 后缀会被裁掉）
        const article = await getCollection(
            "article",
            ({ data }) => data.lang === "en" && !(data.draft ?? false),
        );
        return article.map((entry) => ({
            params: { article: articleSlug(entry) },
            props: { entry },
        }));
    } catch (e) {
        console.error("获取英文文章集合失败：", e);
        return [];
    }
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { modifiedTime, readTime, wordCount } = enrichPost(entry);
---

<MarkdownLayout
    frontmatter={entry.data}
    slug={entry.id}
    modifiedTime={modifiedTime}
    readTime={readTime}
    wordCount={wordCount}
    locale="en"
>
    <Content />
</MarkdownLayout>
