---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { site } from "~/self.config";
import AlbumCard from "~/components/gallery/AlbumCard.astro";

interface AlbumPhoto {
    id: string;
    url: string;
    alt?: string;
    description?: string;
}

interface Album {
    id: string;
    name: string;
    description?: string;
    location?: string;
    date?: string;
    tags?: string[];
    cover?: string;
    photos: AlbumPhoto[];
    photoCount?: number;
}

import albumsData from "~/data/albums.json";

const albums: Album[] = (albumsData as Album[]).map((album) => ({
    ...album,
    cover: album.cover ? `https://pic-api.marxchou.com/api/pic${album.cover}` : "",
    photoCount: album.photos?.length || 0
}));
---

<BaseLayout
    title="Albums"
    description={site.title + " - Photo Albums"}
    image={Astro.site + site.coverImage}
    imageAlt="Albums"
    keywords="Albums, Photos, Gallery"
    publishedTime={new Date()}
    modifiedTime={new Date()}
    locale="en"
>
    <div class="albums-container">
        <h1 class="page-title">Albums</h1>
        <p class="page-description">Capturing beautiful moments in life</p>

        <div class="albums-grid">
            {
                albums.map((album) => (
                    <AlbumCard
                        id={album.id}
                        name={album.name}
                        description={album.description}
                        cover={album.cover}
                        location={album.location}
                        tags={album.location ? [album.location] : []}
                        photoCount={album.photoCount || 0}
                    />
                ))
            }
        </div>
    </div>
</BaseLayout>

<style>
    .albums-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 0.5rem;
        color: var(--title-color);
    }

    .page-description {
        font-size: 1.1rem;
        text-align: center;
        color: var(--body-color);
        margin-bottom: 3rem;
    }

    .albums-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
    }

    @media (max-width: 768px) {
        .albums-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
