---
import BlogContent from "~/components/Pages/BlogContent.astro";
import { makeBlogGetStaticPaths } from "~/utils/blog-paths";

// 英文列表（仅 lang: en 的文章）
export const getStaticPaths = makeBlogGetStaticPaths("en");

interface PostData {
    slug: string;
    url: string;
    data: {
        title: string;
        pubDate: Date;
        tags?: string[];
        image?: { url?: string; alt?: string };
        description?: string;
    };
    wordCount: number;
    readTime: string;
    modifiedTime: Date | string;
    excerpt: string;
    sticky?: number;
}

const { page } = Astro.props as {
    page: {
        data: PostData[];
        url: { prev?: string; next?: string };
        currentPage: number;
        lastPage: number;
    };
};
---

<BlogContent page={page} locale="en" />
