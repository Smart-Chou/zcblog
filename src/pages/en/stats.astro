---
import "~/styles/stats.css";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { site } from "~/self.config";
import { getCollection } from "astro:content";

const allPosts = await getCollection("article");

interface PostData {
    date: string;
    title: string;
    wordCount: number;
    tags: string[];
}

const postsData: PostData[] = allPosts.map((post) => {
    const body = post.body || "";
    const wordCount = body.replace(/\s+/g, "").length;
    return {
        date: post.data.pubDate
            ? new Date(post.data.pubDate).toISOString().split("T")[0]
            : "",
        title: post.data.title || "",
        wordCount,
        tags: post.data.tags || [],
    };
});

const postsByYear = postsData.reduce(
    (acc, post) => {
        const year = post.date.substring(0, 4);
        if (year) {
            acc[year] = (acc[year] || 0) + 1;
        }
        return acc;
    },
    {} as Record<string, number>,
);

const totalPosts = postsData.length;
const totalTags = new Set(postsData.flatMap((p) => p.tags)).size;
const totalWordCount = postsData.reduce((sum, p) => sum + p.wordCount, 0);

const allTags = postsData.flatMap((p) => p.tags);

const now = new Date();
const yearStart = new Date(now.getFullYear(), 0, 1);
const yearEnd = new Date(now.getFullYear() + 1, 0, 1);
const yearProgress = (
    ((now.getTime() - yearStart.getTime()) /
        (yearEnd.getTime() - yearStart.getTime())) *
    100
).toFixed(2);

const startDate = new Date("2020-09-27");
let runningYears = now.getFullYear() - startDate.getFullYear();
let runningMonths = now.getMonth() - startDate.getMonth();
let runningDays = now.getDate() - startDate.getDate();

if (runningDays < 0) {
    runningMonths -= 1;
    const lastMonth = new Date(now.getFullYear(), now.getMonth(), 0);
    runningDays += lastMonth.getDate();
}

if (runningMonths < 0) {
    runningYears -= 1;
    runningMonths += 12;
}

function formatNumber(num: number): string {
    if (num >= 1000000) return `${(num / 1000000).toFixed(1)}m`;
    if (num >= 1000) return `${(num / 1000).toFixed(1)}k`;
    return num.toString();
}

const tagCounts = allTags.reduce(
    (acc, tag) => {
        acc[tag] = (acc[tag] || 0) + 1;
        return acc;
    },
    {} as Record<string, number>,
);

const sortedTags = Object.entries(tagCounts)
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const maxTagCount = Math.max(...sortedTags.map((t) => t.count), 1);

function getTagColor(count: number): string {
    const percentage = count / maxTagCount;
    if (percentage >= 0.8) return "#1e40af";
    if (percentage >= 0.6) return "#1d4ed8";
    if (percentage >= 0.4) return "#3b82f6";
    if (percentage >= 0.2) return "#60a5fa";
    return "#93c5fd";
}
---

<BaseLayout title="Site Statistics" description="Blog statistics and data">
    <div class="stats-container">
        <div class="page-header">
            <div class="header-icon">
                <svg viewBox="0 0 24 24" fill="currentColor"
                    ><path
                        d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"
                    ></path></svg
                >
            </div>
            <h1>Site Statistics</h1>
            <p class="subtitle">Blog statistics and data</p>
        </div>

        <section class="stats-section">
            <h2>Contribution Heatmap</h2>
            <div class="heatmap-container" id="heatmap-container"></div>
        </section>

        <section class="stats-section">
            <h2>Post Statistics</h2>
            <div class="stats-grid">
                <div class="stat-card">
                    <h3>Posts</h3>
                    <p class="stat-value">{formatNumber(totalPosts)}</p>
                </div>
                <div class="stat-card">
                    <h3>Tags</h3>
                    <p class="stat-value">{formatNumber(totalTags)}</p>
                </div>
                <div class="stat-card">
                    <h3>Total Words</h3>
                    <p class="stat-value">{formatNumber(totalWordCount)}</p>
                </div>
            </div>
        </section>

        <section class="stats-section">
            <h2>Blog Status</h2>
            <div class="blog-status">
                <ul class="status-list">
                    <li>
                        <span class="status-label">Year Progress</span><span
                            class="status-value">{yearProgress}%</span
                        >
                    </li>
                    <li>
                        <span class="status-label">Blog Running</span><span
                            class="status-value"
                            >{runningYears} years {runningMonths} months {
                                runningDays
                            } days</span
                        >
                    </li>
                    <li>
                        <span class="status-label">Total Posts</span><span
                            class="status-value">{totalPosts} posts</span
                        >
                    </li>
                    <li>
                        <span class="status-label">Total Tags</span><span
                            class="status-value">{totalTags} tags</span
                        >
                    </li>
                    <li>
                        <span class="status-label">Total Words</span><span
                            class="status-value">{totalWordCount} words</span
                        >
                    </li>
                </ul>
                <div class="status-badges">
                    <img
                        alt="License"
                        src="https://img.shields.io/github/license/marxchou/marxchou.github.io?label=%F0%9F%93%9C%20License"
                    />
                    <img
                        alt="Website"
                        src="https://img.shields.io/website?url=https%3A%2F%2Fmarxchou.com%2F&up_message=%E8%BF%90%E8%A1%8C%E4%B8%AD&down_message=%E5%A4%B1%E8%B4%A5&label=%E2%9C%85%20%E7%BD%91%E7%AB%99%E6%83%85%E5%86%B5"
                    />
                </div>
            </div>
        </section>

        <section class="stats-section">
            <h2>Yearly Statistics</h2>
            <div class="bar-chart-container">
                {
                    (() => {
                        const currentYear = new Date().getFullYear();
                        const years = Array.from({ length: 20 }, (_, i) =>
                            (currentYear - 19 + i).toString(),
                        );
                        const countMap = new Map(Object.entries(postsByYear));
                        const completeData = years.map((year) => ({
                            year,
                            count: countMap.get(year) || 0,
                        }));
                        const maxCount = Math.max(
                            ...Object.values(postsByYear),
                            1,
                        );
                        const chartHeight = 200;
                        const barMaxHeight = chartHeight - 40;

                        return (
                            <div class="bar-chart">
                                <div class="bar-chart-bars">
                                    {completeData.map(({ year, count }) => (
                                        <div class="bar-item">
                                            <div class="bar-value">
                                                {count > 0 ? count : ""}
                                            </div>
                                            <div
                                                class="bar"
                                                style={`height: ${count ? (count / maxCount) * barMaxHeight : 2}px`}
                                            />
                                            <div class="bar-label">{year}</div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        );
                    })()
                }
            </div>
        </section>

        <section class="stats-section">
            <h2>Tag Cloud</h2>
            <div class="tag-cloud">
                {
                    sortedTags.map(({ name, count }) => (
                        <span
                            class="tag-item"
                            style={`background-color: ${getTagColor(count)}`}
                        >
                            {name}
                            <span class="tag-count">{count}</span>
                        </span>
                    ))
                }
            </div>
        </section>
    </div>
</BaseLayout>

<script is:inline define:vars={{ postsData }}>
    function formatDate(date) {
        return date.toISOString().split("T")[0];
    }

    function getClassForValue(count) {
        if (count === 0) return "color-empty";
        if (count < 300) return "color-github-1";
        if (count < 800) return "color-github-2";
        if (count < 1500) return "color-github-3";
        return "color-github-4";
    }

    function initHeatmap() {
        const container = document.getElementById("heatmap-container");
        if (!container) return;

        container.innerHTML = "";

        const today = new Date();
        const startDate = new Date(today);
        startDate.setFullYear(today.getFullYear() - 1);

        startDate.setDate(startDate.getDate() - startDate.getDay());

        const monthNames = [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec",
        ];

        const dataMap = {};
        postsData.forEach((p) => {
            dataMap[p.date] = p;
        });

        const months = [];
        let currentDate = new Date(startDate);
        let lastMonth = -1;
        let weekIndex = 0;

        while (currentDate <= today) {
            const month = currentDate.getMonth();

            if (month !== lastMonth) {
                months.push({ month: monthNames[month], col: weekIndex });
                lastMonth = month;
            }

            currentDate.setDate(currentDate.getDate() + 7);
            weekIndex++;
        }

        const monthRow = document.createElement("div");
        monthRow.className = "heatmap-months";

        months.forEach(({ month, col }) => {
            const span = document.createElement("span");
            span.textContent = month;
            span.style.gridColumn = `${col + 1}`;
            monthRow.appendChild(span);
        });
        container.appendChild(monthRow);

        const wrapper = document.createElement("div");
        wrapper.className = "heatmap-wrapper";

        const yLabels = document.createElement("div");
        yLabels.className = "heatmap-y-labels";
        yLabels.innerHTML = `
            <span>Sun</span><span></span><span>Mon</span><span></span>
            <span>Wed</span><span></span><span>Fri</span>
        `;
        wrapper.appendChild(yLabels);

        const grid = document.createElement("div");
        grid.className = "heatmap-grid";

        currentDate = new Date(startDate);

        while (currentDate <= today) {
            const cell = document.createElement("div");
            const dateStr = formatDate(currentDate);
            const dayData = dataMap[dateStr];

            if (dayData) {
                cell.className = `heatmap-day ${getClassForValue(dayData.wordCount)}`;
                cell.dataset.date = dayData.date;
                cell.dataset.title = dayData.title;
                cell.dataset.count = dayData.wordCount.toString();

                cell.addEventListener("mouseenter", () => {
                    const tooltip = document.createElement("div");
                    tooltip.className = "heatmap-tooltip";

                    let content = `<div class="heatmap-tooltip-date">${dayData.date}</div>`;
                    content += `<div class="heatmap-tooltip-content">`;
                    content += `<div>${dayData.wordCount} words</div>`;
                    content += `<div>《${dayData.title}》</div>`;
                    content += `</div>`;

                    tooltip.innerHTML = content;
                    document.body.appendChild(tooltip);

                    const rect = cell.getBoundingClientRect();
                    tooltip.style.left = rect.left + "px";
                    tooltip.style.top =
                        rect.top - tooltip.offsetHeight - 8 + "px";
                });

                cell.addEventListener("mouseleave", () => {
                    document
                        .querySelectorAll(".heatmap-tooltip")
                        .forEach((t) => t.remove());
                });
            } else {
                cell.className = "heatmap-day color-empty";
            }

            grid.appendChild(cell);

            currentDate.setDate(currentDate.getDate() + 1);
        }

        wrapper.appendChild(grid);
        container.appendChild(wrapper);

        const legendDiv = document.createElement("div");
        legendDiv.className = "heatmap-legend";
        legendDiv.innerHTML = `
            <span>Less</span>
            <span class="heatmap-legend-item" style="background-color: #d6d8db"></span>
            <span class="heatmap-legend-item" style="background-color: #9ad99b"></span>
            <span class="heatmap-legend-item" style="background-color: #68be67"></span>
            <span class="heatmap-legend-item" style="background-color: #3f7f46"></span>
            <span class="heatmap-legend-item" style="background-color: #2f6336"></span>
            <span>More</span>
        `;
        container.appendChild(legendDiv);
    }

    initHeatmap();
</script>
