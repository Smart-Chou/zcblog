---
import { getCollection } from 'astro:content'
import Layout from '~/layouts/BaseLayout.astro'
import Author from '~/components/Author.astro'
import PostCard from '~/components/PostCard.astro'
import Pagination from '~/components/Pagination.astro'
import { calculateReadTime, calculateWordCount } from '~/utils'

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('archives')
  const sortedPosts = allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  return paginate(sortedPosts, { pageSize: 10 })
}

const { page } = Astro.props as any

const postsWithMeta = page.data.map(post => {
  const wordCount = calculateWordCount(post.body)
  const readTime = calculateReadTime(wordCount)
  
  return {
      ...post,
      wordCount,
      readTime,
      slug: post.slug
    }
})

import dayjs from 'dayjs'
import utc from 'dayjs/plugin/utc'

dayjs.extend(utc)

const lastModified = dayjs(page.lastModified).utc().format('YYYY-MM-DD')
---

<Layout>
  <Author />
  <div class="post">
    {postsWithMeta.map(post => (
      <PostCard 
        key={post.slug} 
        title={post.data.title} 
        pubDate={post.data.pubDate} 
        postUrl={`/archives/${post.slug}/`} 
        imageUrl={post.data.image.url} 
        description={post.data.description} 
        tags={post.data.tags} 
        wordCount={post.wordCount} 
        readTime={post.readTime} 
        currentSlug={post.slug}
        lastModified={lastModified}
      />
    ))}
  </div>
  <Pagination page={page} />
</Layout>

<script>
    import { pageviewCount } from '@waline/client/pageview';
    import { commentCount } from '@waline/client/comment';

    const origin = window.location.hostname == 'localhost' ? 'https://waline.marxchou.com/' : window.location.origin
    const serverURL = origin
    const path =  window.location.pathname

    pageviewCount({
        serverURL,
        path,
    });

    commentCount({
        serverURL,
        path,
    });
</script>
