---
import { getCollection } from 'astro:content'
import Layout from '~/layouts/BaseLayout.astro'
import Author from '~/components/Author.astro'
import PostCard from '~/components/PostCard.astro'
import Pagination from '~/components/Pagination.astro'
import { calculateReadTime, calculateWordCount } from '~/utils'
import { site } from '~/self.config'

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('archives')
  const sortedPosts = allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  return paginate(sortedPosts, { pageSize: 8 })
}

const { page } = Astro.props as any

const postsWithMeta = page.data.map(post => {
  const wordCount = calculateWordCount(post.body)
  const readTime = calculateReadTime(wordCount)
  
  return {
      ...post,
      wordCount,
      readTime,
      slug: post.slug
    }
})
---

<Layout title={site.title} description={site.description}>
  <Author />
  <div class="post">
    {postsWithMeta.map(post => (
      <PostCard 
        key={post.slug} 
        title={post.data.title} 
        pubDate={post.data.pubDate} 
        postUrl={`/archives/${post.slug}/`} 
        imagePath={post.data.image.url} 
        description={post.data.description} 
        tags={post.data.tags} 
        wordCount={post.wordCount} 
        readTime={post.readTime} 
        currentSlug={post.slug}
        upDate={post.data.upDate}
        altText={post.data.image.alt}
      />
    ))}
  </div>
  <Pagination page={page} />
</Layout>

<script>
    import { pageviewCount } from '@waline/client/pageview';
    import { commentCount } from '@waline/client/comment';

    document.addEventListener('astro:page-load', () => {
    const origin = 'https://waline.marxchou.com/'
    const serverURL = origin
    const path =  window.location.pathname

    pageviewCount({
        serverURL,
        path,
    });

    commentCount({
        serverURL,
        path,
    });
    });
</script>
