---
import "~/styles/stats.css";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { site } from "~/self.config";
import { getCollection } from "astro:content";

// 获取所有文章
const allPosts = await getCollection("article");

// 计算统计数据
interface PostData {
  date: string;
  title: string;
  wordCount: number;
  tags: string[];
}

const postsData: PostData[] = allPosts.map((post) => {
  const body = post.body || "";
  const wordCount = body.replace(/\s+/g, "").length;
  return {
    date: post.data.pubDate ? new Date(post.data.pubDate).toISOString().split("T")[0] : "",
    title: post.data.title || "",
    wordCount,
    tags: post.data.tags || [],
  };
});

// 按年份统计
const postsByYear = postsData.reduce((acc, post) => {
  const year = post.date.substring(0, 4);
  if (year) {
    acc[year] = (acc[year] || 0) + 1;
  }
  return acc;
}, {} as Record<string, number>);


// 汇总统计数据
const totalPosts = postsData.length;
const totalTags = new Set(postsData.flatMap((p) => p.tags)).size;
const totalWordCount = postsData.reduce((sum, p) => sum + p.wordCount, 0);

// 所有标签
const allTags = postsData.flatMap((p) => p.tags);

// 年度进度
const now = new Date();
const yearStart = new Date(now.getFullYear(), 0, 1);
const yearEnd = new Date(now.getFullYear() + 1, 0, 1);
const yearProgress = (((now.getTime() - yearStart.getTime()) / (yearEnd.getTime() - yearStart.getTime())) * 100).toFixed(2);

// 博客运行时间
const startDate = new Date("2020-09-27");
let runningYears = now.getFullYear() - startDate.getFullYear();
let runningMonths = now.getMonth() - startDate.getMonth();
let runningDays = now.getDate() - startDate.getDate();

if (runningDays < 0) {
  runningMonths -= 1;
  const lastMonth = new Date(now.getFullYear(), now.getMonth(), 0);
  runningDays += lastMonth.getDate();
}

if (runningMonths < 0) {
  runningYears -= 1;
  runningMonths += 12;
}

function formatNumber(num: number): string {
  if (num >= 1000000) return `${(num / 1000000).toFixed(1)}m`;
  if (num >= 1000) return `${(num / 1000).toFixed(1)}k`;
  return num.toString();
}

// 标签云数据
const tagCounts = allTags.reduce((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const sortedTags = Object.entries(tagCounts)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const maxTagCount = Math.max(...sortedTags.map(t => t.count), 1);

function getTagColor(count: number): string {
  const percentage = count / maxTagCount;
  if (percentage >= 0.8) return "#1e40af";
  if (percentage >= 0.6) return "#1d4ed8";
  if (percentage >= 0.4) return "#3b82f6";
  if (percentage >= 0.2) return "#60a5fa";
  return "#93c5fd";
}
---

<BaseLayout title="网站统计数据" description="一些网站文章数据的统计">
  <div class="stats-container">
    <div class="page-header">
      <div class="header-icon">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
      </div>
      <h1>网站统计数据</h1>
      <p class="subtitle">一些网站文章数据的统计</p>
    </div>

    <!-- 发文热力图 -->
    <section class="stats-section">
      <h2>发文热力图</h2>
      <div class="heatmap-container" id="heatmap-container"></div>
    </section>

    <!-- 发文统计 -->
    <section class="stats-section">
      <h2>发文统计</h2>
      <div class="stats-grid">
        <div class="stat-card">
          <h3>文章数</h3>
          <p class="stat-value">{formatNumber(totalPosts)}</p>
        </div>
        <div class="stat-card">
          <h3>标签数</h3>
          <p class="stat-value">{formatNumber(totalTags)}</p>
        </div>
        <div class="stat-card">
          <h3>总字数</h3>
          <p class="stat-value">{formatNumber(totalWordCount)}</p>
        </div>
      </div>
    </section>

    <!-- 博客状态 -->
    <section class="stats-section">
      <h2>博客状态</h2>
      <div class="blog-status">
        <ul class="status-list">
          <li><span class="status-label">年度进度</span><span class="status-value">{yearProgress}%</span></li>
          <li><span class="status-label">博客已运行</span><span class="status-value">{runningYears} 年 {runningMonths} 个月 {runningDays} 天</span></li>
          <li><span class="status-label">文章总数</span><span class="status-value">{totalPosts} 篇</span></li>
          <li><span class="status-label">标签总数</span><span class="status-value">{totalTags} 个</span></li>
          <li><span class="status-label">总字数</span><span class="status-value">{totalWordCount} 字</span></li>
        </ul>
        <div class="status-badges">
          <img alt="License" src="https://img.shields.io/github/license/marxchou/marxchou.github.io?label=%F0%9F%93%9C%20License" />
          <img alt="Website" src="https://img.shields.io/website?url=https%3A%2F%2Fmarxchou.com%2F&up_message=%E8%BF%90%E8%A1%8C%E4%B8%AD&down_message=%E5%A4%B1%E8%B4%A5&label=%E2%9C%85%20%E7%BD%91%E7%AB%99%E6%83%85%E5%86%B5" />
        </div>
      </div>
    </section>

    <!-- 年份统计 -->
    <section class="stats-section">
      <h2>年份统计</h2>
      <div class="bar-chart-container">
        {(() => {
          const currentYear = new Date().getFullYear();
          const years = Array.from({ length: 20 }, (_, i) => (currentYear - 19 + i).toString());
          const countMap = new Map(Object.entries(postsByYear));
          const completeData = years.map((year) => ({ year, count: countMap.get(year) || 0 }));
          const maxCount = Math.max(...Object.values(postsByYear), 1);
          const chartHeight = 200;
          const barMaxHeight = chartHeight - 40;

          return (
            <div class="bar-chart">
              <div class="bar-chart-bars">
                {completeData.map(({ year, count }) => (
                  <div class="bar-item">
                    <div class="bar-value">{count > 0 ? count : ""}</div>
                    <div class="bar" style={`height: ${count ? (count / maxCount) * barMaxHeight : 2}px`}></div>
                    <div class="bar-label">{year}</div>
                  </div>
                ))}
              </div>
            </div>
          );
        })()}
      </div>
    </section>

    <!-- 标签云 -->
    <section class="stats-section">
      <h2>标签云</h2>
      <div class="tag-cloud">
        {sortedTags.map(({ name, count }) => (
            <span class="tag-item" style={`background-color: ${getTagColor(count)}`}>
              {name}
              <span class="tag-count">{count}</span>
            </span>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>


<script is:inline define:vars={{ postsData }}>
  function formatDate(date) {
    return date.toISOString().split("T")[0];
  }

  function getClassForValue(count) {
    if (count === 0) return 'color-empty';
    if (count < 300) return 'color-github-1';
    if (count < 800) return 'color-github-2';
    if (count < 1500) return 'color-github-3';
    return 'color-github-4';
  }

  function initHeatmap() {
    const container = document.getElementById('heatmap-container');
    if (!container) return;

    container.innerHTML = '';

    const today = new Date();
    const startDate = new Date(today);
    startDate.setFullYear(today.getFullYear() - 1);

    // Adjust to start from Sunday
    startDate.setDate(startDate.getDate() - startDate.getDay());

    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    // Month labels
    const monthRow = document.createElement('div');
    monthRow.className = 'heatmap-months';

    const months = [];
    let currentDate = new Date(startDate);
    let lastMonth = -1;

    while (currentDate <= today) {
      const month = currentDate.getMonth();
      if (month !== lastMonth) {
        months.push({ month: monthNames[month], date: new Date(currentDate) });
        lastMonth = month;
      }
      currentDate.setDate(currentDate.getDate() + 7);
    }

    const numMonthsToShow = Math.min(months.length, 12);
    const startMonthIndex = Math.max(0, months.length - numMonthsToShow);
    for (let i = startMonthIndex; i < months.length; i++) {
      const span = document.createElement('span');
      span.textContent = months[i].month;
      monthRow.appendChild(span);
    }
    container.appendChild(monthRow);

    // Wrapper with weekday labels and grid
    const wrapper = document.createElement('div');
    wrapper.className = 'heatmap-wrapper';

    // Y-axis labels (weekdays)
    const yLabels = document.createElement('div');
    yLabels.className = 'heatmap-y-labels';
    yLabels.innerHTML = '<span>Mon</span><span>&nbsp;</span><span>&nbsp;</span><span>Wed</span><span>&nbsp;</span><span>&nbsp;</span><span>Fri</span><span>&nbsp;</span><span>&nbsp;</span><span>Sun</span>';
    wrapper.appendChild(yLabels);

    // Grid
    const grid = document.createElement('div');
    grid.className = 'heatmap-grid';

    const rows = 7;
    const cols = 53;
    const cellMap = {};

    const dataMap = {};
    postsData.forEach(p => {
      dataMap[p.date] = p;
    });

    currentDate = new Date(startDate);
    let colIndex = 0;
    let dayIndex = 0;

    while (currentDate <= today && colIndex < cols) {
      const dayOfWeek = currentDate.getDay();
      const dateStr = formatDate(currentDate);

      if (dayOfWeek === 0 && dayIndex > 0) {
        colIndex++;
      }

      const key = `${dayOfWeek},${colIndex}`;
      const dayData = dataMap[dateStr];

      if (dayData) {
        cellMap[key] = {
          count: dayData.wordCount,
          title: dayData.title,
          wordCount: dayData.wordCount,
          date: dateStr
        };
      }

      currentDate.setDate(currentDate.getDate() + 1);
      dayIndex++;
    }

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const cell = document.createElement('div');
        const key = `${r},${c}`;
        const cellData = cellMap[key];

        if (cellData) {
          cell.className = `heatmap-day ${getClassForValue(cellData.count)}`;
          cell.dataset.date = cellData.date;
          cell.dataset.title = cellData.title;
          cell.dataset.count = cellData.wordCount.toString();

          cell.addEventListener('mouseenter', () => {
            const tooltip = document.createElement('div');
            tooltip.className = 'heatmap-tooltip';

            let content = `<div class="heatmap-tooltip-date">${cellData.date}</div>`;
            content += `<div class="heatmap-tooltip-content">`;
            content += `<div>${cellData.wordCount} 字</div>`;
            content += `<div>《${cellData.title}》</div>`;
            content += `</div>`;

            tooltip.innerHTML = content;
            document.body.appendChild(tooltip);

            const rect = cell.getBoundingClientRect();
            tooltip.style.left = rect.left + 'px';
            tooltip.style.top = (rect.top - tooltip.offsetHeight - 8) + 'px';
          });

          cell.addEventListener('mouseleave', () => {
            document.querySelectorAll('.heatmap-tooltip').forEach(t => t.remove());
          });
        } else {
          cell.className = 'heatmap-day color-empty';
        }

        grid.appendChild(cell);
      }
    }

    wrapper.appendChild(grid);
    container.appendChild(wrapper);

    // Legend
    const legendDiv = document.createElement('div');
    legendDiv.className = 'heatmap-legend';
    legendDiv.innerHTML = `
      <span>Less</span>
      <span class="heatmap-legend-item" style="background-color: #d6d8db"></span>
      <span class="heatmap-legend-item" style="background-color: #9ad99b"></span>
      <span class="heatmap-legend-item" style="background-color: #68be67"></span>
      <span class="heatmap-legend-item" style="background-color: #3f7f46"></span>
      <span class="heatmap-legend-item" style="background-color: #2f6336"></span>
      <span>More</span>
    `;
    container.appendChild(legendDiv);
  }

  initHeatmap();
</script>