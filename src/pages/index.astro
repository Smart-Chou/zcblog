---
import "~/styles/home.css";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import HeroMasthead from "~/components/Index/HeroMasthead.astro";
import Talk from "~/components/Index/Talk.astro";
import Posts from "~/components/Index/Posts.astro";
import Friends from "~/components/Index/Friends.astro";
import Photos from "~/components/Index/Photos.astro";
import Goods from "~/components/Index/Goods.astro";
import Media from "~/components/Index/Media.astro";
import Author from "~/components/Feature/Author.astro";
import booksItems from "~/data/books.json";
import moviesItems from "~/data/movies.json";
import { site } from "~/self.config";
import { sortByPubDate } from "~/utils/date-utils";

const allArticles = await getCollection("article", ({ data }) => !data.draft);
const sortedArticles = sortByPubDate(allArticles);
const recentPosts = sortedArticles.slice(0, 5);
const totalArticles = allArticles.length;

const tagsCount = new Set(allArticles.flatMap((post) => post.data.tags || [])).size;
---

<BaseLayout
    title={`${site.subtitle} -  ${site.title}`}
    description={`${site.title} - ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={site.coverImageAlt}
    keywords={site.keywords}
    publishedTime={new Date()}
    modifiedTime={new Date()}
>
    <div class="page-container">
        <div class="hero-background"></div>
        <main class="main-content">
            <!-- Hero Masthead -->
            <HeroMasthead
                subtitle={site.subtitle}
                totalArticles={totalArticles}
                tagsCount={tagsCount}
            />

            <!-- Talk Ticker -->
            <Talk />

            <!-- Recent Posts -->
            <Posts posts={recentPosts} />

            <!-- Friends -->
            <Friends />

            <!-- Photos -->
            <Photos />

            <!-- Goods -->
            <Goods limit={4} />

            <!-- Media Duo: Movies + Books -->
            <div class="media-duo">
                <Media
                    title="近期观影"
                    items={moviesItems}
                    href="/movies/"
                    limit={4}
                />
                <Media
                    title="近期阅读"
                    items={booksItems}
                    href="/books/"
                    limit={4}
                />
            </div>

            <Author />
        </main>
    </div>
</BaseLayout>
