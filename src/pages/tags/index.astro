---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostLayout from '~/layouts/PostLayout.astro';
import { site, tagsPage } from '~/self.config';

const allPosts = await getCollection('archives');
const tags = [...new Set(allPosts.map(post => post.data.tags).flat())];
---

<BaseLayout 
    title={tagsPage.title + ` - ` + site.title} 
    description={tagsPage.description + ` - ` + site.description}
    image={Astro.site + site.coverImage}
    imageAlt={tagsPage.title}
    keywords={['tags']}
>
    <h1 class="tag-title text-center space-bottom">{tagsPage.title}</h1>
    <PostLayout>
        <div class="tags">
            {
                tags.map(tag => (
                    <p class="tag">
                        <a href={`/tags/${tag}/`}>{tag}</a>
                    </p>
                ))
            }
        </div>
    </PostLayout>
</BaseLayout>

