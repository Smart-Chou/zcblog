---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/BaseLayout.astro';
import PostCardLayout from '~/layouts/PostCardLayout.astro';
const allPosts = await getCollection('archives');
const tags = [...new Set(allPosts.map(post => post.data.tags).flat())];
---

<Layout>
    <h1 class="tag-title text-center space-bottom">Tags</h1>
    <PostCardLayout>
        <div class="tags">
            {
                tags.map(tag => (
                    <p class="tag">
                        <a href={`/tags/${tag}`}>{tag}</a>
                    </p>
                ))
            }
        </div>
    </PostCardLayout>
</Layout>

<style>
    .tags {
        display: flex;
        flex-wrap: wrap;
    }

    .tag {
        margin: 0.25em;
        border-radius: 0.5em;
        padding: 0.5em 1em;
        font-size: 1.15em;
        background-color: #f8fcfd;
    }

    .tag a {
        text-decoration: none;
    }

    .tag a:hover {
        text-decoration: underline;
    }
</style>
