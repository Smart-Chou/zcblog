---
import { getCollection } from "astro:content";
import Layout from '../../layouts/BaseLayout.astro';
import PostCardTagLayout from '../../layouts/PostCardTagLayout.astro';

export async function getStaticPaths() {
    const allPosts = await getCollection("posts");

    const uniqueTags = [...new Set(allPosts.map(post => post.data.tags).flat())];

    return uniqueTags.map(tag => {
        const filteredPosts = allPosts.filter(post => post.data.tags.includes(tag));
        return {
            params: { tag },
            props: { posts: filteredPosts },
        };
    });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout pageTitle={tag}>
    <h1 class="tag-title text-center space-bottom"># {tag}</h1>
    <div class="posts">
        {posts.map(post => <PostCardTagLayout title={post.data.title} url={`/posts/${post.slug}/`} description={post.data.description} pubDate={post.data.pubDate} />)}
    </div>
</Layout>
