---
import { getCollection } from "astro:content";
import SectionPage from "~/components/Layout/SectionPage.astro";
import PostMeta from "~/components/Article/PostMeta.astro";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import { site } from "~/self.config";
import { getPostsWithMeta } from "~/utils/getPostsWithMeta";

export async function getStaticPaths() {
    const allArticles = await getCollection("article");
    const uniqueTags = [
        ...new Set(allArticles.map((post) => post.data.tags || []).flat()),
    ];
    return uniqueTags.map((tag) => ({
        params: { tag },
        props: {
            articles: allArticles.filter((post) =>
                (post.data.tags || []).includes(tag),
            ),
        },
    }));
}

const { tag } = Astro.params;
const { articles } = Astro.props;

const postsWithMeta = articles.map((post) => {
    const { wordCount, readTime, excerpt } = getPostsWithMeta({
        ...post,
        slug: post.id,
    });
    return {
        ...post,
        wordCount,
        readTime,
        excerpt,
        slug: post.id,
    };
});
---

<SectionPage
    title={`# ${tag}`}
    subtitle={`${postsWithMeta.length} 篇文章标签为 "${tag}"`}
    description={`${tag} - ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={tag}
    keywords={[tag]}
    publishedTime={new Date()}
    modifiedTime={new Date()}
    empty={postsWithMeta.length === 0}
    emptyTitle="暂无文章"
    emptyMessage={`没有标签为 "${tag}" 的文章`}
>
    <DynamicIcon name="tabler:tag" slot="icon" />
    <div class="posts">
        {
            postsWithMeta.map((post) => (
                <div class="post-item">
                    <h2 class="post-card-title">
                        <a href={`/article/${post.slug}/`}>{post.data.title}</a>
                    </h2>
                    <p class="post-card-description">{post.excerpt}</p>
                    <PostMeta
                        publishedTime={post.data.pubDate}
                        wordCount={post.wordCount}
                        readTime={post.readTime}
                        currentSlug={post.slug}
                    />
                </div>
            ))
        }
    </div>
</SectionPage>

<style>
    .posts {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .post-item {
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-border);
    }

    .post-card-title {
        margin: 0 0 0.5rem;
    }

    .post-card-title a {
        text-decoration: none;
    }

    .post-card-description {
        opacity: 0.8;
        margin-bottom: 0.75rem;
    }
</style>

<script>
    import { pageviewCount } from "@waline/client/pageview";
    import { waline } from "~/self.config";

    document.addEventListener("astro:page-load", () => {
        const serverURL = waline.serverUrl;
        const path = window.location.pathname;

        pageviewCount({
            serverURL,
            path,
            selector: ".waline-pageview-count",
            update: true,
        });
    });
</script>
