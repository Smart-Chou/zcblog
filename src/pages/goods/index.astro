---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHeader from "~/components/Widget/PageHeader.astro";
import EmptyState from "~/components/Widget/EmptyState.astro";
---

<BaseLayout title="好物">
    <div class="page-container">
        <PageHeader title="好物" subtitle="分享好玩、好用、好看的东西">
            <span slot="icon" style="font-size:32px">🎁</span>
        </PageHeader>
        <EmptyState emoji="🎁" title="即将上线" message="此板块正在建设中，敬请期待" />
    </div>
</BaseLayout>

<style>
    .page-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }
</style>
