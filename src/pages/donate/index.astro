---
import SectionPage from "~/components/Layout/SectionPage.astro";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import QrCard from "~/components/UI/QrCard.astro";
import DonatorsList from "~/components/UI/DonatorsList.astro";
import WalineComment from "~/components/UI/WalineComment.astro";
import { donate } from "~/config";
import donateData from "~/data/donators.json";
import wechatQR from "~/assets/qr/wechat-pay.png";
import alipayQR from "~/assets/qr/alipay.jpg";
import paypalQR from "~/assets/qr/paypal.png";

const { donators } = donateData;
---

<SectionPage
    title="赞赏者名单"
    subtitle="感谢所有支持和鼓励我的朋友们"
    publishedTime={new Date()}
    modifiedTime={new Date()}
>
    <DynamicIcon name="tabler:heart-handshake" slot="icon" />

    <div class="donate-sections">
        <div class="donate-section s-card">
            <div class="donate-header">
                <h2 class="section-title">支持方式</h2>
            </div>
            <div class="donate-methods">
                <QrCard
                    qrImage={wechatQR}
                    alt="微信支付"
                    platformName="微信支付"
                    iconName="mingcute:wechat-pay-line"
                />
                <QrCard
                    qrImage={alipayQR}
                    alt="支付宝支付"
                    platformName="支付宝"
                    iconName="mingcute:alipay-line"
                />
                {
                    donate.paypalUrl && (
                        <QrCard
                            qrImage={paypalQR}
                            alt="PayPal"
                            platformName="PayPal"
                            iconName="mingcute:paypal-fill"
                            paypalUrl={donate.paypalUrl}
                        />
                    )
                }
            </div>
        </div>

        <div class="donators-section s-card">
            <div class="donators-header">
                <h2 class="section-title">赞赏者名单</h2>
                <p class="section-desc">感谢这些朋友的支持，让我能持续写下去（排名不分先后）</p>
            </div>
            <DonatorsList donators={donators} />
        </div>

        <div class="thank-section s-card">
            <div class="thank-content">
                <DynamicIcon name="tabler:heart-handshake" class="thank-icon" />
                <h2 class="thank-title">再次感谢</h2>
                <p class="thank-text">
                    每一份支持都是对我最大的鼓励，我会继续努力创作更多有价值的内容。
                    您的支持将帮助我持续维护这个博客，提供更好的内容和服务。
                </p>
            </div>
        </div>
    </div>

    <WalineComment />
</SectionPage>

<style>
    .donate-sections {
        max-width: 800px;
        margin: 0 auto;
    }

    .donate-section,
    .donators-section,
    .thank-section {
        margin-bottom: 2rem;
        padding: 2rem;
    }

    .donate-header,
    .donators-header {
        margin-bottom: 2rem;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
    }

    .section-desc {
        color: var(--color-muted);
        margin: 0;
    }

    .donate-methods {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1.5rem;
    }

    .thank-section {
        text-align: center;
    }

    .thank-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .thank-content :global(.thank-icon) {
        font-size: 2.5rem;
        color: #e74c3c;
    }

    .thank-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0;
    }

    .thank-text {
        color: var(--color-muted);
        line-height: 1.6;
        margin: 0;
        max-width: 600px;
    }

    @media (max-width: 768px) {
        .donate-section,
        .donators-section,
        .thank-section {
            padding: 1.5rem;
        }

        .donate-methods {
            grid-template-columns: 1fr;
        }
    }

    html[data-theme="dark"] .section-desc,
    html[data-theme="dark"] .thank-text {
        color: rgba(255, 255, 255, 0.65);
    }

    html[data-theme="dark"] .thank-content :global(.thank-icon) {
        color: #f2a19a;
    }
</style>
