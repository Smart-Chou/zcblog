// 相册数据 - 后续可以从存储桶或图床动态获取
const albums = [
  {
    id: "travel",
    title: "旅行相册",
    description: "记录旅途中的美好瞬间",
    coverImage: "https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=beautiful%20landscape%20photography%20mountain%20lake%20scenery&image_size=landscape_4_3",
    photos: [
      {
        id: "1",
        url: "https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=mountain%20landscape%20with%20lake%20and%20blue%20sky&image_size=landscape_4_3",
        alt: "山湖风景",
        description: "美丽的山湖景色"
      },
      {
        id: "2",
        url: "https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=forest%20path%20with%20sunlight%20filtering%20through%20trees&image_size=landscape_4_3",
        alt: "森林小径",
        description: "阳光透过树叶的森林小径"
      },
      {
        id: "3",
        url: "https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=coastal%20sunset%20with%20waves%20and%20orange%20sky&image_size=landscape_4_3",
        alt: "海岸日落",
        description: "橙色天空下的海岸日落"
      }
    ],
    createdAt: new Date("2024-01-01"),
    updatedAt: new Date("2024-01-01")
  },
  {
    id: "nature",
    title: "自然风景",
    description: "大自然的壮丽景色",
    coverImage: "https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=mountain%20peaks%20with%20snow%20and%20clouds&image_size=landscape_4_3",
    photos: [
      {
        id: "1",
        url: "https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=waterfall%20in%20forest%20with%20rainbow&image_size=landscape_4_3",
        alt: "森林瀑布",
        description: "带有彩虹的森林瀑布"
      },
      {
        id: "2",
        url: "https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=desert%20landscape%20with%20sand%20dunes%20and%20sunset&image_size=landscape_4_3",
        alt: "沙漠日落",
        description: "沙丘上的沙漠日落"
      },
      {
        id: "3",
        url: "https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=beach%20with%20clear%20blue%20water%20and%20palm%20trees&image_size=landscape_4_3",
        alt: "海滩风光",
