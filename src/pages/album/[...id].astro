---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { site } from "~/self.config";

// 从JSON文件引入相册数据
import albumData from "~/data/albums.json";

const { albums } = albumData;

// 为动态路由生成静态路径
export async function getStaticPaths() {
    // 在函数内部动态导入相册数据
    const albumData = await import("~/data/albums.json");
    const { albums } = albumData;

    // 根据相册数据生成所有路径
    return albums.map((album) => ({
        params: { id: album.id },
    }));
}

const { id } = Astro.params;
const album = albums.find((album) => album.id === id);

if (!album) {
    return Astro.redirect("/albums");
}
---

<BaseLayout
    title={`${album.title} - 相册`}
    description={site.title + ` - ` + album.description}
    image={album.coverImage}
    imageAlt={album.title}
    keywords={`${album.title},相册,照片`}
    publishedTime={new Date(album.createdAt)}
    modifiedTime={new Date(album.updatedAt)}
>
    <div class="album-detail-container">
        <div class="album-header">
            <a href="/albums/" class="back-link">← 返回相册列表</a>
            <h1 class="album-title">{album.title}</h1>
            <p class="album-description">{album.description}</p>
            <div class="album-meta">
                <span class="photo-count">{album.photos.length} 张照片</span>
                <span class="updated-time"
                    >更新于 {
                        new Date(album.updatedAt).toLocaleDateString()
                    }</span
                >
            </div>
        </div>

        <div class="photos-grid" id="lightgallery">
            {
                album.photos.map((photo) => (
                    <a
                        href={photo.url}
                        class="photo-item"
                        data-lg-size="1920-1280"
                        data-subhtml={`<h4>${photo.alt}</h4><p>${photo.description}</p>`}
                        aria-label={`查看大图: ${photo.alt}`}
                    >
                        <div class="photo-wrapper">
                            <img
                                src={photo.url}
                                alt={photo.alt}
                                class="photo-image"
                                loading="lazy"
                            />
                            <div class="photo-overlay">
                                <span class="photo-description">
                                    {photo.description}
                                </span>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</BaseLayout>

<style>
    .album-detail-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .album-header {
        margin-bottom: 3rem;
        text-align: center;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 1.5rem;
        font-size: 1rem;
        color: var(--body-color);
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .back-link:hover {
        color: var(--link-color);
    }

    .album-title {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--title-color);
    }

    .album-description {
        font-size: 1.1rem;
        color: var(--body-color);
        margin-bottom: 1rem;
    }

    .album-meta {
        display: flex;
        justify-content: center;
        gap: 2rem;
        font-size: 0.9rem;
        color: var(--body-color);
        opacity: 0.8;
    }

    .photos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .photo-item {
        display: block;
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-small);
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
        text-decoration: none;
        color: inherit;
        cursor: zoom-in;
    }

    .photo-item:hover,
    .photo-item:focus-visible {
        transform: translateY(-5px);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15);
        outline: none;
    }

    .photo-item:focus-visible {
        box-shadow:
            0 0 0 3px var(--link-color),
            0 8px 15px rgba(0, 0, 0, 0.15);
    }

    .photo-wrapper {
        position: relative;
        padding-top: 75%;
        overflow: hidden;
    }

    .photo-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .photo-item:hover .photo-image,
    .photo-item:focus-visible .photo-image {
        transform: scale(1.05);
    }

    .photo-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
        color: white;
        padding: 1.5rem 1rem 1rem;
        transform: translateY(100%);
        transition: transform 0.3s ease;
    }

    .photo-item:hover .photo-overlay,
    .photo-item:focus-visible .photo-overlay {
        transform: translateY(0);
    }

    .photo-description {
        font-size: 0.9rem;
        line-height: 1.4;
    }

    @media (max-width: 768px) {
        .photos-grid {
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1rem;
        }

        .album-meta {
            flex-direction: column;
            gap: 0.5rem;
        }
    }
</style>

<script>
    // 导入 Lightgallery 样式
    import "lightgallery.js/dist/css/lightgallery.css";

    // 动态导入 Lightgallery（插件已集成到主库中）
    import("lightgallery.js")
        .then(({ default: lightGallery }) => {
            // 初始化 Lightgallery
            const gallery = document.getElementById("lightgallery");
            if (gallery) {
                lightGallery(gallery, {
                    speed: 500,
                    download: false,
                    getCaptionFromTitleOrAlt: false,
                    subHtmlSelectorRelative: true,
                    thumbnail: true,
                    zoom: true,
                    mode: "lg-fade",
                    cssEase: "cubic-bezier(0.25, 0, 0.25, 1)",
                });
            }
        })
        .catch((error) => {
            console.error("Failed to load Lightgallery:", error);
        });
</script>
