---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import PostLayout from "~/layouts/PostLayout.astro";
import PostMeta from "~/components/PostMeta.astro";
import { site } from "~/self.config";
import { getPostsWithMeta } from "~/utils/getPostsWithMeta";

export async function getStaticPaths() {
    const allArticles = await getCollection("article");
    const uniqueTags = [
        ...new Set(allArticles.map((post) => post.data.tags || []).flat()),
    ];
    return uniqueTags.map((tag) => ({
        params: { tag },
        props: {
            articles: allArticles.filter((post) =>
                (post.data.tags || []).includes(tag),
            ),
        },
    }));
}

const { tag } = Astro.params;
const { articles } = Astro.props;

const postsWithMeta = articles.map((post) => {
    const { wordCount, readTime, modifiedTime, excerpt } =
        getPostsWithMeta(post);
    return {
        ...post,
        modifiedTime: modifiedTime,
        wordCount,
        readTime,
        excerpt,
        slug: post.slug,
    };
});
---

<BaseLayout
    title={`${tag} - ${site.title}`}
    description={`${tag} - ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={tag}
    keywords={tag}
    publishedTime={new Date()}
    modifiedTime={new Date()}
>
    <h1 class="tag-title text-center space-bottom"># {tag}</h1>
    <div class="posts">
        {
            postsWithMeta.map((post) => (
                <PostLayout key={post.slug}>
                    <h2 class="post-card__title">{post.data.title}</h2>
                    <p class="post-card__description">{post.excerpt}</p>
                    <PostMeta
                        publishedTime={post.data.pubDate}
                        modifiedTime={post.modifiedTime}
                        wordCount={post.wordCount}
                        readTime={post.readTime}
                        currentSlug={post.slug}
                    />
                    <a href={`/article/${post.slug}/`} class="post-card__link">
                        Link
                    </a>
                </PostLayout>
            ))
        }
    </div>
</BaseLayout>

<script>
    import { pageviewCount } from "@waline/client/pageview";
    import { commentCount } from "@waline/client/comment";
    import { comment } from "~/self.config";

    document.addEventListener("astro:page-load", () => {
        const serverURL = comment.serverUrl;
        const path = window.location.pathname;

        pageviewCount({
            serverURL,
            path,
        });

        commentCount({
            serverURL,
            path,
        });
    });
</script>
