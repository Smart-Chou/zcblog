---
import { getCollection } from 'astro:content'
import BaseLayout from '~/layouts/BaseLayout.astro'
import PostLayout from '~/layouts/PostLayout.astro'
import PostMeta from '~/components/PostMeta.astro'
import { site } from '~/self.config'
import getReadingTime from 'reading-time'
import { formatPosts } from '~/utils/formatPosts'

export async function getStaticPaths() {
  const articles = await getCollection('article')
  const allPosts = formatPosts(articles)
  const uniqueTags = [...new Set(allPosts.map(post => post.data.tags || []).flat())]
  return uniqueTags.map(tag => {
    const filteredPosts = allPosts.filter(post => (post.data.tags || []).includes(tag))
    return {
      params: { tag },
      props: { article: filteredPosts },
    }
  })
}

const { tag } = Astro.params
const { article } = Astro.props

const postsWithMeta = article.map(post => {
  const upDate =  new Date()
  const readingTime = getReadingTime(post.body)
  const wordCount = readingTime.words
  const readTime = readingTime.text

  return {
    ...post,
    upDate,
    wordCount,
    readTime,
    slug: post.slug,
  }
})
---

<BaseLayout 
    title={tag + ` - ` + site.title} 
    description={tag + ` - ` + site.description}
    image={Astro.site + site.coverImage}
    imageAlt={tag}
    keywords={[`${tag}`]}
>
  <h1 class="tag-title text-center space-bottom"># {tag}</h1>
  <div class="posts">
    {
      postsWithMeta.map(post => (
        <PostLayout>
          <h2 class="post-card__title">{post.data.title}</h2>
          <p class="post-card__description">{post.data.description}</p>
          <PostMeta 
                pubDate={post.data.pubDate} 
                upDate={post.upDate} 
                wordCount={post.wordCount} 
                readTime={post.readTime} 
                currentSlug={post.slug} 
            />
          <a href={`/article/${post.slug}/`} class="post-card__link">
            Link
          </a>
        </PostLayout>
      ))
    }
  </div>
</BaseLayout>

<script>
  import { pageviewCount } from '@waline/client/pageview'
  import { commentCount } from '@waline/client/comment'
  import { comment } from '~/self.config'

  document.addEventListener('astro:page-load', () => {
    const serverURL = comment.serverUrl
    const path = window.location.pathname

    pageviewCount({
      serverURL,
      path,
    })

    commentCount({
      serverURL,
      path,
    })
  })
</script>
