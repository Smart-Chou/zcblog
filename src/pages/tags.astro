---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import PostLayout from "~/layouts/PostLayout.astro";
import Author from "~/components/Author.astro";
import { site, tagsPage } from "~/self.config";

const allPosts = await getCollection("article");
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
---

<style>
    .tags {
        display: flex;
        flex-wrap: wrap;
    }

    .tag {
        margin: 0.25em;
        border-radius: 0.5em;
        padding: 0.5em 1em;
        font-size: 1.15em;
        background-color: var(--bg-color);
    }

    .tag a {
        text-decoration: none;
    }

    .tag a:hover {
        text-decoration: underline;
    }
</style>

<BaseLayout
    title={`${tagsPage.title} - ${site.title}`}
    description={`${tagsPage.description} -  ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={tagsPage.title}
    keywords="Tags"
    publishedTime={new Date()}
    modifiedTime={new Date()}
>
    <h1 class="tag-title text-center space-bottom">{tagsPage.title}</h1>
    <PostLayout>
        <div class="tags">
            {
                tags.map((tag) => (
                    <p class="tag">
                        <a href={`/tag/${tag}/`}>{tag}</a>
                    </p>
                ))
            }
        </div>
    </PostLayout>
    <Author />
</BaseLayout>
