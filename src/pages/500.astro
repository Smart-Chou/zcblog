---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Button from "~/components/UI/Button.astro";
import { t, getLocale } from "~/utils/i18n";

const loc = getLocale(Astro.currentLocale || "zh");
---

<BaseLayout
    title={t(loc, "common.500.pageTitle")}
    description={t(loc, "common.500.pageDescription")}
    image="/cover.png"
    imageAlt="Error"
    publishedTime={new Date()}
    modifiedTime={new Date()}
>
    <div class="error-page">
        <div class="error-content">
            <h1 class="error-code">500</h1>
            <h2 class="error-title">{t(loc, "common.500.heading")}</h2>
            <p class="error-description">{t(loc, "common.500.description")}</p>
            <div class="error-actions">
                <Button href="/" variant="primary">{t(loc, "common.500.backHome")}</Button>
                <Button href="/archives/" variant="secondary"
                    >{t(loc, "common.500.browseArchives")}</Button
                >
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .error-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        padding: 2rem;
    }

    .error-content {
        text-align: center;
        max-width: 600px;
    }

    .error-code {
        font-size: 8rem;
        font-weight: 700;
        margin: 0;
        background: linear-gradient(135deg, var(--color-accent), var(--color-link));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .error-title {
        font-size: 2rem;
        margin: 1rem 0;
        color: var(--color-title);
    }

    .error-description {
        font-size: 1.1rem;
        color: var(--color-body);
        opacity: 0.8;
        margin: 1.5rem 0 2rem;
        line-height: 1.6;
    }

    .error-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .error-actions .btn {
        --btn-primary-bg: var(--color-accent);
        --btn-secondary-color: var(--color-accent);
        --btn-secondary-border: var(--color-accent);
        --btn-secondary-hover-bg: var(--color-accent);
    }

    @media (max-width: 768px) {
        .error-code {
            font-size: 5rem;
        }

        .error-title {
            font-size: 1.5rem;
        }

        .error-description {
            font-size: 1rem;
        }
    }
</style>
