---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/BaseLayout.astro';
import Author from '~/components/Author.astro';
import PostCard from '~/components/PostCard.astro';
import Pagination from '~/components/Pagination.astro';

export async function getStaticPaths({ paginate }) {
    const allPostsPages = await getCollection('archives');
    return paginate(allPostsPages, { pageSize: 10 });
}

const allPosts = await getCollection('archives');
const pageSize = 10;

// 计算总页数
const currentPage = parseInt(Astro.url.pathname.split('/').pop() ?? '1', 10);
const totalPages = Math.ceil(allPosts.length / pageSize);

// 计算前一页和后一页的URL
const pageData = {
    url: {
        prev: currentPage > 1 ? (currentPage === 2 ? '/' : `/${currentPage - 1}`) : null,
        next: currentPage < totalPages ? `/${currentPage + 1}` : null,
    },
    totalPages,
    currentPage,
};

const start = (currentPage - 1) * pageSize;
const end = currentPage * pageSize;
const pagePosts = allPosts.slice(start, end).sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---
<Layout>
    <Author />
    <div class="post">
        {pagePosts.map(post => (
            <PostCard
                key={post.slug}
                title={post.data.title}
                pubDate={post.data.pubDate}
                postUrl={`/archives/${post.slug}/`}
                imageUrl={post.data.image.url}
                description={post.data.description}
                tags={post.data.tags}
            />
        ))}
    </div>
    <Pagination page={pageData} />
</Layout>

<style>
    
</style>
