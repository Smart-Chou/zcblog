---
import { getLocale } from "~/utils/i18n";
import BlogContent from "~/components/Pages/BlogContent.astro";
import { makeBlogGetStaticPaths } from "~/utils/blog-paths";

// 中文列表（英文文章走 /en/blog/）
export const getStaticPaths = makeBlogGetStaticPaths("zh");

interface PostData {
    slug: string;
    url: string;
    data: {
        title: string;
        pubDate: Date;
        tags?: string[];
        image?: { url?: string; alt?: string };
        description?: string;
    };
    wordCount: number;
    readTime: string;
    modifiedTime: Date | string;
    excerpt: string;
    sticky?: number;
}

const { page } = Astro.props as {
    page: {
        data: PostData[];
        url: { prev?: string; next?: string };
        currentPage: number;
        lastPage: number;
    };
};

const locale = getLocale(Astro.currentLocale || "zh");
---

<BlogContent page={page} locale={locale} />
