---
import BaseLayout from "~/layouts/BaseLayout.astro";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { site, redirectPage } from "~/config";
import { t, getLocale, type Locale } from "~/utils/i18n";
import "~/styles/redirect.css";

const loc: Locale = getLocale(Astro.url.pathname.startsWith("/en") ? "en" : "zh");

const domainsJson = JSON.stringify(site.domains);

const scriptTexts = JSON.stringify({
    trustedSite: t(loc, "redirect.trustedSite"),
    blacklistedSite: t(loc, "redirect.blacklistedSite"),
    blockedButton: t(loc, "redirect.blockedButton"),
    autoJumpCountdown: t(loc, "redirect.autoJumpCountdown"),
    jumping: t(loc, "redirect.jumping"),
    fetchFailed: t(loc, "redirect.fetchFailed"),
    sorry: t(loc, "redirect.sorry"),
});
---

<BaseLayout
    title={redirectPage.title}
    description={`${redirectPage.title} - ${redirectPage.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={redirectPage.title}
    keywords="redirect"
    publishedTime={new Date()}
    modifiedTime={new Date()}
>
    <div class="redirect">
        <span class="redirect-tip" id="redirect-tip"
            >{t(loc, "redirect.leavingMessage", { site: site.title })}</span
        >
        <span id="url"></span>
        <div id="jump-content" class="warn">
            <span id="site-info">
                <span class="redirect-icon warn-icon" aria-hidden="true">
                    <DynamicIcon name="tabler:alert-triangle-filled" width="18" height="18" />
                </span>
                {t(loc, "redirect.safetyWarning")}
            </span>
            <div id="jump-button">{t(loc, "redirect.continueButton")}</div>
        </div>
    </div>
    <script is:inline define:vars={{ domainsJson, scriptTexts }}>
        // 跳转网址
        let jumpLink;
        let interval;
        // 获取元素
        const tipDescription = document.getElementById("redirect-tip");
        const urlDom = document.getElementById("url");
        const urlTip = document.getElementById("site-info");
        const jumpContent = document.getElementById("jump-content");
        const jumpButton = document.getElementById("jump-button");
        // 网址白名单
        const siteDomains = JSON.parse(domainsJson);
        const whitelist = [
            ...siteDomains,
            ...siteDomains.map((d) => `*.${d}`),
            "github.com",
            "astro.build",
            "vercel.com",
            "t.me",
        ];
        // 网址黑名单
        const blacklist = ["*.taobao.com", "*.jd.com"];
        // 翻译文本（由服务端注入）
        const texts = JSON.parse(scriptTexts);
        // 自动跳转
        const autoJump = () => {
            let count = 5;
            const updateContent = () => {
                jumpButton.textContent = texts.autoJumpCountdown.replace("{{count}}", count);
                count--;
                if (count < 0) {
                    clearInterval(interval);
                    jumpButton.textContent = texts.jumping;
                    window.location.replace(jumpLink);
                }
            };
            // 每秒更新一次
            updateContent();
            interval = setInterval(updateContent, 1000);
        };
        // 获取跳转网址
        const getJumpUrl = () => {
            try {
                // 解析 URL 参数
                const urlParams = new URLSearchParams(window.location.search);
                const encodedUrl = urlParams.get("url");
                if (!encodedUrl) {
                    throw new Error("URL 参数为空");
                }
                // 处理 URL 安全的 Base64 编码，将 - 转换为 +，_ 转换为 /
                const base64EncodedUrl = encodedUrl.replace(/-/g, "+").replace(/_/g, "/");
                // 添加适当的填充字符
                const paddedEncodedUrl = base64EncodedUrl.padEnd(
                    base64EncodedUrl.length + ((4 - (base64EncodedUrl.length % 4)) % 4),
                    "=",
                );
                // Base64 解码
                jumpLink = atob(paddedEncodedUrl);
                // 如果 URL 以 "//" 开头，添加默认协议
                if (jumpLink.startsWith("//")) {
                    jumpLink = "https:" + jumpLink;
                }
                // 先验证 URL 合法性，再设置文本内容（用 textContent 防 XSS）
                const urlHostname = new URL(jumpLink).hostname;
                urlDom.textContent = jumpLink;
                // 判断网址是否在黑名单中
                for (let i = 0; i < blacklist.length; i++) {
                    const blackPattern = blacklist[i].replace(/\*/g, ".*");
                    if (urlHostname.match(blackPattern)) {
                        // 显示提示信息
                        urlTip.textContent = texts.blacklistedSite;
                        jumpButton.textContent = texts.blockedButton;
                        jumpButton.style.cursor = "not-allowed";
                        jumpButton.style.pointerEvents = "none";
                        jumpButton.style.opacity = "0.4";
                        jumpContent.className = "danger";
                        return true;
                    }
                }
                // 判断网址是否在白名单中
                for (let i = 0; i < whitelist.length; i++) {
                    const whitePattern = whitelist[i].replace(/\*/g, ".*");
                    if (urlHostname.match(whitePattern)) {
                        // 显示提示信息
                        urlTip.textContent = texts.trustedSite;
                        jumpContent.className = "safe";
                        autoJump();
                        return true;
                    }
                }
            } catch (error) {
                console.error("Error during URL parsing:", error);
                tipDescription.remove();
                jumpContent.remove();
                urlDom.textContent = texts.fetchFailed;
                const sorryMessage = document.createElement("span");
                sorryMessage.className = "redirect-tip";
                sorryMessage.textContent = texts.sorry;
                urlDom.parentElement.insertBefore(sorryMessage, urlDom);
            }
        };
        document.addEventListener("contextmenu", function (event) {
            event.preventDefault();
        });
        document.addEventListener("keydown", function (event) {
            if (event.key === "F12") {
                event.preventDefault();
            }
            if (
                event.ctrlKey &&
                event.shiftKey &&
                (event.key === "I" || event.key === "C" || event.key === "G")
            ) {
                event.preventDefault();
            }
        });
        jumpButton.addEventListener("click", () => {
            clearInterval(interval);
            jumpButton.textContent = texts.jumping;
            if (jumpLink) window.location.replace(jumpLink);
        });
        window.addEventListener("DOMContentLoaded", () => {
            getJumpUrl();
        });
    </script>
</BaseLayout>
