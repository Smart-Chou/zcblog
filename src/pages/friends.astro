---
import Layout from '../layouts/Layout.astro';
---
<Layout>
    <div>
        <h1 class="friends-title text-center space-bottom">Friends &amp; Guestbook</h1>
        <div class="friends-container text-center space-bottom">
            <a href="https://code.felinae98.cn/" target="_blank" class="btn" style="color: #fff; background-color: #473922">
                <img alt="avatar" src="https://avatars3.githubusercontent.com/u/23295345?s=160" class="avatar g-image" />
                <span>@Felinae</span>
            </a>
            <a href="https://jychuuu.com/" target="_blank" class="btn" style="color: #fff; background-color: #191919">
                <img alt="avatar" src="https://avatars1.githubusercontent.com/u/46088026?s=160" class="avatar g-image" />
                <span>@agnoCJY</span>
            </a>
            <a href="https://blog.tenkeyseven.com/" target="_blank" class="btn" style="color: #fff; background-color: #b59672">
                <img alt="avatar" src="https://avatars2.githubusercontent.com/u/33371927?s=160" class="avatar g-image" />
                <span>@TenkeySeven</span>
            </a>
            <a href="https://silvester.wang/" target="_blank" class="btn" style="color: #fff; background-color: #595058">
                <img alt="avatar" src="https://avatars0.githubusercontent.com/u/34436920?s=160" class="avatar g-image" />
