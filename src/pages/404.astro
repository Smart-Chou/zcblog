---
import Layout from '~/layouts/BaseLayout.astro';
---
<Layout>
    <div>
        <h1 class="not-found-title text-center space-bottom" >404</h1>
        <div class="not-found-container" >
            <p class="description" >
                🍌 Oh, no, not here.
                <a href="/" class="active" >Take me back home. ↩</a>
            </p>
            <img src="/assets/static/404.74ecd2d.0bc97a81b234628e05fec80dcdf3e3a4.svg" class="not-found-bg--loaded" width="1440" alt="404 Not Found" />
        </div>
    </div>
</Layout>