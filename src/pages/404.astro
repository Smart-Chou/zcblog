---
import Layout from '~/layouts/BaseLayout.astro'
import notFound from '~/assets/404.svg'
import { notFoundPage } from '~/self.config'
---

<Layout title={notFoundPage.title} description={notFoundPage.description}>
  <div>
    <h1 class="not-found-title text-center space-bottom">404</h1>
    <div class="not-found-container">
      <p class="description">
        🍌 Oh, no, not here.
        <a href="/" class="active">Take me back home. ↩</a>
      </p>
      <img src={notFound.src} alt="404 Not Found" class="not-found-bg--loaded" width="600" />
    </div>
  </div>
</Layout>
