---
import BaseLayout from "~/layouts/BaseLayout.astro";
import notFound from "~/assets/404.svg";
import { site } from "~/config";
import { t, getLocale } from "~/utils/i18n";

const loc = getLocale(Astro.currentLocale || "zh");
---

<BaseLayout
    title={t(loc, "common.404.title")}
    description={`${site.title} - ${t(loc, "common.404.message")}`}
    image={Astro.site + site.coverImage}
    imageAlt="404"
    keywords="404"
    publishedTime={new Date()}
    modifiedTime={new Date()}
>
    <div>
        <h1 class="not-found-title text-center space-bottom">404</h1>
        <div class="not-found-container">
            <p class="description">
                🍌 {t(loc, "common.404.heading")}
                <a href="/" class="active">{t(loc, "common.404.backHome")} ↩</a>
            </p>
            <img
                src={notFound.src}
                alt="404 Not Found"
                class="not-found-bg--loaded"
                width="600"
                loading="lazy"
            />
        </div>
    </div>
</BaseLayout>

<style>
    .not-found-container {
        text-align: center;
        max-width: var(--content-width);
        margin: 0 auto;
    }

    .not-found-container .description {
        opacity: 0.8;
    }
</style>
