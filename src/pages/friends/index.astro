---
import Layout from '~/layouts/BaseLayout.astro';
import Author from '~/components/Author.astro';
import { Image } from 'astro:assets';
import friendList from './_friends.json';
import WalineComment from '~/components/WalineComment.astro';

const friends = friendList.map(friend => {
    const id = friend.id;
    const link = friend.link;
    const avatar = friend.avatar;
    const style = friend.style;

    return {
        id,
        link,
        avatar,
        style
    }
});
---

<Layout>
    <h1 class="friends-title text-center space-bottom">Friends &amp; Guestbook</h1>
    <div class="friends-container text-center space-bottom">
        {friends.map((friend) =>
        <a class="btn" href={friend.link} target="_blank" style={friend.style}>
            <Image src={friend.avatar} alt={friend.id} format='webp' inferSize class="avatar" width="160"/>
            <span>{friend.id}</span>
        </a>
        )}
        <p class="note">* I don't accept friend link requests from someone I don't know.</p>
    </div>
    <Author />
    <WalineComment />
</Layout>
