---
import SectionPage from "~/components/Layout/SectionPage.astro";
import EssayItem from "~/components/essay/EssayItem.astro";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import Author from "~/components/Feature/Author.astro";
import essaysData from "~/data/essays.json";
import { site } from "~/self.config";
---

<SectionPage
    title="Essay"
    subtitle="日常随笔与碎碎念"
    description={`${site.title} 的随笔`}
    empty={essaysData.length === 0}
    emptyEmoji="📝"
    emptyTitle="暂无随笔"
>
    <DynamicIcon name="tabler:message-circle" slot="icon" />
    <div class="essay-masonry">
        {essaysData.map((item) => <EssayItem item={item} />)}
    </div>
    <Author />
</SectionPage>

<style>
    .essay-masonry {
        columns: 1;
        column-gap: 0;
    }

    @media (min-width: 650px) {
        .essay-masonry {
            columns: 2;
            column-gap: 1rem;
        }
    }
</style>
