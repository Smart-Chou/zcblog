---
import BaseLayout from "~/layouts/BaseLayout.astro";
import EssayItem from "~/components/essay/EssayItem.astro";
import Chat from "~/components/icons/Chat.astro";
import PageHeader from "~/components/Widget/PageHeader.astro";
import { site } from "~/self.config";
import essaysData from "~/data/essays.json";
---

<BaseLayout title="回忆录" description={`${site.title} 的朋友圈回忆录`}>
    <div class="essay-container">
        <PageHeader
            title="回忆录"
            subtitle="朋友圈的回忆录，大多数都是非主流，当时年少轻狂时候发的"
        >
            <Chat slot="icon" />
        </PageHeader>

        <div class="essay-masonry">
            {essaysData.map((item) => <EssayItem item={item} />)}
        </div>
    </div>
</BaseLayout>

<style>
    .essay-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .essay-masonry {
        column-count: 3;
        column-gap: 1rem;
    }

    @media (max-width: 1024px) {
        .essay-masonry {
            column-count: 2;
        }
    }

    @media (max-width: 640px) {
        .essay-masonry {
            column-count: 1;
        }
    }
</style>
