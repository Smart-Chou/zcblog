---
import SectionPage from "~/components/Layout/SectionPage.astro";
import EssayItem from "~/components/ui/EssayItem.astro";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import Author from "~/components/ui/Author.astro";
import essaysData from "~/data/essays.json";
import { site } from "~/self.config";

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const isEn = locale === "en";
---

<SectionPage
    title={isEn ? "Essays" : "Essay"}
    subtitle={
        isEn
            ? "A collection of moments from my social media - mostly from my wild youth days"
            : "日常随笔与碎碎念"
    }
    description={
        isEn ? `${site.title}'s essays collection` : `${site.title} 的随笔`
    }
    empty={essaysData.length === 0}
    emptyEmoji="📝"
    emptyTitle={isEn ? "No essays yet" : "暂无随笔"}
>
    <DynamicIcon name="tabler:message-circle" slot="icon" />
    <div class="essay-masonry">
        {essaysData.map((item) => <EssayItem item={item} />)}
    </div>
    <Author />
</SectionPage>

<style>
    .essay-masonry {
        columns: 1;
        column-gap: 0;
    }

    @media (min-width: 768px) {
        .essay-masonry {
            columns: 2;
            column-gap: 1rem;
        }
    }
</style>
