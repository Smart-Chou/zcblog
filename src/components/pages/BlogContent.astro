---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Author from "~/components/ui/Author.astro";
import PostCard from "~/components/Article/PostCard.astro";
import Pagination from "~/components/ui/Pagination.astro";
import BackToTop from "~/components/Layout/BackToTop.astro";
import Hitokoto from "~/components/ui/Hitokoto.astro";
import { site, pageView, imageService } from "~/config";

interface PostData {
    slug: string;
    data: {
        title: string;
        pubDate: Date;
        tags?: string[];
        image?: { url?: string; alt?: string };
        description?: string;
    };
    wordCount: number;
    readTime: string;
    modifiedTime: Date | string;
    excerpt: string;
    sticky?: number;
}

interface Props {
    locale?: string;
    page: {
        data: PostData[];
        url: { prev?: string; next?: string };
        currentPage: number;
        lastPage: number;
    };
}

const { locale = "zh", page } = Astro.props;
const postsWithMeta = page.data;
const blogPath = locale === "en" ? "/en/blog" : "/blog";
const prevUrl = page.url.prev ? new URL(page.url.prev, Astro.site).toString() : undefined;
const nextUrl = page.url.next ? new URL(page.url.next, Astro.site).toString() : undefined;
---

<BaseLayout
    title={`${site.subtitle} -  ${site.title}`}
    description={`${site.title} - ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={site.coverImageAlt}
    keywords={site.keywords}
    publishedTime={new Date()}
    modifiedTime={new Date()}
    prevUrl={prevUrl}
    nextUrl={nextUrl}
    locale={locale}
    noindex={page.currentPage > 1}
>
    <Hitokoto />
    <Author />
    <div class="post">
        {
            postsWithMeta.map((post, index: number) => (
                <PostCard
                    key={post.slug}
                    title={post.data.title}
                    publishedTime={post.data.pubDate}
                    modifiedTime={post.modifiedTime}
                    postUrl={`/article/${post.slug}/`}
                    imagePath={
                        post.data.image?.url || `${imageService.baseUrl}${imageService.randomPath}`
                    }
                    description={post.excerpt}
                    tags={post.data.tags}
                    wordCount={post.wordCount}
                    readTime={post.readTime}
                    currentSlug={post.slug}
                    altText={post.data.image?.alt || "Blog Cover"}
                    loading={index < 3 ? "eager" : "lazy"}
                    sticky={post.sticky}
                />
            ))
        }
    </div>
    <Pagination page={page} blogPath={blogPath} />
    {pageView.backtotop && <BackToTop />}
</BaseLayout>

<script>
    import "~/utils/waline-pageview";
</script>
