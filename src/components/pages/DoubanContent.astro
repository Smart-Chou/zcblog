---
import SectionPage from "~/components/Layout/SectionPage.astro";
import DoubanCard from "~/components/douban/DoubanCard.astro";
import type { DoubanItem } from "~/components/douban/DoubanCard.astro";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import Author from "~/components/ui/Author.astro";
import { site } from "~/self.config";
import books from "~/data/douban-books.json";
import movies from "~/data/douban-movies.json";
import music from "~/data/douban-music.json";

interface Props {
  locale?: "zh" | "en";
}

const { locale = "zh" } = Astro.props;
const isEn = locale === "en";

const t = {
  zh: {
    title: "豆瓣",
    subtitle: "我的书影音记录",
    description: `${site.title} 的豆瓣书影音`,
    empty: "暂无数据，请先运行",
    emptyHint: "获取豆瓣数据",
    tabs: { book: "书籍", movie: "影视", music: "音乐" },
    status: {
      wish: "想看",
      watching: "在看",
      watched: "看过",
      reading: "在读",
      read: "读过",
      listening: "在听",
      listened: "听过",
    } as Record<string, string>,
  },
  en: {
    title: "Douban",
    subtitle: "My books, movies & music",
    description: `${site.title}'s Douban collection`,
    empty: "No data yet. Run",
    emptyHint: "to fetch data",
    tabs: { book: "Books", movie: "Movies", music: "Music" },
    status: {
      wish: "Wishlist",
      watching: "Watching",
      watched: "Watched",
      reading: "Reading",
      read: "Read",
      listening: "Listening",
      listened: "Listened",
    } as Record<string, string>,
  },
}[locale];

interface Tab {
  id: string;
  name: string;
  items: DoubanItem[];
}

const tabs: Tab[] = [
  { id: "book", name: t.tabs.book, items: books as DoubanItem[] },
  { id: "movie", name: t.tabs.movie, items: movies as DoubanItem[] },
  { id: "music", name: t.tabs.music, items: music as DoubanItem[] },
].filter((tab) => tab.items.length > 0);

const hasData = tabs.length > 0;
---

<SectionPage
  title={t.title}
  subtitle={t.subtitle}
  description={t.description}
  fullWidth
>
  <DynamicIcon name="mingcute:book-3-line" slot="icon" />

  {
    !hasData ? (
      <div class="empty-state">
        <p>{t.empty} <code>pnpm run fetch-douban</code> {t.emptyHint}</p>
      </div>
    ) : (
      <>
        <div class="tab-nav">
          <nav class="tab-buttons">
            {tabs.map((tab) => (
              <button
                class:list={["tab-btn", { active: tab.id === tabs[0].id }]}
                data-tab={tab.id}
                type="button"
              >
                {tab.name}
                <span class="count">({tab.items.length})</span>
              </button>
            ))}
          </nav>
        </div>

        {tabs.map((tab) => (
          <div
            class:list={["tab-section", { hidden: tab.id !== tabs[0].id }]}
            data-section={tab.id}
          >
            <div class="douban-grid">
              {tab.items.map((item) => (
                <DoubanCard
                  item={item}
                  statusLabel={t.status[item.status] || ""}
                />
              ))}
            </div>
          </div>
        ))}
      </>
    )
  }

  <Author />
</SectionPage>

<script>
  function initDoubanTabs() {
    const buttons = document.querySelectorAll("[data-tab]");
    const sections = document.querySelectorAll("[data-section]");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-tab");
        buttons.forEach((b) =>
          b.classList.toggle("active", b.getAttribute("data-tab") === target)
        );
        sections.forEach((s) => {
          const el = s as HTMLElement;
          const match = el.getAttribute("data-section") === target;
          el.classList.toggle("hidden", !match);
        });
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDoubanTabs);
  } else {
    initDoubanTabs();
  }
  document.addEventListener("astro:page-load", initDoubanTabs);
</script>

<style>
  .tab-nav {
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
  }

  .tab-buttons {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
  }

  .tab-btn {
    padding: 12px 16px;
    border: none;
    background: transparent;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-body);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all var(--duration-normal) var(--ease-out);
    white-space: nowrap;
  }

  .tab-btn:hover {
    color: var(--color-link);
  }

  .tab-btn.active {
    color: var(--color-link);
    border-bottom-color: var(--color-link);
  }

  .count {
    font-size: 0.8rem;
    opacity: 0.7;
    margin-left: 4px;
  }

  .tab-section.hidden {
    display: none;
  }

  .douban-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .douban-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--color-body);
    opacity: 0.7;
  }

  .empty-state code {
    background: var(--color-surface-hover);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.85rem;
  }
</style>
