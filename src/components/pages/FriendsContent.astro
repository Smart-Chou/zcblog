---
import SectionPage from "~/components/Layout/SectionPage.astro";
import WalineComment from "~/components/ui/WalineComment.astro";
import FriendPill from "~/components/ui/FriendPill.astro";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import friendsList from "~/data/friends.json";
import { site, author, friendsPage } from "~/config";
import siteAvatar from "~/assets/logo.svg";

interface Props {
    locale?: string;
}

const siteInfo = {
    name: site.title,
    description: site.subtitle,
    link: site.url,
    avatar: `${site.url}/${author.avatar}`,
};
---

<SectionPage
    title={friendsPage.title}
    subtitle=""
    description={`${friendsPage.title} - ${friendsPage.note}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={friendsPage.title}
    keywords={["Friends"]}
    publishedTime={new Date()}
    modifiedTime={new Date()}
>
    <DynamicIcon name="tabler:user-circle" slot="icon" />

    <div class="friends-container text-center space-bottom">
        {
            friendsList.map((friend) => (
                <FriendPill
                    name={friend.id}
                    url={friend.link}
                    avatar={friend.avatar}
                    style={friend.style}
                />
            ))
        }
    </div>

    <p class="friends-note">
        {friendsPage.note}
    </p>

    <div class="friends-apply-grid">
        <!-- 左侧：本站信息 -->
        <div class="apply-card">
            <div class="card-body">
                <div class="site-info-header">
                    <div class="site-avatar-wrap">
                        <img
                            src={siteAvatar.src}
                            alt={siteInfo.name}
                            class="site-avatar"
                            width={48}
                            height={48}
                            loading="lazy"
                            decoding="async"
                        />
                        <span class="verified-badge">
                            <DynamicIcon
                                name="tabler:circle-check"
                                width="12"
                                height="12"
                            />
                        </span>
                    </div>
                    <div>
                        <h3 class="site-name">{siteInfo.name}</h3>
                        <p class="site-desc">{siteInfo.description}</p>
                    </div>
                </div>

                <div class="info-fields">
                    {
                        Object.entries({
                            站点名称: siteInfo.name,
                            站点描述: siteInfo.description,
                            站点链接: siteInfo.link,
                            头像链接: siteInfo.avatar,
                        }).map(([label, value]) => (
                            <div class="info-field">
                                <div class="field-text">
                                    <span class="field-label">{label}</span>
                                    <span class="field-value">{value}</span>
                                </div>
                                <button
                                    class="copy-btn"
                                    data-copy={value}
                                    title="复制"
                                >
                                    <DynamicIcon
                                        name="tabler:copy"
                                        class="copy-icon"
                                    />
                                    <DynamicIcon
                                        name="tabler:check"
                                        class="check-icon"
                                    />
                                </button>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- 右侧：申请步骤 -->
        <div class="apply-card">
            <div class="card-body">
                <h3 class="steps-title">
                    <span class="steps-icon">
                        <DynamicIcon
                            name="tabler:checklist"
                            width="14"
                            height="14"
                        />
                    </span>
                    申请友链
                </h3>

                <div class="steps-list">
                    <div class="step frist">
                        <div class="step-marker">
                            <span class="step-num">1</span>
                            <div class="step-line"></div>
                        </div>
                        <div class="step-content">
                            <p class="step-heading">添加本站友链</p>
                            <p class="step-desc">
                                请先在您的网站友链页面添加本站信息，可直接复制左侧各字段
                            </p>
                        </div>
                    </div>

                    <div class="step">
                        <div class="step-marker">
                            <span class="step-num">2</span>
                            <div class="step-line"></div>
                        </div>
                        <div class="step-content">
                            <p class="step-heading">评论区提交申请</p>
                            <p class="step-desc">
                                复制下方模板，修改后粘贴到评论区
                            </p>
                            <div class="template-box">
                                <button
                                    class="copy-btn template-copy"
                                    data-copy="站点名称：您的站点名称
站点描述：您的站点描述
站点链接：您的站点链接
头像链接：您的站点头像"
                                    title="复制模板"
                                >
                                    <DynamicIcon
                                        name="tabler:copy"
                                        class="copy-icon"
                                    />
                                    <DynamicIcon
                                        name="tabler:check"
                                        class="check-icon"
                                    />
                                </button>
                                <pre><code>站点名称：您的站点名称
站点描述：您的站点描述
站点链接：您的站点链接
头像链接：您的站点头像</code></pre>
                            </div>
                        </div>
                    </div>

                    <div class="step">
                        <div class="step-marker">
                            <span class="step-num">3</span>
                        </div>
                        <div class="step-content">
                            <p class="step-heading">等待审核</p>
                            <p class="step-desc">
                                确认信息无误后会尽快添加您的友链
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 注意事项 -->
    <div class="notes-card">
        <h3 class="notes-title">
            <DynamicIcon name="tabler:alert-triangle" width="16" height="16" />
            注意事项
        </h3>
        <div class="notes-list">
            <div class="note-item">
                <span class="note-dot"></span>
                <p>
                    <strong>互换原则</strong
                    >：请先将本站添加到您的友链页面，确认后会添加您的友链
                </p>
            </div>
            <div class="note-item">
                <span class="note-dot"></span>
                <p>
                    <strong>链接维护</strong
                    >：友链网站长期无法访问或内容违规，将会被移除
                </p>
            </div>
            <div class="note-item">
                <span class="note-dot"></span>
                <p>
                    <strong>内容要求</strong
                    >：内容积极向上，不含有任何色情/反动/暴力等违法违规内容
                </p>
            </div>
            <div class="note-item">
                <span class="note-dot"></span>
                <p>
                    <strong>站点要求</strong>：支持
                    HTTPS，以原创内容为主，能够正常访问且有持续更新
                </p>
            </div>
        </div>
    </div>

    <WalineComment />
</SectionPage>

<style is:global>
    .friends-container {
        max-width: var(--content-width);
        margin-left: auto;
        margin-right: auto;
    }

    .friends-note {
        margin: var(--space-md) 0 var(--space-lg);
        font-size: var(--text-sm);
        color: var(--color-muted);
        text-align: center;
        font-style: italic;
        letter-spacing: 0.02em;
    }

    /* =========================================
       双栏布局 — Apply Grid
       ========================================= */
    .friends-apply-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-lg);
        max-width: 900px;
        margin: var(--space-xl) auto;
    }

    .friends-apply-grid h3,
    .friends-apply-grid p {
        margin: 0;
    }

    @media (max-width: 768px) {
        .friends-apply-grid {
            grid-template-columns: 1fr;
            gap: var(--space-md);
            margin: var(--space-lg) auto;
        }
    }

    /* =========================================
       Card Base
       ========================================= */
    .apply-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        transition:
            box-shadow var(--duration-normal) var(--ease-out),
            border-color var(--duration-normal) var(--ease-out);
    }

    .apply-card:hover {
        box-shadow: var(--shadow-md);
        border-color: rgba(194, 65, 59, 0.15);
    }

    .card-body {
        padding: var(--space-lg);
    }

    @media (max-width: 450px) {
        .card-body {
            padding: var(--space-md);
        }
    }

    /* =========================================
       左侧卡片 — 本站信息
       ========================================= */
    .site-info-header {
        display: flex;
        align-items: center;
        gap: var(--space-md);
        margin-bottom: var(--space-lg);
        padding-bottom: var(--space-md);
        border-bottom: 1px solid var(--color-border);
    }

    .site-avatar-wrap {
        position: relative;
        flex-shrink: 0;
    }

    .site-avatar {
        width: 56px;
        height: 56px;
        border-radius: var(--radius-lg);
        object-fit: cover;
        box-shadow: var(--shadow-xs);
        border: 2px solid var(--color-surface);
        outline: 1px solid var(--color-border);
    }

    .verified-badge {
        position: absolute;
        bottom: -4px;
        right: -4px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: var(--color-success);
        border: 2px solid var(--color-surface);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
    }

    .site-name {
        font-size: var(--text-base);
        font-weight: 700;
        color: var(--color-title);
        line-height: var(--leading-snug);
    }

    .site-desc {
        font-size: var(--text-xs);
        color: var(--color-muted);
        margin-top: 2px;
        line-height: 1.4;
    }

    /* ---- Info Fields ---- */
    .info-fields {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }

    .info-field {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-sm);
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--radius-md);
        background: var(--color-surface-secondary);
        border: 1px solid transparent;
        transition:
            background var(--duration-fast) var(--ease-out),
            border-color var(--duration-fast) var(--ease-out);
    }

    .info-field:hover {
        background: var(--color-selection);
        border-color: rgba(194, 65, 59, 0.12);
    }

    .field-text {
        min-width: 0;
    }

    .field-label {
        display: block;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-muted);
        margin-bottom: 2px;
    }

    .field-value {
        display: block;
        font-size: var(--text-xs);
        font-weight: 500;
        color: var(--color-body);
        font-family: var(--font-mono);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* ---- Copy Buttons ---- */
    .copy-btn {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-muted);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all var(--duration-fast) var(--ease-out);
    }

    .copy-btn:hover {
        color: var(--color-link);
        border-color: var(--color-link);
        background: rgba(194, 65, 59, 0.04);
    }

    .copy-btn:active {
        transform: scale(0.94);
    }

    .copy-btn.copied {
        color: var(--color-success);
        border-color: var(--color-success);
        background: rgba(77, 124, 77, 0.08);
    }

    .copy-btn.copied .copy-icon,
    .copy-btn:not(.copied) .check-icon {
        display: none;
    }

    /* =========================================
       右侧卡片 — 申请步骤
       ========================================= */
    .steps-title {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        font-size: var(--text-base);
        font-weight: 700;
        color: var(--color-title);
        margin-bottom: var(--space-lg);
        padding-bottom: var(--space-md);
        border-bottom: 1px solid var(--color-border);
    }

    .steps-icon {
        width: 30px;
        height: 30px;
        border-radius: var(--radius-md);
        background: rgba(194, 65, 59, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-link);
    }

    .steps-icon svg {
        width: 15px;
        height: 15px;
    }

    .steps-list {
        display: flex;
        flex-direction: column;
    }

    .step {
        display: flex;
        gap: var(--space-sm);
    }

    .step.frist {
        margin-top: 1rem;
    }

    .step:last-child .step-content {
        padding-bottom: 0;
    }

    .step-marker {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
    }

    .step-num {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 2px solid var(--color-border);
        background: var(--color-surface);
        color: var(--color-muted);
        font-size: 11px;
        font-weight: 700;
        font-family: var(--font-mono);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition:
            border-color var(--duration-normal) var(--ease-out),
            color var(--duration-normal) var(--ease-out),
            background var(--duration-normal) var(--ease-out);
    }

    .step:first-child .step-num {
        border-color: var(--color-link);
        color: var(--color-link);
        background: rgba(194, 65, 59, 0.06);
    }

    .step-line {
        width: 1.5px;
        flex: 1;
        min-height: 18px;
        background: var(--color-border);
        margin: 4px 0;
        border-radius: 1px;
        transition: background var(--duration-normal) var(--ease-out);
    }

    .step:first-child .step-line {
        background: rgba(194, 65, 59, 0.2);
    }

    .step-content {
        padding-bottom: var(--space-md);
        min-width: 0;
    }

    .step-heading {
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--color-title);
        margin-bottom: 3px;
        line-height: var(--leading-snug);
    }

    .step-desc {
        font-size: var(--text-xs);
        color: var(--color-muted);
        line-height: 1.6;
    }

    /* ---- Template Box ---- */
    .template-box {
        position: relative;
        margin-top: var(--space-sm);
        border-radius: var(--radius-md);
        background: var(--color-surface-secondary);
        border: 1px solid var(--color-border);
        border-left: 3px solid var(--color-link);
        overflow: hidden;
        transition: border-color var(--duration-fast) var(--ease-out);
    }

    .template-box:hover {
        border-color: rgba(194, 65, 59, 0.2);
    }

    .template-box pre {
        margin: 0;
        padding: var(--space-sm);
        padding-right: 40px;
        overflow-x: auto;
    }

    .template-box code {
        font-size: 11px;
        font-family: var(--font-mono);
        color: var(--color-body);
        line-height: 1.8;
        white-space: pre;
    }

    .template-copy {
        position: absolute;
        top: var(--space-xs);
        right: var(--space-xs);
        width: 28px;
        height: 28px;
        border-radius: var(--radius-sm);
        border: 1px solid transparent;
        background: transparent;
        color: var(--color-muted);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all var(--duration-fast) var(--ease-out);
    }

    .template-copy:hover {
        color: var(--color-link);
        background: rgba(194, 65, 59, 0.06);
    }

    .template-copy:active {
        transform: scale(0.94);
    }

    .template-copy.copied {
        color: var(--color-success);
    }

    .template-copy.copied .copy-icon,
    .template-copy:not(.copied) .check-icon {
        display: none;
    }

    /* =========================================
       注意事项 — Notes Card
       ========================================= */
    .notes-card {
        max-width: 900px;
        margin: var(--space-xl) auto 0;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        padding: var(--space-lg);
    }

    .notes-card h3,
    .notes-card p {
        margin: 0;
    }

    .notes-title {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        font-size: var(--text-base);
        font-weight: 700;
        color: var(--color-title);
        margin-bottom: var(--space-md);
        padding-bottom: var(--space-sm);
        border-bottom: 1px solid var(--color-border);
    }

    .notes-title svg {
        color: var(--color-warning);
        flex-shrink: 0;
    }

    .notes-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }

    .note-item {
        display: flex;
        align-items: baseline;
        gap: var(--space-sm);
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--radius-md);
        font-size: var(--text-sm);
        color: var(--color-body);
        line-height: 1.6;
        transition: background var(--duration-fast) var(--ease-out);
    }

    .note-item:hover {
        background: var(--color-hover);
    }

    .note-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--color-warning);
        flex-shrink: 0;
        margin-top: 0.6em;
        box-shadow: 0 0 0 2px rgba(176, 128, 60, 0.15);
    }

    .note-item strong {
        color: var(--color-title);
        font-weight: 600;
    }
</style>

<script>
    document.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
            "[data-copy]",
        );
        if (!btn) return;

        const text = btn.dataset.copy || "";
        navigator.clipboard.writeText(text).then(() => {
            btn.classList.add("copied");
            setTimeout(() => btn.classList.remove("copied"), 1500);
        });
    });
</script>
