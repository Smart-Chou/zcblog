---
import SectionPage from "~/components/Layout/SectionPage.astro";
import Author from "~/components/ui/Author.astro";
import WalineComment from "~/components/ui/WalineComment.astro";
import FriendPill from "~/components/ui/FriendPill.astro";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import { site, friendsPage } from "~/self.config";

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const isEn = locale === "en";
---

<SectionPage
    title={friendsPage.title}
    subtitle=""
    description={`${friendsPage.title} - ${friendsPage.note}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={friendsPage.title}
    keywords={["Friends"]}
    publishedTime={new Date()}
    modifiedTime={new Date()}
>
    <DynamicIcon name="tabler:user-circle" slot="icon" />

    <div class="friends-container text-center space-bottom">
        {
            friendsPage.list.map((friend) => (
                <FriendPill
                    name={friend.id}
                    url={friend.link}
                    avatar={friend.avatar}
                    style={friend.style}
                />
            ))
        }
    </div>
    <p class="friends-note">
        * I don't accept friend link requests from someone I don't know.
    </p>
    <Author />
    <WalineComment />
</SectionPage>

<style>
    .friends-container {
        max-width: var(--content-width);
        margin-left: auto;
        margin-right: auto;
    }

    .friends-note {
        margin: calc(var(--space) / 2) 0;
        font-size: 0.9em;
        opacity: 0.8;
        text-align: center;
    }
</style>
