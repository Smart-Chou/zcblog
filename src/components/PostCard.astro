---
import PostLayout from "~/layouts/PostLayout.astro";
import PostTag from "~/components/PostTag.astro";
import PostMeta from "~/components/PostMeta.astro";
import PostCardImage from "~/components/PostCardImage.astro";
import { Icon } from "astro-icon/components";

const {
    altText,
    imagePath,
    title,
    description,
    publishedTime,
    tags,
    postUrl,
    wordCount,
    readTime,
    currentSlug,
    loading,
    sticky,
} = Astro.props;
const isDefaultImage = /^https:\/\/pic\.mcc\.im\/images(\?.*)?$/.test(
    imagePath,
);
const isRemoteImage = /^https?:\/\//.test(imagePath);

// Generate random string for unique image URLs
const generateRandomString = (length = 10) => {
    const chars =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
    let result = "";
    for (let i = 0; i < length; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return result;
};

// Get random image URL with unique parameter
const getRandomImageUrl = () => {
    return `https://pic.mcc.im/images?${generateRandomString()}`;
};
---

<PostLayout>
    <div class="post-card__header">
        {
            isDefaultImage ? (
                <img
                    src={getRandomImageUrl()}
                    alt={altText}
                    class="post-card__image"
                    loading={loading || "lazy"}
                    width={800}
                    height={450}
                />
            ) : isRemoteImage ? (
                <img
                    src={imagePath}
                    alt={altText}
                    class="post-card__image"
                    loading={loading || "lazy"}
                    width={800}
                    height={450}
                />
            ) : (
                <PostCardImage
                    imagePath={imagePath}
                    altText={altText}
                    loading={loading}
                />
            )
        }
        {
            sticky > 0 && (
                <Icon
                    name="tabler:flame"
                    style="color:red; position: absolute;top: 10px; right: 10px; width: 30px; height: 30px;"
                />
            )
        }
    </div>
    <h2 class="post-card__title">{title}</h2>
    <p class="post-card__description">{description}</p>
    <PostMeta
        publishedTime={publishedTime}
        wordCount={wordCount}
        readTime={readTime}
        currentSlug={currentSlug}
    />
    <div class="post-tags post-card__tags">
        {tags.map((tag: string) => <PostTag tag={tag} url={`/tag/${tag}/`} />)}
    </div>
    <a href={postUrl} class="post-card__link">Link</a>
</PostLayout>

<style>
    .post-card__header {
        margin: calc(var(--space) * -1) calc(var(--space) * -1)
            calc(var(--space) / 2);
        overflow: hidden;
        border-radius: var(--radius) var(--radius) 0 0;
        position: relative;
        display: inline-block;
    }

    .post-card__header:empty {
        display: none;
    }

    .post-card__header img {
        display: block;
    }
</style>
