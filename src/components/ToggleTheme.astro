---
import { Icon } from "astro-icon/components";
---

<button
    id="theme-btn"
    role="button"
    aria-label="Toggle dark/light"
    class="toggle-theme"
>
    <Icon name="tabler:sun" class="feather feather-sun" />
    <Icon name="tabler:moon-stars" class="feather feather-moon" />
</button>

<script is:inline>
    // 统一处理主题设置的函数
    function setPreferredTheme(theme) {
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("preferredTheme", theme);

        // 更新类名以支持CSS选择器
        if (theme === "dark") {
            document.documentElement.classList.add("dark");
        } else {
            document.documentElement.classList.remove("dark");
        }
    }

    // 页面加载时初始化主题按钮状态
    document.addEventListener("astro:page-load", () => {
        const themeBtn = document.getElementById("theme-btn");

        // 切换主题按钮事件
        if (themeBtn) {
            themeBtn.addEventListener("click", () => {
                const currentTheme =
                    document.documentElement.getAttribute("data-theme");
                const newTheme = currentTheme === "dark" ? "light" : "dark";
                setPreferredTheme(newTheme);
            });
        }
    });

    // 视图过渡后恢复主题状态
    document.addEventListener("astro:after-swap", () => {
        const preferredTheme =
            localStorage.getItem("preferredTheme") || "light";
        setPreferredTheme(preferredTheme);
    });
</script>

<style>
    [data-icon="tabler:sun"] {
        width: 30px;
        height: 30px;
    }

    [data-icon="tabler:moon-stars"] {
        width: 30px;
        height: 24px;
    }
</style>
