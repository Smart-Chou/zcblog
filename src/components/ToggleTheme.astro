---
import SunIcon from "~/components/icons/Sun.astro";
import MoonIcon from "~/components/icons/Moon.astro";
---

<button
    id="theme-btn"
    role="button"
    aria-label="切换主题"
    aria-pressed="false"
    class="toggle-theme"
    tabindex="0"
>
    <SunIcon class="feather feather-sun" />
    <MoonIcon class="feather feather-moon" />
</button>

<script is:inline>
    (function() {
        const STORAGE_KEY = 'preferredTheme';
        
        const getStoredTheme = () => {
            if (typeof localStorage === 'undefined') return null;
            return localStorage.getItem(STORAGE_KEY);
        };
        
        const getSystemTheme = () => {
            return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        
        const getCurrentTheme = () => {
            return getStoredTheme() || getSystemTheme();
        };
        
        const setTheme = (theme) => {
            const root = document.documentElement;
            
            if (theme === 'dark') {
                root.classList.add('dark');
                root.setAttribute('data-theme', 'dark');
            } else {
                root.classList.remove('dark');
                root.setAttribute('data-theme', 'light');
            }
            
            if (typeof localStorage !== 'undefined') {
                localStorage.setItem(STORAGE_KEY, theme);
            }
            
            updateButton(theme);
        };
        
        const updateButton = (theme) => {
            const btn = document.getElementById('theme-btn');
            if (!btn) return;
            
            const isDark = theme === 'dark';
            btn.setAttribute('data-theme', theme);
            btn.setAttribute('aria-label', isDark ? '切换为浅色模式' : '切换为深色模式');
            btn.setAttribute('aria-pressed', isDark.toString());
        };
        
        const toggleTheme = () => {
            const currentTheme = getCurrentTheme();
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            setTheme(newTheme);
        };
        
        const initThemeToggle = () => {
            const currentTheme = getCurrentTheme();
            setTheme(currentTheme);
            
            const btn = document.getElementById('theme-btn');
            if (!btn) return;
            
            if (!btn.dataset.initialized) {
                btn.addEventListener('click', toggleTheme);
                
                btn.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        toggleTheme();
                    }
                });
                
                btn.dataset.initialized = 'true';
            }
        };
        
        // 使用 window 属性跨页面持久化，防止 View Transitions 导致重复注册监听器
        if (!window.__themeInitialized) {
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
                if (!getStoredTheme()) {
                    setTheme(e.matches ? 'dark' : 'light');
                }
            });
            window.__themeInitialized = true;
        }
        
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initThemeToggle);
        } else {
            initThemeToggle();
        }
        
        document.addEventListener('astro:page-load', initThemeToggle);
    })();
</script>

<style>
    .toggle-theme {
        background: none;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        border-radius: 50%;
        transition: all 0.3s ease;
    }

    /* 仅对鼠标点击隐藏焦点框，键盘导航时保留可见焦点（WCAG 2.1 AA 标准） */
    .toggle-theme:focus:not(:focus-visible) {
        outline: none;
    }

    .toggle-theme:hover {
        background-color: rgba(0, 0, 0, 0.1);
        transform: scale(1.1);
        opacity: 0.8;
    }

    .toggle-theme .feather {
        transition: all 0.3s ease;
    }

    .toggle-theme .feather-sun {
        display: none;
        width: 30px;
        height: 30px;
        color: #f59e0b;
    }

    .toggle-theme .feather-moon {
        display: block;
        width: 30px;
        height: 24px;
        color: #3b82f6;
    }

    .toggle-theme[data-theme="dark"] .feather-sun {
        display: block;
    }

    .toggle-theme[data-theme="dark"] .feather-moon {
        display: none;
    }
</style>
