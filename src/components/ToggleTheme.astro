---
import { Icon } from "astro-icon/components";
---

<button
    id="theme-btn"
    role="button"
    aria-label="Toggle dark/light"
    class="toggle-theme"
>
    <Icon name="tabler:sun" class="feather feather-sun" />
    <Icon name="tabler:moon-stars" class="feather feather-moon" />
</button>

<script>
    document.addEventListener("astro:page-load", () => {
        const themeBtn = document.getElementById("theme-btn");

        function setPreferredTheme(theme) {
            document.documentElement.setAttribute("data-theme", theme);
            localStorage.setItem("preferredTheme", theme);
        }

        // Initialize theme based on localStorage
        const preferredTheme =
            localStorage.getItem("preferredTheme") || "light";
        setPreferredTheme(preferredTheme);

        // Toggle theme function
        if (themeBtn) {
            themeBtn.addEventListener("click", () => {
                const currentTheme =
                    document.documentElement.getAttribute("data-theme");
                const newTheme = currentTheme === "dark" ? "light" : "dark";
                setPreferredTheme(newTheme);
            });
        }
    });
</script>

<script>
    document.addEventListener("astro:after-swap", () => {
        const preferredTheme =
            localStorage.getItem("preferredTheme") || "light";
        document.documentElement.setAttribute("data-theme", preferredTheme);
        if (preferredTheme === "dark") {
            document.documentElement.classList.add("dark");
        } else {
            document.documentElement.classList.remove("dark");
        }
    });
</script>

<style>
    [data-icon="tabler:sun"] {
        width: 30px;
        height: 30px;
    }

    [data-icon="tabler:moon-stars"] {
        width: 30px;
        height: 24px;
    }
</style>
