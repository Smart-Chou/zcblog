---
import { Icon } from 'astro-icon/components';
---

<div class="header__right">
  <button id="theme-btn" role="button" aria-label="Toggle dark/light" class="toggle-theme">
    <Icon name="tabler:sun" class="feather feather-sun"/>
    <Icon name="tabler:moon-stars" class="feather feather-moon"/>
  </button>
</div>

<script is:inline>
  // Add dark / light detection that runs before Vue.js load. Borrowed from overreacted.io
  function __setPreferredTheme(theme) {
    document.body.setAttribute('data-theme', theme)
    localStorage.setItem('preferredTheme', theme)
  }

  // 从 localStorage 获取首选主题
  const preferredTheme = localStorage.getItem('preferredTheme') || 'light'
  __setPreferredTheme(preferredTheme)

  // 主题切换功能
  const themeBtn = document.getElementById('theme-btn')
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const currentTheme = document.body.getAttribute('data-theme')
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark'
      __setPreferredTheme(newTheme)
    })
  }
</script>

<style>
  [data-icon="tabler:sun"] {
    width: 30px;
    height: 30px;
  }
  
  [data-icon="tabler:moon-stars"] {
    width: 30px;
    height: 24px;
  }
</style>