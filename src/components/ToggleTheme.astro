---
import SunIcon from "~/components/icons/Sun.astro";
import MoonIcon from "~/components/icons/Moon.astro";
import { useTheme } from "~/hooks/useTheme";

const themeManager = useTheme();
const isDark = themeManager.isDark;
---

<button
    id="theme-btn"
    role="button"
    aria-label={isDark ? "切换为浅色模式" : "切换为深色模式"}
    aria-pressed={isDark}
    class="toggle-theme"
    data-theme={isDark ? "dark" : "light"}
    tabindex="0"
>
    <SunIcon class="feather feather-sun" />
    <MoonIcon class="feather feather-moon" />
</button>

<script>
    import { useTheme } from "~/hooks/useTheme";

    document.addEventListener("astro:page-load", () => {
        const theme = useTheme();

        const updateButtonState = () => {
            const themeBtn = document.getElementById("theme-btn");
            if (themeBtn) {
                const isDark = theme.isDark;
                themeBtn.setAttribute("data-theme", isDark ? "dark" : "light");
                themeBtn.setAttribute(
                    "aria-label",
                    isDark ? "切换为浅色模式" : "切换为深色模式",
                );
                themeBtn.setAttribute("aria-pressed", isDark.toString());
            }
        };

        updateButtonState();

        const themeBtn = document.getElementById("theme-btn");
        if (themeBtn) {
            const handleToggle = () => {
                theme.toggleTheme();
                updateButtonState();
            };

            themeBtn.addEventListener("click", handleToggle);

            themeBtn.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    handleToggle();
                }
            });
        }
    });
</script>

<style>
    .toggle-theme {
        background: none;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        border-radius: 50%;
        transition: all 0.3s ease;
    }

    .toggle-theme:focus {
        outline: none;
    }

    .toggle-theme:hover {
        background-color: rgba(0, 0, 0, 0.1);
        transform: scale(1.1);
        opacity: 0.8;
    }

    .toggle-theme .feather {
        transition: all 0.3s ease;
    }

    .toggle-theme .feather-sun {
        display: block;
    }

    .toggle-theme .feather-moon {
        display: none;
    }

    .toggle-theme[data-theme="dark"] .feather-sun {
        display: none;
    }

    .toggle-theme[data-theme="dark"] .feather-moon {
        display: block;
    }

    [data-icon="tabler:sun"] {
        width: 30px;
        height: 30px;
        color: #f59e0b;
    }

    [data-icon="tabler:moon-stars"] {
        width: 30px;
        height: 24px;
        color: #3b82f6;
    }
</style>
