---
import HeartIcon from "~/components/icons/Heart.astro";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import { donate } from "~/self.config";
---

<style>
    @keyframes fade-up {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .donate {
        margin-top: 3.5rem;
    }

    @media screen and (max-width: 650px) {
        .donate {
            display: none;
        }
    }

    .donate .reward {
        position: relative;
        display: flex;
        justify-content: center;
        width: max-content;
        margin: 1rem auto;
        -webkit-user-select: none;
        user-select: none;
        cursor: pointer;
    }

    .donate .reward .reward-btn {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        height: 40px;
        width: 120px;
        border: none;
        border-radius: 8px;
        color: #fff;
        background-color: #ff3842;
        transition: box-shadow 0.5s;
        cursor: pointer;
    }

    .donate .modal {
        padding: 0;
        border: none;
        border-radius: 16px;
        background: transparent;
        overflow: visible;
        animation: fade-up 0.5s forwards;
        width: calc(100% - 40px);
        max-width: 430px;
    }

    .donate .modal::backdrop {
        background-color: var(--color-surface-translucent);
    }

    .donate .modal .modal-main {
        padding: 0;
        overflow: hidden;
        border-radius: 16px;
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        box-shadow: 0 8px 16px -4px var(--shadow-sm);
    }

    .donate .modal .modal-main .header-title {
        position: relative;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        font-size: 1.125rem;
        padding: 20px;
        height: 64px;
        background-color: var(--color-bg);
        border-bottom: 1px solid var(--color-border);
    }

    .donate .modal .modal-main .modal-content {
        max-height: calc(80vh - 46px);
        padding: 20px;
        overflow: auto;
    }

    .donate .modal .modal-main .header-title .title-left {
        display: inline-flex;
        align-items: center;
    }

    .donate .modal .modal-main .header-title .close {
        position: absolute;
        right: 20px;
        margin-right: 0;
        font-size: 1rem;
        border-radius: 8px;
        padding: 8px;
        background: none;
        border: none;
        transition: background-color 0.3s;
        cursor: pointer;
    }

    .donate .reward-card .thank {
        display: inline-flex;
        justify-content: center;
        margin-bottom: 1rem;
        width: 100%;
        color: var(--color-link);
        font-weight: 700;
    }

    .donate .reward-card .qr {
        display: grid;
        gap: 1rem;
        grid-template-columns: 1fr 1fr;
    }

    .donate .reward-card .qr .qr-img {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .donate .reward-card .qr .qr-img .tip {
        display: inline-flex;
        align-items: center;
    }
    .donate a {
        text-decoration: none;
        color: var(--color-link);
        transition: all 0.3s;
    }

    .donate .reward-card .all-list {
        margin-top: 20px;
        display: flex;
        align-items: center;
        flex-direction: column;
        background-color: var(--color-code-bg);
    }

    .donate .s-card {
        padding: 0.8rem;
        border-radius: 16px;
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
        box-shadow: 0 8px 16px -4px var(--shadow-sm);
        transition: all 0.3s;
        cursor: pointer;
    }

    .donate .reward-card .all-list .title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 8px;
        transition: color 0.3s;
    }

    .donate .reward-card .all-list .tip {
        text-align: center;
        font-size: 12px;
        opacity: 0.6;
        color: var(--color-code-fg);
    }
</style>

<div class="donate">
    <div class="reward">
        <button
            class="reward-btn"
            commandfor="donateDialog"
            command="show-modal"
        >
            <HeartIcon filled={true} />
            <span class="text">&nbsp;赞赏博主</span>
        </button>
    </div>
    <dialog id="donateDialog" class="modal">
        <div class="modal-main">
            <div class="header-title">
                <div class="title-left">
                    <HeartIcon filled={true} />
                    <span class="title-text">&nbsp;赞赏博主</span>
                </div>
                <button
                    class="close"
                    commandfor="donateDialog"
                    command="close"
                    aria-label="Close"
                >
                    &times;
                </button>
            </div>
            <div class="modal-content">
                <div class="reward-card">
                    <span class="thank">🙏 感谢您赐予我前进的力量</span>
                    <div class="qr">
                        <div class="qr-img">
                            <img
                                src={donate.wechatQRCode}
                                alt="微信支付"
                                loading="lazy"
                            />
                            <span class="tip"
                                ><DynamicIcon
                                    name="mingcute:wechat-pay-line"
                                />&nbsp;微信</span
                            >
                        </div>
                        <div class="qr-img">
                            <img
                                src={donate.alipayQRCode}
                                alt="支付宝支付"
                                loading="lazy"
                            />
                            <span class="tip"
                                ><DynamicIcon
                                    name="simple-icons:alipay"
                                />&nbsp;支付宝</span
                            >
                        </div>
                    </div>
                    <a href="/donate/" class="all-list-btn">
                        <div class="all-list s-card hover">
                            <span class="title">全部赞赏者名单</span>
                            <span class="tip">{donate.tip}</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </dialog>
</div>
