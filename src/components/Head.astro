---
import { ViewTransitions } from 'astro:transitions'
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Spencer Woo - Spencer&#x27;s Blog</title>
  <meta name="description" content="Astro builds fast content sites, powerful web applications, dynamic server APIs, and everything in-between." />
  <meta name="keywords" content="关键词1, 关键词2, 关键词3" />
  <meta name="author" content="作者名称" />
  <meta name="generator" content="Astro v4.9.2" />

  <!-- Open Graph -->
  <meta property="og:title" content="Astro" />
  <meta property="og:description" content="Astro builds fast content sites, powerful web applications, dynamic server APIs, and everything in-between." />
  <meta property="og:image" content="https://astro.build/og/astro.jpg" />
  <meta property="og:image:alt" content="Astro - Build the web you want." />
  <meta property="og:url" content="https://astro.build" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Astro" />
  <meta property="og:locale" content="en" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Astro" />
  <meta name="twitter:description" content="Astro builds fast content sites, powerful web applications, dynamic server APIs, and everything in-between." />
  <meta name="twitter:image" content="https://astro.build/og/astro.jpg" />
  <meta name="twitter:image:alt" content="Astro - Build the web you want." />
  <meta name="twitter:site" content="astrodotbuild" />

  <!-- 浏览器和搜索引擎相关 -->
  <meta name="robots" content="index, follow" />
  <meta http-equiv="Content-Language" content="en" />
  <meta name="theme-color" content="#8D46E7" />
  <meta name="x-astro-vitals-route" content="/" />
  <link rel="sitemap" href="https://astro.build/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" href="https://astro.build/rss.xml" title="RSS" />
  <link rel="canonical" href="https://marxchou.com" />

  <!-- Favicon -->
  <link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon.16x.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon.32x.png" />

  <!-- Umami Analytics -->
  <script is:inline src="https://umami.marxchou.com/script.js" defer data-website-id="73b29141-fccf-4d54-9c2f-f7d0d146f86b"></script>
  
  <ViewTransitions fallback="none" />
