---
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import { author, categories, socialLinks } from "~/self.config";
---

<div class="author">
    <img
        src={`/${author.avatar}`}
        alt="Author"
        class="author__image"
        width="180"
        loading="lazy"
        decoding="async"
    />
    <h1 class="author__site-title">{author.type}</h1>
    <p class="author__intro">{author.motto}</p>
    <p class="author__links">
        {
            categories.map((categorie) => (
                <a
                    href={categorie.url}
                    title={categorie.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={categorie.style}
                    aria-label={categorie.title}
                >
                    <DynamicIcon name={categorie.svg} />
                </a>
            ))
        }
    </p>
    <p class="author__links">
        {
            socialLinks.map((social) => (
                <a
                    data-key={`social-${social.title}`}
                    href={social.url}
                    target="_blank"
                    title={social.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={social.style}
                    aria-label={social.title}
                >
                    <DynamicIcon name={social.svg} />
                </a>
            ))
        }
    </p>
</div>

<style>
    .author {
        margin-top: 2rem;
        text-align: center;
        padding: calc(var(--space) / 2) 0;
    }

    .author__image {
        border-radius: 100%;
        width: 90px;
        height: 90px;
        margin-bottom: 1em;
    }

    .author__intro {
        opacity: 0.8;
    }

    .author__site-title {
        font-size: 1.5em;
    }

    .author__links {
        margin-top: -0.5em;
        font-size: 1em;
        display: flex;
        justify-content: center;
    }

    .author__links a {
        color: var(--link-color);
        margin: 0 0.5em;
        text-decoration: none;
    }
</style>
