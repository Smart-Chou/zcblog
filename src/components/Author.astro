---
import { Icon } from "astro-icon/components";
import { site, categories, socialLinks } from "~/self.config";
---

<div class="author">
    <img
        src={`${site.url}/${site.avatar}`}
        alt="Author"
        class="author__image"
        width="180"
    />
    <h1 class="author__site-title">{site.title}</h1>
    <p class="author__intro">{site.motto}</p>
    <p class="author__links">
        {
            categories.map((categorie) => (
                <a
                    href={categorie.url}
                    title={categorie.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={categorie.style}
                >
                    <Icon name={categorie.svg} />
                </a>
            ))
        }
        <span>/</span>
        {
            socialLinks.map((social) => (
                <a
                    data-key={`social-${social.title}`}
                    href={social.url}
                    target="_blank"
                    title={social.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={social.style}
                >
                    <Icon name={social.svg} />
                </a>
            ))
        }
    </p>
</div>
