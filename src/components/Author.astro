---
import { Icon } from 'astro-icon/components'
import { site, categories, socialLinks } from '~/self.config'
---

<div class="author">
  <img src={Astro.site + site.avatar} alt="Author" class="author__image" width="180" />
  <h1 class="author__site-title">Spencer's Blog</h1>
  <p class="author__intro">阿巴阿巴 o((&gt;ω&lt; ))o</p>
  <p class="author__links">
    {
      categories.map(categorie => (
        <a href={categorie.url} title={categorie.title} rel="noopener" class="has-tooltip active" style={categorie.style}>
          <Icon name={categorie.svg} />
        </a>
      ))
    }
    <span>/</span>
    {
      socialLinks.map(social => (
        <a href={social.url} target="_blank" title={social.title} rel="noopener" class="has-tooltip active" style={social.style}>
          <Icon name={social.svg} />
        </a>
      ))
    }
  </p>
</div>
