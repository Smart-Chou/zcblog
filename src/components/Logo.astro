---
import { site } from '~/self.config'
---

<div class="header__left">
  <span id="sitename"></span>
  <a class="logo" href="/">
    <span class="logo__text"><img src={Astro.site + site.logo} alt="Blog Logo" width="24"/>{site.title}</span>
  </a>
</div>

<style>
  .logo__text img {
    border-radius: 100%;
    margin-right: 0.5rem;
    vertical-align: middle;
  }
</style>