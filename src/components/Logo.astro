---
import { site } from "~/self.config";
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";
---

<span id="sitename"></span>
<a class="logo" href="/">
    <span class="logo__text">
        <Image 
            src={logo} 
            alt="Blog Logo" 
            width={24} 
            height={24}
            loading="eager" 
        />
        {site.title}
    </span>
</a>
