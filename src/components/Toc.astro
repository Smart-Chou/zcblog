---
import '~/styles/toc.css'
---

<div class="toc">
  <div class="toc__content"></div>
</div>

<script>
  import * as tocbot from 'tocbot'
  document.addEventListener('astro:page-load', () => {
    tocbot.init({
      tocSelector: '.toc__content',
      contentSelector: '.post',
      headingSelector: 'h2, h3',
    })
  })
</script>

<script>
  document.addEventListener('astro:page-load', () => {
    const tocContent = document.querySelector('.toc__content') as HTMLElement
    const post = document.querySelector('.post') as HTMLElement
    const author = document.querySelector('.author') as HTMLElement
    if (tocContent && post && author) {
      window.addEventListener('scroll', function () {
        const postBottom = post.getBoundingClientRect().bottom
        const authorTop = author.getBoundingClientRect().top
        const viewportHeight = window.innerHeight
        const tocContentHeight = tocContent ? tocContent.offsetHeight : 0 // Check if directory is not null

        if (postBottom <= viewportHeight) {
          tocContent.style.position = 'absolute'
          tocContent.style.top = window.scrollY + postBottom - tocContentHeight + 200 + 'px'
        } else if (authorTop <= viewportHeight) {
          tocContent.style.position = 'absolute'
          tocContent.style.top = window.scrollY + authorTop - tocContentHeight + 200 + 'px'
        } else {
          tocContent.style.position = 'fixed'
          tocContent.style.top = '500px'
        }
      })
    }
  })
</script>
