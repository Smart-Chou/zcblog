---
import '~/styles/toc.css'
---

<div class="toc">
    <div class="toc__content">
    </div>
</div>

<script>
    import * as tocbot from "tocbot";
    document.addEventListener('astro:page-load', () => {
        tocbot.init({
            tocSelector: '.toc__content',
            contentSelector: '.post',
            headingSelector: 'h2, h3',
        })
        
    })
</script>