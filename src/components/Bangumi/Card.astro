---
import MediaCard from "~/components/ui/MediaCard.astro";
import type { UserSubjectCollection } from "~/types/bangumi";

interface Props {
    item: UserSubjectCollection;
    loadImage?: boolean;
}

const { item, loadImage = false } = Astro.props;

const subject_base_url = "https://bgm.tv/subject/";

const getStatusColor = (type: number) => {
    switch (type) {
        case 1:
            return "var(--status-wish)";
        case 2:
            return "var(--status-watched)";
        case 3:
            return "var(--status-watching)";
        case 4:
            return "var(--status-on-hold)";
        case 5:
            return "var(--status-dropped)";
        default:
            return "var(--status-unknown)";
    }
};

const getStatusText = (type: number) => {
    const subjectType = item.subject.type;
    switch (type) {
        case 1:
            return subjectType === 1
                ? "想读"
                : subjectType === 3
                  ? "想听"
                  : subjectType === 4
                    ? "想玩"
                    : "想看";
        case 2:
            return subjectType === 1
                ? "读过"
                : subjectType === 3
                  ? "听过"
                  : subjectType === 4
                    ? "玩过"
                    : "看过";
        case 3:
            return subjectType === 1
                ? "在读"
                : subjectType === 3
                  ? "在听"
                  : subjectType === 4
                    ? "在玩"
                    : "在看";
        case 4:
            return "搁置";
        case 5:
            return "抛弃";
        default:
            return "未知";
    }
};

const displayTags =
    item.tags && item.tags.length > 0
        ? item.tags
        : (item.subject.tags || []).map((t: { name: string }) => t.name).slice(0, 5);
const visibleCoverTags = displayTags.slice(0, 3);
const hiddenCoverTagCount = Math.max(displayTags.length - visibleCoverTags.length, 0);
---

<MediaCard
    href={`${subject_base_url}${item.subject.id}`}
    image={loadImage ? item.subject?.images?.medium : undefined}
    dataSrc={loadImage ? undefined : item.subject?.images?.medium}
    alt={item.subject.name_cn || item.subject.name}
    aspectRatio="2/3"
    placeholderEmoji="📖"
    target="_blank"
    rel="noopener noreferrer nofollow"
>
    <div slot="badges" class="badges">
        <span class="status-badge" style={`background: ${getStatusColor(item.type)}`}>
            {getStatusText(item.type)}
        </span>
        {item.subject.score && <span class="score-badge">⭐ {item.subject.score}</span>}
    </div>
    <div slot="overlay">
        <h3 class="overlay-title">
            {item.subject.name_cn || item.subject.name}
        </h3>
        {item.subject.date && <p class="overlay-date">{item.subject.date.substring(0, 4)}</p>}
        {
            visibleCoverTags.length > 0 && (
                <div class="overlay-tags">
                    {visibleCoverTags.map((tag: string) => (
                        <span class="tag">{tag}</span>
                    ))}
                    {hiddenCoverTagCount > 0 && (
                        <span class="tag tag-more">+{hiddenCoverTagCount}</span>
                    )}
                </div>
            )
        }
    </div>
</MediaCard>

<style>
    .badges {
        position: absolute;
        top: 8px;
        left: 8px;
        right: 8px;
        display: flex;
        justify-content: space-between;
        pointer-events: none;
    }

    .status-badge {
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 0.7rem;
        color: white;
        font-weight: 500;
    }

    .score-badge {
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 0.7rem;
        color: white;
        font-weight: 500;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
    }

    .overlay-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: white;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .overlay-date {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.8);
        margin-top: 4px;
    }

    .overlay-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 8px;
    }

    .tag {
        font-size: 0.65rem;
        padding: 2px 6px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.2);
        color: white;
    }

    .tag-more {
        opacity: 0.6;
    }
</style>
