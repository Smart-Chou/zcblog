---
interface Filter {
    value: string;
    label: string;
    count?: number;
}
interface Props {
    filters: Filter[];
    activeFilter: string;
    sectionId: string;
}
const { filters, activeFilter, sectionId } = Astro.props;
---

<div class="filter-controls">
    {
        filters.map((filter) => (
            <button
                class:list={["filter-btn", { active: filter.value === activeFilter }]}
                data-filter={filter.value}
                data-section={sectionId}
                type="button"
            >
                {filter.label}
                {filter.count !== undefined && <span class="filter-count">({filter.count})</span>}
            </button>
        ))
    }
</div>

<script>
    import { onPageReady } from "~/utils/page-lifecycle";

    // `define:vars` 会把脚本内联掉，内联脚本里调 onPageReady 是 ReferenceError，
    // 筛选按钮此前一直是死的。按钮本身带 data-section，改事件委托即可，不需要注入变量。
    let controller: AbortController | null = null;

    onPageReady(() => {
        controller?.abort();
        controller = new AbortController();

        document.addEventListener(
            "click",
            (event) => {
                const target = event.target as HTMLElement | null;
                const button = target?.closest("[data-section][data-filter]") as HTMLElement | null;
                if (!button) return;

                const sectionId = button.dataset.section;
                const filter = button.dataset.filter;
                if (!sectionId || !filter) return;

                button
                    .closest(".filter-controls")
                    ?.querySelectorAll(".filter-btn")
                    .forEach((btn) => btn.classList.remove("active"));
                button.classList.add("active");

                document.querySelectorAll(`[data-item-section="${sectionId}"]`).forEach((item) => {
                    const status = item.getAttribute("data-item-status");
                    if (filter === "all" || status === filter) {
                        item.classList.remove("hidden");
                        (item as HTMLElement).style.display = "";
                        item.querySelectorAll("img[data-src]").forEach((img) => {
                            const src = img.getAttribute("data-src");
                            if (src) {
                                img.src = src;
                                img.removeAttribute("data-src");
                            }
                        });
                    } else {
                        item.classList.add("hidden");
                        (item as HTMLElement).style.display = "none";
                    }
                });
            },
            { signal: controller.signal },
        );
    });
</script>

<style>
    .filter-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .filter-btn {
        padding: 6px 12px;
        border: none;
        border-radius: 20px;
        background: var(--color-bg-surface);
        color: var(--color-text);
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
        transition: all var(--duration-normal) var(--ease-out);
        box-shadow: var(--shadow-sm);
    }

    @media (hover: hover) {
        .filter-btn:hover {
            background: var(--color-accent);
            color: white;
        }
    }

    .filter-btn.active {
        background: var(--color-accent);
        color: white;
    }

    .filter-count {
        opacity: 0.7;
        margin-left: 2px;
    }
</style>
