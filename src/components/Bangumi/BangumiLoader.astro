---
import TabNav from "~/components/Bangumi/TabNav.astro";
import BangumiSection from "~/components/Bangumi/BangumiSection.astro";
import type { UserSubjectCollection } from "~/types/bangumi";
import { t, getLocale, type Locale } from "~/utils/i18n";
import bangumiJson from "~/data/bangumi.json";

interface Props {
    locale: string;
}

const { locale } = Astro.props;
const loc: Locale = getLocale(locale);

const categoryMap: Record<string, { id: string; name: string }> = {
    anime: { id: "anime", name: t(loc, "bangumi.categories.anime") },
    book: { id: "book", name: t(loc, "bangumi.categories.book") },
    music: { id: "music", name: t(loc, "bangumi.categories.music") },
    game: { id: "game", name: t(loc, "bangumi.categories.game") },
    tv: { id: "tv", name: t(loc, "bangumi.categories.tv") },
};

const bangumiData = bangumiJson as Record<string, UserSubjectCollection[]>;

const tabs: Array<{ id: string; name: string; count: number }> = [];

for (const [categoryKey, categoryInfo] of Object.entries(categoryMap)) {
    const data = bangumiData[categoryKey] || [];
    tabs.push({
        id: categoryKey,
        name: categoryInfo.name,
        count: data.length,
    });
}

const activeTab = tabs[0]?.id || "anime";
const hasData = tabs.some((t) => t.count > 0);
---

{
    hasData ? (
        <>
            <TabNav tabs={tabs} activeTab={activeTab} />
            {tabs.map((tab) => (
                <BangumiSection
                    sectionId={tab.id}
                    items={bangumiData[tab.id] || []}
                    isActive={tab.id === activeTab}
                    locale={locale}
                />
            ))}
        </>
    ) : (
        <p class="empty-notice">{t(loc, "bangumi.emptyMessageNoData")}</p>
    )
}

<style>
    .empty-notice {
        text-align: center;
        padding: 3rem;
        color: var(--color-body);
        opacity: 0.7;
    }
</style>
