---
interface Tab {
    id: string;
    name: string;
    count?: number;
}

interface Props {
    tabs: Tab[];
    activeTab: string;
}

const { tabs, activeTab } = Astro.props;
---

<div class="tab-nav">
    <nav class="tab-buttons">
        {
            tabs.map((tab) => (
                <button
                    class:list={["tab-btn", { active: tab.id === activeTab }]}
                    data-tab={tab.id}
                    type="button"
                >
                    {tab.name}
                    {tab.count !== undefined && <span class="count">({tab.count})</span>}
                </button>
            ))
        }
    </nav>
</div>

<!-- tab 逻辑见 src/scripts/tab-nav.ts（D-0080） -->

<style>
    .tab-nav {
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 1.5rem;
    }

    .tab-buttons {
        display: flex;
        gap: 0.5rem;
        overflow-x: auto;
    }

    .tab-btn {
        padding: 12px 16px;
        border: none;
        background: transparent;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--color-text);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        transition: all var(--duration-normal) var(--ease-out);
        white-space: nowrap;
    }

    @media (hover: hover) {
        .tab-btn:hover {
            color: var(--color-accent);
        }
    }

    .tab-btn.active {
        color: var(--color-accent);
        border-bottom-color: var(--color-accent);
    }

    .count {
        font-size: 0.8rem;
        opacity: 0.7;
        margin-left: 4px;
    }
</style>
