---
interface TalkItem {
    datetime: string;
    display: string;
    url: string;
    content: string;
}

interface Props {
    items: TalkItem[];
}

// 提取标签（#xxx 开头的关键词）
function extractTags(content: string): string[] {
    const matches = content.match(/#[^\s#]+/g);
    return matches || [];
}

// 提取纯内容（去掉 #tag 前缀）
function stripTags(content: string): string {
    return content.replace(/#[^\s#]+\s*/g, "").trim();
}

const { items } = Astro.props;

// 按时间降序排序
const sorted = [...items].sort(
    (a, b) => new Date(b.datetime).getTime() - new Date(a.datetime).getTime(),
);
---

<div class="talk-timeline">
    {
        sorted.map((item) => {
            const tags = extractTags(item.content);
            const cleanContent = stripTags(item.content);
            return (
                <article class="talk-item">
                    <div class="talk-marker" />
                    <div class="talk-card">
                        <div class="talk-head">
                            {tags.length > 0 && (
                                <div class="talk-tags">
                                    {tags.map((tag) => (
                                        <span class="talk-tag">{tag}</span>
                                    ))}
                                </div>
                            )}
                            <time class="talk-time" datetime={item.datetime}>
                                {item.datetime}
                            </time>
                        </div>
                        <p class="talk-content">
                            <a href={item.url} target="_blank" rel="noreferrer">
                                {cleanContent || item.content}
                            </a>
                        </p>
                        <div class="talk-source">
                            来源:{" "}
                            <a href={item.url} target="_blank" rel="noreferrer">
                                说说
                            </a>
                        </div>
                    </div>
                </article>
            );
        })
    }
</div>

<style>
    .talk-timeline {
        position: relative;
        max-width: 800px;
        margin: 0 auto;
    }

    .talk-timeline::before {
        content: "";
        position: absolute;
        left: 1rem;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--color-border);
    }

    .talk-item {
        position: relative;
        padding-left: 3.5rem;
        margin-bottom: 1.5rem;
    }

    .talk-marker {
        position: absolute;
        left: calc(1rem - 5px);
        top: 3.5rem;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--color-link);
        border: 2px solid var(--color-bg);
        z-index: 1;
    }

    .talk-card {
        background: var(--color-surface);
        border-radius: var(--radius);
        padding: 1rem 1.25rem;
        box-shadow: var(--shadow-sm);
    }

    .talk-head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 0.5rem;
    }

    .talk-tags {
        display: flex;
        gap: 0.35rem;
        flex-wrap: wrap;
    }

    .talk-tag {
        font-size: 0.75rem;
        padding: 2px 8px;
        border-radius: 4px;
        background: var(--color-link);
        color: #fff;
        opacity: 0.85;
    }

    .talk-time {
        font-size: 0.75rem;
        color: var(--color-body);
        opacity: 0.6;
    }

    .talk-content {
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--color-body);
    }

    .talk-content a {
        color: inherit;
        text-decoration: none;
    }

    .talk-content a:hover {
        color: var(--color-link);
    }

    .talk-source {
        margin-top: 0.5rem;
        font-size: 0.75rem;
        opacity: 0.5;
    }

    .talk-source a {
        color: var(--color-link);
        text-decoration: none;
    }

    .talk-source a:hover {
        text-decoration: underline;
    }
</style>
