---
import { getLocalImage } from "~/utils/image-map";

interface Props {
    name: string;
    avatar: string;
    title: string;
    url: string;
    updated: string;
}

const { name, avatar, title, url, updated } = Astro.props;
const avatarSrc = getLocalImage(avatar)?.src ?? avatar;
---

<style>
    .fri-item:nth-child(n + 6) {
        content-visibility: auto;
        contain-intrinsic-size: auto 64px;
    }
</style>

<div class="fri-item">
    <img
        src={avatarSrc}
        alt={name}
        width="48"
        height="48"
        loading="lazy"
        decoding="async"
        class="fri-avatar"
    />
    <div class="fri-cont">
        <div class="fri-title">
            <a target="_blank" rel="noopener nofollow" href={url || "#"}>
                {title}
            </a>
        </div>
        <div class="fri-updated" title={new Date().toISOString()}>
            {updated}
        </div>
    </div>
</div>
