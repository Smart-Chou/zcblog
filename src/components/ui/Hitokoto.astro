---
const API = "https://v1.hitokoto.cn/?c=d&c=i&c=k";

let hitokoto = "";
let from = "";
let fromWho = "";

try {
    const res = await fetch(API);
    if (res.ok) {
        const data = await res.json();
        hitokoto = data.hitokoto;
        from = data.from;
        fromWho = data.from_who;
    }
} catch (e) {
    console.debug("hitokoto fetch failed", e);
}

if (!hitokoto) return;
---

<div class="hitokoto">
    <blockquote class="hitokoto-text" id="hitokoto-text">{hitokoto}</blockquote>
    <p class="hitokoto-source" id="hitokoto-source">
        {fromWho || from ? "—— " : ""}{fromWho}{
            fromWho && from ? "《" + from + "》" : from && !fromWho ? "《" + from + "》" : ""
        }
    </p>
</div>

<style>
    .hitokoto {
        text-align: center;
        max-width: 640px;
        margin: 2rem auto -8rem;
        padding: 1.5rem 1rem;
    }

    .hitokoto-text {
        margin: 0;
        padding: 0;
        font-size: 1.05em;
        line-height: 1.8;
        color: var(--color-text);
        opacity: 0.85;
        letter-spacing: 0.03em;
        border: 0;
        transition: opacity 0.3s ease;
    }

    .hitokoto-text::before {
        content: "\201C";
    }
    .hitokoto-text::after {
        content: "\201D";
    }

    .hitokoto-source {
        margin-top: 0.75em;
        font-size: 0.9em;
        opacity: 0.55;
        transition: opacity 0.3s ease;
    }
</style>

<script>
    function formatSource(from: string, fromWho: string): string {
        if (!fromWho && !from) return "";
        let result = "—— ";
        if (fromWho) result += fromWho;
        if (fromWho && from) result += "《" + from + "》";
        else if (from && !fromWho) result += "《" + from + "》";
        return result;
    }

    const textEl = document.getElementById("hitokoto-text")!;
    const sourceEl = document.getElementById("hitokoto-source")!;

    function getHitokoto() {
        fetch("https://v1.hitokoto.cn/?c=d&c=i&c=k")
            .then((res) => res.json())
            .then((data) => {
                textEl.style.opacity = "0";
                sourceEl.style.opacity = "0";
                setTimeout(() => {
                    textEl.textContent = data.hitokoto;
                    sourceEl.textContent = formatSource(data.from, data.from_who);
                    textEl.style.opacity = "";
                    sourceEl.style.opacity = "";
                }, 320);
            })
            .catch((e) => {
                console.debug("hitokoto fetch failed", e);
            });
    }

    setInterval(getHitokoto, 60000);
</script>
