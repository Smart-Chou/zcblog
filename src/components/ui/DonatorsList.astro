---
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import { Image } from "astro:assets";

interface Donator {
    name: string;
    avatar?: string;
    amount: number;
    message?: string;
    date: string;
}

interface Props {
    donators: Donator[];
}

const { donators } = Astro.props;
---

<div class="donators-list">
    {
        donators.map((donator) => (
            <div class="donator-item">
                <div class="donator-avatar">
                    {donator.avatar ? (
                        <Image
                            src={donator.avatar}
                            alt={donator.name}
                            width={48}
                            height={48}
                            loading="lazy"
                            decoding="async"
                        />
                    ) : (
                        <div class="avatar-placeholder">
                            <DynamicIcon name="ph:user-circle-fill" />
                        </div>
                    )}
                </div>
                <div class="donator-info">
                    <div class="donator-main">
                        <span class="donator-name">{donator.name}</span>
                        <span class="donator-amount">
                            ¥{donator.amount.toFixed(2)}
                        </span>
                    </div>
                    {donator.message && (
                        <div class="donator-message">"{donator.message}"</div>
                    )}
                    <div class="donator-time">{donator.date}</div>
                </div>
            </div>
        ))
    }
</div>

<style>
    .donators-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
    }

    .donator-item {
        display: flex;
        gap: 1rem;
        padding: 1.25rem;
        border-radius: 12px;
        background-color: var(--color-surface);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .donator-item:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .donator-avatar {
        flex-shrink: 0;
    }

    .avatar-placeholder,
    .donator-avatar img {
        width: 48px;
        height: 48px;
        border-radius: 50%;
    }

    .avatar-placeholder {
        background-color: var(--primary-color);
        opacity: 0.85;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
    }

    .donator-info {
        flex: 1;
    }

    .donator-main {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
    }

    .donator-name {
        font-weight: 600;
        font-size: 1.05rem;
    }

    .donator-amount {
        font-weight: 600;
        color: var(--primary-color);
        font-size: 0.9rem;
    }

    .donator-amount::before {
        content: "支持 ";
        font-weight: 400;
        opacity: 0.6;
        margin-right: 2px;
    }

    .donator-time {
        font-size: 0.75rem;
        opacity: 0.6;
        margin-top: 0.25rem;
        display: none;
    }

    .donator-item:hover .donator-time {
        display: block;
    }

    .donator-message {
        font-size: 0.85rem;
        color: var(--color-muted);
        font-style: italic;
        line-height: 1.4;
        margin-top: 0.45rem;
        padding-left: 0.5rem;
        border-left: 2px solid rgba(0, 0, 0, 0.08);
    }

    html[data-theme="dark"] .donator-item {
        background-color: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    html[data-theme="dark"] .donator-item:hover {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
        background-color: rgba(255, 255, 255, 0.05);
    }

    html[data-theme="dark"] .donator-name {
        color: rgba(255, 255, 255, 0.92);
    }

    html[data-theme="dark"] .donator-message {
        color: rgba(255, 255, 255, 0.65);
        border-left-color: rgba(255, 255, 255, 0.12);
    }

    html[data-theme="dark"] .donator-amount {
        color: #f2a19a;
    }

    html[data-theme="dark"] .donator-amount::before {
        opacity: 0.45;
    }

    html[data-theme="dark"] .avatar-placeholder {
        background-color: color-mix(in srgb, var(--primary-color) 60%, black);
    }
</style>
