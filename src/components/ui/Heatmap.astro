---
import "~/styles/heatmap.css";

interface PostData {
    date: string;
    title: string;
    wordCount: number;
}

interface Props {
    postsData: PostData[];
}

const { postsData } = Astro.props;
---

<div
    class="heatmap-container"
    id="heatmap-container"
    data-posts={JSON.stringify(postsData)}
>
</div>

<script>
    import { registerHeatmap } from "~/scripts/heatmap";
    registerHeatmap();
</script>
