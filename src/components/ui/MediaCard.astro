---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    href: string;
    image?: ImageMetadata | string;
    dataSrc?: string;
    alt: string;
    aspectRatio?: string;
    placeholderEmoji?: string;
    target?: string;
    rel?: string;
    class?: string;
    "data-tags"?: string;
}

const {
    href,
    image,
    dataSrc,
    alt,
    aspectRatio = "2/3",
    placeholderEmoji = "📷",
    target,
    rel,
    class: className,
    ...rest
} = Astro.props;
---

<a
    href={href}
    class:list={["media-card", className]}
    target={target}
    rel={rel}
    {...rest}
>
    <div class="media-cover" style={`aspect-ratio: ${aspectRatio}`}>
        {
            image ? (
                typeof image === "string" ? (
                    <img
                        src={image}
                        alt={alt}
                        class="cover-img"
                        loading="lazy"
                        decoding="async"
                    />
                ) : (
                    <Image src={image} alt={alt} class="cover-img" />
                )
            ) : dataSrc ? (
                <img
                    data-src={dataSrc}
                    alt={alt}
                    class="cover-img"
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <div class="cover-placeholder">{placeholderEmoji}</div>
            )
        }
        <slot name="badges" />
        <div class="media-overlay">
            <slot name="overlay" />
        </div>
    </div>
</a>

<style>
    .media-card {
        display: block;
        text-decoration: none;
        border-radius: var(--radius-xl);
        overflow: hidden;
        background: var(--color-surface);
        box-shadow: var(--shadow-sm);
        transition:
            transform var(--duration-slow) var(--ease-out),
            box-shadow var(--duration-slow) var(--ease-out);
    }

    .media-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-xl);
    }

    .media-cover {
        position: relative;
        overflow: hidden;
    }

    .cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--duration-slow) var(--ease-out);
    }

    .media-card:hover .cover-img {
        transform: scale(1.05);
    }

    .cover-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f0f0;
        font-size: 3rem;
    }

    .media-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 12px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
        color: white;
    }
</style>
