---
import { donate } from '~/self.config'
---

<div class="donate">
  <div class="esa-sponsor">
    <div class="tip">
      {donate.tip}
    </div>
    <div class="donate-text">
      <div id="alipay" class="alipay">
        <a href="#">
          <img src="/assets/image/alipay.svg" style="height: 1rem;" alt="alipay" />
        </a>
      </div>
      <div id="wechatpay" class="wechatpay">
        <a href="#">
          <img src="/assets/image/wechat.svg" style="height: 1rem;" alt="wechat" />
        </a>
      </div>
      <div id="paypal" class="paypal">
        <a href={donate.paypalUrl} target="_blank">
          <img src="/assets/image/paypal.svg" style="height: 1rem;" alt="paypal" />
        </a>
      </div>
    </div>
    <div class="qrshow">
      <img src={donate.alipayQRCode} alt="alipayQRCode" />
    </div>
    <div class="qrshow">
      <img src={donate.wechatQRCode} alt="wechatQRCode" />
    </div>
  </div>
</div>

<script>
  import { donate } from '~/self.config'

  document.addEventListener('astro:page-load', () => {
    const qrDiv = document.getElementsByClassName('qrshow') as HTMLCollectionOf<HTMLElement>
    const aliDiv = document.getElementById('alipay')
    const wechatDiv = document.getElementById('wechatpay')

    if (qrDiv.length > 0) {
      if (aliDiv && donate.alipayQRCode) {
        aliDiv.addEventListener('mouseenter', () => {
          qrDiv[0].style.display = 'block'
        })
        aliDiv.addEventListener('mouseleave', () => {
          qrDiv[0].style.display = 'none'
        })
      }
      if (wechatDiv && donate.wechatQRCode) {
        wechatDiv.addEventListener('mouseenter', () => {
          qrDiv[1].style.display = 'block'
        })
        wechatDiv.addEventListener('mouseleave', () => {
          qrDiv[1].style.display = 'none'
        })
      }
    }
  })
</script>
