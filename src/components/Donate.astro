---
import { donate } from "~/self.config";
---

<div class="donate">
    <div class="esa-sponsor">
        <div class="tip">
            {donate.tip}
        </div>
        <div class="donate-text">
            <div id="alipay" class="alipay">
                <a href="#">
                    <img
                        src="/assets/image/alipay.svg"
                        style="height: 1rem;"
                        alt="alipay"
                    />
                </a>
            </div>
            <div id="wechatpay" class="wechatpay">
                <a href="#">
                    <img
                        src="/assets/image/wechat.svg"
                        style="height: 1rem;"
                        alt="wechat"
                    />
                </a>
            </div>
            <div id="paypal" class="paypal">
                <a href={donate.paypalUrl} target="_blank">
                    <img
                        src="/assets/image/paypal.svg"
                        style="height: 1rem;"
                        alt="paypal"
                    />
                </a>
            </div>
        </div>
        <div id="alipay-qr" class="qrshow" style="display: none;">
            <img src={donate.alipayQRCode} alt="Alipay QR Code" />
        </div>
        <div id="wechat-qr" class="qrshow" style="display: none;">
            <img src={donate.wechatQRCode} alt="WeChat QR Code" />
        </div>
    </div>
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const aliDiv = document.getElementById("alipay");
        const wechatDiv = document.getElementById("wechatpay");
        const aliQRCodeDiv = document.getElementById("alipay-qr");
        const wechatQRCodeDiv = document.getElementById("wechat-qr");

        const toggleQRCode = (element, qrCodeDiv) => {
            if (element && qrCodeDiv) {
                element.addEventListener("mouseenter", () => {
                    qrCodeDiv.style.display = "block";
                });
                element.addEventListener("mouseleave", () => {
                    qrCodeDiv.style.display = "none";
                });
            }
        };

        toggleQRCode(aliDiv, aliQRCodeDiv);
        toggleQRCode(wechatDiv, wechatQRCodeDiv);
    });
</script>
