---
import { Image } from "astro:assets";
import { getRandomImageUrl } from "~/utils";

interface Props {
    imagePath: string;
    altText: string;
    loading?: "eager" | "lazy";
}

const { imagePath, altText, loading = "lazy" } = Astro.props;

const isDefaultImage =
    /^https:\/\/pic\.marxchou\.com\/api\/random(\?.*)?$/.test(imagePath) ||
    /^https:\/\/pic\.mcc\.im\/images(\?.*)?$/.test(imagePath);

const src = isDefaultImage ? getRandomImageUrl() : imagePath;
---

<Image
    src={src}
    alt={altText}
    class="post-card-image"
    loading={loading}
    width={800}
    height={450}
    format="avif"
    quality={80}
    decoding="async"
    sizes="(max-width: 650px) 100vw, 860px"
/>
