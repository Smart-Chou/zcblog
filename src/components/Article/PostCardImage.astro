---
import { Image } from "astro:assets";
import { getRandomImageUrl, hasImageService } from "~/utils";
import { imageService } from "~/config";

interface Props {
    imagePath: string;
    altText: string;
    loading?: "eager" | "lazy";
}

const { imagePath, altText, loading = "lazy" } = Astro.props;

const defaultImageUrl = `${imageService.baseUrl}${imageService.randomPath}`;
const isDefaultImage =
    hasImageService && typeof imagePath === "string" && imagePath.startsWith(defaultImageUrl);

// 未配置图床时回退到本地占位图
const src = isDefaultImage ? getRandomImageUrl() : imagePath || getRandomImageUrl();
---

<Image
    src={src}
    alt={altText}
    class="post-card-image"
    loading={loading}
    width={800}
    height={450}
    format="avif"
    quality={80}
    decoding="async"
    sizes="(max-width: 768px) 100vw, 860px"
/>
