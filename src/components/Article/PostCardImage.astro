---
import { Image } from "astro:assets";
import { getRandomImageUrl } from "~/utils";
import { imageService } from "~/self.config";

interface Props {
    imagePath: string;
    altText: string;
    loading?: "eager" | "lazy";
}

const { imagePath, altText, loading = "lazy" } = Astro.props;

const defaultImageUrl = `${imageService.baseUrl}${imageService.randomPath}`;
const isDefaultImage =
    typeof imagePath === "string" && imagePath.startsWith(defaultImageUrl);

const src = isDefaultImage ? getRandomImageUrl() : imagePath;
---

<Image
    src={src}
    alt={altText}
    class="post-card-image"
    loading={loading}
    width={800}
    height={450}
    format="avif"
    quality={80}
    decoding="async"
    sizes="(max-width: 768px) 100vw, 860px"
/>
