---
import type { CollectionEntry } from "astro:content";
import { formatDateI18n } from "~/utils/date-utils";

interface Props {
    relatedPosts: CollectionEntry<"article">[];
}

const { relatedPosts } = Astro.props;

if (relatedPosts.length === 0) {
    // 无相关文章时不渲染任何内容
    return;
}
---

<div class="related-posts">
    <h2 class="related-posts-title">相关文章</h2>
    <ul class="related-posts-list">
        {
            relatedPosts.map((post) => (
                <li class="related-posts-item">
                    <a href={`/article/${post.id}/`} class="related-posts-link">
                        <span class="related-posts-post-title">{post.data.title}</span>
                        <span class="related-posts-meta">
                            {formatDateI18n(post.data.pubDate)}
                            {post.data.tags?.length > 0 && (
                                <span class="related-posts-tags">
                                    {post.data.tags.slice(0, 3).map((tag: string) => (
                                        <span class="related-posts-tag">{tag}</span>
                                    ))}
                                </span>
                            )}
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .related-posts {
        margin-top: calc(var(--space) / 2);
        border-top: 1px solid var(--color-border);
    }

    .related-posts-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-top: 1rem;
        color: var(--color-text);
    }

    .related-posts-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .related-posts-item {
        margin: 0;
    }

    .related-posts-link {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.75rem 1rem;
        border-radius: var(--radius);
        text-decoration: none;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        transition:
            border-color var(--duration-fast),
            background-color var(--duration-fast);
    }

    @media (hover: hover) {
        .related-posts-link:hover {
            border-color: var(--color-accent);
            background: var(--color-hover);
        }
    }

    .related-posts-post-title {
        font-weight: 500;
        color: var(--color-text);
        line-height: 1.4;
    }

    .related-posts-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.8rem;
        color: var(--color-text-dimmed);
    }

    .related-posts-tags {
        display: flex;
        gap: 0.375rem;
    }

    .related-posts-tag {
        display: flex;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        font-size: 0.7rem;
        background: var(--color-hover);
        color: var(--color-text-dimmed);
        align-items: center;
    }

    @media (max-width: 450px) {
        .related-posts-meta {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.375rem;
        }
    }
</style>
