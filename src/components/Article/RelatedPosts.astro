---
import type { CollectionEntry } from "astro:content";
import { formatDateI18n } from "~/utils/date-utils";

interface Props {
    relatedPosts: CollectionEntry<"article">[];
}

const { relatedPosts } = Astro.props;

if (relatedPosts.length === 0) {
    // 无相关文章时不渲染任何内容
    return;
}
---

<div class="related-posts">
    <h2 class="related-posts-title">相关文章</h2>
    <ul class="related-posts-list">
        {
            relatedPosts.map((post) => (
                <li class="related-posts-item">
                    <a
                        href={`${Astro.url.pathname.startsWith("/en/") ? "/en" : ""}/article/${
                            Astro.url.pathname.startsWith("/en/")
                                ? post.id.replace(/-en$/, "")
                                : post.id
                        }/`}
                        class="related-posts-link"
                    >
                        <span class="related-posts-post-title">{post.data.title}</span>
                        <span class="related-posts-meta">
                            {formatDateI18n(post.data.pubDate)}
                            {post.data.tags?.length > 0 && (
                                <span class="related-posts-tags">
                                    {post.data.tags.slice(0, 3).map((tag: string) => (
                                        <span class="related-posts-tag">{tag}</span>
                                    ))}
                                </span>
                            )}
                        </span>
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<!-- 样式已移到 src/styles/article.css（D-0085：并入全局样式链，避免文章页单独拉一份 CSS） -->
