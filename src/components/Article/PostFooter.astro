---
import { normalizeTag } from "~/utils/article-stats";
import PostTag from "~/components/Article/PostTag.astro";
import PostCopyright from "~/components/Article/PostCopyright.astro";

interface Props {
    tags?: string[];
}

const { tags } = Astro.props;
---

<div class="post-footer">
    <div class="post-tags post-card-tags post-card-tags-lists">
        {
            tags?.map((tag: string) => {
                const normalized = normalizeTag(tag);
                return <PostTag tag={normalized} url={`/tags/${normalized}/`} />;
            })
        }
    </div>
    <div class="post-tags post-card-tags post-card-tags-copyright">
        <PostCopyright />
    </div>
</div>

<style>
    .post-footer {
        margin-top: calc(var(--space) / 2);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .post-card-tags-lists {
        max-width: var(--toast-width);
    }

    .post-card-tags-copyright {
        min-width: max-content;
    }
</style>
