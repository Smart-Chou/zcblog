---
import { formatDateToYYYYMMDD } from "~/utils";
import { waline } from "~/config";

interface Props {
    publishedTime: Date;
    modifiedTime?: Date | string;
    wordCount: number;
    readTime: string;
    currentSlug: string;
}

const { publishedTime, modifiedTime, wordCount, readTime, currentSlug } = Astro.props;

// 浏览计数路径：跟随当前语言前缀；英文页去掉 -en 后缀（中文页不裁剪）
const isEnPage = Astro.url.pathname.startsWith("/en");
const pathPrefix = isEnPage ? "/en/article" : "/article";
const cleanSlug = isEnPage ? currentSlug.replace(/-en$/, "") : currentSlug;
const viewPath = `${pathPrefix}/${cleanSlug}/`;

/** 安全转换为 Date，用于后续比较和格式化 */
const safeModified: Date | null = (() => {
    if (!modifiedTime) return null;
    const d = modifiedTime instanceof Date ? modifiedTime : new Date(modifiedTime);
    return isNaN(d.getTime()) ? null : d;
})();

/** 判断更新日期是否与发布日期不同（超过 1 天才显示） */
const showUpdated =
    safeModified &&
    Math.abs(safeModified.getTime() - publishedTime.getTime()) / (1000 * 60 * 60 * 24) > 1;
---

<div class="post-meta post-card-meta">
    Posted {formatDateToYYYYMMDD(publishedTime)}.<slot name="after-posted" />
    {
        showUpdated && safeModified && (
            <span>&nbsp;Updated {formatDateToYYYYMMDD(safeModified)}.</span>
        )
    }
    <span class="meta-break"></span>
    <span class="word-count">{wordCount} words.</span>&nbsp;
    <span class="read-time">{readTime}.</span>
    {
        waline.enable && (
            <>
                &nbsp;
                {/* 占位符用 —：真实数字要等 Waline /article 接口回填（SPA 进入时约 1–3s），
                    写 0 会让人以为「这篇没人看过」 */}
                <span class="waline-pageview-count" data-path={viewPath}>
                    —
                </span>
                <span> views.</span>
            </>
        )
    }
</div>

