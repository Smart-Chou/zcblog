---
import { getAdjacentPosts } from "~/utils/adjacent-posts";
import { getAllArticles } from "~/utils/article-stats";

interface Props {
    slug: string;
}

const { slug } = Astro.props;

// 用 getAdjacentPosts 获取 slug（模块级缓存，O(1) 索引查找）
const { prev: prevSlug, next: nextSlug } = await getAdjacentPosts(slug);

// getAllArticles 由 Astro 内容层缓存，无额外开销
const allPosts = await getAllArticles();
const prevPost = prevSlug ? allPosts.find((p) => p.id === prevSlug) ?? null : null;
const nextPost = nextSlug ? allPosts.find((p) => p.id === nextSlug) ?? null : null;
---

{
    (prevPost || nextPost) && (
        <nav class="post-nav">
            {prevPost && (
                <a href={`/article/${prevPost.id}/`} class="post-nav-link prev">
                    ◀ {prevPost.data.title}
                </a>
            )}
            {nextPost && (
                <a href={`/article/${nextPost.id}/`} class="post-nav-link next">
                    {nextPost.data.title} ▶
                </a>
            )}
        </nav>
    )
}

<style>
    .post-nav {
        border-top: 1px solid var(--color-border);
        margin-top: calc(var(--space) / 2);
        padding: calc(var(--space) / 2) 0 0 0;
        overflow: auto;
    }

    .post-nav-link {
        border: none;
        text-decoration: none;
        color: var(--color-body);
        transition: color var(--duration-fast);
    }

    .post-nav-link:hover {
        color: var(--color-accent);
    }

    .post-nav-link.prev {
        float: left;
    }

    .post-nav-link.next {
        float: right;
    }

    .post-nav-link:first-of-type {
        margin-bottom: calc(var(--space) / 4);
    }
</style>
