---
import { getAdjacentPosts } from "~/utils/adjacent-posts";
import { getAllArticles } from "~/utils/article-stats";

interface Props {
    slug: string;
}

const { slug } = Astro.props;

// 语言由当前 URL 推导（英文文章页在 /en/article/ 下）
const isEn = Astro.url.pathname.startsWith("/en/");
const articlePrefix = isEn ? "/en/article" : "/article";
const toArticleUrl = (id: string) => `${articlePrefix}/${isEn ? id.replace(/-en$/, "") : id}/`;

// 用 getAdjacentPosts 获取同语言相邻文章 slug（模块级缓存，O(1) 索引查找）
const { prev: prevSlug, next: nextSlug } = await getAdjacentPosts(slug, isEn ? "en" : "zh");

// getAllArticles 由 Astro 内容层缓存，无额外开销
const allPosts = await getAllArticles();
const prevPost = prevSlug ? (allPosts.find((p) => p.id === prevSlug) ?? null) : null;
const nextPost = nextSlug ? (allPosts.find((p) => p.id === nextSlug) ?? null) : null;
---

{
    (prevPost || nextPost) && (
        <nav class="post-nav">
            {prevPost && (
                <a href={toArticleUrl(prevPost.id)} class="post-nav-link prev">
                    ◀ {prevPost.data.title}
                </a>
            )}
            {nextPost && (
                <a href={toArticleUrl(nextPost.id)} class="post-nav-link next">
                    {nextPost.data.title} ▶
                </a>
            )}
        </nav>
    )
}

<style>
    .post-nav {
        border-top: 1px solid var(--color-border);
        margin-top: calc(var(--space) / 2);
        padding: calc(var(--space) / 2) 0 0 0;
        overflow: auto;
    }

    .post-nav-link {
        border: none;
        text-decoration: none;
        color: var(--color-text);
        transition: color var(--duration-fast);
    }

    @media (hover: hover) {
        .post-nav-link:hover {
            color: var(--color-accent);
        }
    }

    .post-nav-link.prev {
        float: left;
    }

    .post-nav-link.next {
        float: right;
    }

    .post-nav-link:first-of-type {
        margin-bottom: calc(var(--space) / 4);
    }
</style>
