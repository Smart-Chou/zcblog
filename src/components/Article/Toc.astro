---
import "~/styles/toc.css";
---

<div class="toc">
    <div class="toc-content"></div>
</div>

<script>
    import tocbot from "tocbot";
    document.addEventListener("astro:page-load", () => {
        // 等待主题完全应用后再初始化 TOC，避免样式闪烁
        requestAnimationFrame(() => {
            tocbot.init({
                tocSelector: ".toc-content",
                contentSelector: "#post-content",
                headingSelector: "h2, h3, h4",
                headingsOffset: 100,
                scrollSmoothOffset: -100,
                // 避免与 base.css 全局 scroll-behavior: smooth 冲突
                scrollSmooth: false,
                // 关闭滚动时的 hash 自动更新，避免 pushState 产生多余历史记录
                // 仅点击 TOC 链接时更新 hash（通过下方拦截器改用 replaceState）
                enableUrlHashUpdateOnScroll: false,
                // 子级标题折叠，滚动到对应父级时自动展开
                collapseDepth: 0,
                // title 属性，辅助被截断标题（CSS text-overflow: ellipsis）
                includeTitleTags: true,
                // data-heading-label 属性内置支持，无需 callback
                // 在 markdown 标题上加 data-heading-label="短标题" 即可覆盖 TOC 显示
                // 跳过不想进目录的标题（在 markdown 标题上加 class="toc-ignore"）
                ignoreSelector: ".toc-ignore",
            });

            // tocbot 点击 TOC 链接时用 pushState 更新 hash，会产生历史记录
            // 拦截后改用 replaceState，确保点击多个目录项也只保留一条历史
            const _push = history.pushState.bind(history);
            history.pushState = function (state, title, url) {
                if (typeof url === "string" && url.startsWith("#")) {
                    return history.replaceState(state, title, url);
                }
                return _push(state, title, url);
            };
        });
    });
</script>

<script>
    document.addEventListener("astro:page-load", () => {
        // 等待主题完全应用后再初始化滚动监听
        requestAnimationFrame(() => {
            const tocContent = document.querySelector(
                ".toc-content",
            ) as HTMLElement;
            const post = document.querySelector("#post-content") as HTMLElement;
            const footer = document.querySelector(
                ".post-footer",
            ) as HTMLElement;
            if (tocContent && post && footer) {
                window.addEventListener("scroll", function () {
                    const postBottom =
                        post.getBoundingClientRect().bottom +
                        footer.offsetHeight;
                    const viewportHeight = window.innerHeight;
                    const postScrollHeight =
                        viewportHeight / 2 + tocContent.offsetHeight;
                    if (postBottom <= postScrollHeight) {
                        tocContent.style.position = "absolute";
                        tocContent.style.top = `${((window.scrollY + postBottom - tocContent.offsetHeight) / viewportHeight) * 100}dvh`;
                    } else {
                        tocContent.style.position = "fixed";
                        tocContent.style.top = "50%";
                        tocContent.style.transform = "translateY(-50%)";
                    }
                });
            }
        });
    });
</script>
