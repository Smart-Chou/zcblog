---
import { formatDate } from "~/utils/formatDate";

const { title, publishedTime, postUrl } = Astro.props;
---

<div class="post col-span-1 home-2">
    <h2 class="post-title" aria-label={title}><a href={postUrl}>{title}</a></h2>
    <div class="post-meta">
        Posted {formatDate(publishedTime)}
    </div>
</div>
