---
import PostLayout from "~/layouts/PostLayout.astro";
import PostMeta from "~/components/Article/PostMeta.astro";

interface Props {
    title: string;
    description: string;
    publishedTime: Date;
    postUrl: string;
    wordCount: number;
    readTime: string;
    currentSlug: string;
    tags?: string[];
}

const { title, description, publishedTime, postUrl, wordCount, readTime, currentSlug } =
    Astro.props;
---

<PostLayout>
    <h2 class="post-card-title" aria-label={title}>{title}</h2>
    <p class="post-card-description">{description}</p>
    <PostMeta
        publishedTime={publishedTime}
        wordCount={wordCount}
        readTime={readTime}
        currentSlug={currentSlug}
    />
    <a href={postUrl} class="post-card-link" aria-label={`Read article: ${title}`}>Read More</a>
</PostLayout>
