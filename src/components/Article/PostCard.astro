---
import PostLayout from "~/layouts/PostLayout.astro";
import PostTag from "~/components/Article/PostTag.astro";
import PostMeta from "~/components/Article/PostMeta.astro";
import PostCardImage from "~/components/Article/PostCardImage.astro";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";

const {
    altText,
    imagePath,
    title,
    description,
    publishedTime,
    tags,
    postUrl,
    wordCount,
    readTime,
    currentSlug,
    loading,
    sticky,
} = Astro.props;
---

<PostLayout>
    <div class="post-card-header">
        {
            (
                <PostCardImage
                    imagePath={imagePath}
                    altText={altText}
                    loading={loading}
                />
            )
        }
        {
            sticky > 0 && (
                <DynamicIcon
                    name="tabler:flame"
                    filled={false}
                    style="color:red; position: absolute;top: 10px; right: 10px; width: 30px; height: 30px;"
                    aria-label="Sticky post"
                />
            )
        }
    </div>
    <h2 class="post-card-title" aria-label={title}>{title}</h2>
    <p class="post-card-description">{description}</p>
    <PostMeta
        publishedTime={publishedTime}
        wordCount={wordCount}
        readTime={readTime}
        currentSlug={currentSlug}
    />
    <div class="post-tags post-card-tags">
        {tags.map((tag: string) => <PostTag tag={tag} url={`/tags/${tag}/`} />)}
    </div>
    <a
        href={postUrl}
        class="post-card-link"
        aria-label={`Read article: ${title}`}>Read More</a
    >
</PostLayout>

<style>
    .post-card-header {
        margin: calc(var(--space) * -1) calc(var(--space) * -1)
            calc(var(--space) / 2);
        overflow: hidden;
        border-radius: var(--radius) var(--radius) 0 0;
        position: relative;
        display: inline-block;
    }

    .post-card-header:empty {
        display: none;
    }

    .post-card-header img {
        display: block;
    }
</style>
