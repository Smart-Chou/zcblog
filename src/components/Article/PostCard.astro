---
import PostLayout from "~/layouts/PostLayout.astro";
import PostTag from "~/components/Article/PostTag.astro";
import PostMeta from "~/components/Article/PostMeta.astro";
import PostCardImage from "~/components/Article/PostCardImage.astro";
import FlameIcon from "~/components/icons/Flame.astro";
import { getRandomImageUrl } from "~/utils";
import { Image } from "astro:assets";

const {
    altText,
    imagePath,
    title,
    description,
    publishedTime,
    tags,
    postUrl,
    wordCount,
    readTime,
    currentSlug,
    loading,
    sticky,
} = Astro.props;
const isDefaultImage = /^https:\/\/pic\.mcc\.im\/images(\?.*)?$/.test(
    imagePath,
);
const isRemoteImage = /^https?:\/\//.test(imagePath);
---

<PostLayout>
    <div class="post-card__header">
        {
            isDefaultImage ? (
                <Image
                    src={getRandomImageUrl()}
                    alt={altText}
                    class="post-card__image"
                    loading={loading || "lazy"}
                    width={800}
                    height={450}
                    format="webp"
                    quality={80}
                    decoding="async"
                    sizes="(max-width: 650px) 100vw, 860px"
                />
            ) : isRemoteImage ? (
                <Image
                    src={imagePath}
                    alt={altText}
                    class="post-card__image"
                    loading={loading || "lazy"}
                    width={800}
                    height={450}
                    format="webp"
                    quality={80}
                    decoding="async"
                    sizes="(max-width: 650px) 100vw, 860px"
                />
            ) : (
                <PostCardImage
                    imagePath={imagePath}
                    altText={altText}
                    loading={loading}
                />
            )
        }
        {
            sticky > 0 && (
                <FlameIcon
                    filled={false}
                    style="color:red; position: absolute;top: 10px; right: 10px; width: 30px; height: 30px;"
                    aria-label="Sticky post"
                />
            )
        }
    </div>
    <h2 class="post-card__title" aria-label={title}>{title}</h2>
    <p class="post-card__description">{description}</p>
    <PostMeta
        publishedTime={publishedTime}
        wordCount={wordCount}
        readTime={readTime}
        currentSlug={currentSlug}
    />
    <div class="post-tags post-card__tags">
        {tags.map((tag: string) => <PostTag tag={tag} url={`/tags/${tag}/`} />)}
    </div>
    <a
        href={postUrl}
        class="post-card__link"
        aria-label={`Read article: ${title}`}>Read More</a
    >
</PostLayout>

<style>
    .post-card__header {
        margin: calc(var(--space) * -1) calc(var(--space) * -1)
            calc(var(--space) / 2);
        overflow: hidden;
        border-radius: var(--radius) var(--radius) 0 0;
        position: relative;
        display: inline-block;
    }

    .post-card__header:empty {
        display: none;
    }

    .post-card__header img {
        display: block;
    }
</style>
