---
import Twitter from "~/components/icons/Twitter.astro";
import Github from "~/components/icons/Github.astro";
import Grid from "~/components/icons/Grid.astro";
import { heroConfig } from "~/config/hero.config";
---

<header class="relative left-0 right-0 top-0 z-50">
    <div class="absolute inset-0 h-16 -z-10"></div>
    <div class="h-2"></div>
    <div class="content-wrapper-max">
        <div
            class="relative z-50 flex h-16 items-center justify-between px-2 text-sm md:px-4"
        >
            <nav class="flex md:gap-2" data-accent="violet">
                <a
                    class="flex h-9 items-center gap-2 rounded-xl px-2"
                    aria-label="Home"
                    href={heroConfig.site.url}
                >
                    <div
                        class="border-box flex h-8 w-8 items-center justify-center rounded-xl border-2 sm:h-6 sm:w-6 sm:rounded-lg border-accent-600 bg-accent-600 dark:border-accent-500 dark:bg-accent-500"
                    >
                        <div
                            class="h-3.5 w-0.5 rotate-12 rounded-full sm:h-3 sm:w-0.5 bg-white"
                        >
                        </div>
                    </div>
                    <div class="-mt-1 hidden text-xl sm:block">
                        <span class="text-slate-900 dark:text-slate-200"
                            >{heroConfig.site.name}</span
                        ><span class="text-accent-600 dark:text-accent-500"
                            >dev</span
                        >
                    </div>
                </a>
            </nav>
            <ul class="flex items-center md:gap-1">
                {
                    heroConfig.navLinks
                        .filter((link) => !link.showInLarge)
                        .map((link) => (
                            <li>
                                <a class="nav-link" href={link.url}>
                                    {link.label}
                                </a>
                            </li>
                        ))
                }
                <li class="lg:hidden sf-hidden" data-accent="blue">
                    <!-- Mobile menu items -->
                </li>
                <li class="hidden lg:block" data-accent="blue">
                    <div class="flex">
                        <ul class="flex items-center">
                            {
                                heroConfig.navLinks
                                    .filter((link) => link.showInLarge)
                                    .map((link, index) => (
                                        <>
                                            {index > 0 && (
                                                <li>
                                                    <div class="nav-link-separator">
                                                        ·
                                                    </div>
                                                </li>
                                            )}
                                            <li>
                                                <a
                                                    class="nav-link"
                                                    href={link.url}
                                                >
                                                    {link.label}
                                                </a>
                                            </li>
                                        </>
                                    ))
                            }
                        </ul>
                    </div>
                </li>
                <ul class="flex items-center">
                    {
                        heroConfig.socialLinks
                            .filter((link) => link.icon === "twitter")
                            .map((link) => (
                                <li class="hidden sm:block">
                                    <a
                                        href={link.url}
                                        class="flex items-center justify-center rounded-xl hover:bg-slate-300/50 dark:hover:bg-slate-800/50"
                                        aria-label={`My ${link.title} profile`}
                                        title={`My ${link.title} profile`}
                                        target="_blank"
                                        rel="noreferrer nofollow"
                                    >
                                        <span class="flex h-9 w-9 items-center justify-center rounded-xl">
                                            <Twitter class="h-5 w-5" />
                                        </span>
                                    </a>
                                </li>
                            ))
                    }
                    {
                        heroConfig.socialLinks
                            .filter((link) => link.icon === "github")
                            .map((link) => (
                                <li class="hidden sm:block">
                                    <a
                                        href={link.url}
                                        class="flex items-center justify-center rounded-xl hover:bg-slate-300/50 dark:hover:bg-slate-800/50"
                                        aria-label={`My ${link.title} profile`}
                                        title={`My ${link.title} profile`}
                                        target="_blank"
                                        rel="noreferrer nofollow"
                                    >
                                        <span class="flex h-9 w-9 items-center justify-center rounded-xl">
                                            <Github class="h-5 w-5" />
                                        </span>
                                    </a>
                                </li>
                            ))
                    }
                    <li class="hidden sm:block">
                        <div
                            class="ml-2 mr-4 h-3 w-[1px] bg-slate-200 dark:bg-slate-700"
                        >
                        </div>
                    </li>
                    <li class="mr-2">
                        <button
                            type="button"
                            class="ml-1 flex h-9 w-9 items-center justify-center gap-2 rounded-xl bg-slate-300/50 text-slate-800 xl:w-auto xl:px-3 hover:bg-slate-300/70 sm:ml-0 dark:bg-slate-800/50 dark:text-slate-100 dark:hover:bg-slate-700/50"
                            aria-label="Open Quick Access"
                            title="Open Quick Access"
                        >
                            <Grid class="h-5 w-5" />
                            <div
                                class="hidden items-center gap-2 text-xs font-bold xl:flex dark:font-normal"
                            >
                                Quick Access<kbd
                                    class="rounded-[4px] border border-b-[3px] border-slate-400 bg-slate-300 px-1 py-0.5 font-mono dark:border-slate-300 dark:bg-transparent"
                                    >Q</kbd
                                >
                            </div>
                        </button>
                    </li>
                </ul>
            </ul>
        </div>
    </div>
</header>
