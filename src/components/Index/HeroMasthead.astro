---
import { site } from "~/config";

interface Props {
    subtitle: string;
    totalArticles: number;
    tagsCount: number;
}

const { subtitle, totalArticles, tagsCount } = Astro.props;

// 标题为 "X's Y" 结构时拆分为 强调词 + 's + 其余（如 Marx's Blog → Marx / Blog）；
// 无该结构的标题（如 "Dogeared"）整体作为强调词显示，不再补 "'s"
const hasPossessive = site.title.includes("'s ");
const [titleAccent, titleRest] = hasPossessive ? site.title.split("'s ") : [site.title, null];
---

<header class="hero-masthead animate-in">
    <h1 class="hero-title">
        {
            titleRest ? (
                <>
                    <span class="hero-title-accent">{titleAccent}</span>&#8202;'s {titleRest}
                </>
            ) : (
                <span class="hero-title-accent">{titleAccent}</span>
            )
        }
    </h1>
    <p class="hero-subtitle">{subtitle}</p>
    <div class="hero-divider">
        <span class="hero-divider-dot"></span>
    </div>
    <div class="hero-stats">
        <div class="hero-stat">
            <span class="hero-stat-value">{totalArticles}</span>
            Articles
        </div>
        <div class="hero-stat">
            <span class="hero-stat-value">{tagsCount}+</span>
            Tags
        </div>
    </div>
</header>
