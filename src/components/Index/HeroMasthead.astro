---
import { site } from "~/config";

interface Props {
    subtitle: string;
    totalArticles: number;
    tagsCount: number;
}

const { subtitle, totalArticles, tagsCount } = Astro.props;
const [titleAccent, titleRest] = site.title.split("'s ");
---

<header class="hero-masthead animate-in">
    <h1 class="hero-title">
        <span class="hero-title-accent">{titleAccent}</span>&#8202;'s {
            titleRest
        }
    </h1>
    <p class="hero-subtitle">{subtitle}</p>
    <div class="hero-divider">
        <span class="hero-divider-dot"></span>
    </div>
    <div class="hero-stats">
        <div class="hero-stat">
            <span class="hero-stat-value">{totalArticles}</span>
            Articles
        </div>
        <div class="hero-stat">
            <span class="hero-stat-value">{tagsCount}+</span>
            Tags
        </div>
    </div>
</header>
