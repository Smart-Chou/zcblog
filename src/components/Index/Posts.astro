---
import { Image } from "astro:assets";
import { t, defaultLocale, type Locale } from "~/utils/i18n";

interface Post {
    id: string;
    data: {
        title: string;
        description?: string | null;
        pubDate: Date;
        image?: {
            url: string | { src: string; width: number; height: number };
            alt: string;
        };
    };
}

interface Props {
    posts: Post[];
}

const { posts } = Astro.props;

const pathname = Astro.url.pathname;
const locale: Locale = pathname.startsWith("/en") ? "en" : defaultLocale;

function getImageUrl(image: Post["data"]["image"]): string {
    if (!image) return "";
    if (typeof image.url === "string") return image.url;
    return image.url.src;
}

const archiveUrl = locale === defaultLocale ? "/archives/" : "/en/archives/";

function formatDateFull(date: Date): string {
    return date.toLocaleDateString(locale === "en" ? "en-US" : "zh-CN", {
        year: "numeric",
        month: "short",
        day: "numeric",
    });
}
---

{
    posts.length > 0 && (
        <section>
            <div class="section-header">
                <h2 class="section-label">{t(locale, "stats.recentPosts")}</h2>
                <a class="section-link" href={archiveUrl}>{t(locale, "common.viewAll")} →</a>
            </div>
            <div class="posts-home stagger-children">
                <!-- Featured post -->
                <article class="post-featured">
                    {posts[0].data.image && (
                        <Image
                            src={getImageUrl(posts[0].data.image)}
                            alt={posts[0].data.image.alt}
                            width={720}
                            class="post-featured-cover"
                            loading="lazy"
                            decoding="async"
                        />
                    )}
                    <div class="post-featured-body">
                        <span class="post-featured-label">Featured</span>
                        <h1 class="post-featured-title">
                                {posts[0].data.title}
                        </h1>
                        <span class="post-featured-date">
                            {formatDateFull(posts[0].data.pubDate)}
                        </span>
                    </div>
                    <a href={`/article/${posts[0].id}/`} class="post-card-link" aria-label={`${locale === "en" ? "Read" : "阅读"} ${posts[0].data.title}`}></a>
                </article>

                {/* Secondary posts */}
                {posts.slice(1).map((post) => (
                    <article class="post-card">
                        <h2 class="post-card-title">
                            {post.data.title}
                        </h2>
                        <span class="post-card-meta">
                            {formatDateFull(post.data.pubDate)}
                        </span>
                            <a href={`/article/${post.id}/`} class="post-card-link" aria-label={`${locale === "en" ? "Read" : "阅读"} ${post.data.title}`}></a>
                    </article>
                ))}
            </div>
        </section>
    )
}
