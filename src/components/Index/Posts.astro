---
import HeroPostCard from "../Article/HeroPostCard.astro";
import { t, defaultLocale, type Locale } from "~/utils/i18n";

interface Post {
    id: string;
    data: {
        title: string;
        description: string;
        pubDate: Date;
        image?: {
            url: string | { src: string };
            alt: string;
        };
    };
}

interface Props {
    posts: Post[];
}

const { posts } = Astro.props;

// 自动从 URL 检测语言
const pathname = Astro.url.pathname;
const locale: Locale = pathname.startsWith("/en") ? "en" : defaultLocale;

function formatDate(date: Date, locale: Locale): string {
    const now = new Date();
    const diff = now.getTime() - date.getTime();
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));

    const labels = {
        zh: {
            today: "今天",
            dayAgo: "天前",
            monthAgo: "个月前",
            yearAgo: "年前",
        },
        en: {
            today: "Today",
            dayAgo: "days ago",
            monthAgo: "months ago",
            yearAgo: "years ago",
        },
    };
    const l = labels[locale] || labels.zh;

    if (days === 0) return l.today;
    if (days === 1) return `1 ${l.dayAgo}`;
    if (days < 30) return `${days} ${l.dayAgo}`;
    if (days < 365) return `${Math.floor(days / 30)} ${l.monthAgo}`;
    return `${Math.floor(days / 365)} ${l.yearAgo}`;
}

function getImageUrl(image: Post["data"]["image"]): string {
    if (!image) return "";
    if (typeof image.url === "string") return image.url;
    return image.url.src;
}

const archiveUrl = locale === defaultLocale ? "/archives/" : "/en/archives/";
---

<div class="posts posts-home home grid-cols-2">
    {
        posts.length > 0 && (
            <div class="post first col-span-2 home-1">
                {posts[0].data.image && (
                    <img
                        loading="lazy"
                        decoding="async"
                        src={getImageUrl(posts[0].data.image)}
                        class="post-cover home"
                        alt={posts[0].data.image.alt}
                    />
                )}
                <div class="post-body">
                    <h1 class="post-title">
                        <a href={`/article/${posts[0].id}/`}>
                            {posts[0].data.title}
                        </a>
                    </h1>
                    <div class="post-meta">
                        <span
                            class="post-date"
                            title={posts[0].data.pubDate.toISOString()}
                        >
                            {formatDate(posts[0].data.pubDate, locale)}
                        </span>
                    </div>
                    <div class="post-content">
                        <a
                            class="read-more button"
                            href={`/article/${posts[0].id}/`}
                        >
                            {t(locale, "common.readMore")} →
                        </a>
                    </div>
                </div>
            </div>
        )
    }

    {
        posts
            .slice(1)
            .map((post) => (
                <HeroPostCard
                    title={post.data.title}
                    description={post.data.description}
                    publishedTime={post.data.pubDate.toISOString()}
                    postUrl={`/article/${post.id}/`}
                    currentSlug={post.id}
                />
            ))
    }
</div>

<div class="homemore">
    <a href={archiveUrl}>{t(locale, "common.viewAll")}</a>
</div>
