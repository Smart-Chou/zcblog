---
import MediaCardGrid from "~/components/ui/MediaCardGrid.astro";

interface Media {
    url: string;
    rating: number;
    ratingNum?: number;
    title: string;
    link?: string;
}

interface Props {
    title: string;
    items: Media[];
    href?: string;
    limit?: number;
}

const { title, items, href = "#", limit } = Astro.props;
const displayItems = limit ? items.slice(0, limit) : items;
---

<div class="media-panel">
    <div class="section-header">
        <h2 class="section-label">{title}</h2>
        <a class="section-link" href={href}>查看全部 →</a>
    </div>
    <MediaCardGrid items={displayItems} />
</div>
