---
import MediaCardGrid from "~/components/ui/MediaCardGrid.astro";

interface Media {
    url: string;
    rating: number;
    ratingNum?: number;
    title: string;
    link?: string;
}

interface Props {
    title: string;
    items: Media[];
    href?: string;
    limit?: number;
}

const { title, items, href = "#", limit } = Astro.props;
const displayItems = limit ? items.slice(0, limit) : items;
---

<div class="douban home">
    <h3><a href={href}>{title}</a></h3>
    <MediaCardGrid items={displayItems} />
</div>
