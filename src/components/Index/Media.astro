---
import MediaCardGrid from "~/components/UI/MediaCardGrid.astro";
import { t, type Locale } from "~/utils/i18n";

interface Media {
    url: string;
    rating: number;
    ratingNum?: number;
    title: string;
    link?: string;
}

interface Props {
    title: string;
    items: Media[];
    href?: string;
    limit?: number;
    locale: Locale;
}

const { title, items, href = "#", limit, locale } = Astro.props;
const displayItems = limit ? items.slice(0, limit) : items;
---

<div class="media-panel">
    <div class="section-header">
        <h2 class="section-label">{title}</h2>
        <a class="section-link" href={href}>{t(locale, "common.viewAll")} →</a>
    </div>
    <MediaCardGrid items={displayItems} />
</div>
