---
import FriendCard from "~/components/ui/FriendCard.astro";
import friends from "~/data/friends-articles.json";
---

<section class="friends-section">
    <div class="friends-inner">
        <div class="section-header">
            <h2 class="section-label">朋友连接</h2>
            <a class="section-link" href="/friends/">查看全部 →</a>
        </div>
        <div id="friArticle">
            {
                friends.map((friend) => (
                    <FriendCard
                        name={friend.name}
                        avatar={friend.avatar}
                        title={friend.title}
                        url={friend.url}
                        updated={friend.updated}
                    />
                ))
            }
        </div>
    </div>
</section>
