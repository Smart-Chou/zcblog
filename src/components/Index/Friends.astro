---
import FriendCard from "~/components/ui/FriendCard.astro";
import friends from "~/data/friends-articles.json";
---

<div class="douban friends home">
    <h3><a href="/friends/">朋友连接</a></h3>
    <div id="friArticle">
        {
            friends.map((friend) => (
                <FriendCard
                    name={friend.name}
                    avatar={friend.avatar}
                    title={friend.title}
                    url={friend.url}
                    updated={friend.updated}
                />
            ))
        }
    </div>
</div>
