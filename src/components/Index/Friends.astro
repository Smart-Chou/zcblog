---
import FriendCard from "~/components/UI/FriendCard.astro";
import friends from "~/data/friends-articles.json";
import { t, type Locale } from "~/utils/i18n";

interface Props {
    title: string;
    locale: Locale;
}

const { title, locale } = Astro.props;
---

{
    friends.length > 0 && (
        <section class="friends-section">
            <div class="friends-inner">
                <div class="section-header">
                    <h2 class="section-label">{title}</h2>
                    <a class="section-link" href="/friends/">
                        {t(locale, "common.viewAll")}
                        <span class="section-link-arrow" aria-hidden="true">
                            →
                        </span>
                    </a>
                </div>
                <div id="friArticle">
                    {friends.map((friend) => (
                        <FriendCard
                            name={friend.name}
                            avatar={friend.avatar}
                            title={friend.title}
                            url={friend.url}
                            updated={friend.updated}
                        />
                    ))}
                </div>
            </div>
        </section>
    )
}
