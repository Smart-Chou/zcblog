---
import goods from "~/data/goods.json";
import GoodsCardList from "~/components/ui/GoodsCardList.astro";

interface Props {
    limit?: number;
}

const { limit } = Astro.props;
const displayItems = limit ? goods.slice(0, limit) : goods;
---

<section class="goods-section">
    <div class="section-header">
        <h2 class="section-label">近期好物</h2>
        <a class="section-link" href="/goods/">查看全部 →</a>
    </div>
    <GoodsCardList items={displayItems} />
</section>
