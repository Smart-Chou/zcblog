---
import items from "~/data/talks.json";

const itemsJson = JSON.stringify(items);
---

<div class="talk-container">
    <div id="bber-talk">
        <div class="talk-wrap">
            <ul class="talk-list" data-items={itemsJson}></ul>
        </div>
    </div>
</div>

<style>
    .talk-list {
        will-change: transform, opacity;
        transition: opacity 0.25s ease, transform 0.25s ease;
    }
</style>

<script>
    const DURATION = 6000;
    let intervalId: ReturnType<typeof setInterval> | null = null;

    function initTalk() {
        const list = document.querySelector(".talk-list") as HTMLElement | null;
        if (!list) return;

        const items = JSON.parse(list.dataset.items || "[]");
        if (!items.length) return;

        let index = 0;

        function render() {
            const item = items[index];
            // 用 DOM API 替代 innerHTML，防止 XSS
            const li = document.createElement("li");
            li.className = "item";

            const span = document.createElement("span");
            span.className = "datetime";
            span.title = item.datetime;
            span.textContent = item.display;

            const a = document.createElement("a");
            a.href = item.url;
            a.textContent = item.content;

            li.appendChild(span);
            li.appendChild(a);

            list!.replaceChildren(li);
        }

        render();
        intervalId = setInterval(() => {
            index = (index + 1) % items.length;
            list!.style.opacity = "0";
            list!.style.transform = "translateY(-8px)";
            setTimeout(() => {
                render();
                list!.style.opacity = "1";
                list!.style.transform = "translateY(0)";
            }, 250);
        }, DURATION);
    }

    function destroyTalk() {
        if (intervalId != null) {
            clearInterval(intervalId);
            intervalId = null;
        }
    }

    document.addEventListener("astro:before-swap", destroyTalk);
    document.addEventListener("astro:page-load", initTalk);

    // initial call (fires before astro:page-load on first visit)
    initTalk();
</script>
