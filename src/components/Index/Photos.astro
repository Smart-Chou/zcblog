---
import { Image } from "astro:assets";
import photos from "~/data/herophotos.json";
import { getLocalImage } from "~/utils/image-map";

const isLargeGrid = photos.length >= 9;
const photosWithLocal = photos.map((photo) => {
    const localImage = getLocalImage(photo.url);
    return {
        ...photo,
        image: localImage, // ImageMetadata | undefined
    };
});
---

<section class="photos-section">
    <div class="section-header">
        <h2 class="section-label">近期光影</h2>
        <a class="section-link" href="/albums/">查看全部 →</a>
    </div>
    <div class:list={["photos-grid", { "photos-grid--large": isLargeGrid }]}>
        {
            photosWithLocal.map((photo) => (
                <div class="photo-item">
                    {photo.image ? (
                        <Image
                            src={photo.image}
                            alt={photo.title}
                            loading="lazy"
                            decoding="async"
                            inferSize
                        />
                    ) : (
                        <img
                            src={photo.url}
                            alt={photo.title}
                            loading="lazy"
                            decoding="async"
                        />
                    )}
                    <div class="photo-overlay">
                        <span class="photo-caption">{photo.title}</span>
                    </div>
                </div>
            ))
        }
    </div>
</section>
