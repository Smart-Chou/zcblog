---
const photos = [
    { url: "images/18.jpg", title: "今日夕阳", time: "1 年前" },
    { url: "images/19.webp", title: "工业朋克前的小鼠标", time: "1 年前" },
    { url: "images/20.jpg", title: "山顶咖啡", time: "1 年前" },
    { url: "images/21.jpg", title: "溜车", time: "1 年前" },
    { url: "images/22.webp", title: "茑屋书店", time: "1 年前" },
    { url: "images/23.webp", title: "茑屋书店", time: "1 年前" },
];
---

<section class="photos-section">
    <div class="section-header">
        <h2 class="section-label">近期光影</h2>
        <a class="section-link" href="/albums/">查看全部 →</a>
    </div>
    <div class="photos-grid">
        {
            photos.map((photo) => (
                <div class="photo-item">
                    <img
                        loading="lazy"
                        decoding="async"
                        src={photo.url}
                        alt={photo.title}
                    />
                    <div class="photo-overlay">
                        <span class="photo-caption">{photo.title}</span>
                    </div>
                </div>
            ))
        }
    </div>
</section>
