---
import albums from "~/data/albums.json";
import { imageService } from "~/config";
import { t, type Locale } from "~/utils/i18n";

interface Props {
    title: string;
    locale: Locale;
}

const { title, locale } = Astro.props;

function extractDate(alt: string): Date | null {
    const match = alt.match(/(\d{4}-\d{2}-\d{2})\s*(\d{2}:\d{2}:\d{2})?/);
    if (!match) return null;
    const dateStr = match[2]
        ? `${match[1]}T${match[2]}`
        : `${match[1]}T00:00:00`;
    return new Date(dateStr);
}

const MAX_PHOTOS = 5;
const allPhotos = albums.flatMap((album) =>
    album.photos.map((p) => ({
        url: `${imageService.baseUrl}${imageService.picPath}${p.url}`,
        title: p.alt || p.description || "",
    })),
);
const withDates = allPhotos
    .map((p) => ({ ...p, _date: extractDate(p.title) }))
    .filter((p) => p._date !== null);
const sortedPhotos = withDates.sort(
    (a, b) => b._date!.getTime() - a._date!.getTime(),
);
const photos = sortedPhotos.slice(0, MAX_PHOTOS);

const isLargeGrid = photos.length >= 9;
---

<section class="photos-section">
    <div class="section-header">
        <h2 class="section-label">{title}</h2>
        <a class="section-link" href="/albums/">{t(locale, "common.viewAll")} →</a>
    </div>
    <div class:list={["photos-grid", { "photos-grid--large": isLargeGrid }]}>
        {
            photos.map((photo) => (
                <div class="photo-item">
                    <img
                        src={photo.url}
                        alt={photo.title}
                        width={400}
                        height={300}
                        loading="lazy"
                        decoding="async"
                    />
                    <div class="photo-overlay">
                        <span class="photo-caption">{photo.title}</span>
                    </div>
                </div>
            ))
        }
    </div>
</section>
