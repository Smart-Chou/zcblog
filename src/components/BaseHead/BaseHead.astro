---
import GlobalMeta from "~/components/BaseHead/GlobalMeta.astro";
import OpenGraph from "~/components/BaseHead/OpenGraph.astro";
import Article from "~/components/BaseHead/Article.astro";
import Twitter from "~/components/BaseHead/Twitter.astro";
import Robots from "~/components/BaseHead/Robots.astro";
import Favicon from "~/components/BaseHead/Favicon.astro";
import JsonLd from "~/components/BaseHead/JsonLd.astro";
import Analytics from "~/components/BaseHead/Analytics.astro";
import Scripts from "~/components/BaseHead/Scripts.astro";
import KatexManager from "~/components/Layout/KatexManager.astro";
import SeoLinks from "~/components/BaseHead/SeoLinks.astro";
import FontPreload from "~/components/BaseHead/FontPreload.astro";
import ExternalResources from "~/components/BaseHead/ExternalResources.astro";
import ContentSecurityPolicy from "~/components/BaseHead/ContentSecurityPolicy.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description: string;
    image?: string;
    imageAlt?: string;
    mathjax?: boolean;
    mermaid?: boolean;
    keywords?: string | string[];
    publishedTime?: Date | string;
    modifiedTime?: Date | string;
    prevUrl?: string | null;
    nextUrl?: string | null;
    noindex?: boolean;
    noEnAlternate?: boolean;
}

const {
    title,
    description,
    image = "",
    imageAlt = "",
    mathjax,
    mermaid,
    keywords = [],
    publishedTime,
    modifiedTime,
    prevUrl,
    nextUrl,
    noindex = false,
    noEnAlternate = false,
} = Astro.props;

---

<head>
    <!-- 关键主题 CSS，防止闪烁 - 放在脚本之前确保立即应用 -->
    <style>
        /* 内联关键主题变量，防止外部CSS加载延迟导致的闪烁 */
        html {
            background-color: #fbf8f4;
            color: #2d2822;
        }

        html[data-theme="dark"] {
            background-color: #1c1917;
            color: #e8e3de;
        }

        /* 初始禁用所有过渡，防止页面加载时闪烁 */
        html,
        body {
            transition: none !important;
        }

        /* 启用过渡的类（页面加载后或用户交互时添加） */
        html.theme-transitions-enabled {
            transition:
                background-color 0.3s ease,
                color 0.3s ease,
                border-color 0.3s ease;
        }

        /* 临时禁用过渡（用于主题切换时） */
        html.theme-no-transition,
        html.theme-no-transition body,
        .theme-no-transition {
            transition: none !important;
        }
    </style>

    <script is:inline>
        (function () {
            function getTheme() {
                try {
                    return localStorage.getItem("preferredTheme");
                } catch (e) {
                    return null;
                }
            }

            function applyTheme() {
                const saved = getTheme();
                const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
                const isDark = saved === "dark" || (saved === null && systemDark);
                document.documentElement.classList.toggle("dark", isDark);
                document.documentElement.setAttribute("data-theme", isDark ? "dark" : "light");
                document.documentElement.style.colorScheme = isDark ? "dark" : "light";
            }

            // 首屏：立即应用主题，避免闪烁
            applyTheme();

            // View Transitions 切换前/后重新应用主题
            document.addEventListener("astro:before-swap", applyTheme);
            document.addEventListener("astro:after-swap", applyTheme);

            // 过渡期间冻结页面 CSS 动画/过渡，防止视图抖动
            document.addEventListener("astro:before-swap", function () {
                document.documentElement.classList.add("vt-freeze");
            });
            document.addEventListener("astro:after-swap", function () {
                document.documentElement.classList.remove("vt-freeze");
            });
        })();
    </script>

    <GlobalMeta title={title} description={description} keywords={keywords} />
    <OpenGraph
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        modifiedTime={modifiedTime}
    />
    <Article keywords={keywords} publishedTime={publishedTime} modifiedTime={modifiedTime} />
    <Twitter title={title} description={description} image={image} imageAlt={imageAlt} />
    <Robots noindex={noindex} />
    <Favicon />
    <JsonLd title={title} description={description} image={image} modifiedTime={modifiedTime} />
    <Analytics />
    <KatexManager mathjax={mathjax} />
    <Scripts mathjax={mathjax} mermaid={mermaid} />
    <ClientRouter fallback="none" />

    <SeoLinks prevUrl={prevUrl} nextUrl={nextUrl} noEnAlternate={noEnAlternate} />
    <FontPreload />
    <ExternalResources />
    <ContentSecurityPolicy />
</head>
