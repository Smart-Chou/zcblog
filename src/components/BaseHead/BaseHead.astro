---
import GlobalMeta from "~/components/BaseHead/GlobalMeta.astro";
import OpenGraph from "~/components/BaseHead/OpenGraph.astro";
import Article from "~/components/BaseHead/Article.astro";
import Twitter from "~/components/BaseHead/Twitter.astro";
import Robots from "~/components/BaseHead/Robots.astro";
import Favicon from "~/components/BaseHead/Favicon.astro";
import JsonLd from "~/components/BaseHead/JsonLd.astro";
import Analytics from "~/components/BaseHead/Analytics.astro";
import Scripts from "~/components/BaseHead/Scripts.astro";
import { ClientRouter } from "astro:transitions";
import "~/styles/global.css";

const {
    title,
    description,
    image,
    imageAlt,
    mathjax,
    mermaid,
    keywords = [],
    publishedTime,
    modifiedTime,
} = Astro.props;
---

<head>
    <!-- 关键主题 CSS，防止闪烁 -->
    <style>
        html {
            --bg-color: #fafafa;
            --bg-color-rgb: 250, 250, 250;
            --bg-content-color: #fff;
            --bg-content-color-lighten: #ffffffee;
            --bg-code: #f1f3f4;
            --text-code: #d400ff;
            --text-code-block: #37474f;
            --body-color: #000;
            --title-color: #000;
            --link-color: #0070f3;
            --border-color: rgba(0, 0, 0, 0.1);
            --selection-color: #79ffe1;
        }

        html[data-theme="dark"] {
            --bg-color: #101213;
            --bg-color-rgb: 16, 18, 19;
            --bg-content-color: #2d3235;
            --bg-content-color-lighten: #2d3235ee;
            --bg-code: #1e2224;
            --text-code-block: #fff;
            --border-color: hsla(0, 0%, 100%, 0.1);
            --body-color: #ced8de;
            --title-color: #fff;
            --link-color: #2a89f5;
            --text-code: #df41ff;
        }

        html {
            transition:
                background-color 0.3s ease,
                color 0.3s ease,
                border-color 0.3s ease;
        }

        body {
            background-color: var(--bg-color);
            color: var(--body-color);
            transition:
                background-color 0.3s ease,
                color 0.3s ease,
                border-color 0.3s ease;
        }

        /* 禁用主题切换时的过渡，防止闪烁 */
        html.theme-no-transition,
        html.theme-no-transition body,
        .theme-no-transition {
            transition: none !important;
        }
    </style>

    <!-- 立即主题设置，防止客户端路由导航时闪烁 -->
    <script is:inline>
        (function () {
            try {
                const applyThemeImmediately = () => {
                    // 立即从 localStorage 读取主题偏好
                    const savedTheme = localStorage.getItem("preferredTheme");
                    const systemDark = window.matchMedia(
                        "(prefers-color-scheme: dark)",
                    ).matches;
                    const isDark =
                        savedTheme === "dark" ||
                        (savedTheme === null && systemDark);

                    const root = document.documentElement;

                    // 临时禁用过渡以防止闪烁
                    root.classList.add("theme-no-transition");

                    if (isDark) {
                        root.classList.add("dark");
                        root.setAttribute("data-theme", "dark");
                    } else {
                        root.classList.remove("dark");
                        root.setAttribute("data-theme", "light");
                    }

                    // 强制重绘
                    void root.offsetHeight;

                    // 恢复过渡
                    root.classList.remove("theme-no-transition");
                };

                // 初始应用
                applyThemeImmediately();

                // 监听 View Transitions 事件，在页面交换前设置主题
                if (typeof document !== "undefined") {
                    document.addEventListener(
                        "astro:before-swap",
                        applyThemeImmediately,
                    );
                }
            } catch (e) {
                // 静默失败，后续脚本会处理
                console.debug("主题快速设置失败:", e);
            }
        })();
    </script>

    <GlobalMeta title={title} description={description} keywords={keywords} />
    <OpenGraph
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        modifiedTime={modifiedTime}
    />
    <Article
        keywords={keywords}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
    />
    <Twitter
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
    />
    <Robots />
    <Favicon />
    <JsonLd
        title={title}
        description={description}
        modifiedTime={modifiedTime}
    />
    <Analytics />
    <Scripts mathjax={mathjax} mermaid={mermaid} />
    <ClientRouter fallback="animate" />

    <!-- SEO 增强 -->
    <link rel="canonical" href={Astro.url.href} />
    <link
        rel="alternate"
        type="application/rss+xml"
        title="RSS Feed"
        href="/rss.xml"
    />

    <!-- 预连接到外部资源 -->
    <link rel="preconnect" href="https://pic.mcc.im" crossorigin />
    <link rel="dns-prefetch" href="https://pic.mcc.im" />
</head>
