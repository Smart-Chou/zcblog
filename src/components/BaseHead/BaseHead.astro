---
import GlobalMeta from "~/components/BaseHead/GlobalMeta.astro";
import OpenGraph from "~/components/BaseHead/OpenGraph.astro";
import Article from "~/components/BaseHead/Article.astro";
import Twitter from "~/components/BaseHead/Twitter.astro";
import Robots from "~/components/BaseHead/Robots.astro";
import Favicon from "~/components/BaseHead/Favicon.astro";
import JsonLd from "~/components/BaseHead/JsonLd.astro";
import Analytics from "~/components/BaseHead/Analytics.astro";
import Scripts from "~/components/BaseHead/Scripts.astro";
import KatexManager from "~/components/Layout/KatexManager.astro";
import { ClientRouter } from "astro:transitions";
import { imageService, waline, umami } from "~/config";

interface Props {
    title: string;
    description: string;
    image?: string;
    imageAlt?: string;
    mathjax?: boolean;
    mermaid?: boolean;
    keywords?: string | string[];
    publishedTime?: Date | string;
    modifiedTime?: Date | string;
    prevUrl?: string | null;
    nextUrl?: string | null;
    noindex?: boolean;
    noEnAlternate?: boolean;
}

const {
    title,
    description,
    image = "",
    imageAlt = "",
    mathjax,
    mermaid,
    keywords = [],
    publishedTime,
    modifiedTime,
    prevUrl,
    nextUrl,
    noindex = false,
    noEnAlternate = false,
} = Astro.props;

const siteUrl = (Astro.site?.toString() || "").replace(/\/$/, "");
const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith("/en/");
const zhPath = isEnglish ? currentPath.replace(/^\/en/, "") : currentPath;
const enPath = isEnglish ? currentPath : "/en" + currentPath;
---

<head>
    <!-- 关键主题 CSS，防止闪烁 - 放在脚本之前确保立即应用 -->
    <style>
        /* 内联关键主题变量，防止外部CSS加载延迟导致的闪烁 */
        html {
            background-color: #fbf8f4;
            color: #2d2822;
        }

        html[data-theme="dark"] {
            background-color: #1c1917;
            color: #e8e3de;
        }

        /* 初始禁用所有过渡，防止页面加载时闪烁 */
        html,
        body {
            transition: none !important;
        }

        /* 启用过渡的类（页面加载后或用户交互时添加） */
        html.theme-transitions-enabled {
            transition:
                background-color 0.3s ease,
                color 0.3s ease,
                border-color 0.3s ease;
        }

        /* 临时禁用过渡（用于主题切换时） */
        html.theme-no-transition,
        html.theme-no-transition body,
        .theme-no-transition {
            transition: none !important;
        }
    </style>

    <script is:inline>
        (function () {
            var savedTheme = null;
            try {
                savedTheme = localStorage.getItem("preferredTheme");
            } catch (e) {
                // localStorage 不可用（iOS Safari 隐私模式 / ITP 限制等），回退到系统主题
            }

            var systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            var isDark = savedTheme === "dark" || (savedTheme === null && systemDark);

            if (isDark) {
                document.documentElement.classList.add("dark");
                document.documentElement.setAttribute("data-theme", "dark");
                document.documentElement.style.colorScheme = "dark";
            } else {
                document.documentElement.classList.remove("dark");
                document.documentElement.setAttribute("data-theme", "light");
                document.documentElement.style.colorScheme = "light";
            }

            // 在 View Transitions 开始前就设置主题，避免过渡过程中出现白底闪烁
            function applyTheme() {
                var savedTheme = null;
                try {
                    savedTheme = localStorage.getItem("preferredTheme");
                } catch (e) {}

                var systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
                var isDark = savedTheme === "dark" || (savedTheme === null && systemDark);

                if (isDark) {
                    document.documentElement.classList.add("dark");
                    document.documentElement.setAttribute("data-theme", "dark");
                    document.documentElement.style.colorScheme = "dark";
                } else {
                    document.documentElement.classList.remove("dark");
                    document.documentElement.setAttribute("data-theme", "light");
                    document.documentElement.style.colorScheme = "light";
                }
            }

            // astro:before-swap 在过渡动画之前触发，提前设置主题避免闪烁
            document.addEventListener("astro:before-swap", applyTheme);
            // astro:after-swap 作为备用，确保新页面加载后主题正确
            document.addEventListener("astro:after-swap", applyTheme);

            // 过渡期间冻结页面 CSS 动画/过渡，防止视图抖动
            document.addEventListener("astro:before-swap", function () {
                document.documentElement.classList.add("vt-freeze");
            });
            document.addEventListener("astro:after-swap", function () {
                document.documentElement.classList.remove("vt-freeze");
            });
        })();
    </script>

    <GlobalMeta title={title} description={description} keywords={keywords} />
    <OpenGraph
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        modifiedTime={modifiedTime}
    />
    <Article keywords={keywords} publishedTime={publishedTime} modifiedTime={modifiedTime} />
    <Twitter title={title} description={description} image={image} imageAlt={imageAlt} />
    <Robots noindex={noindex} />
    <Favicon />
    <JsonLd title={title} description={description} image={image} modifiedTime={modifiedTime} />
    <Analytics />
    <KatexManager mathjax={mathjax} />
    <Scripts mathjax={mathjax} mermaid={mermaid} />
    <ClientRouter fallback="none" />

    <!-- SEO 增强 -->
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href={isEnglish ? "/en/rss.xml" : "/rss.xml"} />
    <!-- 分页导航 -->
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <!-- hreflang 多语言标注 -->
    <link rel="alternate" hreflang="zh" href={siteUrl + zhPath} />
    {!noEnAlternate && <link rel="alternate" hreflang="en" href={siteUrl + enPath} />}
    <link rel="alternate" hreflang="x-default" href={siteUrl + zhPath} />

    <!-- Fonts — async load to avoid render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        rel="preload"
        as="style"
        href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=DM+Serif+Display&display=swap"
        onload="this.removeAttribute('onload');this.setAttribute('rel','stylesheet')"
    />
    <noscript>
        <link
            href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=DM+Serif+Display&display=swap"
            rel="stylesheet"
        />
    </noscript>

    <!-- 预连接到外部资源 -->
    <link rel="preconnect" href={imageService.baseUrl} crossorigin />
    <link rel="dns-prefetch" href={imageService.baseUrl} />
    <link rel="dns-prefetch" href="https://cdn.bootcdn.net" />
    <link rel="preconnect" href="https://cdn.bootcdn.net" crossorigin />

    <!-- Content Security Policy -->
    <meta
        http-equiv="Content-Security-Policy"
        content={`default-src 'self'; script-src 'self' 'unsafe-inline' data: https://cdn.jsdelivr.net https://cdn.bootcdn.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.bootcdn.net https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdn.bootcdn.net; img-src 'self' data: https:; connect-src 'self' ${waline.serverUrl} ${umami.umamiBaseUrl} https://v1.hitokoto.cn https://api.github.com https://cdn.jsdelivr.net; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests`}
    />
</head>
