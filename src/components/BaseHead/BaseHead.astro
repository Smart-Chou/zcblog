---
import GlobalMeta from "~/components/BaseHead/GlobalMeta.astro";
import OpenGraph from "~/components/BaseHead/OpenGraph.astro";
import Article from "~/components/BaseHead/Article.astro";
import Twitter from "~/components/BaseHead/Twitter.astro";
import Robots from "~/components/BaseHead/Robots.astro";
import Favicon from "~/components/BaseHead/Favicon.astro";
import JsonLd from "~/components/BaseHead/JsonLd.astro";
import Analytics from "~/components/BaseHead/Analytics.astro";
import Scripts from "~/components/BaseHead/Scripts.astro";
import { ClientRouter } from "astro:transitions";
import "~/styles/global.css";

const {
    title,
    description,
    image,
    imageAlt,
    mathjax,
    mermaid,
    keywords = [],
    publishedTime,
    modifiedTime,
} = Astro.props;
---

<head>
    <!-- 预先设置主题，避免闪烁 -->
    <script is:inline>
        // 在页面渲染前预先设置主题
        const savedTheme = localStorage.getItem("preferredTheme");
        if (savedTheme) {
            document.documentElement.setAttribute("data-theme", savedTheme);
            if (savedTheme === "dark") {
                document.documentElement.classList.add("dark");
            }
        }
    </script>
    <GlobalMeta title={title} description={description} keywords={keywords} />
    <OpenGraph
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        modifiedTime={modifiedTime}
    />
    <Article
        keywords={keywords}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
    />
    <Twitter
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
    />
    <Robots />
    <Favicon />
    <JsonLd
        title={title}
        description={description}
        modifiedTime={modifiedTime}
    />
    <Analytics />
    <Scripts mathjax={mathjax} mermaid={mermaid} />
    <ClientRouter />
</head>
