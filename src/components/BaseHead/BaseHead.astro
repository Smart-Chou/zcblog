---
import GlobalMeta from "~/components/BaseHead/GlobalMeta.astro";
import OpenGraph from "~/components/BaseHead/OpenGraph.astro";
import Article from "~/components/BaseHead/Article.astro";
import Twitter from "~/components/BaseHead/Twitter.astro";
import Robots from "~/components/BaseHead/Robots.astro";
import Favicon from "~/components/BaseHead/Favicon.astro";
import JsonLd from "~/components/BaseHead/JsonLd.astro";
import Analytics from "~/components/BaseHead/Analytics.astro";
import Scripts from "~/components/BaseHead/Scripts.astro";
import { ClientRouter } from "astro:transitions";
import "~/styles/global.css";

const {
    title,
    description,
    image,
    imageAlt,
    mathjax,
    mermaid,
    keywords = [],
    publishedTime,
    modifiedTime,
} = Astro.props;
---

<head>
    <GlobalMeta title={title} description={description} keywords={keywords} />
    <OpenGraph
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        modifiedTime={modifiedTime}
    />
    <Article
        keywords={keywords}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
    />
    <Twitter
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
    />
    <Robots />
    <Favicon />
    <JsonLd
        title={title}
        description={description}
        modifiedTime={modifiedTime}
    />
    <Analytics />
    <Scripts mathjax={mathjax} mermaid={mermaid} />
    <ClientRouter fallback="animate" />

    <!-- SEO 增强 -->
    <link rel="canonical" href={Astro.url.href} />
    <link
        rel="alternate"
        type="application/rss+xml"
        title="RSS Feed"
        href="/rss.xml"
    />

    <!-- 预连接到外部资源 -->
    <link rel="preconnect" href="https://pic.mcc.im" crossorigin />
    <link rel="dns-prefetch" href="https://pic.mcc.im" />
</head>
