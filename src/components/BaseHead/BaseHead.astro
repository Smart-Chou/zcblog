---
import GlobalMeta from "~/components/BaseHead/GlobalMeta.astro";
import OpenGraph from "~/components/BaseHead/OpenGraph.astro";
import Article from "~/components/BaseHead/Article.astro";
import Twitter from "~/components/BaseHead/Twitter.astro";
import Robots from "~/components/BaseHead/Robots.astro";
import Favicon from "~/components/BaseHead/Favicon.astro";
import JsonLd from "~/components/BaseHead/JsonLd.astro";
import Analytics from "~/components/BaseHead/Analytics.astro";
import Scripts from "~/components/BaseHead/Scripts.astro";
import KatexManager from "~/components/Feature/KatexManager.astro";
import { ClientRouter } from "astro:transitions";

const {
    title,
    description,
    image,
    imageAlt,
    mathjax,
    mermaid,
    keywords = [],
    publishedTime,
    modifiedTime,
} = Astro.props;
---

<head>
    <!-- 关键主题 CSS，防止闪烁 - 放在脚本之前确保立即应用 -->
    <style>
        /* 内联关键主题变量，防止外部CSS加载延迟导致的闪烁 */
        html {
            /* 直接设置背景色，防止 FOUC */
            background-color: #fafafa;
            color: #000;
        }

        html[data-theme="dark"],
        html.dark {
            /* 直接设置背景色，防止 FOUC */
            background-color: #101213;
            color: #ced8de;
        }

        /* 初始禁用所有过渡，防止页面加载时闪烁 */
        html,
        body {
            transition: none !important;
        }

        /* 启用过渡的类（页面加载后或用户交互时添加） */
        html.theme-transitions-enabled {
            transition:
                background-color 0.3s ease,
                color 0.3s ease,
                border-color 0.3s ease;
        }

        /* 临时禁用过渡（用于主题切换时） */
        html.theme-no-transition,
        html.theme-no-transition body,
        .theme-no-transition {
            transition: none !important;
        }

        /* 防止 post-title 布局偏移 - 使用硬编码值避免变量解析延迟 */
        #app .content,
        .content {
            max-width: 860px !important;
            margin: 0 auto !important;
            box-sizing: border-box;
        }

        /* 高特异性选择器确保 post-title 立即居中 */
        #app .post-title,
        .post-title {
            max-width: 860px !important;
            margin-inline: auto !important;
            text-align: center !important;
            width: 100% !important;
            box-sizing: border-box !important;
            display: block !important;
            padding: 3.5rem 0 3.5rem !important;
            /* 防止初始渲染偏移 */
            position: relative;
            /* 强制布局计算 */
            contain: layout style;
            /* 防止flex压缩和布局偏移 */
            flex-shrink: 0;
            /* 确保在flex容器中正确对齐 */
            align-self: center;
            /* 立即应用布局，防止闪烁 */
            transform: translateZ(0);
            backface-visibility: hidden;
        }
    </style>

    <!-- 立即主题设置，防止刷新时闪烁 -->
    <script is:inline>
        (function () {
            var savedTheme = localStorage.getItem("preferredTheme");
            var systemDark = window.matchMedia(
                "(prefers-color-scheme: dark)",
            ).matches;
            var isDark =
                savedTheme === "dark" || (savedTheme === null && systemDark);

            if (isDark) {
                document.documentElement.classList.add("dark");
                document.documentElement.setAttribute("data-theme", "dark");
                localStorage.setItem("preferredTheme", "dark");
            } else {
                document.documentElement.classList.remove("dark");
                document.documentElement.setAttribute("data-theme", "light");
                localStorage.setItem("preferredTheme", "light");
            }

            // 监听 View Transitions 页面交换事件
            document.addEventListener("astro:after-swap", function () {
                var savedTheme = localStorage.getItem("preferredTheme");
                var systemDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                var isDark =
                    savedTheme === "dark" ||
                    (savedTheme === null && systemDark);

                if (isDark) {
                    document.documentElement.classList.add("dark");
                    document.documentElement.setAttribute("data-theme", "dark");
                } else {
                    document.documentElement.classList.remove("dark");
                    document.documentElement.setAttribute(
                        "data-theme",
                        "light",
                    );
                }
            });
        })();
    </script>

    <GlobalMeta title={title} description={description} keywords={keywords} />
    <OpenGraph
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        modifiedTime={modifiedTime}
    />
    <Article
        keywords={keywords}
        publishedTime={publishedTime}
        modifiedTime={modifiedTime}
    />
    <Twitter
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
    />
    <Robots />
    <Favicon />
    <JsonLd
        title={title}
        description={description}
        modifiedTime={modifiedTime}
    />
    <Analytics />
    <KatexManager />
    <Scripts mathjax={mathjax} mermaid={mermaid} />
    <ClientRouter fallback="none" />

    <!-- SEO 增强 -->
    <link rel="canonical" href={Astro.url.href} />
    <link
        rel="alternate"
        type="application/rss+xml"
        title="RSS Feed"
        href="/rss.xml"
    />

    <!-- 预连接到外部资源 -->
    <link rel="preconnect" href="https://pic-api.marxchou.com" crossorigin />
    <link rel="dns-prefetch" href="https://pic-api.marxchou.com" />
</head>
