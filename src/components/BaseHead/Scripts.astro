---
import { config } from '~/self.config'
const { mathjax, mermaid } = Astro.props
---

<!-- Style / Scripts -->
{mathjax && <script is:inline type="text/partytown" src="https://cdn.bootcdn.net/ajax/libs/mathjax/3.2.2/es5/tex-chtml.min.js" />}
{mermaid && <script is:inline type="text/partytown" src="https://cdn.bootcdn.net/ajax/libs/mermaid/10.9.0/mermaid.min.js" />}
