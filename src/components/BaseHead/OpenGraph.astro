---
import { site, config, author } from "~/self.config";
const { title, description, image, imageAlt, modifiedTime } = Astro.props;

const fullUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:type" content="image/png" />
<meta property="og:url" content={fullUrl} />
<meta property="og:secure_url" content={fullUrl} />
<meta property="og:site_name" content={author.type} />
<meta property="og:locale" content={config.lang} />
<meta property="og:updated_time" content={modifiedTime.toISOString()} />
