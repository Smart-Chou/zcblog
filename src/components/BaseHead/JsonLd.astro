---
import { author } from "~/self.config";
const currentPath = Astro.url.pathname;
let ldJson = "website";
if (currentPath.startsWith("/article/") && currentPath.split("/").length > 3) {
    ldJson = "article";
}

const { title, imageUrl, modifiedTime } = Astro.props;

const ldJsonSchema = {
    "@context": "https://schema.org",
    "@type": ldJson,
    headline: title,
    image: imageUrl,
    url: Astro.site,
    dateModified: modifiedTime,
    author: {
        "@type": "Person",
        name: author.type,
        url: author.url,
    },
};
---

<!-- JSON-LD -->
<script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(ldJsonSchema)}
/>
