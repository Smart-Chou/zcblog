---
import { author } from "~/self.config";
const currentPath = Astro.url.pathname;
let ldJson = "website";
if (currentPath.startsWith("/article/") && currentPath.split("/").length > 3) {
    ldJson = "article";
}

const { title, imageUrl, modifiedTime } = Astro.props;

// 安全地处理日期，确保它是有效的 Date 对象
const getSafeDateISOString = (time: Date | string | null | undefined) => {
    if (time instanceof Date && !isNaN(time.getTime())) {
        return time.toISOString();
    }
    if (typeof time === 'string') {
        const date = new Date(time);
        if (!isNaN(date.getTime())) {
            return date.toISOString();
        }
    }
    // 处理 null 或 undefined 情况
    if (time === null || time === undefined) {
        return '';
    }
    // 如果没有有效的日期，返回空字符串
    return '';
};

const safeDateModified = getSafeDateISOString(modifiedTime);

const ldJsonSchema = {
    "@context": "https://schema.org",
    "@type": ldJson,
    headline: title,
    image: imageUrl,
    url: Astro.site,
    dateModified: safeDateModified,
    author: {
        "@type": "Person",
        name: author.type,
        url: author.url,
    },
};
---

<!-- JSON-LD -->
<script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(ldJsonSchema)}
/>
