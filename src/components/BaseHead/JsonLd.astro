---
import { site } from "~/self.config";
const currentPath = Astro.url.pathname;
let ldJson = "website";
if (currentPath.startsWith("/article/") && currentPath.split("/").length > 3) {
    ldJson = "article";
}

const { title, imageUrl, modifindTime, author, authorUrl } = Astro.props;

const ldJsonSchema = {
    "@context": "https://schema.org",
    "@type": ldJson,
    headline: title,
    image: imageUrl,
    url: Astro.site,
    dateModified: modifindTime,
    author: {
        "@type": "Person",
        name: site.author,
        url: site.authorUrl,
    },
};
---

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(ldJsonSchema)} />
