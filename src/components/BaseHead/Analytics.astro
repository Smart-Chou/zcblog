---
import { config } from "~/self.config";
---

<!-- Analytics --><!-- Umami -->{
    config.umami && (
        <script
            is:inline
            type="text/partytown"
            src="https://umami.marxchou.com/script.js"
            defer
            data-website-id={String(config.umami)}
            data-domains="marxchou.com"
        />
    )
}

<!-- Google Analytics -->
{
    config.ga && (
        <>
            <script
                is:inline
                type="text/partytown"
                src={`https://www.googletagmanager.com/gtag/js?id=${config.ga}`}
            />
            <script is:inline>
                {`
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                window.dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "${config.ga}");
            `}
            </script>
        </>
    )
}
