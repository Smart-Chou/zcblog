---
import { config } from '~/self.config'
import { GoogleAnalytics } from '@astrolib/analytics'
---

<!-- Analytics -->
{
    config.umami && (
        <>
        <script type="text/partytown" src="https://umami.marxchou.com/script.js" defer data-website-id={String(config.umami)} />
        </>
    )
}
{
    config.ga && (
        <>
        <GoogleAnalytics id={String(config.ga)} />
        </>
    )
}
