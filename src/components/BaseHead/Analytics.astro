---
import { config, umami, site } from "~/config";

const gaId = config.ga ?? null;

const gtagScript = gaId
    ? `window.dataLayer = window.dataLayer || [];
function gtag() {
    dataLayer.push(arguments);
}
gtag("js", new Date());
gtag("config", "${gaId}");`
    : null;
---

<!-- Analytics --><!-- Umami -->{
    umami.enable && (
        <>
            <script
                is:inline
                data-swup-ignore-script
                src={`${umami.umamiBaseUrl}/script.js`}
                async
                data-website-id={String(umami.umamiId)}
                data-domains={site.domains.join(",")}
            />
        </>
    )
}

<!-- Google Analytics -->
{
    gaId && (
        <>
            <script
                is:inline
                data-swup-ignore-script
                src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
                async
            />
            <script is:inline data-swup-ignore-script set:html={gtagScript} />
        </>
    )
}
