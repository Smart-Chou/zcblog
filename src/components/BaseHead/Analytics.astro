---
import { config, umami, site } from "~/config";
---

<!-- Analytics --><!-- Umami -->{
    umami.enable && (
        <>
            <script
                is:inline
                type="text/partytown"
                src={`${umami.umamiBaseUrl}/script.js`}
                defer
                data-website-id={String(umami.umamiId)}
                data-domains={site.domains.join(",")}
            />
        </>
    )
}

<!-- Google Analytics -->
{
    config.ga && (
        <>
            <script
                is:inline
                type="text/partytown"
                src={`https://www.googletagmanager.com/gtag/js?id=${config.ga}`}
            />
            <script type="text/partytown">
                {`
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "${config.ga}");
            `}
            </script>
        </>
    )
}
