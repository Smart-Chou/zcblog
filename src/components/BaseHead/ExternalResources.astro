---
import { imageService } from "~/config";
---

<!-- 预连接到外部资源（配置图床时才输出，避免空 href） -->{
    imageService.baseUrl && (
        <>
            <link rel="preconnect" href={imageService.baseUrl} crossorigin />
            <link rel="dns-prefetch" href={imageService.baseUrl} />
        </>
    )
}
<link rel="dns-prefetch" href="https://cdn.bootcdn.net" />
<link rel="preconnect" href="https://cdn.bootcdn.net" crossorigin />

<!-- Pagefind 搜索 CSS 改为按需注入（D-0053）：6.9KB gz 阻塞样式，只有打开搜索才需要 -->
