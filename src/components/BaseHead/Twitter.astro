---
import { twitter } from "~/config";
const { title, description, image, imageAlt } = Astro.props;

const fullUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:url" content={fullUrl} />
<meta name="twitter:creator" content={twitter.type} />
<meta name="twitter:site" content={twitter.link} />
