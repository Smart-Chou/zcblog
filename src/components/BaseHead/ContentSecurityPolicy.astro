---
import { waline, umami } from "~/config";

// 仅把已启用且配置了地址的服务加进放行清单（避免空串/未启用域名污染 CSP）
const extraOrigins = [
    waline.enable && waline.serverUrl ? waline.serverUrl : null,
    umami.enable && umami.umamiBaseUrl ? umami.umamiBaseUrl : null,
].filter(Boolean);

const connectSrc = [
    "'self'",
    ...extraOrigins,
    "https://v1.hitokoto.cn",
    "https://api.github.com",
    "https://cdn.jsdelivr.net",
].join(" ");
---

<!-- Content Security Policy -->
<meta
    http-equiv="Content-Security-Policy"
    content={`default-src 'self'; script-src 'self' 'unsafe-inline' data: https://cdn.jsdelivr.net https://cdn.bootcdn.net; style-src 'self' 'unsafe-inline' https://cdn.bootcdn.net; font-src 'self' https://cdn.bootcdn.net; img-src 'self' data: https:; connect-src ${connectSrc}; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests`}
/>
