---
import { site } from "~/self.config";
---

<!-- Favicon -->{
    site.favicon && (
        <>
            <link
                rel="icon"
                type="image/svg+xml"
                href={`${site.url}/${site.favicon}`}
            />
        </>
    )
}
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
