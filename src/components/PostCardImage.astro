---
import { Image } from "astro:assets";

interface Props {
    imagePath: string;
    altText: string;
    loading?: "eager" | "lazy";
}

const { imagePath, altText, loading }: Props = Astro.props;
---

<Image
    src={imagePath}
    alt={altText}
    class="post-card__image"
    loading={loading || "lazy"}
    width={800}
    height={450}
    format="webp"
    quality={80}
    decoding="async"
/>
