---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
    imagePath: string;
    altText: string;
    loading?: "eager" | "lazy";
}

const { imagePath, altText, loading } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
    "/public/assets/**/*.{jpeg,jpg,png,gif}",
);

if (!images[`/public/assets/${imagePath}`]) {
    throw new Error(
        `"${imagePath}" does not exist in glob: "/public/assets/**/*.{jpeg,jpg,png,gif}"`,
    );
}

const imageModule = await images[`/public/assets/${imagePath}`]();

console.log(imageModule);
---

<Picture
    src={imageModule.default}
    alt={altText}
    formats={["avif", "webp"]}
    class="post-card__image"
    loading={loading}
/>
