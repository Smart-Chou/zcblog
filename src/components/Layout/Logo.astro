---
import { site } from "~/config";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const logoModules = import.meta.glob<{ default: ImageMetadata }>("~/assets/logo.*", {
    eager: true,
});
// glob key 格式在 dev/prod 下可能不一致，按文件名后缀匹配更稳健
const logoEntry = Object.entries(logoModules).find(([key]) => key.endsWith(site.logo));
const logo = logoEntry?.[1]?.default;
---

<a class="logo" href="/">
    <span class="logo-text">
        {
            logo ? (
                <Image
                    src={logo}
                    alt="Blog Logo"
                    loading="eager"
                    width={64}
                    height={64}
                    class="logo-image"
                />
            ) : (
                <span class="logo-text-fallback">{site.title}</span>
            )
        }
    </span>
</a>

<style>
    .logo {
        display: flex;
        align-items: center;
    }

    .logo-text {
        display: inline-flex;
        align-items: center;
        width: max-content;
    }

    .logo-image {
        border-radius: 99px;
        height: 2rem;
        width: 2rem;
        margin-right: 1em;
    }

    .logo-text-fallback {
        font-weight: 700;
        font-size: 1.25rem;
    }

    .logo-icon-fallback {
        display: none;
        color: var(--color-text);
    }

    @media (max-width: 450px) {
        .logo-image {
            height: 1.5rem;
            width: 1.5rem;
            margin-right: 0;
        }

        .logo-text-fallback {
            display: none;
        }

        .logo-icon-fallback {
            display: flex;
            align-items: center;
        }

        /* 有 logo 图片时隐藏兜底图标 */
        .logo-image ~ .logo-icon-fallback {
            display: none;
        }
    }
</style>
