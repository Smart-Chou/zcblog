---
import { site } from "~/self.config";
import { Image } from "astro:assets";
import logo from "~/assets/logo.svg";
---

<a class="logo" href="/">
    <span class="logo__text">
        <Image src={logo} alt="Blog Logo" loading="eager" class="logo__image" />
        {site.title}
    </span>
</a>

<style>
    .logo {
        display: flex;
        align-items: center;
    }

    .logo__text {
        display: inline-flex;
        align-items: center;
    }

    .logo__image {
        border-radius: 99px;
        height: 2rem;
        width: 2rem;
        margin-right: 1em;
    }
</style>
