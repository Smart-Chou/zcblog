---
// Mermaid 图表客户端渲染器
// 依赖 Scripts.astro 已加载的 window.mermaid
// remarkCodeBlocks 已将 ```mermaid 代码块转为 <pre class="mermaid">
---

<script>
  function renderMermaid() {
    const allNodes = document.querySelectorAll<HTMLElement>("pre.mermaid");
    if (allNodes.length === 0) return;

    const newNodes: HTMLElement[] = [];
    allNodes.forEach((el) => {
      if (!el.querySelector("svg")) {
        newNodes.push(el);
      }
    });
    if (newNodes.length === 0) return;

    const m = (window as any).mermaid;
    if (!m) return;

    m.run({ nodes: newNodes });
  }

  renderMermaid();
  document.addEventListener("astro:page-load", renderMermaid);
</script>
