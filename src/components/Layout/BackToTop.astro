---
import { onPageReady } from "~/utils/page-lifecycle";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";

interface Props {
    threshold?: number;
}

const { threshold = 300 } = Astro.props;
---

<div id="back-to-top" data-threshold={threshold}>
    <DynamicIcon name="mingcute:arrow-up-circle-fill" width="2rem" height="2rem" />
</div>

<script>
    import { onPageReady } from "~/utils/page-lifecycle";

    // 阈值走 data 属性：`define:vars` 会把脚本强制内联，而内联脚本拿不到 import，
    // 之前 `onPageReady(...)` 在这里是 ReferenceError，整个返回顶部直接失效。
    // 事件统一挂 document + AbortController：按钮可能常驻布局，也可能随 <main> 被替换，
    // 每次换页先 abort 再重新绑定，既不会重复触发也不会绑在已销毁的元素上。
    let controller: AbortController | null = null;

    onPageReady(() => {
        controller?.abort();
        controller = new AbortController();

        const update = () => {
            const el = document.getElementById("back-to-top");
            if (!el) return;
            const threshold = Number(el.dataset.threshold ?? 300);
            el.classList.toggle("active", window.scrollY > threshold);
        };

        document.addEventListener("scroll", update, { passive: true, signal: controller.signal });
        document.addEventListener(
            "click",
            (event) => {
                const target = event.target as HTMLElement | null;
                if (!target?.closest("#back-to-top")) return;
                window.scrollTo({ top: 0, behavior: "smooth" });
            },
            { signal: controller.signal },
        );

        update();
    });
</script>

<style>
    #back-to-top {
        position: fixed;
        bottom: 40px;
        right: 30px;
        z-index: 100;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translateY(8px);
        transition:
            opacity var(--duration-normal) var(--ease-out),
            transform var(--duration-normal) var(--ease-out),
            visibility var(--duration-normal);
    }

    #back-to-top.active {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    #back-to-top svg {
        font-size: 1.2em;
        color: var(--color-text);
        transition: color var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        #back-to-top:hover svg {
            color: var(--color-accent);
        }
    }
</style>
