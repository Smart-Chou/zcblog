---
import { site, footerList } from "~/config";
import { Image } from "astro:assets";
import DynamicIcon from "../icons/DynamicIcon.astro";
import { getArticleStats } from "~/utils/article-stats";

const currentYear = new Date().getFullYear();

const { totalPosts, totalTags, totalWordCount } = await getArticleStats();

function formatNumber(num: number): string {
    if (num >= 1000000) return `${(num / 1000000).toFixed(1)}m`;
    if (num >= 1000) return `${(num / 1000).toFixed(1)}k`;
    return num.toString();
}

const stats = [
    { label: "文章", value: formatNumber(totalPosts) },
    { label: "标签", value: formatNumber(totalTags) },
    { label: "字数", value: formatNumber(totalWordCount) },
];
---

<footer class="footer" role="contentinfo">
    <!-- Stats bar — custom crafted, no external images -->
    <div class="footer-stats" aria-label="站点统计">
        {
            stats.map((stat) => (
                <a href="/article/" class="stat-item">
                    <span class="stat-value">{stat.value}</span>
                    <span class="stat-label">{stat.label}</span>
                </a>
            ))
        }
        <span class="stat-divider" aria-hidden="true"></span>
        <a href="/rss.xml" class="stat-item stat-item--icon" aria-label="RSS 订阅">
            <DynamicIcon name="tabler:rss" />
            <span class="stat-label">RSS</span>
        </a>
        <a href="/sitemap-0.xml" class="stat-item stat-item--icon" aria-label="站点地图">
            <DynamicIcon name="tabler:focus-centered" />
            <span class="stat-label">Sitemap</span>
        </a>
    </div>

    <!-- Tech badges row -->
    <div class="footer-tech">
        {
            footerList.map((meta) => (
                <a
                    data-key={`footer-link-${meta.title}`}
                    href={meta.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tech-badge"
                    aria-label={`${meta.title}: ${meta.text}`}
                >
                    <Image
                        src={`https://img.shields.io/badge/${meta.title}-${meta.text}-${meta.color}?logo=${meta.logo}&logoColor=${meta.logoColor}&labelColor=${meta.labelColor}`}
                        alt={`${meta.title} badge`}
                        loading="lazy"
                        width={120}
                        height={20}
                    />
                </a>
            ))
        }
    </div>

    <!-- Meta row -->
    <div class="footer-meta">
        <span class="footer-copyright">
            &copy; {site.startYear}&ndash;{currentYear}
        </span>
        {
            site.beian && (
                <a
                    href={site.beianURL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer-beian"
                >
                    {site.beian}
                </a>
            )
        }
    </div>
</footer>

<style>
    .footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-sm);
        padding: var(--space) 15px;
        font-size: var(--text-sm);
        font-family: var(--font-body);
        color: var(--color-muted);
        margin-top: auto;
        border-top: 1px solid var(--color-border);
    }

    /* ---- Stats bar ---- */
    .footer-stats {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 5px 14px;
        border-radius: var(--radius-full);
        color: var(--color-muted);
        text-decoration: none;
        line-height: 1;
        transition:
            color var(--duration-fast) var(--ease-out),
            background var(--duration-fast) var(--ease-out);
    }

    .stat-item:hover {
        color: var(--color-accent);
        background: var(--color-hover);
    }

    .stat-value {
        font-family: var(--font-mono);
        font-size: 0.85em;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--color-body);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.8em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 500;
        line-height: 1;
    }

    .stat-divider {
        display: inline-block;
        width: 1px;
        height: 14px;
        background: var(--color-border);
        margin: 0 2px;
        border-radius: 1px;
    }

    .stat-svg {
        width: 0.85em;
        height: 0.85em;
        opacity: 0.6;
        flex-shrink: 0;
        transition: opacity var(--duration-fast) var(--ease-out);
    }

    .stat-item:hover .stat-svg {
        opacity: 1;
    }

    /* ---- Tech badges row ---- */
    .footer-tech {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 6px;
    }

    .tech-badge {
        display: inline-block;
        line-height: 0;
        opacity: 0.55;
        transition: opacity var(--duration-fast) var(--ease-out);
    }

    .tech-badge:hover {
        opacity: 1;
    }

    .tech-badge img {
        height: 20px;
        width: auto;
        display: block;
    }

    /* ---- Meta row ---- */
    .footer-meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: var(--space-xs);
        font-size: 0.8em;
    }

    .footer-copyright {
        white-space: nowrap;
    }

    .footer-beian {
        color: inherit;
        text-decoration: none;
        transition: color var(--duration-fast) var(--ease-out);
    }

    .footer-beian:hover {
        color: var(--color-accent);
    }

    /* ---- Mobile ---- */
    @media screen and (max-width: 768px) {
        .footer {
            padding: var(--space) 12px;
            gap: 10px;
        }

        .stat-item {
            padding: 4px 10px;
            gap: 4px;
        }

        .stat-divider {
            height: 12px;
            margin: 0 1px;
        }

        .tech-badge img {
            height: 18px;
        }
    }

    @media screen and (max-width: 480px) {
        .footer {
            padding: var(--space-sm) 10px;
            gap: var(--space-xs);
        }

        .footer-stats {
            flex-wrap: wrap;
            justify-content: center;
            gap: 0;
        }

        .stat-item {
            padding: 4px 8px;
        }

        .stat-value {
            font-size: 0.8em;
        }

        .stat-label {
            font-size: 0.72em;
            letter-spacing: 0.02em;
        }

        .stat-divider {
            display: none;
        }

        .tech-badge img {
            height: 16px;
        }
    }

    @media screen and (max-width: 360px) {
        .stat-item {
            padding: 3px 6px;
        }
    }
</style>
