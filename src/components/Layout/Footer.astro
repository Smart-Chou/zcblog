---
import { site, footerList } from "~/self.config";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const currentYear = new Date().getFullYear();

// 获取文章统计数据
const allPosts = await getCollection("article");
const totalPosts = allPosts.length;
const totalTags = new Set(allPosts.flatMap((p) => p.data.tags || [])).size;
const totalWordCount = allPosts.reduce((sum, post) => {
    const body = post.body || "";
    return sum + body.replace(/\s+/g, "").length;
}, 0);

function formatNumber(num: number): string {
    if (num >= 1000000) return `${(num / 1000000).toFixed(1)}m`;
    if (num >= 1000) return `${(num / 1000).toFixed(1)}k`;
    return num.toString();
}

const sitemapBadgeUrl = `https://img.shields.io/badge/sitemap-%232bb24c?style=flat-square&logo=maplibre&logoColor=%23ffffff&labelColor=%232bb24c&link=${encodeURIComponent(site.url + "/sitemap-index.xml")}`;

const statsBadges = [
    { label: "Articles", value: formatNumber(totalPosts) },
    { label: "Words", value: formatNumber(totalWordCount) },
    { label: "Tags", value: formatNumber(totalTags) },
];
---

<footer class="footer" role="contentinfo">
    <div class="footer-copyright">
        <span>
            Copyright {site.startYear} - {currentYear}. All rights reserved.
        </span>
    </div>
    <div class="footer-links">
        <a href={site.beianURL} target="_blank" rel="noopener noreferrer">
            <span>{site.beian}</span>
        </a>
    </div>
    <div class="footer-links">
        {
            footerList.map((meta) => (
                <a
                    data-key={`footer-link-${meta.title}`}
                    href={meta.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${meta.title}: ${meta.text}`}
                >
                    <Image
                        src={`https://img.shields.io/badge/${meta.title}-${meta.text}-${meta.color}?logo=${meta.logo}&logoColor=${meta.logoColor}&labelColor=${meta.labelColor}`}
                        alt={`${meta.title} badge`}
                        loading="lazy"
                        width={120}
                        height={20}
                    />
                </a>
            ))
        }
    </div>
    <div id="rss-stats">
        &nbsp;&nbsp;
        <a href="/article/" aria-label="Articles">
            <Image
                src={`https://img.shields.io/badge/Articles-${statsBadges[0].value}-informational?style=flat-square&logo=blogger&logoColor=%23ffffff&labelColor=%23303336`}
                alt="Articles badge"
                loading="lazy"
                width={100}
                height={20}
            />
        </a>
        <a href="/article/" aria-label="Words">
            <Image
                src={`https://img.shields.io/badge/Words-${statsBadges[1].value}-informational?style=flat-square&logo=blogger&logoColor=%23ffffff&labelColor=%23303336`}
                alt="Words badge"
                loading="lazy"
                width={100}
                height={20}
            />
        </a>
        <a href="/article/" aria-label="Tags">
            <Image
                src={`https://img.shields.io/badge/Tags-${statsBadges[2].value}-informational?style=flat-square&logo=blogger&logoColor=%23ffffff&labelColor=%23303336`}
                alt="Tags badge"
                loading="lazy"
                width={80}
                height={20}
            />
        </a>
        <a href="/rss.xml">
            <Image
                src="https://img.shields.io/badge/RSS-sky?logo=rss"
                alt="RSS"
                loading="lazy"
                width={80}
                height={20}
            />
        </a>
        <a href="/sitemap-index.xml">
            <Image
                src={sitemapBadgeUrl}
                alt="sitemap"
                loading="lazy"
                width={100}
                height={20}
            />
        </a>
    </div>
</footer>

<style>
    .footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: var(--space) 15px var(--space);
        text-align: center;
        line-height: 1.8;
        font-size: 0.9em;
        font-family: var(--font-body);
        margin-top: auto;
    }

    .footer > span {
        margin: 0.25em;
    }

    .footer a {
        color: currentColor;
    }

    .footer svg {
        max-width: 0.9rem;
    }

    .footer #rss-stats {
        /* padding-top removed, using margin-top from flex container */
    }

    .footer #rss-stats a {
        /* margin-right removed, using gap from flex container */
    }

    /* 图片等高，宽度自适应 */
    .footer img {
        height: 20px;
        width: auto;
    }

    /* 图片链接容器使用 flex 布局 */
    .footer-links:has(img),
    #rss-stats {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.5rem;
    }

    /* 移动端优化 */
    @media screen and (max-width: 768px) {
        .footer {
            padding: calc(var(--space) * 0.75) 12px calc(var(--space) * 0.75);
            font-size: 0.85em;
        }

        .footer-links:has(img),
        #rss-stats {
            gap: 0.25rem;
        }

        .footer img {
            height: 18px;
        }
    }

    @media screen and (max-width: 450px) {
        .footer {
            padding: calc(var(--space) * 0.6) 10px calc(var(--space) * 0.6);
        }

        .footer-copyright span {
            display: block;
            margin-bottom: 0.5rem;
        }

        .footer-links:has(img) {
            flex-direction: column;
            gap: 0.5rem;
        }

        .footer img {
            height: 16px;
        }
    }
</style>
