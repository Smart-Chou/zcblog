---
import { site, footerList } from "~/config";
import DynamicIcon from "../Icons/DynamicIcon.astro";
import { getArticleStats } from "~/utils/article-stats";

const currentYear = new Date().getFullYear();

// 英文页面：统计/RSS 链接指向英文版
const isEn = Astro.url.pathname.startsWith("/en/");
const prefix = isEn ? "/en" : "";
const rssUrl = isEn ? "/en/rss.xml" : "/rss.xml";

const { totalPosts, totalTags, totalWords } = await getArticleStats();

function formatNumber(num: number): string {
    if (num >= 1000000) return `${(num / 1000000).toFixed(1)}m`;
    if (num >= 1000) return `${(num / 1000).toFixed(1)}k`;
    return num.toString();
}

const stats = [
    { label: "文章", value: formatNumber(totalPosts), url: `${prefix}/archives/` },
    { label: "标签", value: formatNumber(totalTags), url: `${prefix}/tags/` },
    { label: "字数", value: formatNumber(totalWords), url: `${prefix}/archives/` },
];
---

<footer class="footer" role="contentinfo">
    <!-- Stats bar — custom crafted, no external images -->
    <div class="footer-stats" aria-label="站点统计">
        {
            stats.map((stat) => (
                <a href={stat.url} class="stat-item">
                    <span class="stat-value">{stat.value}</span>
                    <span class="stat-label">{stat.label}</span>
                </a>
            ))
        }
        <span class="stat-divider" aria-hidden="true"></span>
        <a href={rssUrl} class="stat-item stat-item--icon" aria-label="RSS 订阅">
            <DynamicIcon name="tabler:rss" />
            <span class="stat-label">RSS</span>
        </a>
        <a href="/sitemap-0.xml" class="stat-item stat-item--icon" aria-label="站点地图">
            <DynamicIcon name="tabler:focus-centered" />
            <span class="stat-label">Sitemap</span>
        </a>
    </div>

    <!-- Tech badges row — text chips matching the editorial palette -->
    <div class="footer-tech">
        {
            footerList.map((meta) => (
                <a
                    data-key={`footer-link-${meta.title}`}
                    href={meta.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tech-badge"
                    aria-label={`${meta.title}: ${meta.text}`}
                >
                    <span class="tech-badge__dot" aria-hidden="true" />
                    <span class="tech-badge__text">
                        {meta.title} · {meta.text}
                    </span>
                </a>
            ))
        }
    </div>

    <!-- Meta row -->
    <div class="footer-meta">
        <span class="footer-copyright">
            &copy; {site.startYear}&ndash;{currentYear}
        </span>
        {
            site.beian && (
                <a
                    href={site.beianURL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer-beian"
                >
                    {site.beian}
                </a>
            )
        }
    </div>
</footer>

<style>
    .footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-sm);
        padding: var(--space) 15px;
        font-size: var(--text-sm);
        font-family: var(--font-body);
        color: var(--color-text-muted);
        margin-top: auto;
        border-top: 1px solid var(--color-border);
    }

    /* ---- Stats bar ---- */
    .footer-stats {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 5px 14px;
        border-radius: var(--radius-full);
        color: var(--color-text-muted);
        text-decoration: none;
        line-height: 1;
        transition:
            color var(--duration-fast) var(--ease-out),
            background var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        .stat-item:hover {
            color: var(--color-accent);
            background: var(--color-hover);
        }
    }

    .stat-value {
        font-family: var(--font-mono);
        font-size: 0.85em;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--color-text);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.8em;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 500;
        line-height: 1;
    }

    .stat-divider {
        display: inline-block;
        width: 1px;
        height: 14px;
        background: var(--color-border);
        margin: 0 2px;
        border-radius: 1px;
    }

    .stat-svg {
        width: 0.85em;
        height: 0.85em;
        opacity: 0.6;
        flex-shrink: 0;
        transition: opacity var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        .stat-item:hover .stat-svg {
            opacity: 1;
        }
    }

    /* ---- Tech badges row — text chips ---- */
    .footer-tech {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

    .tech-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-full);
        font-family: var(--font-mono);
        font-size: 0.72em;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--color-text-dimmed);
        text-decoration: none;
        transition:
            color var(--duration-fast) var(--ease-out),
            border-color var(--duration-fast) var(--ease-out);
    }

    .tech-badge__dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--color-accent);
        opacity: 0.85;
        flex-shrink: 0;
    }

    @media (hover: hover) {
        .tech-badge:hover {
            color: var(--color-text);
            border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
        }
    }

    /* ---- Meta row ---- */
    .footer-meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: var(--space-xs);
        font-size: 0.8em;
    }

    .footer-copyright {
        white-space: nowrap;
    }

    .footer-beian {
        color: inherit;
        text-decoration: none;
        transition: color var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        .footer-beian:hover {
            color: var(--color-accent);
        }
    }

    /* ---- Mobile ---- */
    @media screen and (max-width: 768px) {
        .footer {
            padding: var(--space) 12px;
            gap: 10px;
        }

        .stat-item {
            padding: 4px 10px;
            gap: 4px;
        }

        .stat-divider {
            height: 12px;
            margin: 0 1px;
        }
    }

    @media screen and (max-width: 480px) {
        .footer {
            padding: var(--space-sm) 10px;
            gap: var(--space-xs);
        }

        .footer-stats {
            flex-wrap: wrap;
            justify-content: center;
            gap: 0;
        }

        .stat-item {
            padding: 4px 8px;
        }

        .stat-value {
            font-size: 0.8em;
        }

        .stat-label {
            font-size: 0.72em;
            letter-spacing: 0.02em;
        }

        .stat-divider {
            display: none;
        }
    }

    @media screen and (max-width: 360px) {
        .stat-item {
            padding: 3px 6px;
        }
    }
</style>
