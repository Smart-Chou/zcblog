---
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { getCollection } from "astro:content";
import { getLocale, defaultLocale, locales } from "~/utils/i18n";
import { articleLang, articleSlug } from "~/utils/article-url";

const currentLocale = getLocale(Astro.currentLocale || defaultLocale);
const currentPath = Astro.url.pathname;

/** 文章页翻译对照查询（构建期一次；非文章页为 null） */
const articleMatch = currentPath.match(/^\/(?:en\/)?article\/([^/]+)\/?$/);
const articleUrlSlug = articleMatch ? decodeURIComponent(articleMatch[1]) : null;
let articleHasZh = false;
let articleHasEn = false;
if (articleUrlSlug) {
    const all = await getCollection("article", ({ data }) => !(data.draft ?? false));
    articleHasZh = all.some((p) => articleLang(p) === "zh" && articleSlug(p) === articleUrlSlug);
    articleHasEn = all.some((p) => articleLang(p) === "en" && articleSlug(p) === articleUrlSlug);
}

/**
 * 解析语言切换目标路径。
 * - 文章页：有翻译对照则直达对照版（zh ↔ /en/article/<slug>/）；
 * - 其余无英文版页面（相册详情 / 仅中文静态页 / 错误页）回退到最近的英文页面（2026-10 审计修复）。
 */
function getLocalePath(locale: string, path: string): string {
    const stripped = path.replace(/^\/(zh|en)/, "") || "/";
    if (locale === defaultLocale) {
        // 英文错误页切回中文：错误页无对应页面，回中文首页
        if (/^\/(404|500)\//.test(stripped)) return "/";
        if (stripped.startsWith("/article/")) {
            return articleHasZh && articleUrlSlug ? `/article/${articleUrlSlug}/` : "/blog/1/";
        }
        return stripped;
    }
    // 以下页面没有英文版 → 回退
    if (/^\/(404|500)\//.test(stripped)) return "/en/";
    if (
        stripped === "/cookies/" ||
        stripped === "/copyright/" ||
        stripped === "/privacy-policy/" ||
        stripped === "/redirect/"
    ) {
        return "/en/";
    }
    if (stripped.startsWith("/article/")) {
        return articleHasEn && articleUrlSlug ? `/en/article/${articleUrlSlug}/` : "/en/blog/1/";
    }
    if (/^\/albums\/[^/]+\//.test(stripped)) return "/en/albums/";
    return "/en" + stripped;
}

const localeLabels: Record<string, string> = {
    zh: "中文",
    en: "EN",
};
---

<div class="language-switcher">
    <button
        class="language-switcher-button"
        aria-label={`切换语言，当前：${localeLabels[currentLocale]}`}
        aria-expanded="false"
    >
        <span class="language-icon">
            <DynamicIcon name="tabler:world" width="18" height="18" />
        </span>
        <span class="language-label">{localeLabels[currentLocale]}</span>
    </button>
    <ul class="language-switcher-dropdown">
        {
            locales.map((locale) => (
                <li>
                    <a
                        href={getLocalePath(locale, currentPath)}
                        class:list={[
                            "language-switcher-link",
                            { active: locale === currentLocale },
                        ]}
                        hreflang={locale}
                        lang={locale}
                    >
                        {localeLabels[locale]}
                    </a>
                </li>
            ))
        }
    </ul>
</div>

<style>
    .language-switcher {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .language-switcher-button {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.6rem;
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: 6px;
        cursor: pointer;
        color: var(--color-text);
        font-size: 0.85em;
        font-family: var(--font-body);
        transition:
            background-color 0.2s,
            border-color 0.2s;
    }

    @media (hover: hover) {
        .language-switcher-button:hover {
            background-color: var(--color-hover);
            border-color: var(--color-accent);
        }
    }

    .language-icon {
        display: flex;
        align-items: center;
    }

    .language-switcher-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 0.35rem;
        padding: 0.35rem 0;
        background: var(--color-bg-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        box-shadow: var(--shadow-md);
        list-style: none;
        min-width: max-content;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition:
            opacity 0.2s,
            visibility 0.2s,
            transform 0.2s;
        z-index: 100;
    }

    @media (hover: hover) {
        .language-switcher:hover .language-switcher-dropdown {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
    }
    .language-switcher:focus-within .language-switcher-dropdown,
    .language-switcher-button[aria-expanded="true"] + .language-switcher-dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .language-switcher-link {
        display: block;
        padding: 0.5rem 1rem;
        color: var(--color-text);
        text-decoration: none;
        font-size: 0.9em;
        transition: background-color 0.2s;
    }

    @media (hover: hover) {
        .language-switcher-link:hover {
            background-color: var(--color-hover);
        }
    }

    .language-switcher-link.active {
        color: var(--color-accent);
        font-weight: 500;
    }

    @media screen and (max-width: 768px) {
        .language-label {
            display: none;
        }

        .language-switcher-button {
            padding: 0.35rem;
            min-width: 40px;
            min-height: 40px;
            justify-content: center;
        }
    }
</style>

<script>
    /**
     * 语言切换器的 href 是构建期按「当前这一页」算的，而 header 在 <main> 外、
     * 换页不替换 —— SPA 跳转后链接还指着首屏那一页（实测：/en/ → /en/blog/1/
     * 之后，「中文」仍指向 /，直接把人扔回首页）。
     *
     * 换页后从 head 的 hreflang 里取真值（SeoLinks 每页都输出，swup 的 updateHead
     * 会跟着换），取不到再按同样的回退规则现算，并同步按钮文案。
     */
    const localeLabels: Record<string, string> = { zh: "中文", en: "EN" };

    function altPath(hreflang: string): string | null {
        const link = document.querySelector<HTMLLinkElement>(
            `link[rel="alternate"][hreflang="${hreflang}"]`,
        );
        const href = link?.getAttribute("href");
        if (!href) return null;
        try {
            const url = new URL(href, location.origin);
            return url.pathname + url.search + url.hash;
        } catch {
            return href;
        }
    }

    function fallbackZh(path: string): string {
        if (/^\/(404|500)\//.test(path)) return "/";
        if (path.startsWith("/article/")) return "/blog/1/";
        return path.replace(/^\/en/, "") || "/";
    }

    function fallbackEn(path: string): string {
        if (/^\/(404|500)\//.test(path)) return "/en/";
        if (/^\/(cookies|copyright|privacy-policy|redirect)\//.test(path)) return "/en/";
        if (path.startsWith("/article/")) return "/en/blog/1/";
        if (/^\/albums\/[^/]+\//.test(path)) return "/en/albums/";
        return "/en" + path;
    }

    function syncLanguageSwitcher(): void {
        const root = document.querySelector(".language-switcher");
        if (!root) return;

        const path = location.pathname;
        const isEn = path === "/en" || path.startsWith("/en/");
        const current = isEn ? "en" : "zh";

        const targets: Record<string, string> = {
            zh: altPath("zh") ?? fallbackZh(path),
            en: altPath("en") ?? fallbackEn(path),
        };

        root.querySelectorAll<HTMLAnchorElement>(".language-switcher-link").forEach((link) => {
            const lang = link.getAttribute("hreflang");
            if (!lang || !targets[lang]) return;
            link.setAttribute("href", targets[lang]);
            link.classList.toggle("active", lang === current);
        });

        const btn = root.querySelector<HTMLButtonElement>(".language-switcher-button");
        const label = root.querySelector<HTMLElement>(".language-label");
        if (label) label.textContent = localeLabels[current];
        if (btn) btn.setAttribute("aria-label", `切换语言，当前：${localeLabels[current]}`);
    }

    (function () {
        const btn = document.querySelector<HTMLButtonElement>(".language-switcher-button");

        syncLanguageSwitcher();
        document.addEventListener("astro:page-load", syncLanguageSwitcher);

        if (!btn) return;

        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const expanded = btn.getAttribute("aria-expanded") === "true";
            btn.setAttribute("aria-expanded", String(!expanded));
        });

        // 点击外部关闭
        document.addEventListener("click", () => {
            btn.setAttribute("aria-expanded", "false");
        });

        // SPA 导航后重置
        document.addEventListener("astro:after-swap", () => {
            btn.setAttribute("aria-expanded", "false");
        });
    })();
</script>
