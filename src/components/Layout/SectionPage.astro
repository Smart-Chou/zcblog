---
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageHeader from "~/components/UI/PageHeader.astro";
import EmptyState from "~/components/UI/EmptyState.astro";
import { site } from "~/config";

interface Props {
    title: string;
    description?: string;
    subtitle: string;
    buildTime?: string;
    // Empty state
    empty?: boolean;
    emptyTitle?: string;
    emptyMessage?: string;
    emptyEmoji?: string;
    // SEO
    image?: string;
    imageAlt?: string;
    keywords?: string[];
    publishedTime?: Date | string;
    modifiedTime?: Date | string;
    // Layout
    fullWidth?: boolean;
    // SEO
    noindex?: boolean;
    // i18n
    locale?: string;
}

const {
    title,
    description,
    subtitle,
    buildTime,
    empty,
    emptyTitle,
    emptyMessage,
    emptyEmoji,
    image,
    imageAlt,
    keywords,
    publishedTime,
    modifiedTime,
    locale,
    fullWidth = false,
    noindex = false,
} = Astro.props;

const pageTitle = `${title} - ${site.title}`;
const pageDescription = description || pageTitle;
const defaultEmptyTitle = locale === "en" ? "No data" : "暂无数据";
const showEmpty = empty !== undefined ? empty : false;
const hasIcon = Astro.slots.has("icon");
const hasEmptyIcon = Astro.slots.has("empty-icon");
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    image={image}
    imageAlt={imageAlt}
    keywords={keywords}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    fullWidth={fullWidth}
    noindex={noindex}
    locale={locale}
>
    <div class:list={["section-container", { "section-container--full": fullWidth }]}>
        <PageHeader title={title} subtitle={subtitle} buildTime={buildTime} showIcon={hasIcon}>
            {hasIcon && <slot name="icon" slot="icon" />}
        </PageHeader>

        {
            showEmpty ? (
                <EmptyState
                    title={emptyTitle || defaultEmptyTitle}
                    message={emptyMessage}
                    emoji={emptyEmoji || "📭"}
                >
                    {hasEmptyIcon && <slot name="empty-icon" slot="icon" />}
                </EmptyState>
            ) : (
                <slot />
            )
        }
    </div>
</BaseLayout>

<style>
    .section-container {
        max-width: var(--content-width-max);
        margin: 0 auto;
        padding: 2rem 1.5rem;
    }

    .section-container--full {
        max-width: none;
    }
</style>
