---
import { navLinks } from "~/self.config";

const currentPath = Astro.url.pathname;
---

<button
    id="nav-menu-btn"
    class="nav-menu-btn"
    aria-label="打开菜单"
    aria-expanded="false"
    type="button"
>
    <span class="nav-menu-btn-icon">
        <span class="nav-menu-btn-bar"></span>
        <span class="nav-menu-btn-bar"></span>
        <span class="nav-menu-btn-bar"></span>
    </span>
</button>

<nav
    id="nav-dropdown"
    class="nav-dropdown"
    aria-label="主导航"
    aria-hidden="true"
>
    <ul class="nav-dropdown-list" role="list">
        {
            navLinks.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class:list={[
                            "nav-dropdown-link",
                            {
                                active:
                                    link.href === "/"
                                        ? currentPath === "/"
                                        : currentPath.startsWith(link.href),
                            },
                        ]}
                    >
                        {link.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<script>
    let open = false;

    const getBtn = () =>
        document.getElementById("nav-menu-btn") as HTMLButtonElement | null;
    const getDropdown = () =>
        document.getElementById("nav-dropdown") as HTMLElement | null;

    const setOpen = (v: boolean) => {
        open = v;
        const btn = getBtn();
        const dropdown = getDropdown();
        if (btn) {
            btn.setAttribute("aria-expanded", String(v));
            btn.classList.toggle("nav-menu-btn--open", v);
        }
        if (dropdown) {
            dropdown.setAttribute("aria-hidden", String(!v));
            dropdown.classList.toggle("nav-dropdown--open", v);
        }
    };

    document.addEventListener("click", (e) => {
        const btn = getBtn();
        const dropdown = getDropdown();
        const target = e.target as Node;

        if (btn && btn.contains(target)) {
            e.stopPropagation();
            setOpen(!open);
            return;
        }

        if (open && dropdown && !dropdown.contains(target)) {
            setOpen(false);
        }
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && open) {
            setOpen(false);
            getBtn()?.focus();
        }
    });

    window.addEventListener(
        "scroll",
        () => {
            if (open) setOpen(false);
        },
        { passive: true },
    );

    document.addEventListener("astro:after-swap", () => {
        open = false;
    });
</script>

<style>
    ul li {
        margin: 0.2rem;
    }

    .nav-menu-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: var(--color-body);
        font-size: 0.95em;
        font-weight: 600;
        font-family: var(--font-body);
        cursor: pointer;
        transition: background-color var(--duration-fast);
    }

    .nav-menu-btn:hover {
        background: var(--color-hover);
    }

    .nav-menu-btn-icon {
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: 18px;
    }

    .nav-menu-btn-bar {
        display: block;
        width: 18px;
        height: 2px;
        border-radius: 2px;
        background: var(--color-body);
        transition:
            transform 0.3s,
            opacity 0.3s;
    }

    .nav-menu-btn--open .nav-menu-btn-bar:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }

    .nav-menu-btn--open .nav-menu-btn-bar:nth-child(2) {
        opacity: 0;
    }

    .nav-menu-btn--open .nav-menu-btn-bar:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }

    @media screen and (max-width: 768px) {
        .nav-menu-btn-label {
            display: none;
        }

        .nav-menu-btn {
            padding: 8px;
            min-width: 40px;
            min-height: 40px;
            justify-content: center;
        }
    }

    /* ── Dropdown panel ── */
    .nav-dropdown {
        position: fixed;
        top: 80px;
        left: 50%;
        transform: translateX(-50%) translateY(-8px);
        z-index: 10;
        width: calc(100% - 48px);
        max-width: var(--content-width);
        padding: 0 32px;
        background: var(--color-surface);
        background: color-mix(in srgb, var(--color-surface) 90%, transparent);
        -webkit-backdrop-filter: blur(24px);
        backdrop-filter: blur(24px);
        border: 1px solid var(--color-border);
        border-radius: 28px;
        box-shadow: var(--shadow-lg);
        opacity: 0;
        pointer-events: none;
        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
    }

    .nav-dropdown--open {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
        pointer-events: auto;
    }

    .nav-dropdown-list {
        display: flex;
        justify-content: center;
        gap: 8px;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
    }

    .nav-dropdown-link {
        display: inline-flex;
        align-items: center;
        padding: 0.25em 0.6em;
        margin: 4px 0;
        border-radius: 10px;
        font-size: 1.05em;
        font-weight: 600;
        color: var(--color-body);
        text-decoration: none;
        white-space: nowrap;
        transition:
            color var(--duration-fast),
            background-color var(--duration-fast);
    }

    .nav-dropdown-link:hover {
        color: var(--color-accent);
        background: var(--color-hover);
    }

    .nav-dropdown-link.active {
        color: var(--color-accent);
    }

    @media screen and (max-width: 768px) {
        .nav-dropdown {
            top: 60px;
            width: calc(100% - 24px);
            padding: 12px 16px;
            border-radius: 20px;
        }

        .nav-dropdown-link {
            font-size: 0.95em;
            padding: 0.2em 0.4em;
        }
    }

    @media screen and (max-width: 450px) {
        .nav-dropdown {
            top: 56px;
            border-radius: 16px;
        }
    }
</style>
