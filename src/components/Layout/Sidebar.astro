---
import type { SidebarItem } from "~/config/ui";

interface Props {
    items: SidebarItem[];
    currentPath: string;
}

const { items, currentPath } = Astro.props;

function isActive(item: SidebarItem): boolean {
    const path = item.link || (item.slug ? `/${item.slug}/` : "");
    if (!path) return false;
    return currentPath === path || (path !== "/" && currentPath.startsWith(path));
}
---

<nav class="sidebar" aria-label="侧边导航">
    <ul class="sidebar-list">
        {
            items.map((entry) => {
                if ("items" in entry && entry.items) {
                    return (
                        <li class="sidebar-group">
                            <button
                                class="sidebar-group-label"
                                aria-expanded={!entry.collapsed}
                            >
                                {entry.label}
                            </button>
                            {!entry.collapsed && (
                                <ul class="sidebar-group-items">
                                    {entry.items.map((item) => (
                                        <li>
                                            <a
                                                href={item.link || `/${item.slug}/`}
                                                class:list={[
                                                    "sidebar-link",
                                                    { active: isActive(item) },
                                                ]}
                                                aria-current={isActive(item) ? "page" : undefined}
                                            >
                                                {item.label}
                                                {item.badge && (
                                                    <span class="sidebar-badge">
                                                        {typeof item.badge === "string"
                                                            ? item.badge
                                                            : item.badge.text}
                                                    </span>
                                                )}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </li>
                    );
                }
                return (
                    <li>
                        <a
                            href={entry.link || `/${entry.slug}/`}
                            class:list={["sidebar-link", { active: isActive(entry) }]}
                            aria-current={isActive(entry) ? "page" : undefined}
                        >
                            {entry.label}
                        </a>
                    </li>
                );
            })
        }
    </ul>
</nav>

<style>
    .sidebar {
        width: var(--sidebar-width);
        flex-shrink: 0;
        overflow-y: auto;
        position: sticky;
        top: var(--header-height);
        max-height: calc(100vh - var(--header-height));
        padding: var(--space-lg) var(--space-md);
        border-right: 1px solid var(--color-border);
    }

    .sidebar-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .sidebar-group {
        margin-bottom: var(--space-md);
    }

    .sidebar-group-label {
        font-size: var(--text-xs);
        font-weight: var(--font-weight-semibold);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text-muted);
        padding: var(--space-xs) var(--space-sm);
        margin-bottom: var(--space-xs);
        background: none;
        border: none;
        cursor: pointer;
        width: 100%;
        text-align: left;
    }

    .sidebar-group-items {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--radius-md);
        font-size: var(--text-body-sm);
        color: var(--color-text-muted);
        text-decoration: none;
        transition: background var(--duration-fast), color var(--duration-fast);
    }

    .sidebar-link:hover {
        background: var(--color-hover);
        color: var(--color-text);
    }

    .sidebar-link.active {
        background: var(--color-bg-elevated);
        color: var(--color-accent);
        font-weight: var(--font-weight-medium);
    }

    .sidebar-badge {
        font-size: var(--text-xs);
        padding: 1px 6px;
        border-radius: var(--radius-full);
        background: var(--color-bg-accent);
        color: var(--color-text-invert);
    }

    @media (max-width: 768px) {
        .sidebar {
            display: none;
        }
    }
</style>
