---
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
---

<button id="theme-btn" aria-label="切换主题" aria-pressed="false" class="toggle-theme">
    <DynamicIcon name="tabler:sun" class="feather feather-sun" />
    <DynamicIcon name="tabler:moon-stars" class="feather feather-moon" />
</button>

<script is:inline>
    (function () {
        const STORAGE_KEY = "preferredTheme";

        const getStoredTheme = () => {
            if (typeof localStorage === "undefined") return null;
            try {
                return localStorage.getItem(STORAGE_KEY);
            } catch (e) {
                return null;
            }
        };

        const getSystemTheme = () => {
            return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        };

        const getCurrentTheme = () => {
            return getStoredTheme() || getSystemTheme();
        };

        let themeTransitionTimer = null;

        const setTheme = (theme) => {
            const root = document.documentElement;

            // 启用主题过渡，滚动时不触发
            if (themeTransitionTimer) clearTimeout(themeTransitionTimer);
            root.classList.add("theme-transitions-enabled");

            if (theme === "dark") {
                root.classList.add("dark");
                root.setAttribute("data-theme", "dark");
            } else {
                root.classList.remove("dark");
                root.setAttribute("data-theme", "light");
            }

            try {
                if (typeof localStorage !== "undefined") {
                    localStorage.setItem(STORAGE_KEY, theme);
                }
            } catch (e) {
                // localStorage 不可用时静默失败，主题切换仍生效
            }

            updateButton(theme);

            // 过渡完成后移除标记（500ms = --duration-slower），避免滚动时触发过渡
            themeTransitionTimer = setTimeout(() => {
                root.classList.remove("theme-transitions-enabled");
            }, 500);
        };

        const updateButton = (theme) => {
            const btn = document.getElementById("theme-btn");
            if (!btn) return;

            const isDark = theme === "dark";
            btn.setAttribute("data-theme", theme);
            btn.setAttribute("aria-label", isDark ? "切换为浅色模式" : "切换为深色模式");
            btn.setAttribute("aria-pressed", isDark.toString());
        };

        // 从 DOM 读取当前主题（优先于 localStorage）
        const getThemeFromDOM = () => {
            const root = document.documentElement;
            const domTheme = root.getAttribute("data-theme");
            if (domTheme === "dark" || domTheme === "light") {
                return domTheme;
            }
            // 回退到 class
            if (root.classList.contains("dark")) {
                return "dark";
            }
            return getCurrentTheme(); // 最终回退
        };

        const toggleTheme = () => {
            const currentTheme = getThemeFromDOM();
            const newTheme = currentTheme === "dark" ? "light" : "dark";
            setTheme(newTheme);
        };

        const initThemeToggle = () => {
            const btn = document.getElementById("theme-btn");
            if (!btn) return;

            // 优先使用按钮已有的 data-theme 属性（由 BaseHead 设置）
            let currentTheme = btn.getAttribute("data-theme");

            if (!currentTheme || (currentTheme !== "dark" && currentTheme !== "light")) {
                // 回退到从 DOM 读取
                currentTheme = getThemeFromDOM();
            }

            updateButton(currentTheme);

            if (!btn.dataset.initialized) {
                btn.addEventListener("click", toggleTheme);

                btn.addEventListener("keydown", (e) => {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        toggleTheme();
                    }
                });

                btn.dataset.initialized = "true";
            }
        };

        // 使用 window 属性跨页面持久化，防止 View Transitions 导致重复注册监听器
        if (!window.__themeInitialized) {
            window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
                if (!getStoredTheme()) {
                    setTheme(e.matches ? "dark" : "light");
                }
            });
            window.__themeInitialized = true;
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initThemeToggle);
        } else {
            initThemeToggle();
        }

        document.addEventListener("astro:page-load", initThemeToggle);
    })();
</script>

<style>
    .toggle-theme {
        background: none;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
        border-radius: 50%;
        transition: all var(--duration-slow) var(--ease-out);
        min-width: 44px;
        min-height: 44px;
    }

    /* 仅对鼠标点击隐藏焦点框，键盘导航时保留可见焦点（WCAG 2.1 AA 标准） */
    .toggle-theme:focus:not(:focus-visible) {
        outline: none;
    }

    .toggle-theme:hover {
        background-color: rgba(0, 0, 0, 0.1);
        transform: scale(1.1);
        opacity: 0.8;
    }

    .toggle-theme :global(.feather) {
        transition: all var(--duration-slow) var(--ease-out);
    }

    .toggle-theme :global(.feather-sun) {
        display: none;
        width: 30px;
        height: 30px;
        color: #f59e0b;
    }

    .toggle-theme :global(.feather-moon) {
        display: block;
        width: 30px;
        height: 24px;
        color: #3b82f6;
    }

    .toggle-theme[data-theme="dark"] :global(.feather-sun) {
        display: block;
    }

    .toggle-theme[data-theme="dark"] :global(.feather-moon) {
        display: none;
    }
</style>
