---
import Logo from "~/components/Layout/Logo.astro";
import Nav from "~/components/Layout/Nav.astro";
import Search from "~/components/UI/Search.astro";
import ToggleTheme from "~/components/Layout/ToggleTheme.astro";
import LanguageSwitcher from "~/components/Layout/LanguageSwitcher.astro";
import { search } from "~/config";

interface Props {
    searchEnable?: boolean;
}

const { searchEnable = search.enable } = Astro.props;
---

<header id="progress-container" role="banner">
    <div class="nav-shell">
        <div class="header-left">
            <Logo />
            {searchEnable && <Search />}
        </div>
        <div class="header-right">
            <LanguageSwitcher />
            <Nav />
            <ToggleTheme />
        </div>
    </div>
</header>

<script>
    // 滚动超过阈值时切换导航栏宽度（替代 scroll-driven animation，避免持续重绘）
    // Header 是 fixed 定位的持久元素，scroll 事件绑定一次即可，无需每次 swap 重绑
    const SCROLL_THRESHOLD = 100;
    const navShell = document.querySelector<HTMLElement>(".nav-shell");
    if (navShell && !navShell.dataset.scrollBound) {
        navShell.dataset.scrollBound = "1";
        const onScroll = () => {
            navShell.classList.toggle("scrolled", window.scrollY > SCROLL_THRESHOLD);
        };
        onScroll();
        document.addEventListener("scroll", onScroll, { passive: true });
    }
</script>

<style>
    #progress-container {
        position: fixed;
        top: 16px;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        justify-content: center;
        padding: 0 24px;
        view-transition-name: none;
        transform: translateZ(0);
        will-change: transform;
    }

    .nav-shell {
        width: 100%;
        max-width: var(--content-width);
        height: 72px;
        background: var(--color-surface);
        background: color-mix(in srgb, var(--color-surface) 65%, transparent);
        -webkit-backdrop-filter: blur(24px);
        backdrop-filter: blur(24px);
        border: 1px solid var(--color-border);
        border-radius: 46px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 36px;
        box-shadow: var(--shadow-md);
        transition: background-color var(--duration-slow), max-width 0.3s ease;
    }

    .nav-shell.scrolled {
        max-width: var(--header-width);
    }

    .header-left,
    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    /* Pill-adapted overrides for sub-components */
    .header-right :global(.language-switcher-button) {
        border: none;
        background: transparent;
        padding: 6px 8px;
        font-weight: 500;
        border-radius: 8px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .header-right :global(.language-switcher-button:hover) {
        background-color: var(--color-hover);
    }

    .header-right :global(.toggle-theme) {
        min-width: 36px;
        min-height: 36px;
        padding: 6px;
        border-radius: 8px;
    }

    @media screen and (max-width: 768px) {
        #progress-container {
            top: 0;
            padding: 8px 12px;
        }

        .nav-shell {
            height: 52px;
            border-radius: 26px;
            padding: 0 16px;
            -webkit-backdrop-filter: blur(8px);
            backdrop-filter: blur(8px);
        }

        .header-left,
        .header-right {
            gap: 8px;
        }

        /* Hide search text on mobile */
        .header-right :global(site-search button[data-open-modal]) span {
            display: none;
        }

        .header-right :global(site-search button[data-open-modal]) kbd {
            display: none !important;
        }
    }

    @media screen and (max-width: 450px) {
        .nav-shell {
            height: 48px;
            border-radius: 24px;
            padding: 0 12px;
        }

        .header-left :global(.logo) {
            font-size: 0.8em;
        }
    }
</style>
