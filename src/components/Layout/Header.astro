---
import Logo from "~/components/Layout/Logo.astro";
import Search from "~/components/Widget/Search.astro";
import ToggleTheme from "~/components/Layout/ToggleTheme.astro";
import LanguageSwitcher from "~/components/Layout/LanguageSwitcher.astro";
import { search } from "~/self.config";
const { searchEnable = search.enable } = Astro.props;
---

<header id="nprogress-container" role="banner">
    <div class="scroll-progress"></div>
    <div class="fullwidth">
        <div class="header__left">
            <Logo />
        </div>
        <div class="header__right">
            {searchEnable && <Search />}
            <span style="margin: 0 0.2rem;"></span>
            <LanguageSwitcher />
            <ToggleTheme />
        </div>
    </div>
</header>

<script>
    import Lenis from "lenis";

    const lenis = new Lenis({
        autoRaf: true,
        lerp: 0.1,
        smoothWheel: true,
    });

    document.addEventListener("astro:page-load", () => {
        lenis.on("scroll", ({ progress }: { progress: number }) => {
            const progressBar =
                document.querySelector<HTMLElement>(".scroll-progress");
            if (progressBar) {
                progressBar.style.width = `${progress * 100}%`;
            }
        });
    });
</script>

<style>
    .scroll-progress {
        background: var(--color-accent);
        position: fixed;
        z-index: 1031;
        top: 0;
        left: 0;
        height: 2px;
        width: 0%;
        transition: width 0.1s ease-out;
    }

    #nprogress-container {
        display: flex;
        align-items: center;
        min-height: var(--header-height);
        padding: 0 calc(var(--space) / 2);
        top: 0;
        left: 0;
        right: 0;
        background-color: hsla(0, 0%, 100%, 0.6);
        background-color: rgba(var(--color-bg-rgb), 0.6);
        -webkit-backdrop-filter: blur(32px);
        backdrop-filter: blur(32px);
        z-index: 10;
        position: fixed;
        /* 排除 View Transitions 动画 */
        view-transition-name: none;
        /* 提升为独立合成层，避免抖动 */
        transform: translateZ(0);
        will-change: transform;
    }

    @media screen and (min-width: 1300px) {
        #nprogress-container {
            width: 100%;
        }
    }

    .fullwidth {
        max-width: var(--content-width);
        margin: 0 auto;
        display: flex;
        flex: 1;
        justify-content: space-between;
        align-items: center;
    }

    .header__left,
    .header__right {
        display: flex;
        align-items: center;
        font-family: var(--font-body);
    }

    @media screen and (max-width: 768px) {
        #nprogress-container {
            min-height: 50px;
            padding: 0 10px;
        }

        .header__right {
            gap: var(--space-xs);
        }

        /* 在移动端隐藏搜索按钮文本，只显示图标 */
        site-search button[data-open-modal] span {
            display: none;
        }

        site-search button[data-open-modal] kbd {
            display: none !important;
        }
    }

    @media screen and (max-width: 480px) {
        #nprogress-container {
            min-height: 48px;
        }

        .logo {
            font-size: 0.8em;
        }
    }
</style>
