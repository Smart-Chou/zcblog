---
import Logo from "~/components/Layout/Logo.astro";
import Nav from "~/components/Layout/Nav.astro";
import Search from "~/components/UI/Search.astro";
import ToggleTheme from "~/components/Layout/ToggleTheme.astro";
import LanguageSwitcher from "~/components/Layout/LanguageSwitcher.astro";
import { search } from "~/config";

interface Props {
    searchEnable?: boolean;
    locale?: string;
}

const { searchEnable = search.enable, locale = "zh" } = Astro.props;
---

<header id="progress-container" role="banner">
    <div class="nav-shell">
        <div class="header-left">
            <Logo />
            {searchEnable && <Search locale={locale} />}
        </div>
        <div class="header-right">
            <LanguageSwitcher />
            <Nav />
            <ToggleTheme />
        </div>
    </div>
</header>

<script>
    // 滚动超过阈值时切换导航栏宽度
    // View Transitions 会替换 DOM，必须在 handler 内实时 querySelector
    const SCROLL_THRESHOLD = 100;
    function updateNav() {
        const nav = document.querySelector(".nav-shell");
        if (nav) nav.classList.toggle("scrolled", window.scrollY > SCROLL_THRESHOLD);
    }
    updateNav();
    document.addEventListener("scroll", updateNav, { passive: true });
    document.addEventListener("astro:after-swap", updateNav);
</script>

<style>
    #progress-container {
        position: fixed;
        top: calc(16px + var(--notice-height, 0px));
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        justify-content: center;
        padding: 0 24px;
        view-transition-name: none;
        transform: translateZ(0);
        transition: top 0.3s ease;
    }

    .nav-shell {
        width: 100%;
        max-width: var(--content-width);
        height: 72px;
        background: color-mix(in srgb, var(--color-bg-surface) 92%, transparent);
        border: 1px solid var(--color-border);
        border-radius: 46px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 36px;
        box-shadow: var(--shadow-md);
        transition: background-color var(--duration-slow);
    }

    .nav-shell.scrolled {
        max-width: var(--header-width);
    }

    .header-left,
    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    /* Pill-adapted overrides for sub-components */
    .header-right :global(.language-switcher-button) {
        border: none;
        background: transparent;
        padding: 6px 8px;
        font-weight: 500;
        border-radius: 8px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    @media (hover: hover) {
        .header-right :global(.language-switcher-button:hover) {
            background-color: var(--color-hover);
        }
    }

    .header-right :global(.toggle-theme) {
        min-width: 36px;
        min-height: 36px;
        padding: 6px;
        border-radius: 8px;
    }

    @media screen and (max-width: 768px) {
        #progress-container {
            top: var(--notice-height, 0px);
            padding: 8px 12px;
        }

        .nav-shell {
            height: 52px;
            border-radius: 26px;
            padding: 0 16px;
        }

        .header-left,
        .header-right {
            gap: 8px;
        }

        /* Hide search text on mobile */
        .header-right :global(site-search button[data-open-modal]) span {
            display: none;
        }

        .header-right :global(site-search button[data-open-modal]) kbd {
            display: none !important;
        }
    }

    @media screen and (max-width: 450px) {
        .nav-shell {
            height: 48px;
            border-radius: 24px;
            padding: 0 12px;
        }

        .header-left :global(.logo) {
            font-size: 0.8em;
        }

        .header-right :global(.language-switcher-button) {
            padding: 6px 0;
        }

        .header-right :global(.toggle-theme) {
            padding: 0;
        }
    }
</style>
