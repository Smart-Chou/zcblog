---
import Logo from "~/components/Layout/Logo.astro";
import Nav from "~/components/Layout/Nav.astro";
import Search from "~/components/Widget/Search.astro";
import ToggleTheme from "~/components/Layout/ToggleTheme.astro";
import LanguageSwitcher from "~/components/Layout/LanguageSwitcher.astro";
import { search } from "~/self.config";
const { searchEnable = search.enable } = Astro.props;
---

<div class="scroll-progress"></div>
<header id="progress-container" role="banner">
    <div class="nav-shell">
        <div class="header-left">
            <Logo />
        </div>
        <div class="header-right">
            {searchEnable && <Search />}
            <LanguageSwitcher />
            <Nav />
            <ToggleTheme />
        </div>
    </div>
</header>

<script>
    import Lenis from "lenis";

    const lenis = new Lenis({
        autoRaf: true,
        lerp: 0.1,
        smoothWheel: true,
    });

    document.addEventListener("astro:page-load", () => {
        const navShell = document.querySelector<HTMLElement>(".nav-shell");

        lenis.on("scroll", ({ progress }: { progress: number }) => {
            const progressBar =
                document.querySelector<HTMLElement>(".scroll-progress");
            if (progressBar) {
                progressBar.style.width = `${progress * 100}%`;
            }

            if (navShell) {
                const expand = Math.min(progress / 0.25, 1);
                navShell.style.setProperty("--nav-expand", String(expand));
            }
        });
    });
</script>

<style>
    .scroll-progress {
        background: var(--color-accent);
        position: fixed;
        z-index: 1031;
        top: 0;
        left: 0;
        height: 2px;
        width: 0%;
        transition: width 0.1s ease-out;
    }

    #progress-container {
        position: fixed;
        top: 16px;
        left: 0;
        right: 0;
        z-index: 10;
        display: flex;
        justify-content: center;
        padding: 0 24px;
        view-transition-name: none;
        transform: translateZ(0);
        will-change: transform;
    }

    .nav-shell {
        --nav-expand: 0;
        width: 100%;
        max-width: calc(
            var(--content-width) * (1 - var(--nav-expand)) +
                var(--header-width) * var(--nav-expand)
        );
        height: 72px;
        background: color-mix(in srgb, var(--color-surface) 65%, transparent);
        -webkit-backdrop-filter: blur(24px);
        backdrop-filter: blur(24px);
        border: 1px solid var(--color-border);
        border-radius: 46px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 36px;
        box-shadow: var(--shadow-md);
        transition:
            background-color var(--duration-slow),
            border-color var(--duration-slow),
            box-shadow var(--duration-slow);
    }

    .header-left,
    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    /* Pill-adapted overrides for sub-components */
    .header-right :global(.language-switcher-button) {
        border: none;
        background: transparent;
        padding: 6px 8px;
        font-weight: 500;
        border-radius: 8px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .header-right :global(.language-switcher-button:hover) {
        background-color: var(--color-hover);
    }

    .header-right :global(.toggle-theme) {
        min-width: 36px;
        min-height: 36px;
        padding: 6px;
        border-radius: 8px;
    }

    @media screen and (max-width: 768px) {
        #nprogress-container {
            top: 0;
            padding: 8px 12px;
        }

        .nav-shell {
            height: 52px;
            border-radius: 26px;
            padding: 0 16px;
        }

        .header-left,
        .header-right {
            gap: 8px;
        }

        /* Hide search text on mobile */
        .header-right :global(site-search button[data-open-modal]) span {
            display: none;
        }

        .header-right :global(site-search button[data-open-modal]) kbd {
            display: none !important;
        }
    }

    @media screen and (max-width: 480px) {
        .nav-shell {
            height: 48px;
            border-radius: 24px;
            padding: 0 12px;
        }

        .header-left :global(.logo) {
            font-size: 0.8em;
        }
    }
</style>
