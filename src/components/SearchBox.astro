<div id="docsearch"></div>

<script>
    import { docsearch } from "meilisearch-docsearch";
    import "meilisearch-docsearch/css";
    import { search } from "~/self.config";

    document.addEventListener("astro:page-load", () => {
        if (
            search &&
            search.host &&
            search.apiKey &&
            search.indexUid &&
            search.hotKeys
        ) {
            docsearch({
            container: "#docsearch",
            host: search.host,
            apiKey: search.apiKey,
            indexUid: search.indexUid,
            hotKeys: search.hotKeys,
            // 自定义搜索结果展示
            searchParams: {
                hitsPerPage: 10,
            }
        });
        } else {
            console.error("Search configuration is missing or incomplete.");
        }
    });
</script>
