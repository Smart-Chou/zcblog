<div id="docsearch"></div>

<script>
  import { docsearch } from 'meilisearch-docsearch'
  import 'meilisearch-docsearch/css'
  import { search } from '~/self.config'

  document.addEventListener('astro:page-load', () => {
    const host = search.host
    const apiKey = search.apiKey
    const indexUid = search.indexUid
    const hotKeys = search.hotKeys

    docsearch({
      container: '#docsearch',
      host,
      apiKey,
      indexUid,
      hotKeys,
    })
  })
</script>
