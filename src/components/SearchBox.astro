---

<div id="docsearch"></div>

<style>
    /* 优化搜索框样式 */
    #docsearch {
        width: 100%;
        max-width: 300px;
    }
    
    .ds-dropdown-menu {
        border-radius: 0.5rem;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border: 1px solid var(--border-color);
        background-color: var(--card-background);
        color: var(--text-color);
    }
    
    .ds-dropdown-menu a {
        color: var(--text-color);
    }
    
    .ds-dropdown-menu a:hover,
    .ds-dropdown-menu .ds-suggestion--highlight {
        background-color: var(--primary-color-light);
    }
    
    .ds-dropdown-menu .ds-suggestion {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-color);
    }
    
    .ds-dropdown-menu .ds-suggestion:last-child {
        border-bottom: none;
    }
    
    .ds-dropdown-menu .ds-suggestion--no-results {
        color: var(--text-color-muted);
    }
    
    .ds-dropdown-menu .ds-suggestion .ds-suggestion-title {
        font-weight: 600;
        margin-bottom: 0.25rem;
        color: var(--text-color);
    }
    
    .ds-dropdown-menu .ds-suggestion .ds-suggestion-content {
        font-size: 0.875rem;
        color: var(--text-color-muted);
    }
    
    /* 优化搜索框输入样式 */
    .ds-input {
        border-radius: 0.375rem;
        background-color: var(--input-background);
        border: 1px solid var(--border-color);
        color: var(--text-color);
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
        width: 100%;
        transition: all 0.2s ease;
    }
    
    .ds-input:focus {
        outline: none;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px var(--primary-color-light);
    }
    
    /* 适配深色主题 */
    html[data-theme="dark"] .ds-dropdown-menu {
        background-color: var(--card-background-dark);
        border-color: var(--border-color-dark);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.15);
    }
    
    html[data-theme="dark"] .ds-input {
        background-color: var(--input-background-dark);
        border-color: var(--border-color-dark);
    }
    
    /* 优化搜索结果高亮 */
    .ds-suggestion-highlight {
        background-color: var(--highlight-color);
        color: var(--highlight-text-color);
        padding: 0 0.25rem;
        border-radius: 0.25rem;
    }
    
    /* 优化搜索图标 */
    .ds-search-icon {
        color: var(--text-color-muted);
    }
    
    /* 优化清空按钮 */
    .ds-clear-button {
        color: var(--text-color-muted);
    }
    
    .ds-clear-button:hover {
        color: var(--text-color);
    }
</style>

<script>
    import { docsearch } from "meilisearch-docsearch";
    // meilisearch-docsearch 的 CSS 已在上方 <style> 标签中手动定义，无需额外导入
    import { search } from "~/self.config";

    document.addEventListener("astro:page-load", () => {
        if (
            search &&
            search.host &&
            search.apiKey &&
            search.indexUid &&
            search.hotKeys
        ) {
            docsearch({
            container: "#docsearch",
            host: search.host,
            apiKey: search.apiKey,
            indexUid: search.indexUid,
            hotKeys: search.hotKeys,
            // 自定义搜索结果展示
            searchParams: {
                hitsPerPage: 10,
            }
        });
        } else {
            console.error("Search configuration is missing or incomplete.");
        }
    });
</script>
