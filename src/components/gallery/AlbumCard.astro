---
import MediaCard from "~/components/Widget/MediaCard.astro";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";

interface Props {
    id: string;
    name: string;
    cover?: string;
    description?: string;
    date?: string;
    location?: string;
    tags?: string[];
    photoCount?: number;
}

const { id, name, cover, description, date, location, tags, photoCount } =
    Astro.props;
---

<MediaCard
    href={`/albums/${id}/`}
    image={cover}
    alt={name}
    aspectRatio="4/3"
    placeholderEmoji="📷"
    class="album-card"
    data-tags={tags?.join(",") || ""}
>
    <span slot="badges" class="photo-count">{photoCount || 0} 张</span>
    <div slot="overlay">
        <h3 class="album-name">{name}</h3>
        {description && <p class="album-desc">{description}</p>}
        <div class="album-meta">
            {date && <span>{date}</span>}
            {
                location && (
                    <span class="location">
                        <DynamicIcon name="tabler:map-pin-filled" width="12" height="12" />
                        {location}
                    </span>
                )
            }
        </div>
        {
            tags && tags.length > 0 && (
                <div class="album-tags">
                    {tags.slice(0, 4).map((tag) => (
                        <span class="tag">{tag}</span>
                    ))}
                </div>
            )
        }
    </div>
</MediaCard>

<style>
    .photo-count {
        position: absolute;
        top: 8px;
        right: 8px;
        padding: 4px 10px;
        border-radius: 20px;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        color: white;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .album-name {
        font-size: 1rem;
        font-weight: 600;
        color: #f0f0f0;
        margin-bottom: 0.25rem;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .album-desc {
        font-size: 0.85rem;
        opacity: 0.9;
        margin-bottom: 0.5rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .album-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        font-size: 0.75rem;
        opacity: 0.8;
    }

    .location {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .album-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 0.5rem;
    }

    .tag {
        font-size: 0.65rem;
        padding: 2px 8px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.2);
        color: white;
    }
</style>
