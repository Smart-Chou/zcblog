---
import Location from "~/components/icons/Location.astro";

interface Props {
    id: string;
    name: string;
    cover?: string;
    description?: string;
    date?: string;
    location?: string;
    tags?: string[];
    photoCount?: number;
}

const { id, name, cover, description, date, location, tags, photoCount } =
    Astro.props;
---

<a href={`/albums/${id}/`} data-tags={tags?.join(",") || ""} class="album-card">
    <div class="album-cover">
        {
            cover ? (
                <img
                    src={cover}
                    alt={name}
                    class="cover-img"
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <div class="cover-placeholder">📷</div>
            )
        }
        <div class="photo-count-badge">{photoCount || 0} 张</div>
        <div class="album-info">
            <h3 class="album-name">{name}</h3>
            {description && <p class="album-desc">{description}</p>}
            <div class="album-meta">
                {date && <span>{date}</span>}
                {
                    location && (
                        <span class="location">
                            <Location width="12" height="12" />
                            {location}
                        </span>
                    )
                }
            </div>
            {
                tags && tags.length > 0 && (
                    <div class="album-tags">
                        {tags.slice(0, 4).map((tag) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</a>

<style>
    .album-card {
        display: block;
        text-decoration: none;
        border-radius: 12px;
        overflow: hidden;
        background: var(--bg-content-color);
        box-shadow: var(--shadow-small);
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    .album-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .album-cover {
        position: relative;
        aspect-ratio: 4/3;
        overflow: hidden;
    }

    .cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .album-card:hover .cover-img {
        transform: scale(1.05);
    }

    .cover-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f0f0;
        font-size: 4rem;
    }

    .photo-count-badge {
        position: absolute;
        top: 8px;
        right: 8px;
        padding: 4px 10px;
        border-radius: 20px;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        color: white;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .album-info {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 1.5rem 1rem 1rem;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
        color: white;
    }

    .album-name {
        font-size: 1rem;
        font-weight: 600;
        color: #f0f0f0;
        margin-bottom: 0.25rem;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .album-desc {
        font-size: 0.85rem;
        opacity: 0.9;
        margin-bottom: 0.5rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .album-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        font-size: 0.75rem;
        opacity: 0.8;
    }

    .location {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .album-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 0.5rem;
    }

    .tag {
        font-size: 0.65rem;
        padding: 2px 8px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.2);
        color: white;
    }
</style>
