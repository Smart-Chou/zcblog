---
interface Props {
	id: string;
	name: string;
	cover: string;
	description?: string;
	date?: string;
	location?: string;
	tags?: string[];
	photoCount: number;
}

const { id, name, cover, description, date, location, tags, photoCount } = Astro.props;
---

<a href={`/album/${id}/`} data-tags={tags?.join(",") || ""} class="album-card">
	<div class="album-cover">
		{cover ? (
			<img src={cover} alt={name} class="cover-img" loading="lazy" decoding="async" />
		) : (
			<div class="cover-placeholder">📷</div>
		)}
		<div class="photo-count-badge">{photoCount} 张</div>
	</div>
	<div class="album-info">
		<h3 class="album-name">{name}</h3>
		{description && <p class="album-desc">{description}</p>}
		<div class="album-meta">
			{date && <span>{date}</span>}
			{location && (
				<span class="location">
					<svg viewBox="0 0 24 24" fill="currentColor" width="12" height="12"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
					{location}
				</span>
			)}
		</div>
		{tags && tags.length > 0 && (
			<div class="album-tags">
				{tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
			</div>
		)}
	</div>
</a>

<style>
	.album-card {
		display: block;
		text-decoration: none;
		border-radius: 12px;
		overflow: hidden;
		background: var(--bg-content-color);
		box-shadow: var(--shadow-small);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.album-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
	}

	.album-cover {
		position: relative;
		aspect-ratio: 4/3;
		overflow: hidden;
	}

	.cover-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.album-card:hover .cover-img {
		transform: scale(1.05);
	}

	.cover-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #f0f0f0;
		font-size: 4rem;
	}

	.photo-count-badge {
		position: absolute;
		top: 8px;
		right: 8px;
		padding: 4px 10px;
		border-radius: 20px;
		background: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(4px);
		color: white;
		font-size: 0.75rem;
		font-weight: 500;
	}

	.album-info {
		padding: 1rem;
	}

	.album-name {
		font-size: 1rem;
		font-weight: 600;
		color: var(--title-color);
		margin-bottom: 0.25rem;
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.album-desc {
		font-size: 0.85rem;
		color: var(--body-color);
		opacity: 0.8;
		margin-bottom: 0.5rem;
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.album-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-size: 0.75rem;
		color: var(--body-color);
		opacity: 0.7;
	}

	.location {
		display: flex;
		align-items: center;
		gap: 2px;
	}

	.album-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		margin-top: 0.5rem;
	}

	.tag {
		font-size: 0.65rem;
		padding: 2px 8px;
		border-radius: 4px;
		background: rgba(0, 0, 0, 0.1);
		color: var(--body-color);
	}
</style>