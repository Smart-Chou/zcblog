---
import { getIconSvg } from "~/components/icons";

interface Props {
    name: string;
    class?: string;
    width?: number | string;
    height?: number | string;
    style?: string;
}

const { name, class: className, width, height, style } = Astro.props;

const svg = getIconSvg(name);

let result = svg;
if (svg) {
    result = svg.replace(/<svg([^>]*)>/, (_full: string, attrs: string) => {
        let cleanAttrs = attrs;
        if (width) {
            cleanAttrs = cleanAttrs.replace(/\s+width="[^"]*"/g, "");
        }
        if (height) {
            cleanAttrs = cleanAttrs.replace(/\s+height="[^"]*"/g, "");
        }
        const additions: string[] = [];
        if (className) additions.push(`class="${className}"`);
        if (width) additions.push(`width="${typeof width === "number" ? width : width}"`);
        if (height) additions.push(`height="${typeof height === "number" ? height : height}"`);
        if (style) additions.push(`style="${style}"`);
        return `<svg${cleanAttrs}${additions.length ? " " + additions.join(" ") : ""}>`;
    });
}
---

{svg ? <Fragment set:html={result} /> : <span>?</span>}
