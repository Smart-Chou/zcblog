---
import { getIconSvg } from "~/constants/icons";

interface Props {
    name: string;
    class?: string;
    width?: number | string;
    height?: number | string;
    style?: string;
}

const { name, class: className, width, height, style } = Astro.props;

const svg = getIconSvg(name);

let result = svg;
if (className) {
    result = result.replace("<svg", `<svg class="${className}"`);
}
if (width) {
    const w = typeof width === "number" ? String(width) : width;
    result = result.replace("<svg", `<svg width="${w}"`);
}
if (height) {
    const h = typeof height === "number" ? String(height) : height;
    result = result.replace("<svg", `<svg height="${h}"`);
}
if (style) {
    result = result.replace("<svg", `<svg style="${style}"`);
}
---

{svg ? <Fragment set:html={result} /> : <span>?</span>}
