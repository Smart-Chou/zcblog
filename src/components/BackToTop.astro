---
import { Icon } from "astro-icon/components";
---

<div id="back-to-top">
    <Icon name="simple-icons:spaceship" />
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const backToTopElement = document.getElementById("back-to-top");

        if (backToTopElement) {
            window.addEventListener("scroll", function () {
                const scrollHeight = window.scrollY;
                if (scrollHeight > 1000) {
                    backToTopElement.classList.add("active");
                } else {
                    backToTopElement.classList.remove("active");
                }
            });

            backToTopElement.addEventListener("click", function () {
                window.scrollTo({
                    top: 0,
                    behavior: "smooth",
                });
            });
        }
    });
</script>
