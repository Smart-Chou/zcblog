---
import { Icon } from 'astro-icon/components'
---

<div id="back-to-top">
  <Icon name="simple-icons:spaceship" />
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    window.addEventListener('scroll', function (e) {
      const scrollHeight = window.scrollY
      const backToTopElement = document.getElementById('back-to-top')
      if (backToTopElement && scrollHeight > 1000) {
        backToTopElement.classList.add('active')
      } else if (backToTopElement) {
        backToTopElement.classList.remove('active')
      }
    })
    const backToTopElement = document.getElementById('back-to-top')
    if (backToTopElement) {
      backToTopElement.addEventListener('click', function (e) {
        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        })
      })
    }
  })
</script>
