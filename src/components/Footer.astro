---
import { Icon } from 'astro-icon/components'
import { site, footerList } from '~/self.config'

const currentYear = new Date().getFullYear()
---

<footer class="footer">
  <div class="footer__copyright"><span>© {site.startYear} - {currentYear}.&nbsp;All rights reserved</span></div>
  <div class="footer__links"><a href={site.beianURL} target="_blank"><span>{site.beian}</span></a></div>
  {
    footerList.map(footer => (
      <div class="footer__links">
        <span>{footer.text}</span>
        <Icon name={footer.icon} />
        <a href={footer.url}>{footer.title}</a>
      </div>
    ))
  }
  <div id="rss-stats">
    &nbsp;&nbsp;
    <a href="/rss.xml"><span>RSS</span></a>
    <Icon name="tabler:point-filled" />
    <a href="/sitemap-index.xml"><span>Sitemap</span></a>
  </div>
</footer>

<style>
  .footer a:hover {
    text-decoration: underline;
  }
  span {
    margin: 0.25rem;
  }
</style>
