---
import { site, footerList } from "~/self.config";
import { Image } from "astro:assets";

const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
    <div class="footer__copyright">
        <span>
            Copyright {site.startYear} - {currentYear}. All rights reserved.
        </span>
    </div>
    <div class="footer__links">
        <a
            href={site.beianURL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ICP 备案信息"
        >
            <span>{site.beian}</span>
        </a>
    </div>
    <div class="footer__links">
        {
            footerList.map((meta) => (
                <a
                    data-key={`footer-link-${meta.title}`}
                    href={meta.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${meta.title}: ${meta.text}`}
                >
                    <Image
                        src={`https://img.shields.io/badge/${meta.title}-${meta.text}-${meta.color}?logo=${meta.logo}&logoColor=${meta.logoColor}&labelColor=${meta.labelColor}`}
                        alt={`${meta.title} badge`}
                        loading="lazy"
                        width={120}
                        height={20}
                    />
                </a>
            ))
        }
    </div>
    <div id="rss-stats">
        &nbsp;&nbsp;
        <a href="/rss.xml">
            <Image
                src="https://img.shields.io/badge/RSS-sky?logo=rss"
                alt="RSS"
                loading="lazy"
                width={80}
                height={20}
            />
        </a>
        <a href="/sitemap-index.xml">
            <Image
                src="https://img.shields.io/badge/sitemap-%232bb24c?style=flat-square&logo=maplibre&logoColor=%23ffffff&labelColor=%232bb24c&link=https%3A%2F%2Fmarxchou.com%2Fsitemap-index.xml"
                alt="sitemap"
                loading="lazy"
                width={100}
                height={20}
            />
        </a>
    </div>
</footer>

<style>
    .footer {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: var(--space) 15px var(--space);
        text-align: center;
        line-height: 1.8;
        font-size: 0.9em;
        font-family: var(--base-font-family);
        margin-top: auto;
    }

    .footer > span {
        margin: 0.25em;
    }

    .footer a {
        color: currentColor;
    }

    .footer svg {
        max-width: 0.9rem;
    }

    .footer #rss-stats {
        padding-top: 0.35rem;
    }

    .footer #rss-stats a {
        margin-right: 0.35rem;
    }
</style>
