---
import Umami from "~/components/Umami.astro";
import { site, footerList } from "~/self.config";

const currentYear = new Date().getFullYear();
---

<footer class="footer">
    <div class="footer__copyright">
        <span>
            Copyright {site.startYear} - {currentYear}.&nbsp;&nbsp;All rights reserved
        </span>
    </div>
    <div class="footer__links">
        <a href={site.beianURL} target="_blank"><span>{site.beian}</span></a>
    </div>
    <div class="footer__links">
        {
            footerList.map((meta) => (
                <a href={meta.url} target="_blank">
                    <img
                        alt={meta.title}
                        src={`https://img.shields.io/badge/${meta.title}-${meta.text}-${meta.color}?logo=${meta.logo}&logoColor=${meta.logoColor}&labelColor=${meta.labelColor}`}
                    />
                </a>
            ))
        }
    </div>
    <div id="rss-stats">
        &nbsp;&nbsp;
        <a href="/rss.xml">
            <img
                src="https://img.shields.io/badge/RSS-sky?logo=rss"
                alt="rss"
            />
        </a>
        <a href="/sitemap-index.xml">
            <img
                alt="Static Badge"
                src="https://img.shields.io/badge/dynamic/json?url=https%3A%2F%2Fapi.swo.moe%2Fstats%2Ffeedly%2Fhttps%253A%252F%252Fmarxchou.com%252Frss.xml&query=count&color=004fff&label=Feedly&labelColor=2bb24c&logo=feedly&logoColor=ffffff&suffix=+subs&cacheSeconds=3600"
            />
        </a>
    </div>
    <Umami />
</footer>
