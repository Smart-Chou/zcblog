---
import { site, footerList } from "~/self.config";
import { Image } from "astro:assets";

const currentYear = new Date().getFullYear();
---

<footer class="footer">
    <div class="footer__copyright">
        <span>
            Copyright {site.startYear} - {currentYear}. All rights reserved.
        </span>
    </div>
    <div class="footer__links">
        <a href={site.beianURL} target="_blank" rel="noopener noreferrer">
            <span>{site.beian}</span>
        </a>
    </div>
    <div class="footer__links">
        {
            footerList.map((meta) => (
                <a
                    data-key={`footer-link-${meta.title}`}
                    href={meta.url}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <Image
                        src={`https://img.shields.io/badge/${meta.title}-${meta.text}-${meta.color}?logo=${meta.logo}&logoColor=${meta.logoColor}&labelColor=${meta.labelColor}`}
                        alt={meta.title}
                        loading="lazy"
                        width={120}
                        height={20}
                    />
                </a>
            ))
        }
    </div>
    <div id="rss-stats">
        &nbsp;&nbsp;
        <a href="/rss.xml">
            <Image
                src="https://img.shields.io/badge/RSS-sky?logo=rss"
                alt="RSS"
                loading="lazy"
                width={80}
                height={20}
            />
        </a>
        <a href="/sitemap-index.xml">
            <Image
                src="https://img.shields.io/badge/sitemap-%232bb24c?style=flat-square&logo=maplibre&logoColor=%23ffffff&labelColor=%232bb24c&link=https%3A%2F%2Fmarxchou.com%2Fsitemap-index.xml"
                alt="sitemap"
                loading="lazy"
                width={100}
                height={20}
            />
        </a>
    </div>
</footer>
