---
import type { UserSubjectCollection } from "~/types/bangumi";

interface Props {
    item: UserSubjectCollection;
    loadImage?: boolean;
}

const { item, loadImage = false } = Astro.props;

const subject_base_url = "https://bgm.tv/subject/";

const getStatusColor = (type: number) => {
    switch (type) {
        case 1:
            return "var(--status-wish)"; // 想看
        case 2:
            return "var(--status-watched)"; // 看过
        case 3:
            return "var(--status-watching)"; // 在看
        case 4:
            return "var(--status-on-hold)"; // 搁置
        case 5:
            return "var(--status-dropped)"; // 抛弃
        default:
            return "var(--status-unknown)";
    }
};

const getStatusText = (type: number) => {
    const subjectType = item.subject.type;
    switch (type) {
        case 1:
            return subjectType === 1
                ? "想读"
                : subjectType === 3
                  ? "想听"
                  : subjectType === 4
                    ? "想玩"
                    : "想看";
        case 2:
            return subjectType === 1
                ? "读过"
                : subjectType === 3
                  ? "听过"
                  : subjectType === 4
                    ? "玩过"
                    : "看过";
        case 3:
            return subjectType === 1
                ? "在读"
                : subjectType === 3
                  ? "在听"
                  : subjectType === 4
                    ? "在玩"
                    : "在看";
        case 4:
            return "搁置";
        case 5:
            return "抛弃";
        default:
            return "未知";
    }
};

const displayTags =
    item.tags && item.tags.length > 0
        ? item.tags
        : (item.subject.tags || [])
              .map((t: { name: string }) => t.name)
              .slice(0, 5);
const visibleCoverTags = displayTags.slice(0, 3);
const hiddenCoverTagCount = Math.max(
    displayTags.length - visibleCoverTags.length,
    0,
);
---

<a
    href={`${subject_base_url}${item.subject.id}`}
    target="_blank"
    rel="noopener noreferrer nofollow"
    class="bangumi-card"
>
    <div class="card-cover">
        {
            item.subject?.images?.medium ? (
                <img
                    src={loadImage ? item.subject.images.medium : undefined}
                    data-src={
                        loadImage ? undefined : item.subject.images.medium
                    }
                    alt={item.subject.name_cn || item.subject.name}
                    class="cover-img"
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <div class="cover-placeholder">📖</div>
            )
        }
        <div
            class="status-badge"
            style={`background: ${getStatusColor(item.type)}`}
        >
            {getStatusText(item.type)}
        </div>
        {
            item.subject.score && (
                <div class="score-badge">
                    <span class="star">⭐</span>
                    {item.subject.score}
                </div>
            )
        }
        <div class="card-info-overlay">
            <h3 class="card-title">
                {item.subject.name_cn || item.subject.name}
            </h3>
            {
                item.subject.date && (
                    <p class="card-date">{item.subject.date.substring(0, 4)}</p>
                )
            }
            {
                displayTags && displayTags.length > 0 && (
                    <div class="card-tags">
                        {visibleCoverTags.map((tag: string) => (
                            <span class="tag">{tag}</span>
                        ))}
                        {hiddenCoverTagCount > 0 && (
                            <span class="tag tag-more">
                                +{hiddenCoverTagCount}
                            </span>
                        )}
                    </div>
                )
            }
        </div>
    </div>
</a>

<style>
    .bangumi-card {
        display: block;
        text-decoration: none;
        border-radius: 12px;
        overflow: hidden;
        background: var(--bg-content-color);
        box-shadow: var(--shadow-small);
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    .bangumi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .card-cover {
        position: relative;
        aspect-ratio: 2/3;
        overflow: hidden;
    }

    .cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .bangumi-card:hover .cover-img {
        transform: scale(1.05);
    }

    .cover-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0f0f0;
        font-size: 3rem;
    }

    .status-badge {
        position: absolute;
        top: 8px;
        left: 8px;
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 0.7rem;
        color: white;
        font-weight: 500;
        background: var(--status-unknown);
    }

    .score-badge {
        position: absolute;
        top: 8px;
        right: 8px;
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 0.7rem;
        color: white;
        font-weight: 500;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .star {
        font-size: 0.75rem;
    }

    .card-info-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 12px;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
        color: white;
    }

    .card-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: white;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-date {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.8);
        margin-top: 4px;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 8px;
    }

    .tag {
        font-size: 0.65rem;
        padding: 2px 6px;
        border-radius: 4px;
        background: rgba(255, 255, 255, 0.2);
        color: white;
    }

    .tag-more {
        opacity: 0.6;
    }
</style>
