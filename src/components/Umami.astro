---
import { umami } from "~/self.config";
---

<div class="analytics">
    <img
        id="pageviews-img"
        src="https://img.shields.io/badge/%E6%B5%8F%E8%A7%88%E9%87%8F-0-%23ff43bf?logo=googleanalytics"
        alt="浏览量"
    />
    <img
        id="visits-img"
        src="https://img.shields.io/badge/%E8%AE%BF%E9%97%AE%E9%87%8F-0-%23ffdf41?logo=googlebigquery&logoColor=%2344ffcc"
        alt="访问量"
    />
    <img
        id="visitors-img"
        src="https://img.shields.io/badge/%E8%AE%BF%E5%AE%A2-0-%238444ff?logo=codementor&logoColor=%23f544ac"
        alt="访客"
    />
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const umamiBaseUrl = import.meta.env.PUBLIC_UMAMI_BASE_URL;
        const umamiToken = import.meta.env.PUBLIC_UMAMI_API_TOKEN;
        const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
        
        // 如果没有设置环境变量，则不执行后续代码
        if (!umamiToken || !umamiWebsiteId || !umamiBaseUrl) {
            console.error("Umami 配置未完成，请检查环境变量");
            return;
        }
        
        const startAT =
            "startAt=" +
            new Date("2024-05-10T17:33:05.410Z").getTime().toString();
        const endAT = "&endAt=" + new Date().getTime().toString();
        const fullUrl = window.location;
        const postPath = fullUrl.pathname;

        const umamiUrl =
            umamiBaseUrl +
            umamiWebsiteId +
            "/stats?" +
            startAT +
            endAT +
            "&url=" +
            encodeURIComponent(postPath);

        // 修改 fetch 配置以正确处理 CORS 和 Authorization
        const fetchOptions = {
            method: "GET",
            credentials: "same-origin", // 限制凭证使用范围
            headers: {
                "Authorization": `Bearer ${umamiToken}`,
                "Content-Type": "application/json",
            },
        };

        // 添加预检请求验证
        fetch(umamiUrl as RequestInfo, fetchOptions as RequestInit)
            .then((res) => {
                if (!res.ok) {
                    if (res.status === 401) {
                        throw new Error("认证失败");
                    }
                    throw new Error(`HTTP error! status: ${res.status}`);
                }
                return res.json();
            })
            .then((resdata) => {
                const pageviewsImg = document.querySelector(
                    "#pageviews-img",
                ) as HTMLImageElement;
                const visitsImg = document.querySelector(
                    "#visits-img",
                ) as HTMLImageElement;
                const visitorsImg = document.querySelector(
                    "#visitors-img",
                ) as HTMLImageElement;

                if (
                    pageviewsImg &&
                    resdata.pageviews &&
                    resdata.pageviews.value !== undefined
                ) {
                    const pageviewsValue = resdata.pageviews.value;
                    pageviewsImg.src = `https://img.shields.io/badge/%E6%B5%8F%E8%A7%88%E9%87%8F-${pageviewsValue}-%23ff43bf?logo=googleanalytics`;
                } else {
                    console.error(
                        "pageviews data is missing or malformed or element is not found",
                    );
                }

                if (
                    visitorsImg &&
                    resdata.visitors &&
                    resdata.visitors.value !== undefined
                ) {
                    const visitorsValue = resdata.visitors.value;
                    visitorsImg.src = `https://img.shields.io/badge/%E8%AE%BF%E5%AE%A2-${visitorsValue}-%238444ff?logo=codementor&logoColor=%23f544ac`;
                } else {
                    console.error(
                        "visitors data is missing or malformed or element is not found",
                    );
                }

                if (
                    visitsImg &&
                    resdata.visits &&
                    resdata.visits.value !== undefined
                ) {
                    const visitsValue = resdata.visits.value;
                    visitsImg.src = `https://img.shields.io/badge/%E8%AE%BF%E9%97%AE%E9%87%8F-${visitsValue}-%23ffdf41a6?logo=googlebigquery&logoColor=%2344ffcc`;
                } else {
                    console.error(
                        "visits data is missing or malformed or element is not found",
                    );
                }
            })
            .catch((error) => {
                console.error("获取 Umami 统计数据时出错:", error);
                // 可以考虑在此处隐藏或显示错误状态的徽章
            });
    });
</script>
