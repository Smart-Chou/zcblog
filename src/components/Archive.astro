---
const { title, url, publishedTime } = Astro.props;
const formattedDate = new Date(publishedTime).toLocaleDateString('en-US', {
    month: '2-digit',
    day: '2-digit'
});
---

<p class="archive-meta">
    <span class="archive-date">{formattedDate}</span>
    <a class="archive-title" href={url}>{title}</a>
</p>
