---
import { getAllTags, getAllArticles } from "~/utils/article-stats";
import SectionPage from "~/components/Layout/SectionPage.astro";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import Author from "~/components/UI/Author.astro";
import { site, tagsPage } from "~/config";

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const isEn = locale === "en";

const allPosts = await getAllArticles();

const allTags = getAllTags(allPosts, 3);
const tagCounts = allTags.reduce(
    (acc, tag) => {
        const key = tag.toUpperCase();
        acc[key] = (acc[key] || 0) + 1;
        return acc;
    },
    {} as Record<string, number>,
);

const sortedTags = Object.entries(tagCounts)
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const maxTagCount = Math.max(...sortedTags.map((t) => t.count), 1);

function getTagLevel(count: number): number {
    const percentage = count / maxTagCount;
    if (percentage >= 0.8) return 5;
    if (percentage >= 0.6) return 4;
    if (percentage >= 0.4) return 3;
    if (percentage >= 0.2) return 2;
    return 1;
}
---

<SectionPage
    title={tagsPage.title}
    subtitle={isEn ? "" : "快来看看有没有你感兴趣的标签吧！"}
    description={`${tagsPage.description} - ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={tagsPage.title}
    keywords={["Tags"]}
    publishedTime={new Date()}
    modifiedTime={new Date()}
    noindex={true}
>
    <DynamicIcon name="tabler:tags" slot="icon" />

    <div class="tag-cloud">
        {
            sortedTags.map(({ name, count }) => (
                <span class="tag-item">
                    <a href={`/tags/${name}/`}>{name}</a>
                    <span class="tag-count" data-level={getTagLevel(count)}>
                        {count}
                    </span>
                </span>
            ))
        }
    </div>
    <Author />
</SectionPage>

<style>
    .tag-cloud {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }

    .tag-item {
        margin: 0.25em;
        border-radius: 2em;
        padding: 0.5em 1em;
        font-size: 1em;
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        background-color: var(--color-bg);
        border: 1px solid var(--color-border);
    }

    .tag-item a {
        text-decoration: none;
    }

    .tag-item a:hover {
        text-decoration: underline;
    }

    .tag-count {
        font-size: 0.75em;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.8em;
        height: 1.8em;
        border-radius: 50%;
        font-weight: 600;
        color: white;
    }

    .tag-count[data-level="1"] {
        background: #93c5fd;
    }
    .tag-count[data-level="2"] {
        background: #60a5fa;
    }
    .tag-count[data-level="3"] {
        background: #3b82f6;
    }
    .tag-count[data-level="4"] {
        background: #1d4ed8;
    }
    .tag-count[data-level="5"] {
        background: #1e40af;
    }

    html[data-theme="dark"] .tag-count[data-level="1"] {
        background: #1e3a5f;
    }
    html[data-theme="dark"] .tag-count[data-level="2"] {
        background: #1d4ed8;
    }
    html[data-theme="dark"] .tag-count[data-level="3"] {
        background: #2563eb;
    }
    html[data-theme="dark"] .tag-count[data-level="4"] {
        background: #3b82f6;
    }
    html[data-theme="dark"] .tag-count[data-level="5"] {
        background: #60a5fa;
    }
</style>
