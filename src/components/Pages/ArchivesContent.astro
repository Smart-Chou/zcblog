---
import { getCollection } from "astro:content";
import SectionPage from "~/components/Layout/SectionPage.astro";
import Archive from "~/components/UI/Archive.astro";
import Author from "~/components/UI/Author.astro";
import Heatmap from "~/components/UI/Heatmap.astro";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { site, archivesPage } from "~/config";
import { enrichPost } from "~/utils/get-posts-with-meta";
import { sortByPubDate, formatDateToYYYYMMDD } from "~/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const isEn = locale === "en";

interface PostWithMeta extends CollectionEntry<"article"> {
    wordCount: number;
    slug: string;
}

interface PostsByYear {
    [year: number]: PostWithMeta[];
}

const allPosts = await getCollection("article");

const postsWithMeta = allPosts.map((post) => enrichPost(post)) as PostWithMeta[];

const postsByYear = postsWithMeta.reduce<PostsByYear>((acc, post) => {
    const year = new Date(post.data.pubDate).getFullYear();
    if (!acc[year]) {
        acc[year] = [];
    }
    acc[year].push(post);
    return acc;
}, {});

const totalPosts = postsWithMeta.length;
const totalWords = postsWithMeta.reduce((sum, post) => sum + post.wordCount, 0);
const totalWordsInThousands = (totalWords / 1000).toFixed(1) + "k";

const startYear = Math.min(
    ...postsWithMeta.map((post) => new Date(post.data.pubDate).getFullYear()),
);

const postsData = postsWithMeta.map((post) => ({
    date: post.data.pubDate ? formatDateToYYYYMMDD(new Date(post.data.pubDate)) : "",
    title: post.data.title || "",
    wordCount: post.wordCount,
}));
---

<SectionPage
    title={archivesPage.title}
    subtitle={isEn
        ? `(｡･∀･)ﾉﾞ Since ${startYear}, I've published ${totalPosts} posts with a total of ${totalWordsInThousands} words.`
        : `(｡･∀･)ﾉﾞ 自 ${startYear} 以来, 我共发布了 ${totalPosts} 篇文章，共计 ${totalWordsInThousands} 字。`}
    description={`${archivesPage.description} - ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={archivesPage.description}
    keywords={["Archives"]}
    publishedTime={new Date()}
    modifiedTime={new Date()}
>
    <DynamicIcon name="tabler:archive" slot="icon" />
    <section class="stats-section">
        <Heatmap postsData={postsData} />
    </section>
    <div style="padding: 0 2rem;">
        {
            Object.keys(postsByYear)
                .map((year) => Number(year))
                .sort((a, b) => new Date(b).getTime() - new Date(a).getTime())
                .map((year) => (
                    <section data-key={year}>
                        <h2>{year}</h2>
                        {sortByPubDate(postsByYear[year]).map((post) => (
                            <Archive
                                key={post.slug}
                                url={`/article/${post.slug}/`}
                                title={post.data.title}
                                publishedTime={post.data.pubDate}
                            />
                        ))}
                    </section>
                ))
        }
    </div>
    <Author />
</SectionPage>
