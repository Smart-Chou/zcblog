---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Author from "~/components/UI/Author.astro";
import PostCard from "~/components/Article/PostCard.astro";
import Pagination from "~/components/UI/Pagination.astro";
import BackToTop from "~/components/Layout/BackToTop.astro";
import Hitokoto from "~/components/UI/Hitokoto.astro";
import { site, pageView } from "~/config";
import { getRandomImageUrl } from "~/utils";
import { getLocale, t } from "~/utils/i18n";

interface PostData {
    slug: string;
    url: string;
    data: {
        title: string;
        pubDate: Date;
        tags?: string[];
        image?: { url?: string; alt?: string };
        description?: string;
    };
    wordCount: number;
    readTime: string;
    modifiedTime: Date | string;
    excerpt: string;
    sticky?: number;
}

interface Props {
    locale?: string;
    page: {
        data: PostData[];
        url: { prev?: string; next?: string };
        currentPage: number;
        lastPage: number;
    };
}

const { locale = "zh", page } = Astro.props;
const loc = getLocale(locale);
const postsWithMeta = page.data;
const latestModified = postsWithMeta[0]?.modifiedTime || new Date();
const blogPath = loc === "en" ? "/en/blog" : "/blog";
const prevUrl = page.url.prev ? new URL(page.url.prev, Astro.site).toString() : undefined;
const nextUrl = page.url.next ? new URL(page.url.next, Astro.site).toString() : undefined;
---

<BaseLayout
    title={`${t(loc, "site.subtitle")} - ${site.title}`}
    description={`${site.title} - ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={site.coverImageAlt}
    keywords={site.keywords}
    publishedTime={new Date()}
    modifiedTime={latestModified}
    prevUrl={prevUrl}
    nextUrl={nextUrl}
    locale={locale}
    noindex={page.currentPage > 1}
>
    <Hitokoto />
    {pageView.author && <Author />}
    <div class="post">
        {postsWithMeta.length === 0 && <p class="blog-empty">{t(loc, "blog.empty")}</p>}
        {
            postsWithMeta.map((post, index: number) => (
                <PostCard
                    key={post.slug}
                    title={post.data.title}
                    publishedTime={post.data.pubDate}
                    modifiedTime={post.modifiedTime}
                    postUrl={post.url}
                    imagePath={post.data.image?.url || getRandomImageUrl()}
                    description={post.data.description || post.excerpt}
                    tags={post.data.tags}
                    wordCount={post.wordCount}
                    readTime={post.readTime}
                    currentSlug={post.slug}
                    altText={post.data.image?.alt || "Blog Cover"}
                    loading={index < 3 ? "eager" : "lazy"}
                    sticky={post.sticky}
                />
            ))
        }
    </div>
    {page.lastPage > 1 && <Pagination page={page} blogPath={blogPath} />}
    {pageView.backtotop && <BackToTop />}
</BaseLayout>

<style>
    .blog-empty {
        text-align: center;
        color: var(--color-text-muted);
        padding: 3rem 0;
    }
</style>

<script>
    import "~/utils/waline-pageview";
</script>
