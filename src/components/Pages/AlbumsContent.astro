---
import SectionPage from "~/components/Layout/SectionPage.astro";
import AlbumCard from "~/components/Gallery/AlbumCard.astro";
import GalleryFilter from "~/components/Gallery/GalleryFilter.astro";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { site, imageService } from "~/config";
import { t, getLocale, type Locale } from "~/utils/i18n";

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const loc: Locale = getLocale(locale);

interface AlbumPhoto {
    id: string;
    url: string;
    alt?: string;
    description?: string;
}

interface Album {
    id: string;
    name: string;
    description?: string;
    location?: string;
    date?: string;
    tags?: string[];
    cover?: string;
    photos: AlbumPhoto[];
    photoCount?: number;
}

import albumsData from "~/data/albums.json";

const picBase = `${imageService.baseUrl}${imageService.picPath}`;

const albums: Album[] = (albumsData as Album[]).map((album) => ({
    ...album,
    cover: album.cover ? `${picBase}${album.cover}` : "",
    photoCount: album.photos?.length || 0,
}));

const allTags = [...new Set(albums.map((a) => a.name).filter(Boolean))].sort();
---

<SectionPage
    title={t(loc, "albums.title")}
    subtitle={t(loc, "albums.subtitle")}
    description={`${t(loc, "albums.title")} - ${site.title}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={t(loc, "albums.title")}
    keywords={["Albums", "Photos", "Gallery"]}
    publishedTime={new Date()}
    modifiedTime={new Date()}
    empty={albums.length === 0}
    emptyEmoji="📷"
    emptyTitle={t(loc, "albums.emptyTitle")}
>
    <DynamicIcon name="tabler:library-photo" slot="icon" />

    {
        albums.length > 0 && allTags.length > 0 && (
            <GalleryFilter tags={allTags} allLabel={t(loc, "albums.allLabel")} />
        )
    }

    {
        albums.length > 0 && (
            <div class="albums-grid">
                {albums.map((album) => (
                    <AlbumCard
                        id={album.id}
                        name={album.name}
                        cover={album.cover}
                        description={album.description}
                        date={album.date}
                        location={album.location}
                        tags={album.name ? [album.name] : []}
                        photoCount={album.photoCount}
                    />
                ))}
            </div>
        )
    }
</SectionPage>

<style>
    .albums-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }
</style>
