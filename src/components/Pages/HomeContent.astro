---
import "~/styles/home.css";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import HeroMasthead from "~/components/Index/HeroMasthead.astro";
import TypewriterText from "~/components/ui/TypewriterText.astro";
import Talk from "~/components/Index/Talk.astro";
import Posts from "~/components/Index/Posts.astro";
import Friends from "~/components/Index/Friends.astro";
import Photos from "~/components/Index/Photos.astro";
import Media from "~/components/Index/Media.astro";
import Author from "~/components/ui/Author.astro";
import booksData from "~/data/douban-books.json";
import moviesData from "~/data/douban-movies.json";
import typewriterTexts from "~/data/typewriter.json";
import { site } from "~/config";
import { sortByPubDate } from "~/utils";
import { getAllTags } from "~/utils/article-stats";
import { t, getLocale, type Locale } from "~/utils/i18n";

const toMediaItem = (item: (typeof booksData)[number]) => ({
    url: item.cover || "",
    rating: item.rating * 20,
    ratingNum: item.rating || undefined,
    title: item.title,
    link: item.url,
});

const booksItems = booksData.map(toMediaItem);
const moviesItems = moviesData.map(toMediaItem);

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const loc: Locale = getLocale(locale);
const isEn = loc === "en";

const allArticles = await getCollection("article", ({ data }) => !data.draft);
const sortedArticles = sortByPubDate(allArticles);
const recentPosts = sortedArticles.slice(0, 5);
const totalArticles = allArticles.length;

const tagsCount = new Set(getAllTags(allArticles)).size;
---

<BaseLayout
    title={`${site.subtitle} -  ${site.title}`}
    description={`${site.title} - ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={site.coverImageAlt}
    keywords={site.keywords}
    publishedTime={new Date()}
    modifiedTime={new Date()}
    locale={locale}
>
    <div class="page-container">
        <div class="hero-background"></div>
        <div class="main-content">
            <HeroMasthead
                subtitle={site.subtitle}
                totalArticles={totalArticles}
                tagsCount={tagsCount}
            />

            {
                !isEn && (
                    <div class="hero-typewriter">
                        <TypewriterText text={typewriterTexts} speed={80} pauseTime={2500} />
                    </div>
                )
            }

            {!isEn && <Author />}

            <Talk />
            <Posts posts={recentPosts} />
            <Friends title={t(loc, "home.friendsTitle")} locale={loc} />
            <Photos title={t(loc, "home.photosTitle")} locale={loc} />
            <div class="media-duo">
                <Media
                    title={t(loc, "home.moviesTitle")}
                    items={moviesItems}
                    href="/douban/"
                    limit={4}
                    locale={loc}
                />
                <Media
                    title={t(loc, "home.booksTitle")}
                    items={booksItems}
                    href="/douban/"
                    limit={4}
                    locale={loc}
                />
            </div>

            {isEn && <Author />}
        </div>
    </div>
</BaseLayout>
