---
import type { CollectionEntry } from "astro:content";
import SectionPage from "~/components/Layout/SectionPage.astro";
import TagsPostCard from "~/components/Article/TagsPostCard.astro";
import { site } from "~/config";
import { enrichPost } from "~/utils/get-posts-with-meta";
import { t, getLocale, type Locale } from "~/utils/i18n";

interface Props {
    locale?: string;
    articles: CollectionEntry<"article">[];
}

const { locale = "zh", articles } = Astro.props;
const loc: Locale = getLocale(locale);

const tag = (Astro.params.tag as string) || "";

const postsWithMeta = articles.map((post: CollectionEntry<"article">) => enrichPost(post));
const latestModified = postsWithMeta[0]?.modifiedTime || new Date();
---

<SectionPage
    title={`# ${tag}`}
    subtitle={t(loc, "tags.taggedCount", { count: String(postsWithMeta.length), tag })}
    description={`${tag} - ${site.description}`}
    image={`${Astro.site + site.coverImage}`}
    imageAlt={tag}
    keywords={[tag]}
    publishedTime={new Date()}
    modifiedTime={latestModified}
    noindex={true}
    empty={postsWithMeta.length === 0}
    emptyTitle={t(loc, "tags.emptyTitle")}
    emptyMessage={t(loc, "tags.emptyMessage", { tag })}
>
    <div class="posts">
        {
            postsWithMeta.map((post) => (
                <TagsPostCard
                    title={post.data.title}
                    description={post.data.description || post.excerpt}
                    tags={post.data.tags || []}
                    postUrl={`/article/${post.slug}/`}
                    publishedTime={post.data.pubDate}
                    modifiedTime={post.modifiedTime}
                    wordCount={post.wordCount}
                    readTime={post.readTime}
                    currentSlug={post.slug}
                />
            ))
        }
    </div>
</SectionPage>

<style>
    .posts {
        gap: 1.5rem;
    }
</style>

<script>
    import "~/utils/waline-pageview";
</script>
