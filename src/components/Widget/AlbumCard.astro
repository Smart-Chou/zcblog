---
interface Props {
    id: string;
    title: string;
    description: string;
    coverImage: string;
    photoCount: number;
    updatedAt: Date;
}

const { id, title, description, coverImage, photoCount, updatedAt } =
    Astro.props;
---

<a href={`/album/${id}/`} class="album-card">
    <div class="album-cover">
        <img src={coverImage} alt={title} class="cover-image" loading="lazy" />
        <div class="cover-overlay">
            <span class="view-button">查看相册</span>
        </div>
    </div>
    <div class="album-info">
        <h3 class="album-title">{title}</h3>
        <p class="album-description">{description}</p>
        <div class="album-meta">
            <span class="photo-count">{photoCount} 张照片</span>
            <span class="updated-time"
                >{new Date(updatedAt).toLocaleDateString()}</span
            >
        </div>
    </div>
</a>

<style>
    .album-card {
        display: block;
        text-decoration: none;
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        background-color: var(--color-surface);
        transition:
            transform var(--duration-slow) var(--ease-out),
            box-shadow var(--duration-slow) var(--ease-out);
    }

    .album-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-xl);
    }

    .album-cover {
        position: relative;
        width: 100%;
        height: 200px;
        overflow: hidden;
    }

    .cover-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--duration-slower) var(--ease-out);
    }

    .album-card:hover .cover-image {
        transform: scale(1.05);
    }

    .cover-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity var(--duration-slow) var(--ease-out);
    }

    .album-card:hover .cover-overlay {
        opacity: 1;
    }

    .view-button {
        background-color: var(--color-link);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: var(--radius);
        font-size: 0.9rem;
        font-weight: 500;
        transition: background-color var(--duration-slow) var(--ease-out);
    }

    .view-button:hover {
        background-color: var(--color-accent);
    }

    .album-info {
        padding: 1.5rem;
    }

    .album-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--color-title);
        transition: color var(--duration-slow) var(--ease-out);
    }

    .album-card:hover .album-title {
        color: var(--color-link);
    }

    .album-description {
        font-size: 0.9rem;
        color: var(--color-body);
        margin-bottom: 1rem;
        line-height: 1.4;
    }

    .album-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8rem;
        color: var(--color-body);
        opacity: 0.8;
    }

    .photo-count {
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .updated-time {
        font-size: 0.75rem;
    }

    @media (max-width: 768px) {
        .album-cover {
            height: 180px;
        }

        .album-info {
            padding: 1.25rem;
        }
    }
</style>
