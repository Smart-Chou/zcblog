---
// 站点统计 Widget
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { site } from "~/config/site.config";

export interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;

const allPosts = await getCollection("article", ({ data }) => !data.draft);
const allTags = new Set(allPosts.flatMap((p) => p.data.tags || []));

// 计算总字数（估算）
let totalChars = 0;
for (const post of allPosts) {
    if (post.body) {
        const text = post.body
            .replace(/```[\s\S]*?```/g, "")
            .replace(/`[^`]*`/g, "")
            .replace(/\s+/g, " ")
            .trim();
        const chinese = (text.match(/[\u4e00-\u9fa5]/g) || []).length;
        const english = (text.match(/[a-zA-Z]/g) || []).length;
        totalChars += chinese + english;
    }
}

function fmt(n: number): string {
    return n.toLocaleString("zh-CN");
}

const siteStartDate = site.startYear + "-01-01";
const latestPost = allPosts.reduce((latest, p) => {
    if (!latest) return p;
    return p.data.pubDate > latest.data.pubDate ? p : latest;
}, allPosts[0]);

const stats = [
    {
        icon: "material-symbols:article-outline",
        label: "文章",
        value: allPosts.length,
    },
    {
        icon: "material-symbols:label-outline",
        label: "标签",
        value: allTags.size,
    },
    {
        icon: "material-symbols:text-ad-outline-rounded",
        label: "总字数",
        value: totalChars,
        formatted: true,
    },
    {
        icon: "material-symbols:calendar-clock-outline",
        label: "运行天数",
        value: 0,
        id: "running-days",
        dynamic: true,
    },
    {
        icon: "mingcute:heartbeat-line",
        label: "最后更新",
        value: 0,
        id: "last-update",
        dynamic: true,
    },
];
---

<div class:list={["site-stats", className]}>
    <h3
        class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3"
    >
        站点统计
    </h3>
    <div class="space-y-1.5">
        {
            stats.map((s) => (
                <div class="flex items-center justify-between px-3 py-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                    <div class="flex items-center gap-2.5">
                        <span class="text-blue-500 dark:text-blue-400 text-lg">
                            <Icon name={s.icon} />
                        </span>
                        <span class="text-sm text-gray-600 dark:text-gray-300">
                            {s.label}
                        </span>
                    </div>
                    <span
                        class="text-sm font-bold text-gray-800 dark:text-gray-200"
                        data-stat-id={s.id}
                    >
                        {s.formatted ? fmt(s.value as number) : s.value}
                    </span>
                </div>
            ))
        }
    </div>
</div>

<script
    is:inline
    define:vars={{
        siteStartDate,
        latestPost: latestPost?.data.pubDate.toISOString() ?? null,
    }}
>
    function updateStats() {
        const today = new Date();
        const start = new Date(siteStartDate);
        const days = Math.ceil((today.getTime() - start.getTime()) / 86400000);
        document
            .querySelectorAll('[data-stat-id="running-days"]')
            .forEach((el) => {
                el.textContent = String(days);
            });

        if (latestPost) {
            const daysSince = Math.floor(
                (today.getTime() - new Date(latestPost).getTime()) / 86400000,
            );
            document
                .querySelectorAll('[data-stat-id="last-update"]')
                .forEach((el) => {
                    el.textContent =
                        daysSince === 0 ? "今天" : String(daysSince);
                });
            document
                .querySelectorAll('[data-stat-id="last-update"]')
                .forEach((el) => {
                    const suffix = el.nextElementSibling;
                    if (suffix)
                        suffix.textContent = daysSince === 0 ? "" : "天前";
                });
        }
    }
    updateStats();
</script>
