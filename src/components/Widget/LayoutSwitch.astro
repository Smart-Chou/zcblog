---
// 文章列表布局切换按钮（列表 ⇄ 网格）
// 用法：<LayoutSwitch />
// 通过自定义事件 'layoutChange' 通知页面切换布局
export interface Props {
    class?: string;
    defaultLayout?: "list" | "grid";
    allowSwitch?: boolean;
}

const {
    class: className = "",
    defaultLayout = "list",
    allowSwitch = true,
} = Astro.props;
---

{
    allowSwitch && (
        <button
            id="layout-switch-btn"
            class:list={["layout-switch-btn", className]}
            aria-label="切换布局"
            title="切换文章列表布局"
            data-layout={defaultLayout}
        >
            <svg
                class="layout-icon layout-icon-list"
                fill="currentColor"
                viewBox="0 0 24 24"
                width="20"
                height="20"
            >
                <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z" />
            </svg>
            <svg
                class="layout-icon layout-icon-grid"
                fill="currentColor"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                style="display:none"
            >
                <path d="M3 3h7v7H3V3zm0 11h7v7H3v-7zm11-11h7v7h-7V3zm0 11h7v7h-7v-7z" />
            </svg>
        </button>
    )
}

<script>
    function initLayoutSwitch() {
        const btn = document.getElementById(
            "layout-switch-btn",
        ) as HTMLButtonElement | null;
        if (!btn) return;

        const saved = localStorage.getItem("postListLayout");
        let current: "list" | "grid" =
            saved === "list" || saved === "grid"
                ? saved
                : (btn.dataset.layout as "list" | "grid") || "list";

        function applyLayout(layout: "list" | "grid") {
            current = layout;
            localStorage.setItem("postListLayout", layout);
            btn!.dataset.layout = layout;
            const listIcon = btn!.querySelector(
                ".layout-icon-list",
            ) as HTMLElement;
            const gridIcon = btn!.querySelector(
                ".layout-icon-grid",
            ) as HTMLElement;
            if (layout === "grid") {
                listIcon.style.display = "none";
                gridIcon.style.display = "";
                btn!.title = "切换到列表模式";
            } else {
                listIcon.style.display = "";
                gridIcon.style.display = "none";
                btn!.title = "切换到网格模式";
            }
            window.dispatchEvent(
                new CustomEvent("layoutChange", { detail: { layout } }),
            );
        }

        btn.addEventListener("click", () => {
            applyLayout(current === "list" ? "grid" : "list");
        });

        // Apply saved preference on load
        if (saved && saved !== current) {
            applyLayout(saved);
        }
    }

    initLayoutSwitch();
</script>

<style>
    .layout-switch-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;
        border: none;
        background: transparent;
        color: var(--color-text-secondary, #6b7280);
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .layout-switch-btn:hover {
        background: var(--color-bg-hover, #f3f4f6);
        color: var(--color-text-primary, #1a1a2e);
    }
    .layout-switch-btn:active {
        scale: 0.95;
    }
</style>
