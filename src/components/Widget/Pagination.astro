---
import ChevronLeftIcon from "~/components/icons/ChevronLeft.astro";
import ChevronRightIcon from "~/components/icons/ChevronRight.astro";

interface Props {
    page: any;
    blogPath?: string;
}

const { page, blogPath = "/blog" } = Astro.props;
---

<style>
    #pagination {
        margin: var(--space) auto 0;
        text-align: center;
    }

    #pagination a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 10px;
        padding: 3px 10px;
        border: 2px var(--color-link);
        border-style: dashed;
        width: 40px;
        height: 40px;
        line-height: 1;
        box-sizing: border-box;
        vertical-align: middle;
    }

    #pagination a.active {
        font-weight: bold;
        border: 2.5px solid var(--color-link);
    }

    #pagination a.disabled {
        pointer-events: none;
        color: gray;
        border: 1px dashed gray;
        display: none;
    }

    #pagination a.square-class {
        border-radius: 50%;
    }

    @media screen and (max-width: 450px) {
        #pagination a:not([aria-label]) {
            display: none;
        }

        #pagination a.active {
            font-weight: bold;
            border: 2.5px solid var(--color-link);
        }

        #pagination a.disabled {
            display: inline-flex;
        }
    }
</style>

<nav id="pagination" aria-label="Pagination Navigation">
    <a
        href={page.url.prev}
        aria-label="Previous"
        aria-disabled={!page.url.prev}
        class:list={[page.url.prev ? "" : "disabled", "square-class"]}
    >
        <ChevronLeftIcon />
    </a>
    {
        (() => {
            const pages: number[] = [];
            const totalPages = page.lastPage;
            const currentPage = page.currentPage;
            let startPage = 1;
            let endPage = 1;

            if (totalPages < 6) {
                startPage = 1;
                endPage = totalPages;
            } else if (currentPage < 4) {
                startPage = 1;
                endPage = 5;
            } else if (currentPage + 3 > totalPages) {
                startPage = totalPages - 4;
                endPage = totalPages;
            } else {
                startPage = currentPage - 2;
                endPage = currentPage + 2;
            }

            for (
                let pageNumber = startPage;
                pageNumber < endPage + 1;
                pageNumber++
            ) {
                const href = `${blogPath}/${pageNumber}/`;
                pages.push(
                    <a
                        data-key={`page-${pageNumber}`}
                        href={href}
                        aria-current={
                            pageNumber === currentPage ? "page" : null
                        }
                        class={pageNumber === currentPage ? "active" : ""}
                    >
                        {pageNumber}
                    </a>,
                );
            }
            return pages;
        })()
    }
    <a
        href={page.url.next}
        aria-label="Next"
        aria-disabled={!page.url.next}
        class:list={[page.url.next ? "" : "disabled", "square-class"]}
    >
        <ChevronRightIcon />
    </a>
</nav>
