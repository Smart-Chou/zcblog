---
// Reveal.js 演示文稿嵌入组件
// 用法：<RevealSlides>
//   <section data-markdown>## Slide 1</section>
//   <section data-markdown>## Slide 2</section>
// </RevealSlides>

export interface Props {
  width?: number;
  height?: number;
  class?: string;
}

const { width = 960, height = 540, class: className = "" } = Astro.props;
const revealId = "reveal-" + Math.random().toString(36).slice(2, 8);
---

<div class:list={["reveal-wrapper", className]}>
  <div id={revealId} class="reveal">
    <div class="slides">
      {Astro.slots.render("default")}
    </div>
  </div>
</div>

<script>
  (function() {
    const el = document.getElementById("{revealId}");
    if (!el) return;

    function init() {
      const Reveal = (window as any).Reveal;
      if (!Reveal) {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = "https://cdn.jsdelivr.net/npm/reveal.js@5/dist/reveal.min.css";
        document.head.appendChild(link);

        const theme = document.createElement("link");
        theme.rel = "stylesheet";
        theme.href = "https://cdn.jsdelivr.net/npm/reveal.js@5/dist/theme/white.css";
        theme.id = "reveal-theme";
        document.head.appendChild(theme);

        const s = document.createElement("script");
        s.src = "https://cdn.jsdelivr.net/npm/reveal.js@5/dist/reveal.min.js";
        s.onload = init;
        document.head.appendChild(s);
        return;
      }

      const deck = new Reveal(el, {{
        width: {width},
        height: {height},
        margin: 0.1,
        transition: "slide",
        embedded: true,
        hash: false,
      }});
      deck.initialize();
    }
    init();
  })();
</script>

<style>
  .reveal-wrapper {
    margin: 1rem 0;
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }
  .reveal-wrapper .reveal {
    height: {height}px !important;
  }
</style>
