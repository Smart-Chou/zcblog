---
// 文章发布日历 Widget
import { Icon } from "astro-icon/components";

export interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;

const weekDays = ["日", "一", "二", "三", "四", "五", "六"];
const monthNames = [
    "1月",
    "2月",
    "3月",
    "4月",
    "5月",
    "6月",
    "7月",
    "8月",
    "9月",
    "10月",
    "11月",
    "12月",
];
---

<div class:list={["calendar-widget", className]}>
    <div class="flex items-center justify-between mb-3">
        <button
            id="cal-prev"
            class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
            aria-label="上月"
        >
            <Icon name="fa7-solid:chevron-left" class="text-xs" />
        </button>
        <span
            id="cal-month-display"
            class="text-sm font-bold text-gray-800 dark:text-gray-200 cursor-pointer hover:text-blue-500 transition-colors select-none"
        ></span>
        <div class="flex gap-1">
            <button
                id="cal-today"
                class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                aria-label="今天"
            >
                <Icon name="fa7-solid:arrow-rotate-left" class="text-xs" />
            </button>
            <button
                id="cal-next"
                class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                aria-label="下月"
            >
                <Icon name="fa7-solid:chevron-right" class="text-xs" />
            </button>
        </div>
    </div>

    <div class="grid grid-cols-7 gap-0.5 mb-1">
        {
            weekDays.map((d) => (
                <div class="text-center text-[10px] text-gray-400 dark:text-gray-500 font-medium py-0.5">
                    {d}
                </div>
            ))
        }
    </div>

    <div id="cal-grid" class="grid grid-cols-7 gap-0.5"></div>

    <div id="cal-posts" class="mt-2 hidden">
        <div class="border-t border-gray-200 dark:border-gray-700 mb-2"></div>
        <div id="cal-posts-list" class="space-y-0.5 max-h-40 overflow-y-auto">
        </div>
    </div>
</div>

<script is:inline define:vars={{ monthNames }}>
    let displayYear = new Date().getFullYear();
    let displayMonth = new Date().getMonth();
    let postDateMap: Record<
        string,
        { id: string; title: string; published: string }[]
    > = {};
    let allPosts: { id: string; title: string; published: string }[] = [];

    async function fetchData() {
        try {
            if ((window as any).__allPostMetaCache) {
                allPosts = (window as any).__allPostMetaCache;
            } else {
                const res = await fetch("/api/allPostMeta.json");
                allPosts = await res.json();
                (window as any).__allPostMetaCache = allPosts;
            }
            postDateMap = {};
            allPosts.forEach((p) => {
                const d = new Date(p.published);
                const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
                (postDateMap[key] ??= []).push(p);
            });
            render();
        } catch (e) {
            console.error("Calendar fetch error", e);
        }
    }

    function render() {
        const grid = document.getElementById("cal-grid")!;
        const display = document.getElementById("cal-month-display")!;
        display.textContent = `${displayYear}年${monthNames[displayMonth]}`;

        const firstDay = new Date(displayYear, displayMonth, 1).getDay();
        const daysInMonth = new Date(
            displayYear,
            displayMonth + 1,
            0,
        ).getDate();
        const today = new Date();
        const isCurrent =
            displayYear === today.getFullYear() &&
            displayMonth === today.getMonth();

        let html = "";
        for (let i = 0; i < firstDay; i++)
            html += '<div class="aspect-square"></div>';
        for (let d = 1; d <= daysInMonth; d++) {
            const key = `${displayYear}-${String(displayMonth + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
            const has = !!postDateMap[key];
            const count = postDateMap[key]?.length || 0;
            const isToday = isCurrent && d === today.getDate();
            html += `<div class="aspect-square flex items-center justify-center rounded text-xs relative cursor-pointer
        ${has ? "font-bold text-gray-800 dark:text-gray-100" : "text-gray-500 dark:text-gray-400"}
        ${isToday ? "ring-2 ring-blue-500" : ""}
        hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        data-date="${key}" data-has="${has}">
        ${d}
        ${has ? '<span class="absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-blue-500"></span>' : ""}
        ${count > 1 ? `<span class="absolute -top-0.5 -right-0.5 text-[8px] text-blue-500 font-bold">${count}</span>` : ""}
      </div>`;
        }
        grid.innerHTML = html;

        // Show monthly posts
        const monthlyPosts = allPosts.filter((p) => {
            const d = new Date(p.published);
            return (
                d.getFullYear() === displayYear && d.getMonth() === displayMonth
            );
        });
        showPosts(monthlyPosts);

        // Click handlers
        grid.querySelectorAll<HTMLElement>(
            "[data-date][data-has='true']",
        ).forEach((el) => {
            el.addEventListener("click", () => {
                const key = el.dataset.date!;
                const posts = postDateMap[key] || [];
                showPosts(posts);
                grid.querySelectorAll(".cal-selected").forEach((e) =>
                    e.classList.remove("cal-selected"),
                );
                el.classList.add("cal-selected");
            });
        });
    }

    function showPosts(
        posts: { id: string; title: string; published: string }[],
    ) {
        const wrapper = document.getElementById("cal-posts")!;
        const list = document.getElementById("cal-posts-list")!;
        if (posts.length === 0) {
            wrapper.classList.add("hidden");
            return;
        }
        wrapper.classList.remove("hidden");
        list.innerHTML = posts
            .map((p) => {
                const d = new Date(p.published);
                return `<a href="/article/${p.id}/" class="flex justify-between text-xs px-2 py-1 rounded hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-gray-700 dark:text-gray-300 hover:text-blue-500">
        <span class="truncate">${p.title}</span>
        <span class="text-gray-400 ml-2 whitespace-nowrap">${d.getMonth() + 1}-${d.getDate()}</span>
      </a>`;
            })
            .join("");
    }

    function changeMonth(delta: number) {
        displayMonth += delta;
        if (displayMonth > 11) {
            displayMonth = 0;
            displayYear++;
        } else if (displayMonth < 0) {
            displayMonth = 11;
            displayYear--;
        }
        render();
    }

    function resetToday() {
        const now = new Date();
        displayYear = now.getFullYear();
        displayMonth = now.getMonth();
        render();
    }

    document.getElementById("cal-prev")!.onclick = () => changeMonth(-1);
    document.getElementById("cal-next")!.onclick = () => changeMonth(1);
    document.getElementById("cal-today")!.onclick = () => resetToday();
    document.getElementById("cal-month-display")!.onclick = () => {
        displayYear = new Date().getFullYear();
        displayMonth = new Date().getMonth();
        render();
    };

    fetchData();
</script>
