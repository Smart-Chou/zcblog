---
import "~/styles/heatmap.css";

interface PostData {
    date: string;
    title: string;
    wordCount: number;
}

interface Props {
    postsData: PostData[];
}

const { postsData } = Astro.props;
---

<div class="heatmap-container" id="heatmap-container"></div>

<script is:inline define:vars={{ postsData }}>
    function formatDate(date) {
        return date.toISOString().split("T")[0];
    }

    function getClassForValue(count) {
        if (count === 0) return "color-empty";
        if (count < 300) return "color-github-1";
        if (count < 800) return "color-github-2";
        if (count < 1500) return "color-github-3";
        return "color-github-4";
    }

    const monthNames = [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec",
    ];

    function initHeatmap() {
        const container = document.getElementById("heatmap-container");
        if (!container) return;
        container.innerHTML = "";

        const today = new Date();
        const startDate = new Date(today);
        startDate.setFullYear(today.getFullYear() - 1);
        startDate.setDate(startDate.getDate() - startDate.getDay());

        const dataMap = {};
        postsData.forEach(function (p) {
            dataMap[p.date] = p;
        });

        var months = [];
        var currentDate = new Date(startDate);
        var lastMonth = -1;
        var weekIndex = 0;

        while (currentDate <= today) {
            var month = currentDate.getMonth();
            if (month !== lastMonth) {
                months.push({ month: monthNames[month], col: weekIndex });
                lastMonth = month;
            }
            currentDate.setDate(currentDate.getDate() + 7);
            weekIndex++;
        }

        var monthRow = document.createElement("div");
        monthRow.className = "heatmap-months";
        months.forEach(function (m) {
            var span = document.createElement("span");
            span.textContent = m.month;
            span.style.gridColumn = (m.col + 1).toString();
            monthRow.appendChild(span);
        });
        container.appendChild(monthRow);

        var wrapper = document.createElement("div");
        wrapper.className = "heatmap-wrapper";

        var yLabels = document.createElement("div");
        yLabels.className = "heatmap-y-labels";
        yLabels.innerHTML =
            "<span>Sun</span><span></span><span>Tue</span><span></span><span>Thu</span><span></span><span>Sat</span>";
        wrapper.appendChild(yLabels);

        var grid = document.createElement("div");
        grid.className = "heatmap-grid";

        currentDate = new Date(startDate);
        while (currentDate <= today) {
            var cell = document.createElement("div");
            var dateStr = formatDate(currentDate);
            var dayData = dataMap[dateStr];

            if (dayData) {
                cell.className =
                    "heatmap-day " + getClassForValue(dayData.wordCount);
                cell.dataset.date = dayData.date;
                cell.dataset.title = dayData.title;
                cell.dataset.count = dayData.wordCount.toString();

                cell.addEventListener("mouseenter", function () {
                    var tooltip = document.createElement("div");
                    tooltip.className = "heatmap-tooltip";
                    tooltip.innerHTML =
                        '<div class="heatmap-tooltip-date">' +
                        dayData.date +
                        "</div>" +
                        '<div class="heatmap-tooltip-content">' +
                        "<div>" +
                        dayData.wordCount +
                        " 字</div>" +
                        "<div>《" +
                        dayData.title +
                        "》</div>" +
                        "</div>";
                    document.body.appendChild(tooltip);
                    var rect = cell.getBoundingClientRect();
                    tooltip.style.left = rect.left + "px";
                    tooltip.style.top =
                        rect.top - tooltip.offsetHeight - 8 + "px";
                });

                cell.addEventListener("mouseleave", function () {
                    document
                        .querySelectorAll(".heatmap-tooltip")
                        .forEach(function (t) {
                            t.remove();
                        });
                });
            } else {
                cell.className = "heatmap-day color-empty";
            }

            grid.appendChild(cell);
            currentDate.setDate(currentDate.getDate() + 1);
        }

        wrapper.appendChild(grid);
        container.appendChild(wrapper);

        var legendDiv = document.createElement("div");
        legendDiv.className = "heatmap-legend";
        var colors = ["#d6d8db", "#9ad99b", "#68be67", "#3f7f46", "#2f6336"];
        legendDiv.innerHTML =
            "<span>Less</span>" +
            colors
                .map(function (c) {
                    return (
                        '<span class="heatmap-legend-item" style="background-color:' +
                        c +
                        '"></span>'
                    );
                })
                .join("") +
            "<span>More</span>";
        container.appendChild(legendDiv);
    }

    document.addEventListener("astro:page-load", initHeatmap);
    if (document.readyState !== "loading") initHeatmap();
    else document.addEventListener("DOMContentLoaded", initHeatmap);
</script>
