---

<style>
    #commentDetails {
        margin: 1rem auto;
        text-align: center;
    }

    #commentDetails > summary {
        display: inline-block;
        min-width: 180px;
        padding: 0.5rem 1rem;
        background-color: var(--color-surface);
        color: var(--color-link);
        border: 1px var(--color-link);
        border-style: dashed;
        cursor: pointer;
        border-radius: 5px;
        text-align: center;
        list-style: none;
    }

    #commentDetails > summary::-webkit-details-marker {
        display: none;
    }

    #commentDetails[open] > summary {
        font-weight: bold;
        border: 1.5px solid var(--color-link);
    }

    #waline {
        min-height: 38rem;
        max-width: var(--content-width);
        position: relative;
        overflow: hidden;
        margin: 0 auto;
        padding: 0 var(--space);
        content-visibility: auto;
        contain-intrinsic-size: 0 600px;
    }

    @media screen and (max-width: 650px) {
        #waline {
            padding: unset;
        }
    }

    html[data-theme="dark"] {
        --waline-color: #e8e3de !important;
    }
</style>

<details id="commentDetails">
    <summary>展开评论</summary>
    <div id="waline"></div>
</details>

<script>
    import { init } from "@waline/client";
    import { waline } from "~/self.config";
    import "@waline/client/waline.css";
    import "@waline/client/waline-meta.css";

    let walineInitialized = false;

    document.addEventListener("astro:page-load", () => {
        const details = document.getElementById(
            "commentDetails",
        ) as HTMLDetailsElement | null;
        if (!details) return;

        const initWaline = () => {
            if (walineInitialized) return;
            walineInitialized = true;

            const locale = {
                level0: "炼体",
                level1: "炼气",
                level2: "筑基",
                level3: "金丹",
                level4: "元婴",
                level5: "化神",
                placeholder: "写下你的评论...",
                nick: "昵称",
                mail: "邮箱",
                link: "网址",
                submit: "提交评论",
                reply: "回复",
                cancelReply: "取消回复",
                comment: "评论",
                comments: "评论",
                preview: "预览",
                emoji: "表情",
                uploading: "上传中...",
                login: "登录",
                logout: "登出",
                admin: "管理员",
                sticky: "置顶",
                word: "字",
                anonymous: "匿名",
                level: "等级",
                like: "点赞",
                liked: "已赞",
                dislike: "点踩",
                disliked: "已踩",
                quote: "引用",
                at: "@",
                flag: "举报",
                flagConfirm: "确定要举报这条评论吗？",
                approved: "已通过",
                waiting: "等待审核",
                spam: "垃圾评论",
                score: "评分",
                reactionTitle: "你认为这篇文章怎么样？",
                reaction0: "牛逼哄哄",
                reaction1: "不太行哦",
                reaction2: "还不错呦",
                reaction3: "你觉得呢",
                reaction4: "自己看看",
                reaction5: "周公叫我",
            };

            const walineElement = document.getElementById("waline");
            if (!waline.enable || !walineElement) {
                console.error(
                    "Required elements or configuration are missing.",
                );
                return;
            }

            const origin = waline.serverUrl;
            const walineProps = walineElement!.dataset;
            const walineConfig: any = {
                el: "#waline",
                serverURL: origin,
                comment: true,
                locale,
                path: walineProps.walinePath!,
                lang: waline.lang,
                pageSize: waline.pageSize,
                pageview: true,
                meta: ["nick", "mail", "link"],
                requiredMeta: ["nick", "mail"],
                login: "disable",
                search: waline.search,
                dark: 'html[data-theme="dark"]',
                emoji: [
                    "https://unpkg.com/@waline/emojis@1.2.0/qq",
                    "https://cdn.jsdelivr.net/gh/walinejs/emojis@1.0.0/bilibili",
                    "https://unpkg.com/@waline/emojis@1.2.0/tieba",
                    "https://unpkg.com/@waline/emojis@1.2.0/weibo",
                ],
                wordLimit: [0, 1000],
                reaction: true,
                imageUploader: false,
                highlighter: true,
                codeSyntaxHighlight: true,
                uploadImage: () => {
                    return new Promise(() => {
                        alert("图片上传功能暂未开放");
                        throw new Error("图片上传功能暂未开放");
                    });
                },
            };

            if (waline.whiteList.includes(location.pathname)) {
                walineConfig.reaction =
                    typeof waline.reaction === "boolean" &&
                    waline.reaction === true
                        ? []
                        : (waline.reaction as string[]);
            }

            init(walineConfig);
        };

        details.addEventListener("toggle", () => {
            if (details.open) {
                initWaline();
                const summary = details.querySelector("summary");
                if (summary) summary.textContent = "收起评论";
            } else {
                const summary = details.querySelector("summary");
                if (summary) summary.textContent = "展开评论";
            }
        });
    });
</script>
