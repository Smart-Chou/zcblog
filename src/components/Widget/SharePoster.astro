---
// 文章分享海报生成器
// 用法: <SharePoster title="..." author="..." url="..." pubDate="..." coverImage="..." description="..." avatar="..." siteTitle="..." />
export interface Props {
    title: string;
    author: string;
    url: string;
    pubDate: string;
    coverImage?: string | null;
    description?: string;
    avatar?: string | null;
    siteTitle: string;
    class?: string;
}

const {
    title,
    author,
    url,
    pubDate,
    coverImage = null,
    description = "",
    avatar = null,
    siteTitle,
    class: className = "",
} = Astro.props;
---

<button
    class:list={["share-poster-btn", className]}
    data-title={title}
    data-author={author}
    data-url={url}
    data-pubdate={pubDate}
    data-cover={coverImage || ""}
    data-desc={description}
    data-avatar={avatar || ""}
    data-site={siteTitle}
    aria-label="生成分享海报"
>
    <svg
        width="18"
        height="18"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
    >
        <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
        ></path>
    </svg>
    <span>分享海报</span>
</button>

<!-- Poster Modal -->
<div id="poster-modal" class="poster-modal hidden">
    <div class="poster-backdrop"></div>
    <div class="poster-dialog">
        <div class="poster-header">
            <h3>分享海报</h3>
            <button id="poster-close" class="poster-close">&times;</button>
        </div>
        <div id="poster-preview" class="poster-preview">
            <canvas id="poster-canvas"></canvas>
            <div id="poster-loading" class="poster-loading">生成中...</div>
        </div>
        <div class="poster-actions">
            <button id="poster-download" class="poster-action-btn"
                >下载图片</button
            >
        </div>
    </div>
</div>

<script>
    import QRCode from "qrcode";

    function loadImage(src: string): Promise<HTMLImageElement | null> {
        return new Promise((resolve) => {
            const img = new Image();
            img.crossOrigin = "anonymous";
            img.onload = () => resolve(img);
            img.onerror = () => {
                if (!src.includes("images.weserv.nl")) {
                    const proxy = new Image();
                    proxy.crossOrigin = "anonymous";
                    proxy.onload = () => resolve(proxy);
                    proxy.onerror = () => resolve(null);
                    proxy.src = `https://images.weserv.nl/?url=${encodeURIComponent(src)}&output=png`;
                } else {
                    resolve(null);
                }
            };
            img.src = src;
        });
    }

    function getLines(
        ctx: CanvasRenderingContext2D,
        text: string,
        maxWidth: number,
    ): string[] {
        const chars = text.split("");
        const lines: string[] = [];
        let line = "";
        for (const char of chars) {
            if (ctx.measureText(line + char).width < maxWidth) {
                line += char;
            } else {
                lines.push(line);
                line = char;
            }
        }
        if (line) lines.push(line);
        return lines;
    }

    async function generate(data: {
        title: string;
        author: string;
        url: string;
        pubDate: string;
        cover: string;
        desc: string;
        avatar: string;
        site: string;
    }) {
        const modal = document.getElementById("poster-modal")!;
        const loading = document.getElementById("poster-loading")!;
        modal.classList.remove("hidden");
        loading.style.display = "flex";

        try {
            const S = 2;
            const W = 425 * S;
            const P = 24 * S;

            const qrUrl = await QRCode.toDataURL(data.url, {
                margin: 1,
                width: 100 * S,
                color: { dark: "#000", light: "#fff" },
            });
            const [qrImg, coverImg, avatarImg] = await Promise.all([
                loadImage(qrUrl),
                data.cover ? loadImage(data.cover) : Promise.resolve(null),
                data.avatar ? loadImage(data.avatar) : Promise.resolve(null),
            ]);

            const canvas = document.getElementById(
                "poster-canvas",
            ) as HTMLCanvasElement;
            const ctx = canvas.getContext("2d")!;
            canvas.width = W;

            let y = 0;
            const coverH = 200 * S;
            y += coverH + P;

            ctx.font = `700 ${24 * S}px sans-serif`;
            const titleH =
                getLines(ctx, data.title, W - P * 2).length * (30 * S);
            y += titleH + 16 * S;

            ctx.font = `${14 * S}px sans-serif`;
            const descLines = data.desc
                ? getLines(ctx, data.desc, W - P * 2 - 16 * S).slice(0, 5)
                : [];
            const descH = descLines.length * (25 * S);
            y += descH + 24 * S + 64 * S + P;

            canvas.height = y;

            // Background
            ctx.fillStyle = "#fff";
            ctx.fillRect(0, 0, W, y);

            // Cover
            if (coverImg) {
                const r = coverImg.width / coverImg.height;
                const tr = W / coverH;
                if (r > tr) {
                    const sw = coverImg.height * tr;
                    ctx.drawImage(
                        coverImg,
                        (coverImg.width - sw) / 2,
                        0,
                        sw,
                        coverImg.height,
                        0,
                        0,
                        W,
                        coverH,
                    );
                } else {
                    const sh = coverImg.width / tr;
                    ctx.drawImage(
                        coverImg,
                        0,
                        (coverImg.height - sh) / 2,
                        coverImg.width,
                        sh,
                        0,
                        0,
                        W,
                        coverH,
                    );
                }
            }

            // Date badge
            const d = new Date(data.pubDate);
            if (!isNaN(d.getTime())) {
                ctx.fillStyle = "rgba(0,0,0,0.3)";
                roundRect(ctx, P, coverH - 60 * S, 60 * S, 60 * S, 4 * S);
                ctx.fill();
                ctx.fillStyle = "#fff";
                ctx.textAlign = "center";
                ctx.font = `700 ${30 * S}px sans-serif`;
                ctx.fillText(
                    String(d.getDate()).padStart(2, "0"),
                    P + 30 * S,
                    coverH - 36 * S,
                );
                ctx.font = `${10 * S}px sans-serif`;
                ctx.fillText(
                    `${d.getFullYear()} ${String(d.getMonth() + 1).padStart(2, "0")}`,
                    P + 30 * S,
                    coverH - 9 * S,
                );
            }

            // Title
            let dy = coverH + P;
            ctx.textAlign = "left";
            ctx.fillStyle = "#111827";
            ctx.font = `700 ${24 * S}px sans-serif`;
            const tls = getLines(ctx, data.title, W - P * 2);
            tls.forEach((l) => {
                ctx.fillText(l, P, dy);
                dy += 30 * S;
            });
            dy += 16 * S;

            // Description
            if (descLines.length > 0) {
                ctx.fillStyle = "#4b5563";
                ctx.font = `${14 * S}px sans-serif`;
                descLines.forEach((l) => {
                    ctx.fillText(l, P, dy);
                    dy += 25 * S;
                });
            }
            dy += 24 * S;

            // Divider
            ctx.strokeStyle = "#f3f4f6";
            ctx.lineWidth = 1 * S;
            ctx.beginPath();
            ctx.moveTo(P, dy);
            ctx.lineTo(W - P, dy);
            ctx.stroke();
            dy += 24 * S;

            // Footer
            if (avatarImg) {
                ctx.save();
                ctx.beginPath();
                ctx.arc(P + 32 * S, dy + 32 * S, 32 * S, 0, Math.PI * 2);
                ctx.clip();
                ctx.drawImage(avatarImg, P, dy, 64 * S, 64 * S);
                ctx.restore();
            }
            const ax = P + (avatarImg ? 64 * S + 16 * S : 0);
            ctx.fillStyle = "#9ca3af";
            ctx.font = `${12 * S}px sans-serif`;
            ctx.fillText("作者", ax, dy + 12 * S);
            ctx.fillStyle = "#1f2937";
            ctx.font = `700 ${20 * S}px sans-serif`;
            ctx.fillText(data.author, ax, dy + 36 * S);

            // QR code
            ctx.textAlign = "right";
            ctx.fillStyle = "#9ca3af";
            ctx.font = `${12 * S}px sans-serif`;
            ctx.fillText("扫码阅读", W - P - 80 * S, dy + 12 * S);
            ctx.fillStyle = "#1f2937";
            ctx.font = `700 ${20 * S}px sans-serif`;
            ctx.fillText(data.site, W - P - 80 * S, dy + 36 * S);

            if (qrImg) {
                ctx.fillStyle = "#fff";
                roundRect(ctx, W - P - 64 * S, dy, 64 * S, 64 * S, 4 * S);
                ctx.fill();
                ctx.drawImage(
                    qrImg,
                    W - P - 60 * S,
                    dy + 4 * S,
                    56 * S,
                    56 * S,
                );
            }

            loading.style.display = "none";
            canvas.style.display = "block";
        } catch (e) {
            console.error("Poster generation failed:", e);
            loading.textContent = "生成失败";
        }
    }

    function roundRect(
        ctx: CanvasRenderingContext2D,
        x: number,
        y: number,
        w: number,
        h: number,
        r: number,
    ) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.lineTo(x + w - r, y);
        ctx.quadraticCurveTo(x + w, y, x + w, y + r);
        ctx.lineTo(x + w, y + h - r);
        ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
        ctx.lineTo(x + r, y + h);
        ctx.quadraticCurveTo(x, y + h, x, y + h - r);
        ctx.lineTo(x, y + r);
        ctx.quadraticCurveTo(x, y, x + r, y);
        ctx.closePath();
    }

    // Init buttons
    document
        .querySelectorAll<HTMLButtonElement>(".share-poster-btn")
        .forEach((btn) => {
            btn.addEventListener("click", () => {
                generate({
                    title: btn.dataset.title!,
                    author: btn.dataset.author!,
                    url: btn.dataset.url!,
                    pubDate: btn.dataset.pubdate!,
                    cover: btn.dataset.cover!,
                    desc: btn.dataset.desc!,
                    avatar: btn.dataset.avatar!,
                    site: btn.dataset.site!,
                });
            });
        });

    document.getElementById("poster-close")!.addEventListener("click", () => {
        document.getElementById("poster-modal")!.classList.add("hidden");
    });
    document
        .querySelector(".poster-backdrop")!
        .addEventListener("click", () => {
            document.getElementById("poster-modal")!.classList.add("hidden");
        });
    document
        .getElementById("poster-download")!
        .addEventListener("click", () => {
            const canvas = document.getElementById(
                "poster-canvas",
            ) as HTMLCanvasElement;
            const a = document.createElement("a");
            a.href = canvas.toDataURL("image/png");
            a.download = "poster.png";
            a.click();
        });
</script>

<style>
    .share-poster-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        border: 1px solid var(--color-border, #e5e7eb);
        background: var(--color-bg-card, #fff);
        color: var(--color-text-secondary, #6b7280);
        cursor: pointer;
        font-size: 0.875rem;
        transition: all 0.15s;
    }
    .share-poster-btn:hover {
        color: var(--color-accent, #3b82f6);
        border-color: var(--color-accent, #3b82f6);
    }

    .poster-modal {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .poster-modal.hidden {
        display: none;
    }
    .poster-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
    }
    .poster-dialog {
        position: relative;
        background: var(--color-bg-card, #fff);
        border-radius: 12px;
        max-width: 460px;
        width: 90vw;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    }
    .poster-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--color-border, #e5e7eb);
    }
    .poster-header h3 {
        font-weight: 600;
    }
    .poster-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: var(--color-text-secondary, #6b7280);
    }
    .poster-preview {
        padding: 1rem;
        display: flex;
        justify-content: center;
    }
    .poster-preview canvas {
        display: none;
        max-width: 100%;
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }
    .poster-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 200px;
        color: var(--color-text-secondary, #6b7280);
    }
    .poster-actions {
        display: flex;
        justify-content: center;
        padding: 1rem;
        border-top: 1px solid var(--color-border, #e5e7eb);
    }
    .poster-action-btn {
        padding: 0.5rem 1.5rem;
        border-radius: 8px;
        border: none;
        background: var(--color-accent, #3b82f6);
        color: #fff;
        cursor: pointer;
        font-weight: 500;
        transition: opacity 0.15s;
    }
    .poster-action-btn:hover {
        opacity: 0.9;
    }
</style>
