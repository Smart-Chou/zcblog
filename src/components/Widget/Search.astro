---
import SearchIcon from "~/components/icons/Search.astro";

const pagefindTranslations = {
    placeholder: "搜索",
};
---

<site-search
    class={Astro.props.class}
    data-translations={JSON.stringify(pagefindTranslations)}
>
    <button
        data-open-modal
        commandfor="searchDialog"
        command="show-modal"
        disabled
        aria-label="搜索"
        aria-keyshortcuts="Control+K"
        aria-haspopup="dialog"
    >
        <SearchIcon aria-hidden="true" />
        <span class="sl-hidden md:sl-block" aria-hidden="true">搜索</span>
        <kbd class="sl-hidden md:sl-flex" style="display: none;">
            <kbd>Ctrl</kbd><kbd>K</kbd>
        </kbd>
    </button>

    <dialog id="searchDialog" style="padding:0" aria-label="搜索">
        <div class="dialog-frame sl-flex">
            <button
                data-close-modal
                commandfor="searchDialog"
                command="close"
                class="sl-flex md:sl-hidden">取消</button
            >
            {
                import.meta.env.DEV ? (
                    <div
                        style="margin: auto; text-align: center; white-space: pre-line;"
                        dir="ltr"
                    >
                        <p>搜索功能在开发模式下不可用。</p>
                    </div>
                ) : (
                    <div class="search-container">
                        <div id="starlight-search" />
                    </div>
                )
            }
        </div>
    </dialog>
</site-search>

<script>
    document.addEventListener("astro:page-load", () => {
        const dialog = document.getElementById(
            "searchDialog",
        ) as HTMLDialogElement | null;
        const openBtn = document.querySelector(
            "button[data-open-modal]",
        ) as HTMLButtonElement | null;
        if (!dialog || !openBtn) return;

        const isAppleDevice = () => {
            if ((navigator as any).userAgentData?.platform) {
                return (
                    (navigator as any).userAgentData.platform === "macOS" ||
                    (navigator as any).userAgentData.platform === "iOS"
                );
            }
            return /(Mac|iPhone|iPod|iPad)/i.test(navigator.userAgent);
        };

        const shortcut = openBtn.querySelector("kbd");
        const platformKey = shortcut?.querySelector("kbd");
        if (platformKey && shortcut instanceof HTMLElement) {
            if (isAppleDevice()) {
                platformKey.textContent = "⌘";
                openBtn.setAttribute("aria-keyshortcuts", "Meta+K");
            }
            shortcut.style.display = "";
        }

        openBtn.disabled = false;

        dialog.addEventListener("toggle", () => {
            document.body.toggleAttribute(
                "data-search-modal-open",
                dialog.open,
            );
        });

        dialog.addEventListener("click", (e) => {
            if (e.target === dialog) dialog.close();
        });

        window.addEventListener("keydown", (e) => {
            if ((e.metaKey === true || e.ctrlKey === true) && e.key === "k") {
                e.preventDefault();
                dialog.open ? dialog.close() : dialog.showModal();
            }
        });

        if (import.meta.env.DEV) return;

        const translations = JSON.parse(
            (document.querySelector("site-search") as HTMLElement)?.dataset
                .translations || "{}",
        );

        const formatURL = (path: string) => path.replace(/(.)\/$/, "$1");

        (async () => {
            // @ts-expect-error — Missing types for @pagefind/default-ui package.
            const { PagefindUI } = await import("@pagefind/default-ui");
            const searchElement = document.getElementById("starlight-search");
            if (!searchElement) {
                console.error("Search element #starlight-search not found");
                return;
            }

            new PagefindUI({
                element: searchElement,
                baseUrl: import.meta.env.BASE_URL,
                bundlePath:
                    import.meta.env.BASE_URL.replace(/\/$/, "") + "/pagefind/",
                showImages: false,
                translations,
                showSubResults: true,
                processResult: (result: {
                    url: string;
                    sub_results: Array<{ url: string }>;
                }) => {
                    result.url = formatURL(result.url);
                    result.sub_results = result.sub_results.map(
                        (sub_result) => {
                            sub_result.url = formatURL(sub_result.url);
                            return sub_result;
                        },
                    );
                },
            });

            const searchInput =
                searchElement.querySelector<HTMLInputElement>(
                    ".pagefind-ui-search-input",
                ) ||
                searchElement.querySelector<HTMLInputElement>(
                    'input[type="search"]',
                ) ||
                searchElement.querySelector<HTMLInputElement>("input");
            if (searchInput) {
                searchInput.id = "starlight-search-input";
                searchInput.name = "q";
                setTimeout(() => searchInput.focus(), 100);
            }
        })();
    });
</script>

<style>
    @layer starlight.utils {
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }

        .sl-hidden {
            display: none;
        }
        .sl-flex {
            display: flex;
        }
        .sl-block {
            display: block;
        }
        @media (min-width: 50rem) {
            .md\:sl-hidden {
                display: none;
            }
            .md\:sl-flex {
                display: flex;
            }
            .md\:sl-block {
                display: block;
            }
        }
        @media (min-width: 72rem) {
            .lg\:sl-hidden {
                display: none;
            }
            .lg\:sl-flex {
                display: flex;
            }
            .lg\:sl-block {
                display: block;
            }
        }
        [data-theme="dark"] .sl-hidden {
            display: none;
        }

        [dir="rtl"] .rtl\:flip:not(:where([dir="rtl"] [dir="ltr"] *)) {
            transform: matrix(-1, 0, 0, 1, 0, 0);
        }
    }

    kbd kbd {
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 3px;
        border: 0px;
        padding: 3px;
        background: var(--docsearch-key-gradient);
        box-shadow: var(--docsearch-key-shadow);
        color: var(--docsearch-muted-color);
    }
</style>
