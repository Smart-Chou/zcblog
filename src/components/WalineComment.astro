---

---

<div id="commentContainer" style="display: none;">
    <div id="waline"></div>
</div>
<button id="toggleComment" class="closeComment">展开评论</button>

<script>
    import { init, type WalineInitOptions } from '@waline/client';
    import { waline } from '~/self.config';
    import '@waline/client/waline.css';
    import '@waline/client/waline-meta.css';

    document.addEventListener('astro:page-load', () => {
        const locale = {
            level0: '炼体',
            level1: '炼气',
            level2: '筑基',
            level3: '金丹',
            level4: '元婴',
            level5: '化神',
            reactionTitle: '你认为这篇文章怎么样？',
            reaction0: '牛逼哄哄',
            reaction1: '不太行哦',
            reaction2: '还不错呦',
            reaction3: '你觉得呢',
            reaction4: '自己看看',
            reaction5: '周公叫我',
        };

        const walineElement = document.getElementById('waline');

        if (!waline.enable || !walineElement) {
            console.error('Required elements or configuration are missing.');
            return;
        }

        const origin = waline.serverUrl;
        const walineProps = walineElement!.dataset;
        const walineConfig: Partial<WalineInitOptions> = {
            el: '#waline',
            serverURL: origin,
            comment: true,
            locale,
            path: walineProps.walinePath!,
            lang: waline.lang,
            pageSize: waline.pageSize,
            pageview: true,
            meta: ['nick', 'mail'],
            requiredMeta: ['nick', 'mail'],
            login: 'disable',
            search: waline.search,
            dark: 'html[data-theme="dark"]',
            emoji: ['https://unpkg.com/@waline/emojis@1.2.0/qq', 'https://cdn.jsdelivr.net/gh/walinejs/emojis@1.0.0/bilibili'],
        };

        // 仅当不在白名单时添加 reaction 属性
        if (waline.whiteList.includes(location.pathname)) {
            // 将布尔值转换为字符串数组
            walineConfig.reaction =
                typeof waline.reaction === 'boolean' && waline.reaction === true
                    ? [] // 为 true 时使用空数组启用默认反应
                    : (waline.reaction as string[]); // 若已是数组则直接使用
        }

        init(walineConfig as WalineInitOptions);
    });
</script>

<script>
    document.addEventListener('astro:page-load', () => {
        const toggleButton = document.getElementById('toggleComment');
        const commentContainer = document.getElementById('commentContainer');

        if (!commentContainer || !toggleButton) {
            console.error('Required elements are missing from the page.');
            return;
        }

        toggleButton.addEventListener('click', () => {
            if (commentContainer.style.display === 'none') {
                commentContainer.style.display = 'block';
                toggleButton.textContent = '收起评论';
                toggleButton.style.position = 'relative';
                toggleButton.style.top = 'auto';
                toggleButton.className = 'active';
                commentContainer.parentNode?.insertBefore(toggleButton, commentContainer.nextSibling);
            } else {
                commentContainer.style.display = 'none';
                toggleButton.textContent = '展开评论';
                toggleButton.style.position = 'static';
                toggleButton.className = 'closeComment';
            }
        });
    });
</script>
