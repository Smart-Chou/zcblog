---

---

<div id="waline"></div>

<script>
  // 中文默认
  const locale = {
    level0: '炼体',
    level1: '炼气',
    level2: '筑基',
    level3: '金丹',
    level4: '元婴',
    level5: '化神',
    reactionTitle: '你认为这篇文章怎么样？',
    reaction0: '牛逼哄哄',
    reaction1: '不太行哦',
    reaction2: '还不错呦',
    reaction3: '你觉得呢',
    reaction4: '自己看看',
    reaction5: '周公叫我',
  }

  import { init } from '@waline/client'
  import '@waline/client/style'
  import '@waline/client/meta'
  const walineElement = document.getElementById('waline')
  if (walineElement) {
    const origin = window.location.hostname == 'localhost' ? 'https://waline.marxchou.com/' : window.location.origin
    const walineProps = walineElement!.dataset
    init({
      el: '#waline',
      serverURL: origin,
      locale,
      path: walineProps.walinePath!,
      lang: 'zh-CN',
      requiredMeta: ['nick', 'mail'],
      login: 'disable',
      search: false,
      reaction: true,
      pageview: true,
      comment: true,
      dark: 'body[data-theme="dark"]',
      emoji: ['https://unpkg.com/@waline/emojis@1.2.0/qq', 'https://cdn.jsdelivr.net/gh/walinejs/emojis@1.0.0/bilibili'],
    })
  }
</script>

<style>
  #waline {
    max-width: var(--content-width);
    position: relative;
    overflow: hidden;
    margin: 0 auto;
    padding: 0 var(--space);
  }

  @media screen and (max-width: 650px) {
    #waline {
      padding: unset;
    }
  }

  body[data-theme="dark"] {
    --waline-color: #ced8de !important;
  }
</style>
