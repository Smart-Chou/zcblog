---

---

<style>
    #toggleComment {
        display: block;
        margin: 1rem auto;
        padding: 0.5rem 1rem;
        background-color: var(--bg-content-color);
        color: var(--link-color);
        border: 1px var(--link-color);
        border-style: dashed;
        cursor: pointer;
        border-radius: 5px;
        text-align: center;
    }

    #toggleComment:focus {
        outline: none;
    }

    #toggleComment.active {
        font-weight: bold;
        border: 1.5px solid var(--link-color);
    }

    #waline {
        min-height: 38rem;
        max-width: var(--content-width);
        position: relative;
        overflow: hidden;
        margin: 0 auto;
        padding: 0 var(--space);
    }

    @media screen and (max-width: 650px) {
        #waline {
            padding: unset;
        }
    }

    html[data-theme="dark"] {
        --waline-color: #ced8de !important;
    }
</style>

<div id="commentContainer" style="display: none;">
    <div id="waline"></div>
</div>
<button id="toggleComment" class="closeComment">展开评论</button>

<script>
    import { init } from "@waline/client";
    import { waline } from "~/self.config";
    import "@waline/client/waline.css";
    import "@waline/client/waline-meta.css";

    document.addEventListener("astro:page-load", () => {
        const locale = {
            // 等级名称
            level0: "炼体",
            level1: "炼气",
            level2: "筑基",
            level3: "金丹",
            level4: "元婴",
            level5: "化神",
            // 评论功能相关
            placeholder: "写下你的评论...",
            nick: "昵称",
            mail: "邮箱",
            link: "网址",
            submit: "提交评论",
            reply: "回复",
            cancelReply: "取消回复",
            comment: "评论",
            comments: "评论",
            preview: "预览",
            emoji: "表情",
            uploading: "上传中...",
            login: "登录",
            logout: "登出",
            admin: "管理员",
            sticky: "置顶",
            word: "字",
            anonymous: "匿名",
            level: "等级",
            like: "点赞",
            liked: "已赞",
            dislike: "点踩",
            disliked: "已踩",
            quote: "引用",
            at: "@",
            flag: "举报",
            flagConfirm: "确定要举报这条评论吗？",
            approved: "已通过",
            waiting: "等待审核",
            spam: "垃圾评论",
            score: "评分",
            // 表情反应相关
            reactionTitle: "你认为这篇文章怎么样？",
            reaction0: "牛逼哄哄",
            reaction1: "不太行哦",
            reaction2: "还不错呦",
            reaction3: "你觉得呢",
            reaction4: "自己看看",
            reaction5: "周公叫我",
        };

        const walineElement = document.getElementById("waline");

        if (!waline.enable || !walineElement) {
            console.error("Required elements or configuration are missing.");
            return;
        }

        const origin = waline.serverUrl;
        const walineProps = walineElement!.dataset;
        const walineConfig: any = {
            el: "#waline",
            serverURL: origin,
            comment: true,
            locale,
            path: walineProps.walinePath!,
            lang: waline.lang,
            pageSize: waline.pageSize,
            pageview: true,
            meta: ["nick", "mail", "link"],
            requiredMeta: ["nick", "mail"],
            login: "disable",
            search: waline.search,
            dark: 'html[data-theme="dark"]',
            emoji: [
                "https://unpkg.com/@waline/emojis@1.2.0/qq",
                "https://cdn.jsdelivr.net/gh/walinejs/emojis@1.0.0/bilibili",
                "https://unpkg.com/@waline/emojis@1.2.0/tieba",
                "https://unpkg.com/@waline/emojis@1.2.0/weibo",
            ],
            // 新增配置
            wordLimit: [0, 1000], // 评论字数限制
            reaction: true, // 启用表情反应
            imageUploader: false, // 禁用图片上传
            highlighter: true, // 启用代码高亮
            codeSyntaxHighlight: true, // 代码语法高亮
            uploadImage: () => {
                return new Promise(() => {
                    alert("图片上传功能暂未开放");
                    throw new Error("图片上传功能暂未开放");
                });
            },
        };

        // 仅当在白名单时添加 reaction 属性
        if (waline.whiteList.includes(location.pathname)) {
            walineConfig.reaction =
                typeof waline.reaction === "boolean" && waline.reaction === true
                    ? [] // 为 true 时使用空数组启用默认反应
                    : (waline.reaction as string[]); // 若已是数组则直接使用
        }

        init(walineConfig);
    });
</script>

<script>
    document.addEventListener("astro:page-load", () => {
        const toggleButton = document.getElementById("toggleComment");
        const commentContainer = document.getElementById("commentContainer");

        if (!commentContainer || !toggleButton) {
            console.error("Required elements are missing from the page.");
            return;
        }

        toggleButton.addEventListener("click", () => {
            if (commentContainer.style.display === "none") {
                commentContainer.style.display = "block";
                toggleButton.textContent = "收起评论";
                toggleButton.style.position = "relative";
                toggleButton.style.top = "auto";
                toggleButton.className = "active";
                // 将按钮移到评论区下方
                commentContainer.parentNode?.insertBefore(
                    toggleButton,
                    commentContainer.nextSibling,
                );
            } else {
                commentContainer.style.display = "none";
                toggleButton.textContent = "展开评论";
                toggleButton.style.position = "relative";
                toggleButton.style.bottom = "auto";
                toggleButton.className = "closeComment";
                // 将按钮移回原位
                commentContainer.parentNode?.insertBefore(
                    toggleButton,
                    commentContainer,
                );
            }
        });
    });
</script>
