---
import { formatDate } from "~/utils/formatDate";
const { publishedTime, wordCount, readTime, currentSlug } = Astro.props;
---

<div class="post-meta post-card__meta">
    Posted {formatDate(publishedTime)}.&nbsp;&nbsp;
    <span id="word-count">{wordCount} words.</span>&nbsp;
    <span id="read-time">{readTime}.</span>&nbsp;
    <span class="waline-pageview-count" data-path={`/article/${currentSlug}/`}
        >0</span
    >
    <span> views.&nbsp;</span>
</div>
