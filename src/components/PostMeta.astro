---
const { date, wordCount, readTime, currentSlug, lastModified } = Astro.props;
---

<div class="post-meta post-card__meta">
    Posted {date}.Update {lastModified}.
    <span id="word-count">{wordCount} words.</span>
    <span id="read-time">{readTime} min read.</span>
    <span class="waline-pageview-count" data-path={`/archives/${currentSlug}/`}>0</span> views.
    <span class="waline-comment-count" data-path={`/archives/${currentSlug}/`}>0</span> messages.
</div>
