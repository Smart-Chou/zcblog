---
interface Post {
    id: string;
    data: {
        title: string;
        description: string;
        pubDate: Date;
        image?: {
            url: string | { src: string };
            alt: string;
        };
    };
}

interface Props {
    posts: Post[];
}

const { posts } = Astro.props;

function formatDate(date: Date): string {
    const now = new Date();
    const diff = now.getTime() - date.getTime();
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));

    if (days === 0) return "今天";
    if (days === 1) return "1 天前";
    if (days < 30) return `${days} 天前`;
    if (days < 365) return `${Math.floor(days / 30)} 个月前`;
    return `${Math.floor(days / 365)} 年前`;
}

function getImageUrl(image: Post["data"]["image"]): string {
    if (!image) return "";
    if (typeof image.url === "string") return image.url;
    return image.url.src;
}
---

<div class="posts posts-home home grid-cols-2">
    {
        posts.length > 0 && (
            <div class="post first col-span-2 home-1">
                {posts[0].data.image && (
                    <img
                        loading="lazy"
                        decoding="async"
                        src={getImageUrl(posts[0].data.image)}
                        class="post-cover home"
                        alt={posts[0].data.image.alt}
                    />
                )}
                <h1 class="post-title">
                    <a href={`/article/${posts[0].id}/`}>
                        {posts[0].data.title}
                    </a>
                </h1>
                <div class="post-meta">
                    <span
                        class="post-date"
                        title={posts[0].data.pubDate.toISOString()}
                    >
                        {formatDate(posts[0].data.pubDate)}
                    </span>
                </div>
                <div class="post-content">
                    <p>{posts[0].data.description}</p>
                    <a
                        class="read-more button"
                        href={`/article/${posts[0].id}/`}
                    >
                        阅读全文 →
                    </a>
                </div>
            </div>
        )
    }

    {
        posts.slice(1).map((post) => (
            <div class="post col-span-1 home-2">
                {post.data.image && (
                    <img
                        loading="lazy"
                        decoding="async"
                        src={getImageUrl(post.data.image)}
                        class="post-cover"
                        alt={post.data.image.alt}
                    />
                )}
                <h1 class="post-title">
                    <a href={`/article/${post.id}/`}>{post.data.title}</a>
                </h1>
                <div class="post-meta">
                    <span
                        class="post-date"
                        title={post.data.pubDate.toISOString()}
                    >
                        {formatDate(post.data.pubDate)}
                    </span>
                </div>
            </div>
        ))
    }
</div>

<div class="homemore">
    <a href="/archives/">查看更多</a>
</div>
