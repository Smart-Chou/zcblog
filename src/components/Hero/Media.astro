---
import MediaCardGrid from "~/components/ui/MediaCardGrid.astro";

interface Media {
    url: string;
    rating: number;
    ratingNum?: number;
    title: string;
    link?: string;
}

interface Props {
    title: string;
    items: Media[];
    href?: string;
}

const { title, items, href = "#" } = Astro.props;
---

<div class="douban media-section">
    <h3><a href={href}>{title}</a></h3>
    <MediaCardGrid items={items} />
</div>
