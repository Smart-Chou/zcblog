---
import { heroConfig } from "~/config/hero.config";
import Button from "~/components/Widget/Button.astro";
---

<header class="hero-header">
    <div class="hero-info">
        <div class="hero-greeting">hi! 👋</div>
        <h1 class="hero-title">
            I'm <span class="accent">{heroConfig.author.name}</span>
        </h1>
        <p class="hero-subtitle">{heroConfig.author.title}</p>
        <p class="hero-motto">{heroConfig.author.motto}</p>
        <div class="hero-links">
            {
                heroConfig.ctaButtons.map((btn) => (
                    <Button
                        href={btn.url}
                        variant={
                            btn.variant === "solid" ? "primary" : "secondary"
                        }
                        target={btn.external ? "_blank" : undefined}
                        rel={btn.external ? "noopener" : undefined}
                    >
                        {btn.label}
                    </Button>
                ))
            }
        </div>
    </div>
    <div class="hero-avatar">
        <div class="avatar-circle">
            <span class="avatar-initial">M</span>
        </div>
        <p class="avatar-caption">Illustration</p>
    </div>
</header>
