---
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import { author, socialLinks, categories } from "~/self.config";

const socials = socialLinks;
---

<header class="hero">
    <div class="hero__container">
        <div class="hero__avatar-wrapper">
            <img
                src={`/${author.avatar}`}
                alt={author.type}
                class="hero__avatar"
                width="120"
                height="120"
                loading="eager"
            />
            <span class="hero__status-indicator" aria-label="Online"></span>
        </div>

        <div class="hero__content">
            <h1 class="hero__title">
                <span class="hero__greeting">hi!</span>
                <span class="hero__name">
                    I'm <strong>{author.type.split(" ")[0]}</strong>,
                </span>
            </h1>
            <p class="hero__subtitle">{author.motto}</p>
        </div>

        <div class="hero__links">
            {
                socials.map((link) => (
                    <a
                        href={link.url}
                        title={link.title}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hero__link"
                        aria-label={link.title}
                        style={link.style}
                    >
                        <DynamicIcon name={link.svg} />
                    </a>
                ))
            }
        </div>
    </div>
</header>

<style>
    .hero {
        padding: 4rem 0 2rem;
        text-align: center;
    }

    .hero__container {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 0 var(--space);
    }

    .hero__avatar-wrapper {
        position: relative;
        display: inline-block;
        margin-bottom: 1.5rem;
    }

    .hero__avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--bg-content-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .hero__status-indicator {
        position: absolute;
        bottom: 8px;
        right: 8px;
        width: 16px;
        height: 16px;
        background-color: #22c55e;
        border-radius: 50%;
        border: 3px solid var(--bg-content-color);
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }

    .hero__content {
        margin-bottom: 1.5rem;
    }

    .hero__title {
        font-size: 2.5rem;
        font-weight: 1000;
        line-height: 1.2;
        margin-bottom: 0.5rem;
        color: var(--title-color);
    }

    .hero__greeting {
        font-size: 1.5rem;
        opacity: 0.7;
        display: block;
        margin-bottom: 0.25rem;
    }

    .hero__name {
        font-size: 2.5rem;
    }

    .hero__name strong {
        color: var(--accent-color);
    }

    .hero__subtitle {
        font-size: 1.1rem;
        opacity: 0.8;
        margin-bottom: 1rem;
    }

    .hero__links {
        display: flex;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .hero__link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background-color: var(--bg-color);
        transition:
            transform 0.2s,
            background-color 0.2s;
    }

    .hero__link:hover {
        transform: translateY(-3px);
        background-color: var(--bg-content-color);
    }

    .hero__link :global(svg) {
        width: 20px;
        height: 20px;
    }

    @media screen and (max-width: 650px) {
        .hero {
            padding: 2rem 0 1.5rem;
        }

        .hero__avatar {
            width: 100px;
            height: 100px;
        }

        .hero__title {
            font-size: 1.8rem;
        }

        .hero__name {
            font-size: 1.8rem;
        }

        .hero__greeting {
            font-size: 1.2rem;
        }
    }
</style>