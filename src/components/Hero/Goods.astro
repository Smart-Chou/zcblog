---
// 好物数据（来自 immm）
const goods = [
    {
        url: "images/24.webp",
        price: "¥458 (25-05)",
        title: "罗技 MX Keys Mini",
        note: "颜值在线，手感舒适，静音首选",
    },
    {
        url: "images/25.webp",
        price: "¥129 (24-06)",
        title: "米家桌面移动风扇",
        note: "风力是真强筋，内置 4000 毫安电池，说是最大档能吹 2 小时。",
    },
    {
        url: "images/26.webp",
        price: "¥99 (23-12)",
        title: "酷态科口袋充电宝",
        note: "名片大小，小巧玲珑，颜值在线，支持 30W 快充。",
    },
    {
        url: "images/27.webp",
        price: "¥168 (23-10)",
        title: "米家充气宝 2",
        note: "充气虽然慢了点，发热有点厉害，但值得常备。",
    },
    {
        url: "images/28.webp",
        price: "¥204 (23-10)",
        title: "Mac mini 立式扩展",
        note: "虽塑料材质，但接口全也满速，还可内置 ssd。立起来后，桌面整洁不少。",
    },
];
---

<div class="home">
    <h3><a href="/goods/">近期好物</a></h3>
    <div id="goods">
        {
            goods.map((item) => (
                <div class="goods-bankuai img-hide">
                    <div class="goods-duiqi">
                        <img
                            loading="lazy"
                            decoding="async"
                            src={item.url}
                            alt={item.title}
                        />
                    </div>
                    <div class="goods-jiage">{item.price}</div>
                    <div class="goods-title">{item.title}</div>
                    <div class="goods-note">{item.note}</div>
                </div>
            ))
        }
    </div>
</div>
