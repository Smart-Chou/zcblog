---
import { heroConfig } from '~/config/hero.config';
---

<header class="relative left-0 right-0 top-0 z-50">
    <div class="absolute inset-0 h-16 -z-10"></div>
    <div class="h-2"></div>
    <div class="content-wrapper-max">
        <div class="relative z-50 flex h-16 items-center justify-between px-2 text-sm md:px-4">
            <nav class="flex md:gap-2" data-accent="violet">
                <a class="flex h-9 items-center gap-2 rounded-xl px-2" aria-label="Home" href={heroConfig.site.url}>
                    <div class="border-box flex h-8 w-8 items-center justify-center rounded-xl border-2 sm:h-6 sm:w-6 sm:rounded-lg border-accent-600 bg-accent-600 dark:border-accent-500 dark:bg-accent-500">
                        <div class="h-3.5 w-0.5 rotate-12 rounded-full sm:h-3 sm:w-0.5 bg-white"></div>
                    </div>
                    <div class="-mt-1 hidden text-xl sm:block">
                        <span class="text-slate-900 dark:text-slate-200">{heroConfig.site.name}</span><span class="text-accent-600 dark:text-accent-500">dev</span>
                    </div>
                </a>
            </nav>
            <ul class="flex items-center md:gap-1">
                {heroConfig.navLinks.filter(link => !link.showInLarge).map(link => (
                    <li>
                        <a class="nav-link" href={link.url}>{link.label}</a>
                    </li>
                ))}
                <li class="lg:hidden sf-hidden" data-accent="blue">
                    <!-- Mobile menu items -->
                </li>
                <li class="hidden lg:block" data-accent="blue">
                    <div class="flex">
                        <ul class="flex items-center">
                            {heroConfig.navLinks.filter(link => link.showInLarge).map((link, index) => (
                                <>
                                    {index > 0 && (
                                        <li>
                                            <div class="nav-link__separator">·</div>
                                        </li>
                                    )}
                                    <li>
                                        <a class="nav-link" href={link.url}>{link.label}</a>
                                    </li>
                                </>
                            ))}
                        </ul>
                    </div>
                </li>
                <ul class="flex items-center">
                    {heroConfig.socialLinks.filter(link => link.icon === 'twitter').map(link => (
                        <li class="hidden sm:block">
                            <a href={link.url} class="flex items-center justify-center rounded-xl hover:bg-slate-300/50 dark:hover:bg-slate-800/50" aria-label={`My ${link.title} profile`} title={`My ${link.title} profile`} target="_blank" rel="noreferrer nofollow">
                                <span class="flex h-9 w-9 items-center justify-center rounded-xl">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" role="img" fill="currentColor" class="h-5 w-5">
                                        <title>{link.title} Icon</title>
                                        <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path>
                                    </svg>
                                </span>
                            </a>
                        </li>
                    ))}
                    {heroConfig.socialLinks.filter(link => link.icon === 'github').map(link => (
                        <li class="hidden sm:block">
                            <a href={link.url} class="flex items-center justify-center rounded-xl hover:bg-slate-300/50 dark:hover:bg-slate-800/50" aria-label={`My ${link.title} profile`} title={`My ${link.title} profile`} target="_blank" rel="noreferrer nofollow">
                                <span class="flex h-9 w-9 items-center justify-center rounded-xl">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" role="img" fill="currentColor" class="h-5 w-5">
                                        <title>{link.title} Icon</title>
                                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
                                    </svg>
                                </span>
                            </a>
                        </li>
                    ))}
                    <li class="hidden sm:block">
                        <div class="ml-2 mr-4 h-3 w-[1px] bg-slate-200 dark:bg-slate-700"></div>
                    </li>
                    <li class="mr-2">
                        <button type="button" class="ml-1 flex h-9 w-9 items-center justify-center gap-2 rounded-xl bg-slate-300/50 text-slate-800 xl:w-auto xl:px-3 hover:bg-slate-300/70 sm:ml-0 dark:bg-slate-800/50 dark:text-slate-100 dark:hover:bg-slate-700/50" aria-label="Open Quick Access" title="Open Quick Access">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
                                <path fill-rule="evenodd" d="M2.5 3A1.5 1.5 0 001 4.5v4A1.5 1.5 0 002.5 10h6A1.5 1.5 0 0010 8.5v-4A1.5 1.5 0 008.5 3h-6zm11 2A1.5 1.5 0 0012 6.5v7a1.5 1.5 0 001.5 1.5h4a1.5 1.5 0 001.5-1.5v-7A1.5 1.5 0 0017.5 5h-4zm-10 7A1.5 1.5 0 002 13.5v2A1.5 1.5 0 003.5 17h6a1.5 1.5 0 001.5-1.5v-2A1.5 1.5 0 009.5 12h-6z" clip-rule="evenodd"></path>
                            </svg>
                            <div class="hidden items-center gap-2 text-xs font-bold xl:flex dark:font-normal">
                                Quick Access<kbd class="rounded-[4px] border border-b-[3px] border-slate-400 bg-slate-300 px-1 py-0.5 font-mono dark:border-slate-300 dark:bg-transparent">Q</kbd>
                            </div>
                        </button>
                    </li>
                </ul>
            </ul>
        </div>
    </div>
</header>