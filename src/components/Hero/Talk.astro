---
import TalkIcon from "~/components/icons/TalkIcon.astro";
import items from "~/data/talks.json";

const itemsJson = JSON.stringify(items);
---

<div id="bber-talk">
    <span class="index-talk-icon">
        <TalkIcon />
    </span>
    <div class="talk-wrap">
        <ul class="talk-list" data-items={itemsJson}></ul>
    </div>
</div>

<script>
    const DURATION = 6000;
    const list = document.querySelector(".talk-list") as HTMLElement;
    const items = JSON.parse(list.dataset.items || "[]");
    let index = 0;

    function render() {
        if (!items.length) return;
        const item = items[index];
        list.innerHTML = `
            <li class="item">
                <span class="datetime" title="${item.datetime}">${item.display}</span>：
                <a href="${item.url}">${item.content}</a>
            </li>
        `;
    }

    render();
    setInterval(() => {
        index = (index + 1) % items.length;
        list.style.opacity = "0";
        setTimeout(() => {
            render();
            list.style.opacity = "1";
        }, 200);
    }, DURATION);
</script>
