---
interface Props {
    key?: string;
    title: string;
    url: string;
    publishedTime: Date | string;
}

const { title, url, publishedTime } = Astro.props;

// 验证和格式化日期
const formattedDate = publishedTime
    ? new Date(publishedTime).toLocaleDateString("en-US", {
          month: "2-digit",
          day: "2-digit",
      })
    : "Invalid date";
---

<p class="archive-meta">
    <span class="archive-date">{formattedDate}</span>
    <a class="archive-title" href={url} rel="noopener noreferrer">{title}</a>
</p>

<style>
    .archive-meta {
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .archive-date {
        display: flex;
        margin-left: 1rem;
        min-width: 3rem;
        color: gray;
        justify-content: flex-end;
    }

    .archive-title {
        margin-left: 0.5rem;
        text-decoration: none;
    }

    @media (hover: hover) {
        .archive-title:hover {
            text-decoration: underline;
        }
    }
</style>
