---
const API = "https://v1.hitokoto.cn/?c=d&c=i&c=k";

let hitokoto = "";
let from = "";
let fromWho = "";

try {
    const res = await fetch(API);
    if (res.ok) {
        const data = await res.json();
        hitokoto = data.hitokoto;
        from = data.from;
        fromWho = data.from_who;
    }
} catch (e) {
    console.debug("hitokoto fetch failed", e);
}

if (!hitokoto) return;
---

<div class="hitokoto">
    <blockquote class="hitokoto-text" id="hitokoto-text">{hitokoto}</blockquote>
    <p class="hitokoto-source" id="hitokoto-source">
        {fromWho || from ? "—— " : ""}{fromWho}{
            fromWho && from ? "《" + from + "》" : from && !fromWho ? "《" + from + "》" : ""
        }
    </p>
</div>

<style>
    .hitokoto {
        text-align: center;
        max-width: 640px;
        /* 原为 -8rem（与 Author 旧 8rem 顶部间距配对）；Author 间距重构后会造成
           与作者区重叠 96px，2026-10-02 改为 0，与全站 32px 节奏一致 */
        margin: 2rem auto 0;
        padding: 1.5rem 1rem;
    }

    .hitokoto-text {
        margin: 0;
        padding: 0;
        font-size: 1.05em;
        line-height: 1.8;
        color: var(--color-text);
        opacity: 0.85;
        letter-spacing: 0.03em;
        border: 0;
        transition: opacity 0.3s ease;
    }

    .hitokoto-text::before {
        content: "\201C";
    }
    .hitokoto-text::after {
        content: "\201D";
    }

    .hitokoto-source {
        margin-top: 0.75em;
        font-size: 0.9em;
        /* A8：opacity 0.55 把实际对比度压到 3.41:1；改为直接给色（5.3:1），不再靠透明度 */
        color: #6b6762;
        opacity: 1;
        transition: opacity 0.3s ease;
    }
</style>

<script>
    import { onPageReady } from "~/utils/page-lifecycle";

    function formatSource(from: string, fromWho: string): string {
        if (!fromWho && !from) return "";
        let result = "—— ";
        if (fromWho) result += fromWho;
        if (fromWho && from) result += "《" + from + "》";
        else if (from && !fromWho) result += "《" + from + "》";
        return result;
    }

    function getHitokoto() {
        const textEl = document.getElementById("hitokoto-text");
        const sourceEl = document.getElementById("hitokoto-source");
        if (!textEl || !sourceEl) {
            if (timer) {
                clearInterval(timer);
                timer = null;
            }
            return;
        }
        fetch("https://v1.hitokoto.cn/?c=d&c=i&c=k")
            .then((res) => res.json())
            .then((data) => {
                textEl.style.opacity = "0";
                sourceEl.style.opacity = "0";
                setTimeout(() => {
                    textEl.textContent = data.hitokoto;
                    sourceEl.textContent = formatSource(data.from, data.from_who);
                    textEl.style.opacity = "";
                    sourceEl.style.opacity = "";
                }, 320);
            })
            .catch((e) => {
                console.debug("hitokoto fetch failed", e);
            });
    }

    // 元素在 <main> 里，换页会被整体替换；定时器和旧节点都必须跟着换，
    // 否则 ① 新页面的一言不发请求（它只会在 60s 后打给已被移除的旧节点）
    // ② 每次换页都多一个 setInterval，越攒越多。
    let timer: ReturnType<typeof setInterval> | null = null;

    onPageReady(() => {
        if (timer) {
            clearInterval(timer);
            timer = null;
        }
        if (!document.getElementById("hitokoto-text")) return;

        getHitokoto();
        timer = setInterval(getHitokoto, 60000);
    });
</script>
