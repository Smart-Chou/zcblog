---
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";

interface PageInfo {
    url: { prev?: string; next?: string };
    lastPage: number;
    currentPage: number;
}

interface Props {
    page: PageInfo;
    blogPath?: string;
}

const { page, blogPath = "/blog" } = Astro.props;
---

<style>
    #pagination {
        margin: calc(var(--space) * 1.25) auto var(--space);
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    #pagination a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        box-sizing: border-box;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-full);
        color: var(--color-text-muted);
        font-size: 0.9em;
        text-decoration: none;
        line-height: 1;
        transition:
            color var(--duration-fast) var(--ease-out),
            border-color var(--duration-fast) var(--ease-out),
            background-color var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        #pagination a:not(.disabled):not(.active):hover {
            color: var(--color-accent);
            border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
        }
    }

    #pagination a.active {
        font-weight: 600;
        color: var(--color-accent);
        border-color: var(--color-accent);
        background-color: color-mix(in srgb, var(--color-accent) 8%, transparent);
    }

    #pagination a.disabled {
        pointer-events: none;
        color: var(--color-text-dimmed);
        border-color: var(--color-border);
        opacity: 0.45;
    }

    #pagination a.square-class {
        width: 36px;
        height: 36px;
        padding: unset;
    }

    @media screen and (max-width: 450px) {
        #pagination a:not([aria-label]) {
            display: none;
        }

        #pagination a.active {
            display: inline-flex;
        }
    }
</style>

<nav id="pagination" aria-label="Pagination Navigation">
    <a
        href={page.url.prev}
        aria-label="Previous"
        aria-disabled={!page.url.prev}
        class:list={[page.url.prev ? "" : "disabled", "square-class"]}
    >
        <DynamicIcon name="tabler:chevrons-left" />
    </a>
    {
        (() => {
            const pages: number[] = [];
            const totalPages = page.lastPage;
            const currentPage = page.currentPage;
            let startPage = 1;
            let endPage = 1;

            if (totalPages < 6) {
                startPage = 1;
                endPage = totalPages;
            } else if (currentPage < 4) {
                startPage = 1;
                endPage = 5;
            } else if (currentPage + 3 > totalPages) {
                startPage = totalPages - 4;
                endPage = totalPages;
            } else {
                startPage = currentPage - 2;
                endPage = currentPage + 2;
            }

            for (let pageNumber = startPage; pageNumber < endPage + 1; pageNumber++) {
                const href = `${blogPath}/${pageNumber}/`;
                pages.push(
                    <a
                        data-key={`page-${pageNumber}`}
                        href={href}
                        aria-current={pageNumber === currentPage ? "page" : null}
                        class={pageNumber === currentPage ? "active" : ""}
                    >
                        {pageNumber}
                    </a>,
                );
            }
            return pages;
        })()
    }
    <a
        href={page.url.next}
        aria-label="Next"
        aria-disabled={!page.url.next}
        class:list={[page.url.next ? "" : "disabled", "square-class"]}
    >
        <DynamicIcon name="tabler:chevrons-right" />
    </a>
</nav>
