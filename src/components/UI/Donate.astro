---
import { Image } from "astro:assets";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { donate } from "~/config";
import type { ImageMetadata } from "astro";
import { t, getLocale, type Locale } from "~/utils/i18n";

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const loc: Locale = getLocale(locale);

const qrModules = import.meta.glob<{ default: ImageMetadata }>("~/assets/qr/*", { eager: true });

function getQRImage(configPath: string): ImageMetadata | null {
    const filename = configPath.split("/").pop();
    if (!filename) return null;
    const key = Object.keys(qrModules).find((k) => k.endsWith(filename));
    return key ? qrModules[key]?.default : null;
}

const wechatQR = getQRImage(donate.wechatQRCode);
const alipayQR = getQRImage(donate.alipayQRCode);
---

<!-- 样式已移到 src/styles/article.css（D-0085：并入全局样式链，避免文章页单独拉一份 CSS） -->
<div class="donate">
    <div class="reward">
        <button id="donateTrigger" class="reward-btn">
            <DynamicIcon name="mingcute:hand-heart-line" />
            <span class="text">&nbsp;{t(loc, "donate.buttonText")}</span>
        </button>
    </div>
    <dialog id="donateDialog" class="modal">
        <div class="modal-main">
            <div class="header-title">
                <div class="title-left">
                    <DynamicIcon name="mingcute:hand-heart-line" />
                    <span class="title-text">&nbsp;{t(loc, "donate.buttonText")}</span>
                </div>
                <button id="donateClose" class="close" aria-label="Close"> &times; </button>
            </div>
            <div class="modal-content">
                <div class="reward-card">
                    <span class="thank">{t(loc, "donate.thankNote")}</span>
                    <div class="qr">
                        {
                            wechatQR && (
                                <div class="qr-img">
                                    <Image
                                        src={wechatQR}
                                        alt={t(loc, "donate.wechatPay")}
                                        width={200}
                                        format="avif"
                                        quality={80}
                                    />
                                    <span class="tip">
                                        <DynamicIcon name="mingcute:wechat-pay-line" />
                                        &nbsp;{t(loc, "donate.wechat")}
                                    </span>
                                </div>
                            )
                        }
                        {
                            alipayQR && (
                                <div class="qr-img">
                                    <Image
                                        src={alipayQR}
                                        alt={t(loc, "donate.alipay")}
                                        width={200}
                                        format="avif"
                                        quality={80}
                                    />
                                    <span class="tip">
                                        <DynamicIcon name="mingcute:alipay-line" />
                                        &nbsp;{t(loc, "donate.alipayShort")}
                                    </span>
                                </div>
                            )
                        }
                    </div>
                    <a href={loc === "en" ? "/en/donate/" : "/donate/"} class="all-list-btn">
                        <div class="all-list s-card hover">
                            <span class="title">{t(loc, "donate.viewAllDonators")}</span>
                            <span class="tip">{t(loc, "donate.tipText")}</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </dialog>
</div>

<script>
    // 弹窗可能是文章页里唯一"浮在 top layer"的东西，SPA 换页时必须主动收尾：
    // 元素会随 <main> 一起被替换，dialog 的 toggle 事件不会再派发，滚动锁会留下；
    // 而且 swup 的 before-swap 要等新页面 HTML 抓回来才派发（实测 ~450ms），
    // 这段时间弹窗还浮在新页面上，看起来就是"一闪而过"。
    // 所以：点击弹窗内的链接立刻收，换页事件再兜一层。
    function closeDonateDialog() {
        const dialog = document.querySelector<HTMLDialogElement>("#donateDialog");
        if (!dialog?.open) return;
        dialog.close();
        import("~/scripts/scroll-lock").then((mod) => mod.unlockScroll());
    }

    document.addEventListener("swup:visit:start", closeDonateDialog);
    document.addEventListener("astro:before-swap", closeDonateDialog);

    function setupDonate() {
        const dialog = document.getElementById("donateDialog") as HTMLDialogElement | null;
        const trigger = document.getElementById("donateTrigger");
        const closeBtn = document.getElementById("donateClose");
        if (!dialog || !trigger || !closeBtn) return;

        // Prevent duplicate listeners
        if (dialog.dataset.donateReady) return;
        dialog.dataset.donateReady = "true";

        let lockScrollFn: (() => void) | null = null;
        let unlockScrollFn: (() => void) | null = null;

        trigger.addEventListener("click", async () => {
            // 延迟加载 scroll-lock：仅在用户点击捐赠按钮时才下载
            if (!lockScrollFn) {
                const mod = await import("~/scripts/scroll-lock");
                lockScrollFn = mod.lockScroll;
                unlockScrollFn = mod.unlockScroll;
            }
            dialog.showModal();
        });

        closeBtn.addEventListener("click", () => {
            dialog.close();
        });

        dialog.addEventListener("click", (e) => {
            // Close on backdrop click
            if (e.target === dialog) {
                dialog.close();
                return;
            }
            // 弹窗里的链接（如"全部赞赏者名单"）：按下即收，不等 swup 抓完 HTML
            const link = (e.target as HTMLElement | null)?.closest("a[href]");
            if (link) {
                dialog.close();
                unlockScrollFn?.();
            }
        });

        dialog.addEventListener("toggle", () => {
            if (dialog.open) {
                lockScrollFn?.();
            } else {
                unlockScrollFn?.();
            }
        });
    }

    document.addEventListener("astro:page-load", setupDonate);

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupDonate);
    } else {
        setupDonate();
    }
</script>
