---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";

interface Props {
    qrImage: ImageMetadata;
    alt: string;
    platformName: string;
    iconName: string;
    paypalUrl?: string;
}

const { qrImage, alt, platformName, iconName, paypalUrl } = Astro.props;
---

<div class="donate-method">
    <div class="qr-code">
        <Image src={qrImage} alt={alt} width={160} height={160} loading="lazy" decoding="async" />
        <div class="qr-info">
            {
                paypalUrl ? (
                    <a
                        href={paypalUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="paypal-btn"
                    >
                        <DynamicIcon name={iconName} class="pay-icon" />
                        <span class="pay-name">{platformName}</span>
                    </a>
                ) : (
                    <>
                        <DynamicIcon name={iconName} class="pay-icon" />
                        <span class="pay-name">{platformName}</span>
                    </>
                )
            }
        </div>
    </div>
</div>

<style>
    .donate-method {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .qr-code {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .qr-code img {
        width: 160px;
        height: 160px;
        object-fit: contain;
        border-radius: 8px;
    }

    .qr-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .qr-info :global(.pay-icon) {
        font-size: 1.2rem;
    }

    .pay-name {
        font-weight: 500;
    }

    .paypal-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        text-decoration: none;
        color: inherit;
    }
</style>
