---
/**
 * Search component using Pagefind Component UI (v1.5.0+).
 * Requires `pnpm build` once to generate public/pagefind/ for dev server.
 */
import { t, getLocale, type Locale } from "~/utils/i18n";

interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const loc: Locale = getLocale(locale);
const searchPlaceholder = t(loc, "common.searchPlaceholder");
---

<script is:inline>
    // ============================================================
    // 修复 Pagefind 中文 (CJK) 搜索分词不一致问题
    //
    // 背景：
    //   Pagefind 构建时用 Rust 索引器分词，搜索时用浏览器的 Intl.Segmenter
    //   分词。二者结果可能不一致，"好家伙" 索引时被拆成 "好家"+"伙"，搜索时
    //   Intl.Segmenter 拆成 "好"+"家伙"，导致 "好家伙" 搜不到但 "好" 可以。
    //
    // 修复策略：
    //   覆写 Intl.Segmenter，对 CJK 语言的 word 分词结果后处理：将包含
    //   中日韩文字的单词拆为单字，非 CJK 单词（英文等）保持原样。
    //   效果："好家伙" → "好 家 伙"，"LobeChat 导出" → "LobeChat 导 出"
    //
    // 注意：此修复仅在 Pagefind 修复索引/搜索分词对齐之前需要。
    // ============================================================
    (function () {
        var O = typeof Intl !== "undefined" && Intl.Segmenter;
        if (!O) return;

        var _Orig = O;
        var cjkPrefixes = ["zh", "ja", "ko", "th"];
        var cjkRe =
            /\p{Script=Han}|\p{Script=Katakana}|\p{Script=Hiragana}|\p{Script=Hangul}|\p{Script=Thai}/u;

        Intl.Segmenter = function (locales, options) {
            var opts = options || {};
            if (opts.granularity !== "word") {
                return new _Orig(locales, opts);
            }

            var locale =
                typeof locales === "string"
                    ? locales
                    : Array.isArray(locales) && locales.length > 0
                      ? locales[0]
                      : "";
            var lang = locale.split("-")[0].toLowerCase();

            if (!cjkPrefixes.includes(lang)) {
                return new _Orig(locales, opts);
            }

            // CJK 语言：后处理 word 分词结果，将 CJK 单词拆为单字
            var wordSeg = new _Orig(locales, { granularity: "word" });
            var charSeg = new _Orig(locales, { granularity: "grapheme" });

            return {
                segment: function* (input) {
                    for (var seg of wordSeg.segment(input)) {
                        if (seg.isWordLike && cjkRe.test(seg.segment)) {
                            var idx = seg.index;
                            for (var g of charSeg.segment(seg.segment)) {
                                yield {
                                    segment: g.segment,
                                    index: idx,
                                    input: input,
                                    isWordLike: true,
                                };
                                idx += g.segment.length;
                            }
                        } else {
                            yield seg;
                        }
                    }
                },
            };
        };

        Intl.Segmenter.prototype = _Orig.prototype;

        // 加载 Pagefind Component UI 模块 —— 按需（S3 / D-0053）
        // 这个模块 38.3KB gz，比整站首屏 JS 还大。原来在解析期无条件 append，
        // 等于每个访客为「从没点过的搜索」付一次全量下载。改为首次交互才加载：
        //   鼠标/手指悬停在搜索按钮、按下 ⌘K/Ctrl+K、点击按钮
        var base = "/pagefind/";
        var src = base + "pagefind-component-ui.js";

        var pfPromise = null;
        var pfCssHref = base + "pagefind-component-ui.css";
        function ensurePagefindCss() {
            if (document.querySelector('link[href="' + pfCssHref + '"]')) return;
            var l = document.createElement("link");
            l.rel = "stylesheet";
            l.href = pfCssHref;
            document.head.appendChild(l);
        }
        function loadPagefind() {
            if (pfPromise) return pfPromise;
            ensurePagefindCss();
            pfPromise = new Promise(function (resolve) {
                var existing = document.querySelector('script[src="' + src + '"]');
                if (existing) return resolve();
                var s = document.createElement("script");
                s.src = src;
                s.type = "module";
                s.addEventListener("load", function () {
                    resolve();
                });
                s.addEventListener("error", function () {
                    pfPromise = null;
                    resolve();
                });
                document.head.appendChild(s);
            });
            return pfPromise;
        }
        // 暴露给其它脚本（如首页搜索框）按需触发
        window.__loadPagefindUI = loadPagefind;

        // 1) 悬停意图：抢在点击之前把模块拉下来（用户几乎感觉不到）
        //    只对鼠标生效——触摸设备没有 hover，pointerenter 会和手指的 pointerdown 同时到达，
        //    模块在「按下去」和「松开」之间升级，pagefind 会替换掉内部按钮，click 落在被摘掉的节点上
        //    → 第一次点按没有反应，要再点一次（这就是移动端「点两次」的根因）。
        document.addEventListener(
            "pointerenter",
            function (e) {
                if (e.pointerType === "touch") return;
                var t = e.target;
                if (t && t.closest && t.closest("pagefind-modal-trigger")) loadPagefind();
            },
            true,
        );
        // 2) 快捷键：mod+k（pagefind 按平台渲染角标并绑定：Mac=⌘K，其它=Ctrl+K）
        document.addEventListener("keydown", function (e) {
            if (!(e.metaKey || e.ctrlKey) || String(e.key).toLowerCase() !== "k") return;
            // 模块还没升级：这次按键只有我们能接住（pagefind 自己的快捷键监听还没绑），
            // 所以先拦下浏览器默认行为，加载完再手动开一次。
            if (customElements.get("pagefind-modal-trigger")) return;
            e.preventDefault();
            var trigger = document.querySelector("pagefind-modal-trigger");
            loadPagefind().then(function () {
                if (trigger && typeof trigger.openModal === "function") trigger.openModal();
            });
        });
        // 3) 打开搜索：自己接管，不依赖 pagefind 内部的按钮
        //    · 已经打开 → 直接放行，避免重复 showModal
        //    · 未打开 → 拦下，等模块就绪后调宿主元素上的 openModal()
        function modalIsOpen() {
            var m = document.querySelector("pagefind-modal");
            if (!m) return false;
            var d = m.querySelector("dialog");
            return !!(d && d.open);
        }
        function openSearch() {
            return loadPagefind().then(function () {
                var t = document.querySelector("pagefind-modal-trigger");
                // 触发器的点击处理绑在内部按钮上，宿主元素的 click() 不会冒泡进去，
                // 实测 trigger.click() 打不开模态框；有 openModal 就直接调。
                if (t && typeof t.openModal === "function") t.openModal();
            });
        }
        // 3a) 按下即接管：触摸时 pointerdown 的目标一定还连着 DOM，
        //     不会像 click 那样随组件升级一起被摘掉 —— 这是「点一次就开」的关键。
        document.addEventListener(
            "pointerdown",
            function (e) {
                var t = e.target;
                var trigger = t && t.closest && t.closest("pagefind-modal-trigger");
                if (!trigger || e.button !== 0 || modalIsOpen()) return;
                e.preventDefault();
                openSearch();
            },
            true,
        );
        // 3b) click 兜底（键盘回车、辅助技术触发，或不产生 pointerdown 的场景）
        document.addEventListener(
            "click",
            function (e) {
                var t = e.target;
                var trigger = t && t.closest && t.closest("pagefind-modal-trigger");
                if (!trigger || modalIsOpen()) return;
                e.preventDefault();
                e.stopPropagation();
                openSearch();
            },
            true,
        );
        // 4) SPA 换页后 head 会被 swup 的 head 插件重写，已注入的 CSS 可能被移除
        //    注意：本段是 is:inline，拿不到 import，不能调 utils 里的 onPageReady
        //    （之前那一版在这里抛 ReferenceError，换页后 CSS 就再没补回来）。
        var pageReady = function (fn) {
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", fn, { once: true });
            } else {
                fn();
            }
            document.addEventListener("astro:page-load", fn);
        };
        // 4) 首屏静态占位的平台键：Mac 显示 ⌘，其它显示 Ctrl（与 pagefind 的渲染规则一致）
        var isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
        function syncModKey() {
            var keys = document.querySelectorAll(
                "pagefind-modal-trigger .pf-trigger-key[data-mod-key]",
            );
            for (var i = 0; i < keys.length; i++) keys[i].textContent = isMac ? "⌘" : "Ctrl";
        }
        pageReady(function () {
            syncModKey();
            if (pfPromise) ensurePagefindCss();
        });
    })();
</script>

<pagefind-modal-trigger placeholder={searchPlaceholder} shortcut="mod+k">
    {
        /*
        首屏静态占位（D-0066 / D-0071）。
        pagefind 的组件 JS 按需加载，升级前 <pagefind-modal-trigger> 是空元素（0×0），
        首屏等于「搜索框不见了」。这里直接复用 pagefind 自己的类名结构，
        样式由它自带的 CSS 提供，所以和升级后的真实按钮像素级一致——
        之前那版自定义类名做出来的占位，宽高、颜色、快捷键角标都和真实 UI 有小差别。
        元素升级后由 `pagefind-modal-trigger:defined .search-trigger-fallback{display:none}` 撤掉。
    */
    }
    <button
        class="pf-trigger-btn search-trigger-fallback"
        type="button"
        tabindex="-1"
        aria-hidden="true"
    >
        <span class="pf-trigger-icon" aria-hidden="true"></span>
        <span class="pf-trigger-text">{searchPlaceholder}</span>
        <span class="pf-trigger-shortcut" aria-hidden="true">
            <span class="pf-trigger-key" data-mod-key>⌘</span>
            <span class="pf-trigger-key">K</span>
        </span>
    </button>
</pagefind-modal-trigger>

<pagefind-modal reset-on-close>
    <pagefind-modal-header>
        <pagefind-input></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
        <pagefind-summary></pagefind-summary>
        <pagefind-results max-sub-results="5"></pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
        <pagefind-keyboard-hints></pagefind-keyboard-hints>
        <div class="footer-brand">
            Search by <strong>Pagefind</strong>
        </div>
    </pagefind-modal-footer>
</pagefind-modal>

<script>
    import { onPageReady } from "~/utils/page-lifecycle";
    import "../../scripts/search-template.js";
    import { applyResultTemplate } from "../../scripts/search-template.js";

    // View Transition 的 DOM morphing 会破坏 Pagefind 内部创建的 <dialog> 元素。
    // 导航后完全销毁旧实例并创建新实例，确保 clean state。
    document.addEventListener("astro:after-swap", () => {
        const oldTrigger = document.querySelector("pagefind-modal-trigger");
        const oldModal = document.querySelector("pagefind-modal");
        if (!oldTrigger || !oldModal) return;

        // 清除旧 utility 注册，防止 getUtilities("modal")[0] 返回已脱离文档的旧 modal
        if ((oldModal as any).instance?.componentsByType) {
            (oldModal as any).instance.componentsByType.utility = [];
        }

        // 获取 light DOM 子元素，排除 Pagefind 内部创建的 <dialog>（morph 后已损坏）
        const children = Array.from(oldModal.childNodes).filter(
            (node) => !(node instanceof HTMLElement) || node.tagName !== "DIALOG",
        );

        // 创建新 modal，移入子元素
        const newModal = document.createElement("pagefind-modal");
        newModal.setAttribute("reset-on-close", "");
        for (const child of children) {
            newModal.appendChild(child);
        }

        // 创建新 trigger — 从已有 DOM 读取 locale 相关的 placeholder
        const placeholder = oldTrigger.getAttribute("placeholder") || "Search";
        const newTrigger = document.createElement("pagefind-modal-trigger");
        newTrigger.setAttribute("placeholder", placeholder);
        newTrigger.setAttribute("shortcut", "mod+k");
        // ⚠️ 必须把首屏静态占位一起搬过来（D-0071）：这个 handler 每次换页都会
        // 新建一个空的 <pagefind-modal-trigger>，而 pagefind 模块是按需加载的，
        // 新建后没人升级它 → 搜索框在换页后整个消失（实测 0×0、innerHTML 为空）。
        const fallback = oldTrigger.querySelector(".search-trigger-fallback");
        if (fallback) newTrigger.appendChild(fallback.cloneNode(true));

        // 替换 DOM
        oldModal.replaceWith(newModal);
        oldTrigger.replaceWith(newTrigger);

        // 重新应用模板
        applyResultTemplate();
    });
</script>
