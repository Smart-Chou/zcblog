---
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";

const pagefindTranslations = {
    placeholder: "搜索",
};

const dataAttributes: DOMStringMap = {
    "data-translations": JSON.stringify(pagefindTranslations),
};
---

<site-search class={Astro.props.class} {...dataAttributes}>
    <button
        data-open-modal
        disabled
        aria-label="搜索"
        aria-keyshortcuts="Control+K"
        aria-haspopup="dialog"
        aria-expanded="false"
    >
        <DynamicIcon name="tabler:search" class="search-mobile-center" aria-hidden="true" />
        <span class="sl-hidden md:sl-block" aria-hidden="true">搜索</span>
        <kbd class="sl-hidden md:sl-flex" style="display: none;">
            <kbd>Ctrl</kbd><kbd>K</kbd>
        </kbd>
    </button>

    <dialog style="padding:0" aria-label="搜索">
        <div class="dialog-frame sl-flex">
            <button data-close-modal class="sl-flex md:sl-hidden">取消</button>
            <div class="search-container">
                <div
                    id="search-panel"
                >
                </div>
            </div>
        </div>
        <div class="search-footer">
            <div class="search-footer-hints">
                <kbd>↑</kbd><kbd>↓</kbd><span>导航</span>
                <span>·</span>
                <kbd>↵</kbd><span>打开</span>
                <span>·</span>
                <kbd>ESC</kbd><span>关闭</span>
            </div>
            <div class="search-footer-brand">
                Search by <strong>Pagefind</strong>
            </div>
        </div>
    </dialog>
</site-search>

{
    /**
     * This is intentionally inlined to avoid briefly showing an invalid shortcut.
     * Purposely using the deprecated `navigator.platform` property to detect Apple devices, as the
     * user agent is spoofed by some browsers when opening the devtools.
     */
}
<script>
    class SiteSearch extends HTMLElement {
        constructor() {
            super();
            const openBtn = this.querySelector<HTMLButtonElement>("button[data-open-modal]")!;
            const closeBtn = this.querySelector<HTMLButtonElement>("button[data-close-modal]")!;
            const dialog = this.querySelector("dialog")!;
            const dialogFrame = this.querySelector(".dialog-frame")!;
            const shortcut = openBtn?.querySelector("kbd");
            const platformKey = shortcut?.querySelector("kbd");

            // Modern way to detect Apple devices
            const isAppleDevice = () => {
                if ((navigator as any).userAgentData?.platform) {
                    return (
                        (navigator as any).userAgentData.platform === "macOS" ||
                        (navigator as any).userAgentData.platform === "iOS"
                    );
                }
                // Fallback for older browsers
                return /(Mac|iPhone|iPod|iPad)/i.test(navigator.userAgent);
            };

            // Update shortcut keys based on device type
            if (platformKey && shortcut instanceof HTMLElement) {
                if (isAppleDevice()) {
                    platformKey.textContent = "⌘";
                    openBtn.setAttribute("aria-keyshortcuts", "Meta+K");
                }
                shortcut.style.display = "";
            }

            /** Close the modal if a user clicks on a link or outside of the modal. */
            const onClick = (event: MouseEvent) => {
                const isLink = "href" in (event.target || {});
                if (
                    isLink ||
                    (document.body.contains(event.target as Node) &&
                        !dialogFrame.contains(event.target as Node))
                ) {
                    closeModal();
                }
            };

            let handleWheel: ((e: WheelEvent) => void) | null = null;
            const openModal = (event?: MouseEvent) => {
                dialog.showModal();
                document.body.toggleAttribute("data-search-modal-open", true);
                openBtn.setAttribute("aria-expanded", "true");
                event?.stopPropagation();

                // 滚动穿透：当鼠标在 dialogFrame 内时阻止滚动传播，外部允许滚动
                handleWheel = (e: WheelEvent) => {
                    const target = e.target as HTMLElement;
                    if (dialogFrame.contains(target)) {
                        e.stopPropagation();
                    }
                };
                dialog.addEventListener("wheel", handleWheel, {
                    passive: true,
                });
                window.addEventListener("click", onClick);

                // Ensure search input gets focus, even if PagefindUI initializes after modal opens
                setTimeout(() => {
                    const searchInput =
                        this.querySelector(".pagefind-ui__search-input") ||
                        this.querySelector('input[type="search"]') ||
                        this.querySelector("input");
                    (searchInput as HTMLInputElement)?.focus();
                }, 100);
            };

            const closeModal = () => {
                dialog.close();
                openBtn.setAttribute("aria-expanded", "false");
                document.body.toggleAttribute("data-search-modal-open", false);
                window.removeEventListener("click", onClick);
                if (handleWheel) {
                    dialog.removeEventListener("wheel", handleWheel);
                    handleWheel = null;
                }
            };

            openBtn.addEventListener("click", openModal);
            openBtn.disabled = false;
            closeBtn.addEventListener("click", closeModal);

            dialog.addEventListener("close", () => {
                document.body.toggleAttribute("data-search-modal-open", false);
                openBtn.setAttribute("aria-expanded", "false");
                window.removeEventListener("click", onClick);
            });

            // Listen for `ctrl + k` and `cmd + k` keyboard shortcuts.
            window.addEventListener("keydown", (e) => {
                if ((e.metaKey === true || e.ctrlKey === true) && e.key === "k") {
                    dialog.open ? closeModal() : openModal();
                    e.preventDefault();
                }
            });

            let translations: Record<string, string> = {};
            try {
                translations = JSON.parse(this.dataset.translations || "{}");
            } catch {}

            const shouldStrip = this.dataset.stripTrailingSlash !== undefined;
            const stripTrailingSlash = (path: string) => path.replace(/(.)\/$/, "$1");
            const formatURL = shouldStrip ? stripTrailingSlash : (path: string) => path;

            // Initialize PagefindUI when the element is connected to the DOM
            this.addEventListener("connectedCallback", async () => {
                try {
                    // Directly import and initialize PagefindUI without unnecessary delays
                    // @ts-expect-error — Missing types for @pagefind/default-ui package.
                    const { PagefindUI } = await import("@pagefind/default-ui");

                    // Ensure the search-panel element exists before initializing
                    const searchElement = this.querySelector("#search-panel");
                    if (!searchElement) {
                        console.error("Search element #search-panel not found");
                        return;
                    }

                    new PagefindUI({
                        element: searchElement,
                        baseUrl: import.meta.env.BASE_URL,
                        bundlePath: import.meta.env.BASE_URL.replace(/\/$/, "") + "/pagefind/",
                        showImages: false,
                        translations,
                        showSubResults: true,
                        processResult: (result: {
                            url: string;
                            sub_results: Array<{ url: string }>;
                        }) => {
                            result.url = formatURL(result.url);
                            result.sub_results = result.sub_results.map((sub_result) => {
                                sub_result.url = formatURL(sub_result.url);
                                return sub_result;
                            });
                        },
                    });

                    // Add id and name attributes to the search input for better accessibility
                    const searchInput =
                        (searchElement as Element).querySelector<HTMLInputElement>(
                            ".pagefind-ui__search-input",
                        ) ||
                        (searchElement as Element).querySelector<HTMLInputElement>(
                            'input[type="search"]',
                        ) ||
                        (searchElement as Element).querySelector<HTMLInputElement>("input");
                    if (searchInput) {
                        searchInput.id = "search-panel-input";
                        (searchInput as HTMLInputElement).name = "q";
                    }
                } catch (error) {
                    console.error("Failed to initialize PagefindUI:", error);
                }
            });

            // Also try to initialize immediately if connected
            if (this.isConnected) {
                // Trigger the initialization manually if already connected
                this.dispatchEvent(new Event("connectedCallback"));
            }
        }
    }
    customElements.define("site-search", SiteSearch);
</script>

<style>
    @layer starlight.utils {
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }

        .sl-hidden {
            display: none;
        }
        .sl-flex {
            display: flex;
        }
        .sl-block {
            display: block;
        }
        @media (min-width: 50rem) {
            .md\:sl-hidden {
                display: none;
            }
            .md\:sl-flex {
                display: flex;
            }
            .md\:sl-block {
                display: block;
            }
        }
        @media (min-width: 72rem) {
            .lg\:sl-hidden {
                display: none;
            }
            .lg\:sl-flex {
                display: flex;
            }
            .lg\:sl-block {
                display: block;
            }
        }
        [data-theme="dark"] .sl-hidden {
            display: none;
        }

        /**
	 * Flip an element around the y-axis when in an RTL context.
	 * Primarily useful for things where we can’t rely on writing direction like icons.
	 *
	 * <Icon name="right-arrow" class="rtl:flip" />
	 *
	 * In a LTR context: →				In a RTL context: ←
	 */
        [dir="rtl"] .rtl\:flip:not(:where([dir="rtl"] [dir="ltr"] *)) {
            transform: matrix(-1, 0, 0, 1, 0, 0);
        }
    }

    /* Style for inner kbd elements only */
    kbd kbd {
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 3px;
        border: 0px;
        padding: 3px;
        background: var(--search-kbd-gradient);
        box-shadow: var(--search-kbd-shadow);
        color: var(--search-kbd-text);
    }
</style>
