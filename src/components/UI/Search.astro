---
/**
 * Search component using Pagefind Component UI (v1.5.0+).
 * Requires `pnpm build` once to generate public/pagefind/ for dev server.
 */
---

<script is:inline>
    var pfBase = "/pagefind/";
    var link = document.createElement("link");
    link.href = pfBase + "pagefind-component-ui.css";
    link.rel = "stylesheet";
    document.head.appendChild(link);
    var s = document.createElement("script");
    s.src = pfBase + "pagefind-component-ui.js";
    s.type = "module";
    document.head.appendChild(s);
</script>

<pagefind-modal-trigger placeholder="搜索" shortcut="mod+k"></pagefind-modal-trigger>

<pagefind-modal reset-on-close>
    <pagefind-modal-header>
        <pagefind-input></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
        <pagefind-summary></pagefind-summary>
        <pagefind-results></pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
        <pagefind-keyboard-hints></pagefind-keyboard-hints>
        <div class="footer-brand">
            Search by <strong>Pagefind</strong>
        </div>
    </pagefind-modal-footer>
</pagefind-modal>

<script>
    import "../../scripts/search-template.js";
</script>
