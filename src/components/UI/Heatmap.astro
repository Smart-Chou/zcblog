---
import "~/styles/heatmap.css";

interface PostData {
    date: string;
    title: string;
    wordCount: number;
}

interface Props {
    postsData: PostData[];
}

const { postsData } = Astro.props;
---

<div class="heatmap-container" id="heatmap-container" data-posts={JSON.stringify(postsData)}></div>

<!-- 行为已上移到页面层（ArchivesContent 的 client script）；组件只负责渲染。 -->
