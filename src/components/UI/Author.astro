---
import { Image } from "astro:assets";
import authorImg from "~/assets/logo.svg";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { author, categories, socialLinks, site } from "~/config";

// 作者一句话简介：取站点描述的第二句，避免与 hero slogan 重复
const bioParts = site.description
    .split("。")
    .map((s) => s.trim())
    .filter(Boolean);
const authorBio = bioParts[1] ? `${bioParts[1]}。` : site.subtitle;
---

<div class="author">
    <Image
        src={authorImg}
        alt="Author"
        class="author-image"
        width={90}
        height={90}
        loading="eager"
        fetchpriority="high"
        decoding="async"
    />
    <p class="author-site-title">{author.type}</p>
    <p class="author-intro">{authorBio}</p>
    <p class="author-links">
        {
            categories.map((categorie) => (
                <a
                    href={
                        /^(https?:)?\/\//.test(categorie.url)
                            ? categorie.url
                            : `${Astro.url.pathname.startsWith("/en/") ? "/en" : ""}${categorie.url}`
                    }
                    title={categorie.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={categorie.style}
                    aria-label={categorie.title}
                >
                    <DynamicIcon name={categorie.svg} />
                </a>
            ))
        }
    </p>
    <p class="author-links">
        {
            socialLinks.map((social) => (
                <a
                    data-key={`social-${social.title}`}
                    href={social.url}
                    target="_blank"
                    title={social.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={social.style}
                    aria-label={social.title}
                >
                    <DynamicIcon name={social.svg} />
                </a>
            ))
        }
    </p>
</div>

