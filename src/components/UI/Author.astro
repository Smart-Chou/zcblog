---
import { Image } from "astro:assets";
import authorImg from "~/assets/logo.svg";
import DynamicIcon from "~/components/icons/DynamicIcon.astro";
import { author, categories, socialLinks } from "~/config";
---

<div class="author">
    <Image
        src={authorImg}
        alt="Author"
        class="author-image"
        width={90}
        height={90}
        loading="lazy"
        decoding="async"
    />
    <h1 class="author-site-title">{author.type}</h1>
    <p class="author-intro">{author.motto}</p>
    <p class="author-links">
        {
            categories.map((categorie) => (
                <a
                    href={categorie.url}
                    title={categorie.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={categorie.style}
                    aria-label={categorie.title}
                >
                    <DynamicIcon name={categorie.svg} />
                </a>
            ))
        }
    </p>
    <p class="author-links">
        {
            socialLinks.map((social) => (
                <a
                    data-key={`social-${social.title}`}
                    href={social.url}
                    target="_blank"
                    title={social.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={social.style}
                    aria-label={social.title}
                >
                    <DynamicIcon name={social.svg} />
                </a>
            ))
        }
    </p>
</div>

<style>
    .author {
        margin-top: 8rem;
        text-align: center;
        padding: calc(var(--space) / 2) 0;
    }

    .author-image {
        border-radius: 100%;
        width: 90px;
        height: 90px;
        margin-bottom: 1em;
        display: inline;
    }

    .author-intro {
        opacity: 0.8;
    }

    .author-site-title {
        font-size: 1.5em;
    }

    .author-links {
        margin-top: -0.5em;
        font-size: 1em;
        display: flex;
        justify-content: center;
    }

    .author-links a {
        color: var(--color-link);
        margin: 0 0.5em;
        text-decoration: none;
    }
</style>
