---
import { Image } from "astro:assets";
import authorImg from "~/assets/logo.svg";
import DynamicIcon from "~/components/Icons/DynamicIcon.astro";
import { author, categories, socialLinks, site } from "~/config";

// 作者一句话简介：取站点描述的第二句，避免与 hero slogan 重复
const bioParts = site.description
    .split("。")
    .map((s) => s.trim())
    .filter(Boolean);
const authorBio = bioParts[1] ? `${bioParts[1]}。` : site.subtitle;
---

<div class="author">
    <Image
        src={authorImg}
        alt="Author"
        class="author-image"
        width={90}
        height={90}
        loading="eager"
        fetchpriority="high"
        decoding="async"
    />
    <p class="author-site-title">{author.type}</p>
    <p class="author-intro">{authorBio}</p>
    <p class="author-links">
        {
            categories.map((categorie) => (
                <a
                    href={categorie.url}
                    title={categorie.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={categorie.style}
                    aria-label={categorie.title}
                >
                    <DynamicIcon name={categorie.svg} />
                </a>
            ))
        }
    </p>
    <p class="author-links">
        {
            socialLinks.map((social) => (
                <a
                    data-key={`social-${social.title}`}
                    href={social.url}
                    target="_blank"
                    title={social.title}
                    rel="noopener noreferrer"
                    class="has-tooltip"
                    style={social.style}
                    aria-label={social.title}
                >
                    <DynamicIcon name={social.svg} />
                </a>
            ))
        }
    </p>
</div>

<style>
    .author {
        margin-top: 2rem;
        text-align: center;
        padding: 0 0 2.5rem;
    }

    .author-image {
        border-radius: 100%;
        width: 90px;
        height: 90px;
        margin-bottom: 1em;
        display: inline;
    }

    .author-site-title {
        font-family: var(--font-heading);
        font-size: 1.6em;
        font-weight: 400;
        margin: 0 0 0.35em;
        color: var(--color-title);
    }

    .author-intro {
        color: var(--color-text-muted);
        font-size: var(--text-sm);
        max-width: 36em;
        margin: 0 auto;
    }

    .author-links {
        margin: 2px 0 0;
        font-size: 1.2em;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
    }

    .author-links a {
        color: var(--color-accent);
        margin: 0;
        min-width: 34px;
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        text-decoration: none;
        transition:
            background-color var(--duration-fast) var(--ease-out),
            transform var(--duration-fast) var(--ease-out);
    }

    @media (hover: hover) {
        .author-links a:hover {
            background-color: var(--color-hover);
            transform: translateY(-1px);
        }
    }
</style>
