---
import { Image } from "astro:assets";
import { getLocalImage } from "~/utils/image-map";

interface EssayItem {
    username: string;
    time: string;
    content: string;
    images: string[] | string | null;
    comment: string | null;
    avatar_url: string;
    tags?: string[];
    url?: string;
}

interface Props {
    item: EssayItem;
}

const { item } = Astro.props;
const time = new Date(item.time).toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
const images = item.images ? (Array.isArray(item.images) ? item.images : [item.images]) : [];
const avatarImage = getLocalImage(item.avatar_url);
---

<article class="essay-card">
    <div class="essay-header">
        <img
            src={avatarImage?.src ?? item.avatar_url}
            alt={item.username}
            class="avatar"
            width={40}
            height={40}
            loading="lazy"
            decoding="async"
        />
        <div class="essay-meta">
            <span class="username">{item.username}</span>
            <span class="time">{time}</span>
        </div>
    </div>
    <div class="essay-content">
        {
            item.tags && item.tags.length > 0 && (
                <div class="essay-tags">
                    {item.tags.map((tag) => (
                        <span class="essay-tag">{tag}</span>
                    ))}
                </div>
            )
        }
        <p class="content-text">{item.content}</p>
        {
            images.length > 0 && (
                <div class="essay-images" data-count={images.length}>
                    {images.map((img) => (
                        <Image
                            src={img}
                            alt="essay image"
                            width={160}
                            height={160}
                            class="essay-img"
                            loading="lazy"
                        />
                    ))}
                </div>
            )
        }
        {
            item.comment && (
                <div class="essay-comment">
                    <p>{item.comment}</p>
                </div>
            )
        }
        {
            item.url && (
                <div class="essay-source">
                    来源:{" "}
                    <a href={item.url} target="_blank" rel="noreferrer">
                        Blinko 闪念
                    </a>
                </div>
            )
        }
    </div>
</article>

<style>
    .essay-card {
        background: var(--color-bg-surface);
        border-radius: var(--radius);
        padding: 1rem 1.25rem;
        box-shadow: var(--shadow-sm);
    }

    .essay-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
    }

    .essay-meta {
        display: flex;
        flex-direction: column;
    }

    .username {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--color-title);
    }

    .time {
        font-size: 0.7rem;
        color: var(--color-text);
        opacity: 0.7;
    }

    .essay-tags {
        display: flex;
        gap: 0.35rem;
        flex-wrap: wrap;
        margin-bottom: 0.5rem;
    }

    .essay-tag {
        font-size: 0.75rem;
        padding: 2px 8px;
        border-radius: 4px;
        background: var(--color-accent);
        color: #fff;
        opacity: 0.85;
    }

    .content-text {
        color: var(--color-text);
        line-height: 1.6;
        font-size: 0.9rem;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .essay-images {
        display: grid;
        gap: 0.25rem;
        margin-top: 0.5rem;
        max-width: 160px;
    }

    .essay-images[data-count="1"] {
        grid-template-columns: 1fr;
    }

    .essay-images[data-count="2"] {
        grid-template-columns: repeat(2, 1fr);
    }

    .essay-images[data-count="3"] {
        grid-template-columns: repeat(3, 1fr);
    }

    .essay-images[data-count="4"],
    .essay-images[data-count="5"],
    .essay-images[data-count="6"] {
        grid-template-columns: repeat(3, 1fr);
    }

    .essay-images[data-count="5"] {
        grid-template-columns: repeat(2, 1fr);
    }

    .essay-images[data-count="5"] > :nth-child(5) {
        grid-column: span 2;
    }

    .essay-img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 4px;
        cursor: pointer;
        transition: transform var(--duration-normal) var(--ease-out);
    }

    @media (hover: hover) {
        .essay-img:hover {
            transform: scale(1.03);
        }
    }

    .essay-comment {
        margin-top: 0.5rem;
        padding: 0.5rem;
        background: var(--color-bg);
        border-radius: 4px;
        font-size: 0.8rem;
        color: var(--color-text);
        opacity: 0.9;
    }

    .essay-source {
        margin-top: 0.5rem;
        font-size: 0.75rem;
        opacity: 0.5;
    }

    .essay-source a {
        color: var(--color-accent);
        text-decoration: none;
    }

    @media (hover: hover) {
        .essay-source a:hover {
            text-decoration: underline;
        }
    }
</style>
