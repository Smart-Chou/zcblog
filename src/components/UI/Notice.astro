---
import { notice } from "~/config";
import { t, getLocale } from "~/utils/i18n";

const { pathname = "" } = Astro.url;
const loc = getLocale(Astro.currentLocale || "zh");

if (!notice.enable) {
    return;
}

if (notice.path && !pathname.startsWith(notice.path)) {
    return;
}

const noticeTitle = t(loc, "notice.title");
const noticeContent = t(loc, "notice.content");
const noticeConfirmText = t(loc, "notice.confirmText");

function simpleHash(str: string): string {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
        const chr = str.charCodeAt(i);
        hash = (hash << 5) - hash + chr;
        hash |= 0;
    }
    return Math.abs(hash).toString(36);
}

const storageKey = notice.key || `notice-${simpleHash(noticeTitle + noticeContent)}`;
const storageType = notice.showOnce ? "localStorage" : "sessionStorage";
---

<!-- 阻塞式内联脚本：在 Notice 元素渲染前，检查是否已被用户关闭 -->
<script
    is:inline
    data-notice-storage-key={storageKey}
    data-notice-storage-type={storageType}
>
    (function () {
        var s = document.currentScript;
        if (!s) return;
        var key = s.dataset.noticeStorageKey || "";
        var type = s.dataset.noticeStorageType;
        var storage = type === "localStorage" ? localStorage : sessionStorage;
        if (storage.getItem(key)) {
            document.documentElement.classList.add("notice-dismissed");
            document.documentElement.style.setProperty("--notice-height", "0px");
        }
    })();
</script>

<script>
    (function () {
        const banner = document.getElementById("global-notice");
        if (!banner) return;
        const el = banner;

        const key = el.dataset.storageKey || "";
        const storage = el.dataset.storageType === "localStorage" ? localStorage : sessionStorage;

        // 已被 is:inline 脚本标记为关闭，无需初始化
        if (document.documentElement.classList.contains("notice-dismissed")) return;

        const root = document.documentElement;
        const updateNoticeHeight = () => {
            root.style.setProperty("--notice-height", `${el.offsetHeight}px`);
        };
        updateNoticeHeight();

        const ro = new ResizeObserver(updateNoticeHeight);
        ro.observe(el);

        function dismiss() {
            el.style.display = "none";
            document.documentElement.classList.add("notice-dismissed");
            root.style.setProperty("--notice-height", "0px");
            storage.setItem(key, "1");
            ro.disconnect();
        }

        const closeBtn = el.querySelector("[data-notice-close]");
        if (closeBtn) {
            closeBtn.addEventListener("click", dismiss);
        }

        const confirmBtn = el.querySelector("[data-notice-confirm]");
        if (confirmBtn) {
            confirmBtn.addEventListener("click", dismiss);
        }
    })();
</script>

<aside
    id="global-notice"
    class="notice-banner"
    role="status"
    aria-live="polite"
    data-storage-key={storageKey}
    data-storage-type={storageType}
>
    <div class="notice-banner-inner">
        <div class="notice-banner-body">
            {notice.title && <strong class="notice-banner-title">{noticeTitle}</strong>}
            <span class="notice-banner-content">
                {noticeContent}
            </span>
        </div>
        <div class="notice-banner-actions">
            {
                notice.confirm ? (
                    <button data-notice-confirm class="notice-btn notice-btn--primary">
                        {noticeConfirmText}
                    </button>
                ) : (
                    <button
                        data-notice-close
                        class="notice-btn notice-btn--close"
                        aria-label="关闭公告"
                    >
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                        >
                            <path d="M18 6 6 18M6 6l12 12" />
                        </svg>
                    </button>
                )
            }
        </div>
    </div>
</aside>

<style>
    .notice-banner {
        display: flex;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 101;
        width: 100%;
        background: var(--color-accent);
        color: #fff;
        font-size: 0.9rem;
        border-bottom: 1px solid var(--color-border);
    }

    html[data-theme="dark"] .notice-banner {
        background: var(--color-accent);
    }

    .notice-banner-inner {
        display: flex;
        align-items: center;
        max-width: 100%;
        margin: 0 auto;
        padding: var(--space-xs) 0 var(--space-xs) var(--space);
    }

    .notice-banner-body {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: var(--space-xs);
        flex-wrap: wrap;
        flex: 1;
        min-width: 0;
        padding-right: -8px;
    }

    .notice-banner-title {
        font-weight: 600;
    }

    .notice-banner-content {
        opacity: 0.95;
    }

    .notice-banner-content a {
        color: #fff;
        text-decoration: underline;
    }

    .notice-banner-actions {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        flex-shrink: 0;
        padding-right: 8px;
    }

    .notice-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        border-radius: var(--radius-sm);
        font-size: 0.85rem;
        transition: opacity var(--duration-fast);
    }

    @media (hover: hover) {
        .notice-btn:hover {
            opacity: 0.8;
        }
    }

    .notice-btn--close {
        background: none;
        color: #fff;
        padding: var(--space-2xs);
        opacity: 0.7;
    }

    @media (hover: hover) {
        .notice-btn--close:hover {
            opacity: 1;
        }
    }

    .notice-btn--primary {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
        padding: var(--space-2xs) var(--space-sm);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    @media (hover: hover) {
        .notice-btn--primary:hover {
            background: rgba(255, 255, 255, 0.3);
        }
    }
</style>

<style is:global>
    /* 默认无通知条高度；首访时 Notice 组件可见，由估算值预留空间，JS 加载后精确修正 */
    :root {
        --notice-height: 0px;
    }

    html:not(.notice-dismissed) {
        --notice-height: 44px;
    }

    html.notice-dismissed .notice-banner {
        display: none;
    }

    @media screen and (max-width: 768px) {
        html:not(.notice-dismissed) {
            --notice-height: 40px;
        }
    }
</style>
