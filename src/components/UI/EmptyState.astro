---
interface Props {
    title: string;
    message?: string;
    emoji?: string;
}

const { title, message, emoji } = Astro.props;

const showSlot = Astro.slots.has("icon");
---

<div class="empty-state">
    {
        showSlot ? (
            <div class="empty-icon">
                <slot name="icon" />
            </div>
        ) : emoji ? (
            <div class="empty-emoji">{emoji}</div>
        ) : null
    }
    <h2>{title}</h2>
    {message && <p>{message}</p>}
</div>

<style>
    .empty-state {
        text-align: center;
        padding: 4rem 1rem;
    }

    .empty-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 1.5rem;
        opacity: 0.3;
    }

    .empty-icon :global(svg) {
        width: 100%;
        height: 100%;
    }

    .empty-emoji {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.6;
    }

    .empty-state h2 {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
        color: var(--color-title);
    }

    .empty-state p {
        color: var(--color-body);
        opacity: 0.7;
    }
</style>
