---
interface Props {
    locale?: string;
}

const { locale = "zh" } = Astro.props;
const isEn = locale === "en";
---

<style>
    #comment-wrapper {
        margin: 1rem auto;
        text-align: center;
    }

    #waline-toggle {
        display: inline-block;
        min-width: 180px;
        padding: 0.5rem 1rem;
        background-color: var(--color-bg-surface);
        color: var(--color-accent);
        border: 1px var(--color-accent);
        border-style: dashed;
        cursor: pointer;
        border-radius: 5px;
        text-align: center;
        font: inherit;
    }

    #waline-toggle.active {
        font-weight: bold;
        border: 1.5px solid var(--color-accent);
    }

    #waline {
        display: none;
        content-visibility: auto;
        contain-intrinsic-size: auto 38rem;
        min-height: 38rem;
        max-width: var(--content-width);
        position: relative;
        overflow: hidden;
        margin: 0 auto;
        padding: 0 var(--space);
    }

    #waline.visible {
        display: block;
    }

    @media screen and (max-width: 768px) {
        #waline {
            padding: unset;
        }
    }

    html[data-theme="dark"] {
        --waline-color: #e8e3de !important;
    }
</style>

<div id="comment-wrapper" data-waline-locale={locale}>
    <button id="waline-toggle" type="button">{isEn ? "Show Comments" : "展开评论"}</button>
    <div id="waline"></div>
</div>

<script>
    import { waline } from "~/config";
    import walineCssUrl from "@waline/client/waline.css?url";
    import walineMetaCssUrl from "@waline/client/waline-meta.css?url";

    // 评论实例懒加载（2026-10-03）：只用到 destroy()，用结构化最小接口
    let walineInstance: { destroy: () => void } | null = null;
    let walineInitializing = false;

    // Waline 样式改为点击展开时注入（Astro 会把脚本里 import 的 CSS 静态挂到页面，
    // 用 ?url 拿资源地址、运行时按需插入 <link>，避免文章页白载 36KB 评论样式）
    const injectedStyles = new Set<string>();
    function ensureStylesheet(href: string): Promise<void> {
        if (!href || injectedStyles.has(href)) return Promise.resolve();
        injectedStyles.add(href);
        return new Promise((resolve) => {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = href;
            link.onload = () => resolve();
            link.onerror = () => resolve();
            document.head.appendChild(link);
        });
    }

    const walineLocales: Record<string, Record<string, string>> = {
        zh: {
            level0: "炼体",
            level1: "炼气",
            level2: "筑基",
            level3: "金丹",
            level4: "元婴",
            level5: "化神",
            placeholder: "写下你的评论...",
            nick: "昵称",
            mail: "邮箱",
            link: "网址",
            submit: "提交评论",
            reply: "回复",
            cancelReply: "取消回复",
            comment: "评论",
            comments: "评论",
            preview: "预览",
            emoji: "表情",
            uploading: "上传中...",
            login: "登录",
            logout: "登出",
            admin: "管理员",
            sticky: "置顶",
            word: "字",
            anonymous: "匿名",
            level: "等级",
            like: "点赞",
            liked: "已赞",
            dislike: "点踩",
            disliked: "已踩",
            quote: "引用",
            at: "@",
            flag: "举报",
            flagConfirm: "确定要举报这条评论吗？",
            approved: "已通过",
            waiting: "等待审核",
            spam: "垃圾评论",
            score: "评分",
            reactionTitle: "你认为这篇文章怎么样？",
            reaction0: "牛逼哄哄",
            reaction1: "不太行哦",
            reaction2: "还不错呦",
            reaction3: "你觉得呢",
            reaction4: "自己看看",
            reaction5: "周公叫我",
        },
        en: {
            level0: "Beginner",
            level1: "Novice",
            level2: "Apprentice",
            level3: "Adept",
            level4: "Expert",
            level5: "Master",
            placeholder: "Write a comment...",
            nick: "Nickname",
            mail: "Email",
            link: "Website",
            submit: "Submit",
            reply: "Reply",
            cancelReply: "Cancel",
            comment: "Comment",
            comments: "Comments",
            preview: "Preview",
            emoji: "Emoji",
            uploading: "Uploading...",
            login: "Login",
            logout: "Logout",
            admin: "Admin",
            sticky: "Sticky",
            word: "words",
            anonymous: "Anonymous",
            level: "Level",
            like: "Like",
            liked: "Liked",
            dislike: "Dislike",
            disliked: "Disliked",
            quote: "Quote",
            at: "@",
            flag: "Report",
            flagConfirm: "Are you sure you want to report this comment?",
            approved: "Approved",
            waiting: "Pending",
            spam: "Spam",
            score: "Score",
            reactionTitle: "What do you think of this article?",
            reaction0: "Amazing",
            reaction1: "Not great",
            reaction2: "Pretty good",
            reaction3: "What do you think",
            reaction4: "See for yourself",
            reaction5: "Zzz...",
        },
    };

    const toggleLabels: Record<string, { show: string; hide: string }> = {
        zh: { show: "展开评论", hide: "收起评论" },
        en: { show: "Show Comments", hide: "Hide Comments" },
    };

    function getWalineLocale(): string {
        const wrapper = document.getElementById("comment-wrapper");
        return wrapper?.dataset.walineLocale || "zh";
    }

    async function doInitWaline() {
        if (walineInitializing || walineInstance) return;
        const walineElement = document.getElementById("waline");
        if (!waline.enable || !walineElement) {
            console.error("Required elements or configuration are missing.");
            return;
        }

        walineInitializing = true;
        try {
            // 懒加载：客户端 JS + 样式均在首次展开评论时才加载
            const [{ init }] = await Promise.all([
                import("@waline/client"),
                ensureStylesheet(walineCssUrl),
                ensureStylesheet(walineMetaCssUrl),
            ]);
            const loc = getWalineLocale();
            const locale = walineLocales[loc] || walineLocales.zh;

            const origin = waline.serverUrl;
            const walineConfig = {
                el: "#waline",
                serverURL: origin,
                comment: true,
                locale,
                path: walineElement.dataset.walinePath!,
                lang: waline.lang,
                pageSize: waline.pageSize,
                // 浏览量由 ~/utils/waline-pageview 单独上报（避免懒初始化丢计数/双计数）
                meta: ["nick", "mail", "link"],
                requiredMeta: ["nick", "mail"],
                login: "disable",
                search: waline.search,
                dark: 'html[data-theme="dark"]',
                emoji: [
                    "https://cdn.jsdelivr.net/npm/@waline/emojis@1.4.0/qq",
                    "https://cdn.jsdelivr.net/npm/@waline/emojis@1.4.0/bilibili",
                    "https://cdn.jsdelivr.net/npm/@waline/emojis@1.4.0/tieba",
                    "https://cdn.jsdelivr.net/npm/@waline/emojis@1.4.0/weibo",
                ],
                wordLimit: [0, 1000],
                reaction: true as boolean | string[],
                codeSyntaxHighlight: true,
                imageUploader: () => {
                    console.warn("Waline 图片上传功能暂未开放");
                    return Promise.reject(new Error("图片上传功能暂未开放"));
                },
            };

            if (waline.whiteList.includes(location.pathname)) {
                walineConfig.reaction =
                    typeof waline.reaction === "boolean" && waline.reaction === true
                        ? []
                        : (waline.reaction as string[]);
            }

            // 销毁旧实例，避免重复挂载
            if (walineInstance) {
                try {
                    walineInstance.destroy();
                } catch {
                    // 忽略 View Transitions 切换时的 AbortError
                }
                walineInstance = null;
            }

            walineInstance = init(walineConfig);
        } finally {
            walineInitializing = false;
        }
    }

    function destroyWaline() {
        if (walineInstance) {
            try {
                walineInstance.destroy();
            } catch {
                // 忽略 AbortError
            }
            walineInstance = null;
        }
    }

    function setupWalineToggle() {
        const toggle = document.getElementById("waline-toggle");
        const walineEl = document.getElementById("waline");
        if (!toggle || !walineEl) return;

        if (toggle.dataset.walineReady) return;
        toggle.dataset.walineReady = "true";

        toggle.addEventListener("click", () => {
            const labels = toggleLabels[getWalineLocale()] || toggleLabels.zh;
            if (walineInstance) {
                const visible = walineEl.classList.toggle("visible");
                toggle.classList.toggle("active", visible);
                toggle.textContent = visible ? labels.hide : labels.show;
            } else {
                walineEl.classList.add("visible");
                toggle.classList.add("active");
                toggle.textContent = labels.hide;
                requestAnimationFrame(() => {
                    doInitWaline();
                });
            }
        });
    }

    // SPA 导航：重置评论 UI（评论区改为点击“展开评论”后才初始化）
    document.addEventListener("astro:page-load", () => {
        const toggle = document.getElementById("waline-toggle");
        const walineEl = document.getElementById("waline");
        if (!toggle || !walineEl) return;

        // 重置 UI 状态
        walineEl.classList.remove("visible");
        toggle.classList.remove("active");
        toggle.textContent = (toggleLabels[getWalineLocale()] || toggleLabels.zh).show;
        toggle.style.display = "";

        setupWalineToggle();
    });

    // View Transitions 切换前清理，避免 AbortError
    document.addEventListener("astro:before-swap", () => {
        destroyWaline();
    });

    // 页面卸载时清理
    window.addEventListener("beforeunload", () => {
        destroyWaline();
    });

    // 首次加载：仅挂载按钮；评论实例在首次点击“展开评论”时懒加载
    setupWalineToggle();
</script>
