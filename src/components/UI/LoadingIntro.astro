---
// Loading intro — ring + red rule spin together as one unit,
// positioned to match the hero's ::before / ::after ornaments.
// Fades out to reveal the real hero underneath.
// Only plays once for first-time visitors; repeat visits skip it entirely.
---

<div id="loading-intro" class="loading-intro" aria-hidden="true">
    <div class="loading-intro__inner">
        <div class="loading-intro__circle" aria-hidden="true">
            <div class="loading-intro__rule" aria-hidden="true"></div>
        </div>
    </div>
</div>

<noscript>
    <style>
        .loading-intro {
            display: none !important;
        }
    </style>
</noscript>

<script>
    let _loadingBound = false;

    function handleLoading() {
        const el = document.getElementById("loading-intro");
        if (!el) return;

        const path = window.location.pathname.replace(/\/$/, "") || "/";
        if (path !== "/" && path !== "/en") {
            el.remove();
            return;
        }
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            el.remove();
            return;
        }

        // 双重调用防抖：同一次加载中 handleLoading 可能被调用两次
        // （脚本直调 + astro:page-load 事件），第二次不应立即移除正在播放的动画
        if (el.dataset.introState === "playing") return;

        // 只对首次访客播放一次开场动画；回访直接跳过
        const KEY = "loading-intro-shown";
        let seen = false;
        try {
            seen = !!localStorage.getItem(KEY);
        } catch (e) {}
        if (seen) {
            el.remove();
            return;
        }
        el.dataset.introState = "playing";
        try {
            localStorage.setItem(KEY, "1");
        } catch (e) {}

        setTimeout(() => {
            el.classList.add("loading-intro--done");
            setTimeout(() => {
                if (el.parentNode) el.remove();
            }, 1200);
        }, 1600);

        setTimeout(() => {
            if (el.parentNode) el.remove();
        }, 15000);
    }

    if (!_loadingBound) {
        _loadingBound = true;
        document.addEventListener("astro:page-load", handleLoading);
    }
    handleLoading();
</script>
