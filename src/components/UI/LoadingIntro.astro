---
// Loading intro — ring + red rule spin together as one unit,
// positioned to match the hero's ::before / ::after ornaments.
// Fades out to reveal the real hero underneath.
---

<div id="loading-intro" class="loading-intro" aria-hidden="true">
    <div class="loading-intro__inner">
        <div class="loading-intro__circle" aria-hidden="true">
            <div class="loading-intro__rule" aria-hidden="true"></div>
        </div>
    </div>
</div>

<noscript>
    <style>
        .loading-intro {
            display: none !important;
        }
    </style>
</noscript>

<script>
    let _loadingBound = false;

    function handleLoading() {
        const el = document.getElementById("loading-intro");
        if (!el) return;

        const path = window.location.pathname.replace(/\/$/, "") || "/";
        if (path !== "/" && path !== "/en") { el.remove(); return; }
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) { el.remove(); return; }

        const KEY = "loading-intro-shown";
        let spinMs = 400;
        try {
            if (localStorage.getItem(KEY)) spinMs = 200;
            localStorage.setItem(KEY, "1");
        } catch (e) {}

        setTimeout(() => {
            el.classList.add("loading-intro--done");
            setTimeout(() => { if (el.parentNode) el.remove(); }, 350);
        }, spinMs);

        setTimeout(() => { if (el.parentNode) el.remove(); }, 3500);
    }

    if (!_loadingBound) {
        _loadingBound = true;
        document.addEventListener("astro:page-load", handleLoading);
    }
    handleLoading();
</script>
