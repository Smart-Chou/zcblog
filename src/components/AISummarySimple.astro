---
---

<div class="ai-summary-widget">
    <button id="ai-summary-btn" class="ai-btn" aria-label="AI 摘要">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
            <line x1="12" x2="12" y1="19" y2="22"></line>
        </svg>
        <span>AI 摘要</span>
    </button>

    <div id="ai-panel" class="ai-panel" hidden>
        <div class="panel-header">
            <h3>🤖 AI 文章摘要</h3>
            <button id="close-panel" class="close-btn">×</button>
        </div>

        <div id="ai-config" class="config-section">
            <select id="ai-provider" class="select-input">
                <option value="deepseek">DeepSeek (推荐)</option>
                <option value="qwen">通义千问</option>
                <option value="wenxin">文心一言</option>
            </select>

            <input 
                type="password" 
                id="ai-key" 
                class="text-input" 
                placeholder="输入 API Key"
            />

            <label class="checkbox-label">
                <input type="checkbox" id="save-key" />
                <span>保存 API Key</span>
            </label>

            <button id="generate-btn" class="primary-btn">生成摘要</button>

            <div class="hint">
                <a href="https://platform.deepseek.com/api_keys" target="_blank">获取 DeepSeek API Key</a>
            </div>
        </div>

        <div id="ai-loading" class="loading-section" hidden>
            <div class="spinner"></div>
            <p>AI 正在分析...</p>
        </div>

        <div id="ai-result" class="result-section" hidden>
            <div class="result-header">
                <h4>📝 摘要</h4>
                <button id="copy-btn" class="icon-btn">📋</button>
            </div>
            <div id="summary-text" class="summary-text"></div>
            <button id="retry-btn" class="secondary-btn">重新生成</button>
        </div>

        <div id="ai-error" class="error-section" hidden></div>
    </div>
</div>

<style>
    .ai-summary-widget {
        position: fixed;
        left: 20px;
        bottom: 80px;
        z-index: 999;
    }

    .ai-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 24px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        transition: all 0.3s;
    }

    .ai-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(102, 126, 234, 0.5);
    }

    .ai-panel {
        position: fixed;
        left: 20px;
        bottom: 140px;
        width: 380px;
        max-height: 500px;
        background: var(--bg-content-color);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    .ai-panel[hidden] {
        display: none;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .panel-header h3 {
        margin: 0;
        font-size: 16px;
    }

    .close-btn {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        font-size: 24px;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .close-btn:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    .config-section,
    .loading-section,
    .result-section,
    .error-section {
        padding: 20px;
    }

    .select-input,
    .text-input {
        width: 100%;
        padding: 10px 12px;
        margin-bottom: 12px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--bg-color);
        color: var(--body-color);
        font-size: 14px;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
        font-size: 14px;
        cursor: pointer;
    }

    .primary-btn,
    .secondary-btn {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

    .primary-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .primary-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }

    .secondary-btn {
        background: var(--bg-color);
        border: 1px solid var(--border-color);
        color: var(--body-color);
        margin-top: 12px;
    }

    .secondary-btn:hover {
        background: #667eea;
        color: white;
        border-color: #667eea;
    }

    .hint {
        margin-top: 12px;
        font-size: 12px;
        text-align: center;
    }

    .hint a {
        color: #667eea;
        text-decoration: none;
    }

    .loading-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 40px 20px;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid var(--border-color);
        border-top-color: #667eea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    .result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .result-header h4 {
        margin: 0;
        font-size: 14px;
    }

    .icon-btn {
        background: none;
        border: 1px solid var(--border-color);
        padding: 6px 10px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 16px;
    }

    .icon-btn:hover {
        background: #667eea;
        border-color: #667eea;
    }

    .summary-text {
        padding: 16px;
        background: var(--bg-color);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 14px;
        line-height: 1.8;
        color: var(--body-color);
    }

    .error-section {
        padding: 16px;
        background: #fee;
        border: 1px solid #fcc;
        border-radius: 8px;
        color: #c33;
        font-size: 14px;
    }

    @media (max-width: 768px) {
        .ai-summary-widget {
            left: 10px;
            bottom: 70px;
        }

        .ai-panel {
            left: 10px;
            bottom: 130px;
            width: calc(100vw - 20px);
            max-width: 380px;
        }

        .ai-btn span {
            display: none;
        }

        .ai-btn {
            width: 48px;
            height: 48px;
            padding: 0;
            justify-content: center;
            border-radius: 50%;
        }
    }
</style>

<script>
    const STORAGE_KEY_API = 'ai-api-key';
    const STORAGE_KEY_PROVIDER = 'ai-provider';

    document.addEventListener('astro:page-load', () => {
        if (!document.querySelector('#post-content')) return;

        const btn = document.getElementById('ai-summary-btn');
        const panel = document.getElementById('ai-panel');
        const closeBtn = document.getElementById('close-panel');
        const generateBtn = document.getElementById('generate-btn');
        const retryBtn = document.getElementById('retry-btn');
        const copyBtn = document.getElementById('copy-btn');
        const providerSelect = document.getElementById('ai-provider') as HTMLSelectElement;
        const apiKeyInput = document.getElementById('ai-key') as HTMLInputElement;
        const saveKeyCheckbox = document.getElementById('save-key') as HTMLInputElement;

        const savedProvider = localStorage.getItem(STORAGE_KEY_PROVIDER);
        const savedApiKey = localStorage.getItem(STORAGE_KEY_API);

        if (savedProvider && providerSelect) {
            providerSelect.value = savedProvider;
        }

        if (savedApiKey && apiKeyInput) {
            apiKeyInput.value = savedApiKey;
            saveKeyCheckbox.checked = true;
        }

        btn?.addEventListener('click', () => {
            panel?.removeAttribute('hidden');
        });

        closeBtn?.addEventListener('click', () => {
            panel?.setAttribute('hidden', '');
        });

        generateBtn?.addEventListener('click', () => generateSummary());
        retryBtn?.addEventListener('click', () => generateSummary());

        copyBtn?.addEventListener('click', async () => {
            const text = document.getElementById('summary-text')?.textContent;
            if (text) {
                await navigator.clipboard.writeText(text);
                copyBtn.textContent = '✓';
                setTimeout(() => copyBtn.textContent = '📋', 2000);
            }
        });

        async function generateSummary() {
            const provider = providerSelect?.value;
            const apiKey = apiKeyInput?.value.trim();

            if (!apiKey) {
                showError('请输入 API Key');
                return;
            }

            if (saveKeyCheckbox?.checked) {
                localStorage.setItem(STORAGE_KEY_API, apiKey);
                localStorage.setItem(STORAGE_KEY_PROVIDER, provider);
            }

            const content = getArticleContent();
            if (!content) {
                showError('无法获取文章内容');
                return;
            }

            showLoading();

            try {
                const response = await fetch('/api/ai-summary', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content, apiKey, provider }),
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || '生成失败');
                }

                showResult(data.summary);
            } catch (error) {
                showError(error instanceof Error ? error.message : '生成失败');
            }
        }

        function getArticleContent(): string {
            const article = document.querySelector('#post-content');
            if (!article) return '';
            const clone = article.cloneNode(true) as HTMLElement;
            clone.querySelectorAll('script, style, img, svg').forEach(el => el.remove());
            return clone.textContent?.trim() || '';
        }

        function showLoading() {
            document.getElementById('ai-config')?.setAttribute('hidden', '');
            document.getElementById('ai-result')?.setAttribute('hidden', '');
            document.getElementById('ai-error')?.setAttribute('hidden', '');
            document.getElementById('ai-loading')?.removeAttribute('hidden');
        }

        function showResult(summary: string) {
            document.getElementById('ai-loading')?.setAttribute('hidden', '');
            document.getElementById('ai-config')?.setAttribute('hidden', '');
            document.getElementById('ai-error')?.setAttribute('hidden', '');
            const resultDiv = document.getElementById('ai-result');
            const summaryText = document.getElementById('summary-text');
            if (summaryText) summaryText.textContent = summary;
            resultDiv?.removeAttribute('hidden');
        }

        function showError(message: string) {
            document.getElementById('ai-loading')?.setAttribute('hidden', '');
            const errorDiv = document.getElementById('ai-error');
            if (errorDiv) {
                errorDiv.textContent = `❌ ${message}`;
                errorDiv.removeAttribute('hidden');
            }
            document.getElementById('ai-config')?.removeAttribute('hidden');
        }
    });
</script>
