{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "strict": true,
        "strictNullChecks": true,
        "allowJs": true,
        "paths": {
            "~/*": ["./src/*"]
        },
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", ".astro"]
}
