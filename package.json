{
    "name": "@marxchou/spencer",
    "version": "2.0.0",
    "description": "个人博客网站，使用Astro框架构建，包含文章、标签、归档、捐赠等功能",
    "type": "module",
    "private": false,
    "scripts": {
        "dev": "rm -rf node_modules/.astro node_modules/.vite .astro && astro dev",
        "start": "rm -rf node_modules/.astro node_modules/.vite .astro && astro dev",
        "build": "NODE_OPTIONS=\"--max-old-space-size=4096\" astro build && npx pagefind",
        "preview": "astro preview",
        "astro": "astro",
        "type-check": "tsc --noEmit --isolatedDeclarations",
        "new-post": "node scripts/new-post.js",
        "preinstall": "npx only-allow pnpm",
        "icons": "node scripts/generate-icons.js",
        "format": "prettier -w ."
    },
    "dependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/mdx": "^5.0.4",
        "@astrojs/partytown": "^2.1.7",
        "@astrojs/rss": "^4.0.18",
        "@astrojs/sitemap": "^3.7.2",
        "@expressive-code/plugin-collapsible-sections": "^0.41.7",
        "@expressive-code/plugin-line-numbers": "^0.41.7",
        "@fancyapps/ui": "^6.1.14",
        "@pagefind/default-ui": "^1.5.2",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.4",
        "@waline/client": "^3.13.0",
        "astro": "^6.3.0",
        "astro-compressor": "^1.3.0",
        "astro-expressive-code": "^0.42.0",
        "astro-icon": "^1.1.5",
        "astro-vtbot": "^2.1.12",
        "dayjs": "^1.11.20",
        "fast-glob": "^3.3.3",
        "hastscript": "^9.0.1",
        "html-minifier": "^4.0.0",
        "katex": "^0.16.45",
        "lenis": "^1.3.23",
        "marked": "^17.0.6",
        "mdast-util-find-and-replace": "^3.0.2",
        "mdast-util-to-string": "^4.0.0",
        "node-html-parser": "^7.1.0",
        "overlayscrollbars": "^2.15.1",
        "pagefind": "^1.5.2",
        "reading-time": "^1.5.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-callouts": "^2.1.2",
        "rehype-components": "^0.3.0",
        "rehype-katex": "^7.0.1",
        "rehype-slug": "^6.0.0",
        "remark-directive": "^4.0.0",
        "remark-directive-rehype": "^0.4.2",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-sectionize": "^2.1.0",
        "sanitize-html": "^2.17.3",
        "satori": "^0.26.0",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.2.4",
        "tocbot": "^4.36.6",
        "unist-util-is": "^6.0.1",
        "unist-util-remove": "^4.0.0",
        "unist-util-visit": "^5.1.0"
    },
    "devDependencies": {
        "@playform/inline": "^0.1.4",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.2.2",
        "@types/hast": "^3.0.4",
        "@types/mdast": "^4.0.4",
        "@types/qrcode": "^1.5.6",
        "@types/sanitize-html": "^2.16.1",
        "@vitest/ui": "^4.1.5",
        "jsdom": "^28.1.0",
        "prettier": "^3.8.3",
        "prettier-plugin-astro": "^0.14.1",
        "tailwindcss": "^4.2.2",
        "terser": "^5.47.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.3",
        "vitest": "^4.1.5"
    },
    "engines": {
        "node": ">= 22.0.0"
    }
}
