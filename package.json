{
    "name": "@marxchou/spwblog",
    "version": "1.0.1",
    "description": "个人博客网站，使用Astro框架构建，包含文章、标签、归档、捐赠等功能",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">= 22.0.0"
    },
    "pnpm": {
        "overrides": {
            "@iconify/tools": "^5.0.2"
        },
        "ignoredBuiltDependencies": [
            "puppeteer"
        ],
        "onlyBuiltDependencies": [
            "esbuild",
            "sharp"
        ]
    },
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro check && astro build && npx pagefind",
        "process-html": "node process-html.mjs",
        "preview": "astro preview",
        "test": "pnpm test:unit && pnpm test:e2e",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "deploy": "vercel --prod",
        "format": "prettier -w ."
    },
    "dependencies": {
        "@astrojs/mdx": "^5.0.0",
        "@astrojs/partytown": "^2.1.5",
        "@astrojs/rss": "^4.0.17",
        "@astrojs/sitemap": "^3.7.1",
        "@expressive-code/plugin-collapsible-sections": "^0.41.7",
        "@expressive-code/plugin-line-numbers": "^0.41.7",
        "@fancyapps/ui": "^6.1.13",
        "@pagefind/default-ui": "^1.4.0",
        "@playform/inline": "^0.1.2",
        "@waline/client": "^3.13.0",
        "astro": "^6.0.2",
        "astro-expressive-code": "^0.41.7",
        "astro-icon": "^1.1.5",
        "astro-vtbot": "^2.1.12",
        "dayjs": "^1.11.19",
        "fast-glob": "^3.3.3",
        "hastscript": "^9.0.1",
        "html-minifier": "^4.0.0",
        "katex": "^0.16.45",
        "lenis": "^1.3.23",
        "marked": "^17.0.4",
        "mdast-util-to-string": "^4.0.0",
        "pagefind": "^1.4.0",
        "reading-time": "^1.5.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-katex": "^7.0.1",
        "rehype-slug": "^6.0.0",
        "remark-directive": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "sanitize-html": "^2.17.1",
        "satori": "^0.26.0",
        "sharp": "^0.34.5",
        "tocbot": "^4.36.4",
        "unist-util-remove": "^4.0.0",
        "unist-util-visit": "^5.1.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.7",
        "@types/qrcode": "^1.5.6",
        "@vitest/ui": "^4.1.0",
        "jsdom": "^28.1.0",
        "prettier": "^3.8.1",
        "prettier-plugin-astro": "^0.14.1",
        "terser": "^5.46.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.1.0"
    },
    "browserslist": [
        "last 2 versions",
        "> 0.5%",
        "not dead",
        "not op_mini all"
    ]
}
