{
    "name": "@marxchou/spencer",
    "version": "2.0.0",
    "description": "个人博客网站，使用Astro框架构建，包含文章、标签、归档、捐赠等功能",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "rm -rf node_modules/.vite && astro dev",
        "start": "rm -rf node_modules/.vite && astro dev",
        "build": "pnpm run fetch:all && pnpm run fetch:verify && astro build",
        "preview": "astro preview",
        "astro": "astro",
        "type-check": "tsc --noEmit",
        "new-post": "node scripts/new-post.js",
        "preinstall": "npx only-allow pnpm",
        "fetch:all": "pnpm run talks & pnpm run douban & pnpm run friends & pnpm run bangumi & pnpm run icons",
        "icons": "node scripts/generate-icons.js",
        "talks": "node scripts/fetch-talks.mjs",
        "douban": "node scripts/fetch-douban.mjs",
        "friends": "node scripts/fetch-friends.mjs",
        "bangumi": "node scripts/fetch-bangumi.mjs",
        "fetch:verify": "node scripts/verify-data.mjs",
        "links": "node scripts/link-check.mjs",
        "release": "standard-version",
        "release:dry": "standard-version --dry-run",
        "format": "prettier -w .",
        "format:check": "prettier --check .",
        "lint": "pnpm run format:check",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/markdown-remark": "^7.2.0",
        "@astrojs/mdx": "^6.0.1",
        "@astrojs/partytown": "^2.1.7",
        "@astrojs/rss": "^4.0.18",
        "@astrojs/sitemap": "^3.7.3",
        "@expressive-code/plugin-collapsible-sections": "^0.41.7",
        "@expressive-code/plugin-line-numbers": "^0.41.7",
        "@fancyapps/ui": "^6.1.14",
        "@pagefind/default-ui": "^1.5.2",
        "@tailwindcss/vite": "^4.3.0",
        "@waline/client": "^3.15.0",
        "astro": "^6.4.2",
        "astro-expressive-code": "^0.42.0",
        "astro-icon": "^1.1.5",
        "astro-vtbot": "^2.1.12",
        "fast-glob": "^3.3.3",
        "hast-util-to-html": "^9.0.5",
        "hastscript": "^9.0.1",
        "html-minifier-terser": "^7.2.0",
        "katex": "^0.16.47",
        "marked": "^18.0.4",
        "pagefind": "^1.5.2",
        "pangu": "^7.2.1",
        "reading-time": "^1.5.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-callouts": "^2.1.2",
        "rehype-components": "^0.3.0",
        "rehype-katex": "^7.0.1",
        "rehype-slug": "^6.0.0",
        "remark-directive": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "sanitize-html": "^2.17.4",
        "satori": "^0.26.0",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.3.0",
        "tocbot": "^4.36.8",
        "unist-util-remove": "^4.0.0",
        "unist-util-visit": "^5.1.0"
    },
    "devDependencies": {
        "@iconify-json/logos": "^1.2.11",
        "@iconify-json/mingcute": "^1.2.7",
        "@iconify-json/tabler": "^1.2.35",
        "@iconify/utils": "^3.1.3",
        "@playwright/test": "^1.60.0",
        "@types/hast": "^3.0.4",
        "@types/mdast": "^4.0.4",
        "@types/sanitize-html": "^2.16.1",
        "jsdom": "^28.1.0",
        "prettier": "^3.8.3",
        "prettier-plugin-astro": "^0.14.1",
        "standard-version": "^9.5.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.5",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.8"
    },
    "packageManager": "pnpm@11.5.0"
}
